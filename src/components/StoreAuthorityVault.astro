---
// src/components/StoreAuthorityVault.astro
// Founder & Proof section + FAQ + Guarantee.
// Replaces the former "medical board" (placeholder doctor profiles were removed in the
// Nov 2026 compliance cleanup — never re-add people who are not real, consenting advisors).
// FAQ content lives in src/lib/homeFaqs.ts and is shared with the FAQPage schema.
import { BRAND_CONFIG, getWhatsAppLink } from '../config/brand';
import { homeFaqs } from '../lib/homeFaqs';

const lab = BRAND_CONFIG.labReport;

// TODO(founder): add a real founder photo (/brand/founder-yash.webp) and the founder's own
// story in their words. Do not invent biography details.
const videos = [
  {
    id: 'founder-video',
    videoId: 'ugm6QqndEzQ',
    label: 'Founder • 1:36',
    title: 'Yash Suryawanshi explains how Sujata Spirulina is grown and tested',
  },
  {
    id: 'facility-video',
    videoId: 'WbhJp-tZVj4',
    label: 'Facility Tour • 1:01',
    title: 'Inside the facility where Sujata Spirulina is cultivated and harvested',
  },
];
---

<section id="authority-vault" aria-labelledby="founder-heading" class="py-16 md:py-24 bg-[#FAF9F6] text-[#111827] border-t border-gray-200/80 font-sans">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-12">

    {/* ================= 1. FOUNDER & PROOF ================= */}
    <div class="max-w-3xl mb-10 md:mb-12">
      <span class="block text-[11px] font-bold uppercase tracking-[0.2em] text-[#166534] mb-2">Founder &amp; Proof</span>
      <h2 id="founder-heading" class="text-3xl sm:text-4xl md:text-5xl font-serif font-normal tracking-tight leading-tight mb-3">
        Meet the Founder. <span class="italic text-[#166534]">See the Farm. Read the Lab Report.</span>
      </h2>
      <p class="text-sm text-gray-600 leading-relaxed">
        Sujata Nutrilive was founded in Nashik, Maharashtra in 2024 by <strong class="text-[#111827]">Yash Suryawanshi</strong>.
        We'd rather show you than tell you: watch how our spirulina is grown, and check our independent lab report yourself.
      </p>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 lg:gap-8 mb-16">

      {/* Videos (lite facades — iframe injected only on click) */}
      <div class="lg:col-span-7 grid grid-cols-1 sm:grid-cols-2 gap-4">
        {videos.map((v) => (
          <figure class="bg-white rounded-2xl border border-gray-200 shadow-sm overflow-hidden">
            <button
              type="button"
              class="vault-video relative block w-full aspect-video bg-gray-900 group cursor-pointer"
              data-video-id={v.videoId}
              data-video-title={v.title}
              aria-label={`Play video: ${v.title}`}
            >
              <img
                src={`https://i.ytimg.com/vi/${v.videoId}/hqdefault.jpg`}
                alt=""
                width="480"
                height="360"
                loading="lazy"
                decoding="async"
                class="absolute inset-0 w-full h-full object-cover opacity-95"
              />
              <span class="absolute top-2.5 left-2.5 bg-black/60 text-white/90 px-2.5 py-0.5 rounded-full text-[10.5px] font-mono">{v.label}</span>
              <span class="absolute inset-0 flex items-center justify-center">
                <span class="w-12 h-12 rounded-full bg-white/95 text-[#166534] flex items-center justify-center shadow-lg group-hover:scale-110 transition-transform">
                  <svg class="w-5 h-5 fill-current translate-x-0.5" viewBox="0 0 24 24" aria-hidden="true"><path d="M8 5v14l11-7z"/></svg>
                </span>
              </span>
            </button>
            <figcaption class="p-3.5 text-xs sm:text-[13px] font-semibold text-[#111827] leading-snug">{v.title}</figcaption>
          </figure>
        ))}

        <div class="sm:col-span-2 bg-white rounded-2xl border border-gray-200 p-5 shadow-sm">
          <h3 class="text-base font-bold font-serif mb-3">Our commitments to you</h3>
          <ul class="space-y-2 text-xs sm:text-sm text-gray-700">
            <li class="flex gap-2"><span class="text-emerald-600" aria-hidden="true">✓</span><span>We publish our full lab report, not just a badge.</span></li>
            <li class="flex gap-2"><span class="text-emerald-600" aria-hidden="true">✓</span><span>100% spirulina: no binders, talc or fillers.</span></li>
            <li class="flex gap-2"><span class="text-emerald-600" aria-hidden="true">✓</span><span>FSSAI registered: Lic. No. <span class="font-mono">{BRAND_CONFIG.fssaiNumber}</span>.</span></li>
            <li class="flex gap-2"><span class="text-emerald-600" aria-hidden="true">✓</span><span>No health claims we cannot back up, and a 90-day refund if you are not satisfied.</span></li>
          </ul>
        </div>
      </div>

      {/* Lab report certificate */}
      <div id="lab-report" class="lg:col-span-5 bg-white rounded-2xl border border-gray-200 shadow-sm p-5 sm:p-6 flex flex-col sm:flex-row lg:flex-col gap-5">
        <a href={lab.pdfUrl} target="_blank" rel="noopener" class="block shrink-0 sm:w-44 lg:w-full lg:max-w-[260px] lg:mx-auto rounded-lg overflow-hidden border border-gray-200 shadow-sm hover:shadow-md transition-shadow">
          <img
            src="/lab/lilaba-report-LAL-NN-131125023-p1.webp"
            alt={`Lilaba Analytical Laboratories test report ${lab.number}, page 1`}
            width="480"
            height="679"
            loading="lazy"
            decoding="async"
            class="w-full h-auto"
          />
        </a>
        <div class="flex-1">
          <span class="block text-[10px] font-bold uppercase tracking-[0.2em] text-[#166534] mb-1">Independent Lab Report</span>
          <h3 class="text-lg font-bold font-serif mb-3">Report #{lab.number}</h3>
          <dl class="grid grid-cols-2 gap-x-3 gap-y-2 text-xs mb-4">
            <dt class="text-gray-500">Laboratory</dt><dd class="font-semibold">{lab.lab}</dd>
            <dt class="text-gray-500">Sample</dt><dd class="font-semibold">{lab.sample}</dd>
            <dt class="text-gray-500">Batch</dt><dd class="font-semibold font-mono">{lab.batch}</dd>
            <dt class="text-gray-500">Issued</dt><dd class="font-semibold">{lab.issueDate}</dd>
            <dt class="text-gray-500">Protein</dt><dd class="font-bold text-[#166534]">{lab.proteinPct}%</dd>
            <dt class="text-gray-500">Iron (as Fe)</dt><dd class="font-bold text-[#166534]">{lab.ironMgPerKg} mg/kg</dd>
          </dl>
          <a
            href={lab.pdfUrl}
            target="_blank"
            rel="noopener"
            class="inline-flex items-center justify-center w-full gap-2 bg-[#064E3B] hover:bg-[#166534] text-white px-5 py-3 rounded-xl font-bold text-xs uppercase tracking-wider transition-colors touch-manipulation"
          >
            Download Full Report (PDF) ↓
          </a>
        </div>
      </div>
    </div>

    {/* ================= 2. FAQ + GUARANTEE ================= */}
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-12 items-start mb-12">

      <div class="lg:col-span-7">
        <div class="mb-6">
          <span class="text-xs font-bold text-[#166534] uppercase tracking-[0.2em] mb-1 block">Before You Buy</span>
          <h2 id="faq" class="text-2xl sm:text-3xl font-serif font-normal">
            Spirulina &amp; Sea Buckthorn: <span class="italic text-[#166534]">Your Questions Answered</span>
          </h2>
        </div>

        <div class="border-t border-gray-200">
          {homeFaqs.map((faq, index) => (
            <details class="faq-item group border-b border-gray-200" lang={faq.lang || undefined} open={index === 0}>
              <summary class="w-full text-left py-5 flex items-start gap-4 cursor-pointer list-none [&::-webkit-details-marker]:hidden">
                <span class="text-xs font-bold text-gray-400 mt-0.5 tracking-wider" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
                <h3 class="flex-1 text-[#111827] text-sm sm:text-base font-bold pr-4">{faq.question}</h3>
                <span class="shrink-0 text-gray-400 text-lg leading-none group-open:rotate-45 transition-transform" aria-hidden="true">+</span>
              </summary>
              <p class="text-gray-600 text-xs sm:text-sm leading-relaxed pb-5 pl-9 pr-6">{faq.answer}</p>
            </details>
          ))}
        </div>
      </div>

      <div class="lg:col-span-5 bg-[#064E3B] text-white rounded-3xl p-7 sm:p-9 shadow-md">
        <span class="text-[10px] font-black uppercase tracking-widest bg-emerald-800/80 text-emerald-200 border border-emerald-500/30 px-3 py-1 rounded-full inline-block mb-6">Risk-Free</span>
        <h3 class="text-2xl font-serif font-normal mb-3 leading-snug">
          90-Day Satisfaction Return.<br/>
          <span class="italic text-emerald-300">Transparent terms, no outcome promises.</span>
        </h3>
        <p class="text-xs sm:text-sm text-emerald-100/80 leading-relaxed mb-6">
          Sujata products are dietary supplements, not medicines. If you are not satisfied after a 90-day routine, contact our support team within 7 days to process a return as per our <a href="/refund-policy" class="underline hover:text-emerald-200">Refund Policy</a>.
        </p>
        <ul class="space-y-2 text-xs border-t border-emerald-700/50 pt-4">
          <li class="flex items-center gap-2"><span class="text-emerald-300" aria-hidden="true">✓</span><a href="/refund-policy" class="text-emerald-200 hover:text-white underline font-semibold">Read the full refund policy →</a></li>
          <li class="flex items-center gap-2"><span class="text-emerald-300" aria-hidden="true">✓</span><span>Support desk: {BRAND_CONFIG.operatingHours}</span></li>
          <li class="flex items-center gap-2"><span class="text-emerald-300" aria-hidden="true">✓</span><span>Lab report #{lab.number} published</span></li>
        </ul>
      </div>
    </div>

    {/* ================= 3. WHATSAPP HELP BAR ================= */}
    <div class="bg-white rounded-2xl p-6 border border-gray-200 shadow-sm flex flex-col sm:flex-row items-center justify-between gap-5">
      <div class="flex items-center gap-4 text-left">
        <div class="w-12 h-12 rounded-xl bg-emerald-50 border border-emerald-200 flex items-center justify-center text-xl shrink-0" aria-hidden="true">💬</div>
        <div>
          <p class="text-sm sm:text-base font-bold text-[#111827]">Questions about dosage or which pack to choose?</p>
          <p class="text-xs text-gray-500 mt-0.5">Our team replies on WhatsApp. For medical conditions, please also check with your doctor.</p>
        </div>
      </div>
      <a
        href={getWhatsAppLink("Hi Sujata Nutrilive, I have a question about spirulina dosage / which pack to choose.")}
        target="_blank"
        rel="noopener noreferrer"
        class="bg-[#111827] hover:bg-[#166534] text-white px-6 py-3 rounded-xl font-bold text-xs uppercase tracking-wider transition-colors shrink-0 touch-manipulation"
      >
        Ask Us on WhatsApp →
      </a>
    </div>

  </div>
</section>

<script is:inline>
  (function () {
    function initVaultVideos() {
      document.querySelectorAll('#authority-vault .vault-video').forEach(function (btn) {
        if (btn.dataset.bound) return;
        btn.dataset.bound = '1';
        btn.addEventListener('click', function () {
          var id = btn.getAttribute('data-video-id');
          var title = btn.getAttribute('data-video-title') || 'Video';
          var iframe = document.createElement('iframe');
          iframe.src = 'https://www.youtube-nocookie.com/embed/' + id + '?autoplay=1&rel=0&modestbranding=1&playsinline=1';
          iframe.title = title;
          iframe.className = 'absolute inset-0 w-full h-full border-0';
          iframe.allow = 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture';
          iframe.allowFullscreen = true;
          var wrap = document.createElement('div');
          wrap.className = 'relative block w-full aspect-video bg-black';
          wrap.appendChild(iframe);
          btn.replaceWith(wrap);
        });
      });
    }
    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', initVaultVideos);
    else initVaultVideos();
  })();
</script>
