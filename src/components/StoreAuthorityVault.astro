<script is:inline>
  function initVaultFAQAccordion() {
    const faqButtons = document.querySelectorAll('#authority-vault .faq-button');

    faqButtons.forEach(button => {
      button.addEventListener('click', () => {
        const answer = button.querySelector('.faq-answer');
        const icon = button.querySelector('.shrink-0');
        const isOpen = answer.classList.contains('open');

        // Close all other FAQs
        faqButtons.forEach(otherBtn => {
          const otherAnswer = otherBtn.querySelector('.faq-answer');
          const otherIcon = otherBtn.querySelector('.shrink-0');
          if (otherAnswer) {
            otherAnswer.classList.remove('open');
            otherAnswer.style.gridTemplateRows = '0fr';
          }
          if (otherIcon) otherIcon.innerText = '+';
        });

        // Toggle clicked FAQ
        if (!isOpen && answer) {
          answer.classList.add('open');
          answer.style.gridTemplateRows = '1fr';
          if (icon) icon.innerText = '−';
        }
      });
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initVaultFAQAccordion);
  } else {
    initVaultFAQAccordion();
  }
  document.addEventListener('astro:page-load', initVaultFAQAccordion);
</script>
