---
// src/components/StoreBundleBuilder.astro
const shopifyDomain = import.meta.env.PUBLIC_SHOPIFY_STOREFRONT_DOMAIN || "skadas-headless-demo.myshopify.com";
const storefrontToken = import.meta.env.PUBLIC_SHOPIFY_STOREFRONT_TOKEN || "32f678c5f8d1345e945ed48713d9cf2f";
---

<!-- 🌟 10/10 Clean Minimalist Welcome Kit Builder (Seed / AG1 / Ritual Standard) -->
<div id="welcome-kit-builder" class="bg-white rounded-3xl p-6 sm:p-10 lg:p-14 border border-gray-200 shadow-sm text-[#111827]">
  
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-16 items-center">
    
    {/* LEFT COLUMN (6 Cols): Clean Studio Photography & Manifest */}
    <div class="lg:col-span-6 flex flex-col items-center lg:items-start text-center lg:text-left">
      
      {/* Social Proof Pill */}
      <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-emerald-50 border border-emerald-200/80 mb-6">
        <div class="flex text-[#D97706] text-xs">★★★★★</div>
        <span class="text-xs font-bold text-[#166534] font-sans">4.9 / 5.0 (1,280+ Reviews)</span>
      </div>

      {/* Main Product Visual */}
      <div class="w-full max-w-md aspect-square bg-[#FAF9F6] rounded-3xl p-6 flex items-center justify-center mb-6 relative overflow-hidden group">
        <img 
          id="kit-visual-img"
          src="/spirulina-bottle.png" 
          alt="Sujata Nutrilive Daily Ritual Kit" 
          class="w-full h-full object-contain drop-shadow-xl group-hover:scale-105 transition-transform duration-500"
        />
        <span class="absolute bottom-4 right-4 bg-white/90 backdrop-blur-md border border-gray-200 text-[10px] font-bold uppercase tracking-wider text-gray-600 px-2.5 py-1 rounded-lg font-sans">
          Batch #SN-0882 Verified
        </span>
      </div>

      {/* Itemized Manifest Checklist */}
      <div class="w-full max-w-md space-y-2.5 text-left border-t border-gray-100 pt-5">
        <div class="flex items-center gap-2.5 text-xs text-gray-700 font-sans">
          <span class="text-[#166534] font-bold text-sm">✓</span>
          <span id="manifest-supply-text">3x Bottles 100% Pure Spirulina (90-Day Full Supply)</span>
        </div>
        <div class="flex items-center gap-2.5 text-xs text-gray-700 font-sans">
          <span class="text-amber-600 font-bold text-sm">🎁</span>
          <span><strong>Complimentary Gift:</strong> Stainless Steel Shaker Bottle (Worth ₹699)</span>
        </div>
        <div class="flex items-center gap-2.5 text-xs text-gray-700 font-sans">
          <span class="text-[#166534] font-bold text-sm">✓</span>
          <span>Ayurvedic Dosage Protocol & NABL Certified Lab Analysis</span>
        </div>
      </div>

    </div>

    {/* RIGHT COLUMN (6 Cols): Clean, Frictionless Selection Controls */}
    <div class="lg:col-span-6 flex flex-col space-y-6">
      
      {/* Title & Tagline */}
      <div>
        <span class="text-[11px] font-bold uppercase tracking-[0.2em] text-[#166534] block mb-1 font-sans">
          The Starter Welcome Ritual
        </span>
        <h2 class="text-3xl sm:text-4xl font-serif font-normal text-[#111827] tracking-tight leading-tight mb-2">
          Begin Your Daily Ritual<span class="text-[#166534]">.</span>
        </h2>
        <p class="text-xs sm:text-sm text-gray-600 font-normal leading-relaxed">
          Everything required for 90 days of peak cellular vitality, organic immunity, and natural stamina in one doctor-formulated kit.
        </p>
      </div>

      {/* 1. Form Choice (Segmented Toggle) */}
      <div>
        <label class="text-xs font-bold uppercase tracking-wider text-gray-700 block mb-2 font-sans">
          1. Select Formulation
        </label>
        <div class="grid grid-cols-2 gap-3 p-1 bg-gray-100 rounded-2xl">
          <button 
            type="button" 
            class="format-toggle-btn active py-3 px-4 rounded-xl text-xs font-bold font-sans transition-all flex items-center justify-center gap-2 bg-white text-[#111827] shadow-sm cursor-pointer"
            data-format="capsules"
          >
            <span>💊</span>
            <span>Veg Capsules</span>
          </button>
          <button 
            type="button" 
            class="format-toggle-btn py-3 px-4 rounded-xl text-xs font-bold font-sans transition-all flex items-center justify-center gap-2 text-gray-600 hover:text-black cursor-pointer"
            data-format="powder"
          >
            <span>🌿</span>
            <span>Pure Raw Powder</span>
          </button>
        </div>
      </div>

      {/* 2. Supply Plan (2 Clear Cards: 90-Day vs 30-Day) */}
      <div>
        <label class="text-xs font-bold uppercase tracking-wider text-gray-700 block mb-2 font-sans">
          2. Select Duration Plan
        </label>

        <div class="space-y-3">
          
          {/* 90-DAY BEST VALUE CARD (Default Active) */}
          <div 
            class="plan-card active p-4 sm:p-5 rounded-2xl border-2 border-[#166534] bg-emerald-50/40 cursor-pointer transition-all flex items-center justify-between gap-4"
            data-plan="90"
            data-price="2023"
            data-old-price="2699"
          >
            <div class="flex items-center gap-3">
              <div class="w-5 h-5 rounded-full border-2 border-[#166534] flex items-center justify-center shrink-0">
                <div class="w-2.5 h-2.5 rounded-full bg-[#166534]"></div>
              </div>
              <div>
                <div class="flex items-center gap-2">
                  <span class="text-sm sm:text-base font-bold text-[#111827] font-sans">90-Day Ritual Kit</span>
                  <span class="text-[10px] font-black uppercase tracking-wider bg-[#166534] text-white px-2 py-0.5 rounded-full font-sans">Save 25%</span>
                </div>
                <span class="text-xs text-gray-500 font-sans block mt-0.5">Includes Free Shaker Bottle + Free Delivery</span>
              </div>
            </div>

            <div class="text-right shrink-0">
              <span class="text-lg sm:text-xl font-black text-[#111827] font-sans block">₹2,023</span>
              <span class="text-xs text-gray-400 line-through font-sans">₹2,699</span>
            </div>
          </div>

          {/* 30-DAY STARTER CARD */}
          <div 
            class="plan-card p-4 sm:p-5 rounded-2xl border border-gray-200 bg-white hover:border-gray-300 cursor-pointer transition-all flex items-center justify-between gap-4"
            data-plan="30"
            data-price="799"
            data-old-price="1299"
          >
            <div class="flex items-center gap-3">
              <div class="w-5 h-5 rounded-full border-2 border-gray-300 flex items-center justify-center shrink-0">
                <div class="w-2.5 h-2.5 rounded-full bg-transparent"></div>
              </div>
              <div>
                <span class="text-sm sm:text-base font-bold text-[#111827] font-sans block">30-Day Starter Kit</span>
                <span class="text-xs text-gray-500 font-sans block mt-0.5">1-Month Standard Trial Supply</span>
              </div>
            </div>

            <div class="text-right shrink-0">
              <span class="text-lg sm:text-xl font-black text-[#111827] font-sans block">₹799</span>
              <span class="text-xs text-gray-400 line-through font-sans">₹1,299</span>
            </div>
          </div>

        </div>
      </div>

      {/* 3. Master Call to Action Button */}
      <div class="pt-2">
        <button 
          id="claim-kit-btn"
          type="button" 
          class="w-full bg-[#111827] hover:bg-[#166534] text-white py-4 rounded-2xl font-bold text-sm uppercase tracking-wider transition-all shadow-md active:scale-95 touch-manipulation cursor-pointer flex items-center justify-center gap-3"
          data-domain={shopifyDomain}
          data-token={storefrontToken}
        >
          <span id="claim-btn-label">Claim 90-Day Welcome Kit — ₹2,023</span>
          <span class="text-base">→</span>
        </button>

        {/* Micro Guarantees */}
        <div class="flex items-center justify-center gap-4 text-[11px] text-gray-500 mt-3 font-sans">
          <span>🚚 Free Express Shipping</span>
          <span>•</span>
          <span>🛡️ 30-Day Guarantee</span>
          <span>•</span>
          <span>💵 Cash on Delivery</span>
        </div>
      </div>

    </div>

  </div>

</div>

<script is:inline>
  function initCleanWelcomeKitBuilder() {
    let currentFormat = 'capsules';
    let currentPlan = '90';

    const formatBtns = document.querySelectorAll('#welcome-kit-builder .format-toggle-btn');
    const planCards = document.querySelectorAll('#welcome-kit-builder .plan-card');
    const visualImg = document.getElementById('kit-visual-img');
    const manifestSupply = document.getElementById('manifest-supply-text');
    const claimBtn = document.getElementById('claim-kit-btn');
    const claimBtnLabel = document.getElementById('claim-btn-label');

    function updateKitState() {
      // Update Image & Text based on format
      if (visualImg) {
        visualImg.src = currentFormat === 'capsules' ? '/spirulina-bottle.png' : '/spirulina-powder.png';
      }

      if (manifestSupply) {
        if (currentPlan === '90') {
          manifestSupply.innerText = currentFormat === 'capsules' 
            ? '3x Bottles 100% Veg Capsules (90-Day Supply)' 
            : '3x Jars Raw Pure Spirulina Powder (90-Day Supply)';
        } else {
          manifestSupply.innerText = currentFormat === 'capsules' 
            ? '1x Bottle 100% Veg Capsules (30-Day Starter Supply)' 
            : '1x Jar Raw Pure Spirulina Powder (30-Day Starter Supply)';
        }
      }

      // Update CTA Label & Price
      if (claimBtnLabel) {
        if (currentPlan === '90') {
          claimBtnLabel.innerText = 'Claim 90-Day Welcome Kit — ₹2,023';
        } else {
          claimBtnLabel.innerText = 'Claim 30-Day Starter Kit — ₹799';
        }
      }
    }

    // Format toggle listener
    formatBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        formatBtns.forEach(b => {
          b.classList.remove('active', 'bg-white', 'text-[#111827]', 'shadow-sm');
          b.classList.add('text-gray-600');
        });
        btn.classList.add('active', 'bg-white', 'text-[#111827]', 'shadow-sm');
        btn.classList.remove('text-gray-600');
        currentFormat = btn.getAttribute('data-format') || 'capsules';
        updateKitState();
      });
    });

    // Plan card listener
    planCards.forEach(card => {
      card.addEventListener('click', () => {
        planCards.forEach(c => {
          c.classList.remove('active', 'border-2', 'border-[#166534]', 'bg-emerald-50/40');
          c.classList.add('border', 'border-gray-200', 'bg-white');
          const dot = c.querySelector('.w-2\\.5');
          if (dot) dot.className = 'w-2.5 h-2.5 rounded-full bg-transparent';
          const ring = c.querySelector('.w-5');
          if (ring) ring.className = 'w-5 h-5 rounded-full border-2 border-gray-300 flex items-center justify-center shrink-0';
        });

        card.classList.add('active', 'border-2', 'border-[#166534]', 'bg-emerald-50/40');
        card.classList.remove('border', 'border-gray-200', 'bg-white');
        const activeDot = card.querySelector('.w-2\\.5');
        if (activeDot) activeDot.className = 'w-2.5 h-2.5 rounded-full bg-[#166534]';
        const activeRing = card.querySelector('.w-5');
        if (activeRing) activeRing.className = 'w-5 h-5 rounded-full border-2 border-[#166534] flex items-center justify-center shrink-0';

        currentPlan = card.getAttribute('data-plan') || '90';
        updateKitState();
      });
    });

    // Claim Button Click -> Add To Cart via Cart Drawer
    if (claimBtn) {
      claimBtn.addEventListener('click', () => {
        const title = `Sujata ${currentFormat === 'capsules' ? 'Capsules' : 'Powder'} (${currentPlan}-Day Protocol Kit)`;
        const price = currentPlan === '90' ? 2023 : 799;
        const image = currentFormat === 'capsules' ? '/spirulina-bottle.png' : '/spirulina-powder.png';
        const variantId = currentPlan === '90' ? 'kit_90_' + currentFormat : 'kit_30_' + currentFormat;
        const subtitle = currentPlan === '90' ? '90-Day Kit + Free Shaker Bottle' : '30-Day Starter Supply';

        if (typeof window.addItemToLocalCart === 'function') {
          window.addItemToLocalCart({
            id: variantId,
            title: title,
            subtitle: subtitle,
            price: price,
            image: image,
            quantity: 1
          });
        }
      });
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initCleanWelcomeKitBuilder);
  } else {
    initCleanWelcomeKitBuilder();
  }
  document.addEventListener('astro:page-load', initCleanWelcomeKitBuilder);
</script>
