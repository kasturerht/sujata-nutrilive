---
// src/components/StoreMedicalBoard.astro
---

<!-- 🏛️ Minimalist Corporate & Clinical Advisory Board (Clean Editorial Luxury) -->
<section id="medical-advisory-board" class="py-20 md:py-28 bg-[#FBF9F5] text-[#111827] border-t border-gray-200/80">
  
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-12">
    
    {/* 1. Clean Corporate Section Header */}
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 mb-14 md:mb-16 border-b border-gray-200 pb-8">
      <div class="max-w-2xl">
        <span class="text-[11px] font-bold uppercase tracking-[0.2em] text-[#166534] block mb-2">
          Clinical Governance & Medical Board
        </span>
        <h2 class="text-3xl sm:text-4xl md:text-5xl font-black font-['Playfair_Display'] text-[#111827] tracking-tight leading-tight">
          Formulated by Practitioners.<br/>
          <span class="font-normal text-gray-600">Guided by Clinical Science.</span>
        </h2>
      </div>

      <div class="max-w-md">
        <p class="text-xs sm:text-sm text-gray-600 leading-relaxed font-normal">
          Our formulations undergo independent review and batch clearance by certified Ayurvedic Vaidyas and Clinical Nutritionists to ensure zero heavy metal toxicity and peak bio-availability.
        </p>
      </div>
    </div>

    {/* 2. 3 Clean, Minimalist Corporate Practitioner Cards */}
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 lg:gap-8 mb-12">
      
      {/* PRACTITIONER 1 */}
      <div class="bg-white rounded-2xl p-7 border border-gray-200/90 shadow-sm hover:shadow-md hover:border-[#166534]/40 transition-all flex flex-col justify-between">
        <div>
          {/* Header Metadata */}
          <div class="flex items-center justify-between border-b border-gray-100 pb-4 mb-5 text-[11px]">
            <span class="font-bold text-[#166534]">Ayurvedic Medicine</span>
            <span class="font-mono text-gray-400">Reg: MCIM/I-48921-A</span>
          </div>

          {/* Identity */}
          <div class="mb-4">
            <h3 class="text-lg sm:text-xl font-bold font-['Playfair_Display'] text-[#111827]">
              Dr. Rajesh Joshi
            </h3>
            <p class="text-xs font-semibold text-[#166534] mt-0.5">BAMS, MD (Ayurveda)</p>
            <p class="text-xs text-gray-500 mt-1">Former Dean, Bharati Vidyapeeth Ayurvedic Hospital, Pune</p>
          </div>

          {/* Clinical Perspective */}
          <p class="text-xs text-gray-600 leading-relaxed mb-6 font-normal">
            "Low-temperature harvesting preserves organic iron and phycocyanin in their natural bio-active state, enabling effective Rasayana (cellular rejuvenation) without synthetic additives."
          </p>
        </div>

        {/* Specialization Tags */}
        <div class="pt-4 border-t border-gray-100 flex flex-wrap gap-2 text-[10px]">
          <span class="px-2.5 py-1 rounded bg-gray-100 text-gray-700 font-medium">Rasayana Protocol</span>
          <span class="px-2.5 py-1 rounded bg-gray-100 text-gray-700 font-medium">Cellular Longevity</span>
        </div>
      </div>

      {/* PRACTITIONER 2 */}
      <div class="bg-white rounded-2xl p-7 border border-gray-200/90 shadow-sm hover:shadow-md hover:border-[#166534]/40 transition-all flex flex-col justify-between">
        <div>
          {/* Header Metadata */}
          <div class="flex items-center justify-between border-b border-gray-100 pb-4 mb-5 text-[11px]">
            <span class="font-bold text-[#166534]">Clinical Nutrition</span>
            <span class="font-mono text-gray-400">Reg: IDA-MH-2018-091</span>
          </div>

          {/* Identity */}
          <div class="mb-4">
            <h3 class="text-lg sm:text-xl font-bold font-['Playfair_Display'] text-[#111827]">
              Dr. Ananya Sharma
            </h3>
            <p class="text-xs font-semibold text-[#166534] mt-0.5">Ph.D., RD (Clinical Nutrition)</p>
            <p class="text-xs text-gray-500 mt-1">Former Lead Nutritionist, Fortis Healthcare</p>
          </div>

          {/* Clinical Perspective */}
          <p class="text-xs text-gray-600 leading-relaxed mb-6 font-normal">
            "Providing a complete essential amino acid profile and 65% bio-available protein, cold-pressed Spirulina addresses widespread micronutrient deficiencies in modern urban diets."
          </p>
        </div>

        {/* Specialization Tags */}
        <div class="pt-4 border-t border-gray-100 flex flex-wrap gap-2 text-[10px]">
          <span class="px-2.5 py-1 rounded bg-gray-100 text-gray-700 font-medium">Metabolic Health</span>
          <span class="px-2.5 py-1 rounded bg-gray-100 text-gray-700 font-medium">Plant Protein Bio-Availability</span>
        </div>
      </div>

      {/* PRACTITIONER 3 */}
      <div class="bg-white rounded-2xl p-7 border border-gray-200/90 shadow-sm hover:shadow-md hover:border-[#166534]/40 transition-all flex flex-col justify-between">
        <div>
          {/* Header Metadata */}
          <div class="flex items-center justify-between border-b border-gray-100 pb-4 mb-5 text-[11px]">
            <span class="font-bold text-[#166534]">Quality & Purity Audits</span>
            <span class="font-mono text-gray-400">Reg: MCIM/I-55210-B</span>
          </div>

          {/* Identity */}
          <div class="mb-4">
            <h3 class="text-lg sm:text-xl font-bold font-['Playfair_Display'] text-[#111827]">
              Dr. Vikramaditya Patil
            </h3>
            <p class="text-xs font-semibold text-[#166534] mt-0.5">BAMS, MS (Ayur-Surgery & Detox)</p>
            <p class="text-xs text-gray-500 mt-1">15+ Years Clinical Practice in Immunity & Purity</p>
          </div>

          {/* Clinical Perspective */}
          <p class="text-xs text-gray-600 leading-relaxed mb-6 font-normal">
            "Every harvest is independently tested across 18 heavy metal parameters at NABL laboratories. Zero-lead and zero-mercury standards are strictly enforced prior to batch distribution."
          </p>
        </div>

        {/* Specialization Tags */}
        <div class="pt-4 border-t border-gray-100 flex flex-wrap gap-2 text-[10px]">
          <span class="px-2.5 py-1 rounded bg-gray-100 text-gray-700 font-medium">NABL Heavy Metal Audits</span>
          <span class="px-2.5 py-1 rounded bg-gray-100 text-gray-700 font-medium">Immunity Protocols</span>
        </div>
      </div>

    </div>

    {/* 3. Clean, Refined Consultation Footer Banner */}
    <div class="bg-[#064E3B] rounded-2xl p-6 sm:p-7 text-white flex flex-col sm:flex-row items-center justify-between gap-5 shadow-sm">
      <div class="text-left">
        <h4 class="text-base font-bold text-white">Have a dosage or formulation query?</h4>
        <p class="text-xs text-emerald-100/80 mt-0.5">Consult with our certified Ayurvedic team for personalized guidance.</p>
      </div>

      <a 
        href="https://wa.me/919876543210?text=Hello%20Sujata%20Nutrilive%2C%20I%20have%20a%20question%20regarding%20Spirulina%20dosage." 
        target="_blank" 
        rel="noopener noreferrer"
        class="bg-white text-[#064E3B] hover:bg-emerald-50 px-6 py-3 rounded-xl font-bold text-xs uppercase tracking-wider transition-colors flex-shrink-0 active:scale-95 touch-manipulation"
      >
        Consult on WhatsApp →
      </a>
    </div>

  </div>
</section>
