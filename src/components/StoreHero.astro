---
// src/components/StoreHero.astro
// Single static hero (no carousel, no entrance animations, no client JS).
// Goal: a first-time mobile visitor understands in 3 seconds WHAT this is, WHY to trust it,
// and WHAT to buy first. Every claim here must be verifiable — facts come from BRAND_CONFIG.
import { BRAND_CONFIG, getWhatsAppLink } from '../config/brand';

interface Props {
  products?: any[];
}

const { products = [] } = Astro.props;
const lab = BRAND_CONFIG.labReport;
const reviews = BRAND_CONFIG.reviews;

function findProduct(handles: string[]) {
  if (!products || !products.length) return null;
  for (const h of handles) {
    const found = products.find((p: any) => p?.node?.handle === h);
    if (found) return found.node;
  }
  return null;
}

// Prices come only from Shopify. A struck-through "compare at" price is shown ONLY when Shopify
// has a real compareAtPrice — never an invented one.
function priceInfo(node: any, fallbackPrice: number) {
  const v = node?.variants?.edges?.[0]?.node;
  const price = v?.price?.amount ? Math.round(Number(v.price.amount)) : fallbackPrice;
  const compare = v?.compareAtPrice?.amount ? Math.round(Number(v.compareAtPrice.amount)) : 0;
  return { price, compare: compare > price ? compare : 0, live: Boolean(v) };
}

const spiri = findProduct(['sujata-spirulina-capsules', 'sujata-spirulina-tablets']);
const spiriHandle = spiri?.handle || 'sujata-spirulina-capsules';
const spiriPrice = priceInfo(spiri, 499);
const spiriPerDay = Math.round(spiriPrice.price / 30);

const combo = findProduct(['sujata-spirulina-sea-buckthorn-combo-pack', 'sujata-spirulina-sea-buckthorn-combo']);
const comboHandle = combo?.handle || 'sujata-spirulina-sea-buckthorn-combo-pack';
const comboPrice = priceInfo(combo, 1100);

const inr = (n: number) => `₹${n.toLocaleString('en-IN')}`;

const whatsappHref = getWhatsAppLink(
  "Hi Sujata Nutrilive, I'm on your website homepage. Which spirulina pack should I start with? I'd like to order with Cash on Delivery."
);
---

<section
  id="hero-section"
  aria-labelledby="hero-heading"
  class="relative w-full bg-[#011F18] text-white overflow-hidden border-b border-emerald-950/80 font-sans"
  style="padding-top: calc(var(--store-header-h, 74px) + 12px);"
>
  {/* Static ambient glow (no animation) */}
  <div aria-hidden="true" class="absolute top-0 left-1/2 -translate-x-1/2 w-[520px] md:w-[960px] h-[320px] md:h-[480px] bg-emerald-500/15 rounded-full blur-[120px] pointer-events-none"></div>

  <div class="relative z-10 max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 pb-6 sm:pb-8 lg:pb-12">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-4 lg:gap-10 items-center">

      {/* ================= COPY COLUMN ================= */}
      <div class="lg:col-span-7 flex flex-col items-start text-left">

        {/* Rating line — real numbers only */}
        <p class="inline-flex items-center gap-2 mb-2.5 bg-emerald-950/70 border border-emerald-400/25 px-3 py-1 rounded-full text-[11px] sm:text-xs">
          <span class="text-amber-400 tracking-tight" aria-hidden="true">★★★★★</span>
          <span class="font-bold text-emerald-100">{reviews.ratingValue}/5</span>
          <span class="text-white/30" aria-hidden="true">•</span>
          <span class="font-semibold text-emerald-200">{reviews.verifiedBuyersLabel} Verified Buyers</span>
        </p>

        {/* The ONLY H1 on the homepage */}
        <h1
          id="hero-heading"
          class="text-[1.65rem] leading-[1.12] sm:text-4xl lg:text-[2.75rem] font-serif font-normal tracking-tight text-white mb-2.5"
        >
          Lab-Tested Pure Spirulina
          <span class="block italic text-emerald-300">&amp; Himalayan Sea Buckthorn</span>
        </h1>

        <p class="text-[13px] sm:text-base text-emerald-50/85 leading-relaxed max-w-xl mb-4">
          {lab.proteinPct}% plant protein and natural non-heme iron, with zero binders or fillers, for steady
          everyday stamina. 100% pure, chemical-free hydro-cultivated, and no fishy smell.
        </p>

        {/* Mobile-only compact product image (desktop shows it in the right column) */}
        <div class="lg:hidden w-full flex justify-center mb-4">
          <img
            src="/products/sujata-combo-spirulina-sea-buckthorn-transparent.webp"
            alt="Sujata Nutrilive Pure Spirulina capsules and Himalayan Sea Buckthorn capsules bottles"
            width="838"
            height="810"
            class="w-[58%] max-w-[240px] h-auto drop-shadow-[0_12px_24px_rgba(0,0,0,0.6)]"
            loading="eager"
            fetchpriority="high"
            decoding="async"
          />
        </div>

        {/* ============ PROOF ROW (exact, verifiable facts) ============ */}
        <ul class="grid grid-cols-2 gap-2 w-full max-w-xl mb-4" aria-label="Verified quality facts">
          <li class="rounded-xl bg-white/[0.06] border border-white/10 px-3 py-2">
            <span class="block text-base sm:text-lg font-black text-emerald-300 leading-none">{lab.proteinPct}%</span>
            <span class="block text-[10.5px] sm:text-xs text-emerald-100/80 mt-1 leading-tight">Plant protein, lab tested</span>
          </li>
          <li class="rounded-xl bg-white/[0.06] border border-white/10 px-3 py-2">
            <span class="block text-base sm:text-lg font-black text-emerald-300 leading-none">0%</span>
            <span class="block text-[10.5px] sm:text-xs text-emerald-100/80 mt-1 leading-tight">Binders, talc or fillers</span>
          </li>
          <li class="rounded-xl bg-white/[0.06] border border-white/10 px-3 py-2">
            <span class="block text-[11px] sm:text-xs font-black text-white leading-tight">FSSAI Lic. No.</span>
            <span class="block text-[11px] sm:text-xs font-mono text-emerald-200 mt-1 leading-tight">{BRAND_CONFIG.fssaiNumber}</span>
          </li>
          <li class="rounded-xl bg-white/[0.06] border border-white/10 px-3 py-2">
            <a href={lab.pdfUrl} target="_blank" rel="noopener" class="group block">
              <span class="block text-[11px] sm:text-xs font-black text-white leading-tight group-hover:underline">Lab Report ↗</span>
              <span class="block text-[11px] sm:text-xs font-mono text-emerald-200 mt-1 leading-tight">#{lab.number}</span>
            </a>
          </li>
        </ul>

        {/* ============ CTAs: one primary, one secondary, WhatsApp ============ */}
        <div class="flex flex-col sm:flex-row gap-2.5 w-full sm:w-auto mb-3">
          <a
            href={`/product/${spiriHandle}`}
            class="inline-flex items-center justify-center gap-2 bg-emerald-400 hover:bg-emerald-300 active:scale-[0.98] text-[#022C22] font-extrabold text-sm uppercase tracking-wide px-6 py-3.5 rounded-xl shadow-[0_6px_20px_rgba(52,211,153,0.35)] transition-colors touch-manipulation"
          >
            <span>Order Spirulina • {inr(spiriPrice.price)}</span>
            {spiriPrice.compare > 0 && (
              <span class="text-xs font-semibold line-through opacity-60">{inr(spiriPrice.compare)}</span>
            )}
          </a>
          <a
            href={`/product/${comboHandle}`}
            class="inline-flex items-center justify-center gap-2 bg-transparent hover:bg-white/10 border border-amber-300/60 text-amber-200 font-bold text-sm px-5 py-3.5 rounded-xl transition-colors touch-manipulation"
          >
            <span>Spirulina + Sea Buckthorn Combo • {inr(comboPrice.price)}</span>
          </a>
        </div>

        <a
          href={whatsappHref}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 text-[13px] font-semibold text-emerald-100 hover:text-white mb-4 touch-manipulation"
        >
          <svg class="w-4 h-4 text-[#25D366]" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M17.47 14.38c-.3-.15-1.76-.87-2.03-.97-.27-.1-.47-.15-.67.15-.2.3-.77.97-.94 1.17-.17.2-.35.22-.65.07-.3-.15-1.26-.46-2.4-1.48-.89-.79-1.49-1.77-1.66-2.07-.17-.3-.02-.46.13-.61.13-.13.3-.35.45-.52.15-.17.2-.3.3-.5.1-.2.05-.37-.02-.52-.08-.15-.67-1.62-.92-2.22-.24-.58-.49-.5-.67-.51h-.57c-.2 0-.52.07-.8.37-.27.3-1.04 1.02-1.04 2.48s1.07 2.88 1.21 3.08c.15.2 2.1 3.2 5.08 4.49.71.31 1.26.49 1.69.63.71.23 1.36.2 1.87.12.57-.09 1.76-.72 2.01-1.41.25-.7.25-1.29.17-1.41-.07-.13-.27-.2-.57-.35zM12.04 21.5h-.01a9.4 9.4 0 0 1-4.8-1.32l-.34-.2-3.57.94.95-3.48-.22-.36a9.43 9.43 0 1 1 8 4.42zm8.02-17.45A11.3 11.3 0 0 0 12.04.75C5.8.75.72 5.83.72 12.07c0 2 .52 3.94 1.51 5.66L.62 23.25l5.65-1.48a11.3 11.3 0 0 0 5.77 1.47h.01c6.24 0 11.32-5.08 11.32-11.32 0-3.02-1.18-5.87-3.31-8z"/></svg>
          <span>Not sure which to pick? <span class="underline underline-offset-2">Ask us on WhatsApp</span></span>
        </a>

        {/* Reassurance strip */}
        <ul class="flex flex-wrap items-center gap-x-3 gap-y-1 text-[11px] sm:text-xs font-semibold text-emerald-200/90">
          <li>💵 Free Cash on Delivery</li>
          <li aria-hidden="true" class="text-white/25">•</li>
          <li>⚡ Extra 10% off on UPI</li>
          <li aria-hidden="true" class="text-white/25">•</li>
          <li>🚚 Dispatch in 24h</li>
          <li aria-hidden="true" class="text-white/25">•</li>
          <li>🛡️ 90-Day Guarantee</li>
          <li aria-hidden="true" class="text-white/25">•</li>
          <li>Just ₹{spiriPerDay}/day</li>
        </ul>
      </div>

      {/* ================= DESKTOP IMAGE COLUMN ================= */}
      <div class="hidden lg:flex lg:col-span-5 justify-center">
        <img
          src="/products/sujata-combo-spirulina-sea-buckthorn-transparent.webp"
          alt="Sujata Nutrilive Pure Spirulina capsules and Himalayan Sea Buckthorn capsules bottles"
          width="838"
          height="810"
          class="w-full max-w-[420px] h-auto drop-shadow-[0_16px_32px_rgba(0,0,0,0.6)]"
          loading="eager"
          decoding="async"
        />
      </div>

    </div>
  </div>
</section>
