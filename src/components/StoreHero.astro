              </a>
            </div>

            <a
              href={whatsappHref}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 min-h-[44px] text-[13px] font-semibold text-emerald-100 hover:text-white touch-manipulation"
            >
              <svg class="w-4 h-4 text-[#25D366]" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M17.47 14.38c-.3-.15-1.76-.87-2.03-.97-.27-.1-.47-.15-.67.15-.2.3-.77.97-.94 1.17-.17.2-.35.22-.65.07-.3-.15-1.26-.46-2.4-1.48-.89-.79-1.49-1.77-1.66-2.07-.17-.3-.02-.46.13-.61.13-.13.3-.35.45-.52.15-.17.2-.3.3-.5.1-.2.05-.37-.02-.52-.08-.15-.67-1.62-.92-2.22-.24-.58-.49-.5-.67-.51h-.57c-.2 0-.52.07-.8.37-.27.3-1.04 1.02-1.04 2.48s1.07 2.88 1.21 3.08c.15.2 2.1 3.2 5.08 4.49.71.31 1.26.49 1.69.63.71.23 1.36.2 1.87.12.57-.09 1.76-.72 2.01-1.41.25-.7.25-1.29.17-1.41-.07-.13-.27-.2-.57-.35zM12.04 21.5h-.01a9.4 9.4 0 0 1-4.8-1.32l-.34-.2-3.57.94.95-3.48-.22-.36a9.43 9.43 0 1 1 8 4.42zm8.02-17.45A11.3 11.3 0 0 0 12.04.75C5.8.75.72 5.83.72 12.07c0 2 .52 3.94 1.51 5.66L.62 23.25l5.65-1.48a11.3 11.3 0 0 0 5.77 1.47h.01c6.24 0 11.32-5.08 11.32-11.32 0-3.02-1.18-5.87-3.31-8z"/></svg>
              <span>Not sure which to pick? <span class="underline underline-offset-2">Ask us on WhatsApp</span></span>
            </a>
          </div>

          {/* Desktop image column */}
          <div class="hidden lg:flex lg:col-span-5 justify-center">
            <img
              src="/products/sujata-combo-spirulina-sea-buckthorn-transparent.webp"
              alt="Sujata Nutrilive Pure Spirulina capsules and Himalayan Sea Buckthorn capsules bottles"
              width="838"
              height="810"
              class="w-full max-w-[420px] h-auto drop-shadow-[0_16px_32px_rgba(0,0,0,0.6)]"
              loading="eager"
              fetchpriority="high"
              decoding="async"
            />
          </div>
        </div>
      </div>

      {/* ================= SLIDE 2 — LAB-TESTED PROOF ================= */}
      <div role="group" aria-roledescription="slide" aria-label={`2 of 4: ${slideLabels[1]}`} data-slide class="hero-slide">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-5 lg:gap-10 items-center content-center h-full">
          <div class="lg:col-span-7 flex flex-col items-start text-left">
            <p class="inline-flex items-center gap-2 mb-3 bg-emerald-950/70 border border-emerald-400/25 px-3 py-1 rounded-full text-[11px] sm:text-xs font-semibold text-emerald-200">
              <span aria-hidden="true">🔬</span> Lab Report #{lab.number}
            </p>
            <h2 class="text-[1.65rem] leading-[1.12] sm:text-4xl lg:text-[2.75rem] font-serif font-normal tracking-tight text-white mb-3">
              {lab.proteinPct}% Protein.
              <span class="block italic text-emerald-300">Proven, Not Promised.</span>
            </h2>
            <p class="text-[13px] sm:text-base text-emerald-50/85 leading-relaxed max-w-xl mb-4">
              Independently tested by {lab.lab} (batch {lab.batch}, issued {lab.issueDate}).
              Zero binders, talc or fillers. FSSAI Central License No. {BRAND_CONFIG.fssaiNumber}.
            </p>
            <ul class="grid grid-cols-2 gap-2 w-full max-w-xl mb-5" aria-label="Lab report values">
              <li class="rounded-xl bg-white/[0.06] border border-white/10 px-3 py-2">
                <span class="block text-base sm:text-lg font-black text-emerald-300 leading-none">{lab.proteinPct}%</span>
                <span class="block text-[10.5px] sm:text-xs text-emerald-100/80 mt-1 leading-tight">Protein</span>
              </li>
              <li class="rounded-xl bg-white/[0.06] border border-white/10 px-3 py-2">
                <span class="block text-base sm:text-lg font-black text-emerald-300 leading-none">{lab.ironMgPerKg}</span>
                <span class="block text-[10.5px] sm:text-xs text-emerald-100/80 mt-1 leading-tight">Iron, mg/kg</span>
              </li>
              <li class="rounded-xl bg-white/[0.06] border border-white/10 px-3 py-2">
                <span class="block text-base sm:text-lg font-black text-emerald-300 leading-none">{lab.calciumMgPerKg}</span>
                <span class="block text-[10.5px] sm:text-xs text-emerald-100/80 mt-1 leading-tight">Calcium, mg/kg</span>
              </li>
              <li class="rounded-xl bg-white/[0.06] border border-white/10 px-3 py-2">
                <span class="block text-base sm:text-lg font-black text-emerald-300 leading-none">0%</span>
                <span class="block text-[10.5px] sm:text-xs text-emerald-100/80 mt-1 leading-tight">Binders or fillers</span>
              </li>
            </ul>
            <div class="flex flex-col sm:flex-row gap-2.5 w-full sm:w-auto">
              <a
                href={lab.pdfUrl}
                target="_blank"
                rel="noopener"
                class="inline-flex items-center justify-center gap-2 bg-emerald-400 hover:bg-emerald-300 active:scale-[0.98] text-[#022C22] font-extrabold text-sm uppercase tracking-wide px-6 py-3.5 rounded-xl shadow-[0_6px_20px_rgba(52,211,153,0.35)] transition-colors touch-manipulation"
              >See the Lab Report ↗</a>
              <a
                href={`/product/${spiriHandle}`}
                class="inline-flex items-center justify-center gap-2 bg-transparent hover:bg-white/10 border border-amber-300/60 text-amber-200 font-bold text-sm px-5 py-3.5 rounded-xl transition-colors touch-manipulation"
              >Shop Spirulina{spiriPrice.live && ` • ${inr(spiriPrice.price)}`}</a>
            </div>
          </div>
          <div class="lg:col-span-5 flex justify-center">
            <a href={lab.pdfUrl} target="_blank" rel="noopener" class="relative block rotate-[-2deg] hover:rotate-0 transition-transform" aria-label={`Open lab report ${lab.number} (PDF)`}>
