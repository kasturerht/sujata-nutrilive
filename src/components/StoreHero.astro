                src="/lab/lilaba-report-LAL-NN-131125023-p1.webp"
                alt={`First page of ${lab.lab} test report ${lab.number} for Sujata Spirulina powder`}
                width="480"
                height="679"
                class="w-[120px] sm:w-[170px] lg:w-[240px] h-auto rounded-lg border border-white/20 shadow-[0_16px_40px_rgba(0,0,0,0.55)]"
                loading="lazy"
                fetchpriority="low"
                decoding="async"
              />
              <span class="absolute -bottom-3 -right-3 bg-amber-300 text-[#022C22] text-xs sm:text-sm font-black px-3 py-1.5 rounded-full shadow-lg">{lab.proteinPct}% protein</span>
            </a>
          </div>
        </div>
      </div>

      {/* ================= SLIDE 3 — DAILY VALUE + RISK REVERSAL ================= */}
      <div role="group" aria-roledescription="slide" aria-label={`3 of 4: ${slideLabels[2]}`} data-slide class="hero-slide">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-5 lg:gap-10 items-center content-center h-full">
          <div class="lg:col-span-7 flex flex-col items-start text-left">
            <p class="inline-flex items-center gap-2 mb-3 bg-emerald-950/70 border border-emerald-400/25 px-3 py-1 rounded-full text-[11px] sm:text-xs font-semibold text-emerald-200">
              <span aria-hidden="true">🛡️</span> 90-Day Guarantee <span class="text-white/30" aria-hidden="true">•</span> Free COD
            </p>
            <h2 class="text-[1.65rem] leading-[1.12] sm:text-4xl lg:text-[2.75rem] font-serif font-normal tracking-tight text-white mb-3">
              Your Daily Superfood Routine
              <span class="block italic text-emerald-300">for just ₹{spiriPerDay}/day</span>
            </h2>
            <p class="text-[13px] sm:text-base text-emerald-50/85 leading-relaxed max-w-xl mb-4">
              Spirulina + Himalayan Sea Buckthorn, together for 90 days{combo3PerDay > 0 && ` at about ₹${combo3PerDay}/day for both`}.
              Extra 10% off on UPI, dispatched within 24 hours, and backed by our 90-Day Guarantee.
            </p>
            <ul class="flex flex-wrap gap-2 mb-5 text-[11px] sm:text-xs font-semibold" aria-label="Order benefits">
              <li class="rounded-full bg-white/[0.06] border border-white/10 px-3 py-1.5 text-emerald-100">⚡ Extra 10% off on UPI</li>
              <li class="rounded-full bg-white/[0.06] border border-white/10 px-3 py-1.5 text-emerald-100">💵 Free Cash on Delivery</li>
              <li class="rounded-full bg-white/[0.06] border border-white/10 px-3 py-1.5 text-emerald-100">🚚 Dispatch in 24h</li>
            </ul>
            <div class="flex flex-col sm:flex-row gap-2.5 w-full sm:w-auto">
              <a
                href={combo3Href}
                class="inline-flex items-center justify-center gap-2 bg-emerald-400 hover:bg-emerald-300 active:scale-[0.98] text-[#022C22] font-extrabold text-sm uppercase tracking-wide px-6 py-3.5 rounded-xl shadow-[0_6px_20px_rgba(52,211,153,0.35)] transition-colors touch-manipulation"
              >
                <span>Get the 3-Month Combo{combo3Price.live && ` • ${inr(combo3Price.price)}`}</span>
                {combo3Price.compare > 0 && (
                  <span class="text-xs font-semibold line-through opacity-60">{inr(combo3Price.compare)}</span>
                )}
              </a>
              <a
                href="/refund-policy"
                class="inline-flex items-center justify-center gap-2 bg-transparent hover:bg-white/10 border border-amber-300/60 text-amber-200 font-bold text-sm px-5 py-3.5 rounded-xl transition-colors touch-manipulation"
              >How the Guarantee Works</a>
            </div>
          </div>
          <div class="lg:col-span-5 flex justify-center">
            <div class="relative">
              <img
                src="/products/sujata-combo-3month-hero.webp"
                alt="Sujata 3-Month Plan: 3 Spirulina capsule bottles and 3 Himalayan Sea Buckthorn capsule bottles"
                width="800"
                height="537"
                class="w-[190px] sm:w-[280px] lg:w-[380px] h-auto rounded-2xl bg-white shadow-[0_16px_40px_rgba(0,0,0,0.55)]"
                loading="lazy"
                fetchpriority="low"
                decoding="async"
              />
              <span class="absolute -top-3 -left-3 bg-amber-300 text-[#022C22] text-xs sm:text-sm font-black px-3 py-1.5 rounded-full shadow-lg">3-Month Plan</span>
            </div>
          </div>
        </div>
      </div>

      {/* ================= SLIDE 4 — REAL BUYERS & FOUNDER INTEGRITY ================= */}
      <div role="group" aria-roledescription="slide" aria-label={`4 of 4: ${slideLabels[3]}`} data-slide class="hero-slide">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-5 lg:gap-10 items-center content-center h-full">
          <div class="lg:col-span-7 flex flex-col items-start text-left">
            <p class="inline-flex items-center gap-2 mb-3 bg-emerald-950/70 border border-emerald-400/25 px-3 py-1 rounded-full text-[11px] sm:text-xs">
              <span class="text-emerald-300 font-bold" aria-hidden="true">✓</span>
              <span class="font-bold text-emerald-100">{trust.ordersLabel} orders since {trust.ordersSince}</span>
              <span class="text-white/30" aria-hidden="true">•</span>
              <span class="font-semibold text-emerald-200">FSSAI licensed · NABL lab-tested</span>
            </p>
            <h2 class="text-[1.65rem] leading-[1.12] sm:text-4xl lg:text-[2.75rem] font-serif font-normal tracking-tight text-white mb-3">
              Chosen in {trust.ordersLabel} Orders
              <span class="block italic text-emerald-300">Across India</span>
            </h2>
            {/* TODO(founder): replace with Yash Suryawanshi's own approved quote, in quotation marks.
                Until then this is a factual line only — never put invented words in a real person's mouth. */}
            <p class="text-[13px] sm:text-base text-emerald-50/85 leading-relaxed max-w-xl mb-5">
              Founded in Nashik in 2024 by <strong class="font-semibold text-white">Yash Suryawanshi</strong>, who shows on
              camera how our spirulina is grown and tested, and publishes every lab report for you to check.
