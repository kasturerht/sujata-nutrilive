---
// src/components/StoreHero.astro
import { Image } from 'astro:assets';
import imgMorningRoutine from '../assets/sujata_morning_routine.png';
---

<section id="d2c-performance-hero" class="relative w-full font-sans z-20">

  {/* ==========================================
      1. THE MASTER SLIDER CONTAINER (Dynamic Viewport Height for Mobile)
      ========================================== */}
  <div class="relative w-full overflow-hidden bg-[#F8FAFC] h-[85vh] h-[85dvh] min-h-[500px] md:min-h-[700px] lg:min-h-[750px] max-h-[850px]" id="hero-slider">
    
    {/* -----------------------------------
        SLIDE 1: THE BIG VALUE INTRO (Clinical Dark Theme)
        ----------------------------------- */}
    <div class="slide absolute inset-0 w-full h-full transition-transform duration-700 ease-[cubic-bezier(0.25,1,0.5,1)] translate-x-0" data-index="0">
      <div class="absolute inset-0 bg-gradient-to-r from-[#022c22] via-[#043e31] to-[#064e3b] z-0"></div>
      
      <div class="max-w-[90rem] mx-auto px-5 sm:px-8 lg:px-16 relative z-10 w-full h-full pt-[90px] md:pt-[140px] pb-[70px] md:pb-[100px] flex flex-col md:flex-row items-center justify-between gap-6 md:gap-4">
        
        <div class="w-full md:w-[55%] flex flex-col items-center md:items-start text-center md:text-left z-20">
          <span class="text-xs sm:text-sm font-bold text-emerald-300 uppercase tracking-[0.25em] mb-2 font-sans">
            The Daily Longevity Ritual
          </span>
          
          <h1 class="text-white text-3xl sm:text-5xl md:text-6xl lg:text-7xl font-normal font-serif leading-[1.08] tracking-tight mb-3">
            Peak Cellular Energy.<br/>
            <span class="italic text-emerald-300">Without the crash.</span>
          </h1>

          <p class="text-xs sm:text-sm md:text-base font-normal text-emerald-100/80 mb-6 max-w-lg leading-relaxed">
            100% Pure, cold-pressed raw Spirulina. Packed with 65% bio-protein, organic iron, and zero synthetic fillers. Save ₹500 on your first starter pack.
          </p>

          <div class="flex items-center gap-4 mb-6 md:mb-8">
            <span class="text-2xl md:text-3xl font-extrabold text-white font-sans">₹799</span>
            <span class="text-sm md:text-base text-emerald-200/50 line-through font-sans">₹1,299</span>
            <span class="bg-amber-400 text-black text-[10px] md:text-xs font-black uppercase tracking-widest px-3 py-1 rounded-full shadow-md">
              SAVE ₹500
            </span>
          </div>

          <a href="#product-ecosystem" class="bg-emerald-400 hover:bg-emerald-300 text-black text-center text-xs sm:text-sm md:text-base font-bold uppercase tracking-[0.15em] px-8 sm:px-12 py-3.5 md:py-4 rounded-xl shadow-[0_10px_30px_rgba(52,211,153,0.3)] transition-all transform hover:-translate-y-0.5 active:scale-95 w-full sm:w-auto">
            Shop 30-Day Ritual
          </a>
        </div>

        <div class="w-full md:w-[45%] flex items-center justify-center relative h-[220px] sm:h-[260px] md:h-full group">
          <Image src="/spirulina-powder.png" alt="Spirulina Kit" width={500} height={500} class="relative z-10 w-auto h-[85%] max-h-[85%] object-contain drop-shadow-2xl group-hover:-translate-y-2 transition-transform duration-700 ease-[cubic-bezier(0.16,1,0.3,1)]" fetchpriority="high"/>
          <div class="absolute -bottom-4 w-48 h-8 bg-black/40 rounded-full blur-xl z-0 group-hover:scale-90 transition-transform duration-700"></div>
        </div>
      </div>
    </div>

    {/* -----------------------------------
        SLIDE 2: THE BUNDLE OFFER (Clinical Mint Theme)
        ----------------------------------- */}
    <div class="slide absolute inset-0 w-full h-full transition-transform duration-700 ease-[cubic-bezier(0.25,1,0.5,1)] translate-x-full" data-index="1">
      <div class="absolute inset-0 bg-gradient-to-r from-[#FCFBF9] to-[#F0FDF4] z-0"></div>
      
      <div class="max-w-[90rem] mx-auto px-5 sm:px-8 lg:px-16 relative z-10 w-full h-full pt-[90px] md:pt-[140px] pb-[70px] md:pb-[100px] flex flex-col md:flex-row items-center justify-between gap-6 md:gap-4">
        
        <div class="w-full md:w-[55%] flex flex-col items-center md:items-start text-center md:text-left z-20">
          <span class="text-xs sm:text-sm font-bold text-[#166534] uppercase tracking-[0.25em] mb-2 font-sans">
            Complimentary Welcome Offer
          </span>
          
          <h2 class="text-[#111827] text-3xl sm:text-5xl md:text-6xl lg:text-7xl font-normal font-serif leading-[1.08] tracking-tight mb-3">
            Buy 2 Bottles.<br/>
            <span class="italic text-[#166534]">Get 1 Bottle On Us.</span>
          </h2>

          <p class="text-xs sm:text-sm md:text-base font-normal text-gray-600 mb-6 max-w-lg leading-relaxed">
            Full 90-day cellular rejuvenation supply. Organic, lab-tested, and certified heavy-metal free. Shipped with free express delivery.
          </p>

          <a href="#product-ecosystem" class="bg-[#064E3B] hover:bg-[#022C22] text-white text-center text-xs sm:text-sm md:text-base font-bold uppercase tracking-[0.15em] px-8 sm:px-12 py-3.5 md:py-4 rounded-xl shadow-[0_10px_20px_rgba(6,78,59,0.2)] transition-all transform hover:-translate-y-0.5 active:scale-95 w-full sm:w-auto">
            Claim 3-Bottle Bundle
          </a>
        </div>

        <div class="w-full md:w-[45%] flex items-center justify-center relative h-[200px] sm:h-[240px] md:h-full">
          <Image src="/spirulina-bottle.png" alt="Bottle 1" width={300} height={400} class="relative z-10 h-[75%] object-contain drop-shadow-xl -rotate-6 translate-x-4 opacity-90"/>
          <Image src="/spirulina-bottle.png" alt="Bottle 2" width={350} height={450} class="relative z-20 h-[90%] object-contain drop-shadow-2xl"/>
          <Image src="/spirulina-bottle.png" alt="Bottle 3" width={300} height={400} class="relative z-10 h-[75%] object-contain drop-shadow-xl rotate-6 -translate-x-4 opacity-90"/>
          
          <div class="absolute bottom-[10%] right-[5%] lg:right-[15%] bg-amber-400 text-black px-4 py-2 text-[11px] font-black uppercase tracking-[0.2em] rounded-full shadow-xl rotate-3 z-30">
            ★ 1 BOTTLE FREE
          </div>
        </div>
      </div>
    </div>

    {/* -----------------------------------
        SLIDE 3: THE COMBO PACK (Deep Forest Theme)
        ----------------------------------- */}
    <div class="slide absolute inset-0 w-full h-full transition-transform duration-700 ease-[cubic-bezier(0.25,1,0.5,1)] translate-x-full" data-index="2">
      <div class="absolute inset-0 bg-gradient-to-r from-[#011C16] to-[#043E31] z-0"></div>
      
      <div class="max-w-[90rem] mx-auto px-5 sm:px-8 lg:px-16 relative z-10 w-full h-full pt-[90px] md:pt-[140px] pb-[70px] md:pb-[100px] flex flex-col md:flex-row items-center justify-between gap-6 md:gap-4">
        
        <div class="w-full md:w-[55%] flex flex-col items-center md:items-start text-center md:text-left z-20">
          <span class="text-xs sm:text-sm font-bold text-amber-300 uppercase tracking-[0.25em] mb-2 font-sans">
            The Complete Protocol
          </span>
          
          <h2 class="text-white text-3xl sm:text-5xl md:text-6xl lg:text-7xl font-normal font-serif leading-[1.08] tracking-tight mb-3">
            Dual Synergistic Pack.<br/>
            <span class="italic text-amber-200">Save 30% Today.</span>
          </h2>

          <p class="text-xs sm:text-sm md:text-base font-normal text-emerald-100/80 mb-6 max-w-lg leading-relaxed">
            Pure organic powder for morning smoothies + convenient travel-ready veg capsules for afternoon focus.
          </p>

          <a href="#product-ecosystem" class="bg-amber-400 hover:bg-amber-300 text-black text-center text-xs sm:text-sm md:text-base font-bold uppercase tracking-[0.15em] px-8 sm:px-12 py-3.5 md:py-4 rounded-xl shadow-[0_10px_20px_rgba(217,119,6,0.3)] transition-all transform hover:-translate-y-0.5 active:scale-95 w-full sm:w-auto">
            Shop Dual Protocol
          </a>
        </div>

        <div class="w-full md:w-[45%] flex items-center justify-center relative h-[200px] sm:h-[240px] md:h-full">
          <Image src="/spirulina-powder.png" alt="Powder" width={400} height={400} class="relative z-10 w-auto h-[85%] object-contain drop-shadow-2xl translate-x-6"/>
          <Image src="/spirulina-bottle.png" alt="Bottle" width={300} height={300} class="relative z-20 w-auto h-[65%] object-contain drop-shadow-xl -translate-x-6 translate-y-6"/>
          
          <div class="absolute top-[10%] left-[5%] lg:left-[15%] bg-white/10 backdrop-blur-md border border-white/20 text-amber-300 px-3.5 py-1.5 text-[11px] font-black uppercase tracking-[0.2em] rounded-full shadow-xl">
            BEST VALUE
          </div>
        </div>
      </div>
    </div>

    {/* -----------------------------------
        SLIDE 4: THE LOW-BARRIER TRIAL (Clinical Cream Theme)
        ----------------------------------- */}
    <div class="slide absolute inset-0 w-full h-full transition-transform duration-700 ease-[cubic-bezier(0.25,1,0.5,1)] translate-x-full" data-index="3">
      <div class="absolute inset-0 bg-gradient-to-r from-[#FCFBF9] to-[#ECFDF5] z-0"></div>
      
      <div class="max-w-[90rem] mx-auto px-5 sm:px-8 lg:px-16 relative z-10 w-full h-full pt-[90px] md:pt-[140px] pb-[70px] md:pb-[100px] flex flex-col md:flex-row items-center justify-between gap-6 md:gap-4">
        
        <div class="w-full md:w-[55%] flex flex-col items-center md:items-start text-center md:text-left z-20">
          <span class="text-xs sm:text-sm font-bold text-[#166534] uppercase tracking-[0.25em] mb-2 font-sans">
            7-Day Risk-Free Trial
          </span>
          
          <h2 class="text-[#111827] text-3xl sm:text-5xl md:text-6xl lg:text-7xl font-normal font-serif leading-[1.08] tracking-tight mb-3">
            Feel The Shift.<br/>
            <span class="italic text-[#166534]">For Just ₹499.</span>
          </h2>

          <p class="text-xs sm:text-sm md:text-base font-normal text-gray-600 mb-6 max-w-lg leading-relaxed">
            Experience 7 days of pure organic energy, enhanced digestion, and cellular recovery. Zero subscriptions.
          </p>

          <a href="#product-ecosystem" class="bg-[#064E3B] hover:bg-[#022C22] text-white text-center text-xs sm:text-sm md:text-base font-bold uppercase tracking-[0.15em] px-8 sm:px-12 py-3.5 md:py-4 rounded-xl shadow-[0_10px_20px_rgba(6,78,59,0.2)] transition-all transform hover:-translate-y-0.5 active:scale-95 w-full sm:w-auto">
            Start 7-Day Trial
          </a>
        </div>

        <div class="w-full md:w-[45%] flex items-center justify-center relative h-[200px] sm:h-[240px] md:h-full">
          <Image src={imgMorningRoutine} alt="Trial Pack" width={500} height={500} class="relative z-10 w-auto h-[80%] lg:h-[85%] object-cover rounded-3xl shadow-2xl border border-[#064E3B]/10"/>
          
          <div class="absolute bottom-[15%] right-[5%] md:right-[15%] bg-[#064E3B] text-white px-3.5 py-1.5 text-[11px] font-black uppercase tracking-[0.2em] rounded-full shadow-xl rotate-3 z-30">
            BEGINNER FRIENDLY
          </div>
        </div>
      </div>
    </div>

    {/* ==========================================
        PROGRESS TABS (Fixed at bottom of hero)
        ========================================== */}
    <div class="absolute bottom-4 left-0 right-0 z-30 flex justify-center items-center px-4">
      <div class="bg-black/30 backdrop-blur-md border border-white/15 p-1.5 rounded-full flex gap-2 sm:gap-3 max-w-full overflow-x-auto">
        <button class="hero-tab active px-3 sm:px-4 py-1.5 rounded-full text-[10px] sm:text-xs font-bold uppercase tracking-wider transition-all text-white bg-white/20 border border-white/30 cursor-pointer" data-target="0">
          30-Day Kit
        </button>
        <button class="hero-tab px-3 sm:px-4 py-1.5 rounded-full text-[10px] sm:text-xs font-bold uppercase tracking-wider transition-all text-white/70 hover:text-white hover:bg-white/10 cursor-pointer" data-target="1">
          Buy 2 Get 1
        </button>
        <button class="hero-tab px-3 sm:px-4 py-1.5 rounded-full text-[10px] sm:text-xs font-bold uppercase tracking-wider transition-all text-white/70 hover:text-white hover:bg-white/10 cursor-pointer" data-target="2">
          Dual Protocol
        </button>
        <button class="hero-tab px-3 sm:px-4 py-1.5 rounded-full text-[10px] sm:text-xs font-bold uppercase tracking-wider transition-all text-white/70 hover:text-white hover:bg-white/10 cursor-pointer" data-target="3">
          ₹499 Trial
        </button>
      </div>
    </div>

    {/* Navigation Arrows */}
    <button id="prev-slide" class="absolute left-4 top-1/2 -translate-y-1/2 z-30 w-10 h-10 rounded-full bg-black/20 hover:bg-black/40 text-white flex items-center justify-center backdrop-blur-sm border border-white/10 transition-all cursor-pointer hidden md:flex" aria-label="Previous Slide">
      ‹
    </button>
    <button id="next-slide" class="absolute right-4 top-1/2 -translate-y-1/2 z-30 w-10 h-10 rounded-full bg-black/20 hover:bg-black/40 text-white flex items-center justify-center backdrop-blur-sm border border-white/10 transition-all cursor-pointer hidden md:flex" aria-label="Next Slide">
      ›
    </button>
  </div>
</section>

<script is:inline>
  function initHeroSlider() {
    const slides = document.querySelectorAll('.slide');
    const tabs = document.querySelectorAll('.hero-tab');
    const prevBtn = document.getElementById('prev-slide');
    const nextBtn = document.getElementById('next-slide');
    let currentSlide = 0;
    let autoSlideInterval;

    function goToSlide(index) {
      if (index < 0) index = slides.length - 1;
      if (index >= slides.length) index = 0;
      
      slides.forEach((slide, i) => {
        if (i === index) {
          slide.classList.remove('translate-x-full', '-translate-x-full');
          slide.classList.add('translate-x-0');
        } else if (i < index) {
          slide.classList.remove('translate-x-0', 'translate-x-full');
          slide.classList.add('-translate-x-full');
        } else {
          slide.classList.remove('translate-x-0', '-translate-x-full');
          slide.classList.add('translate-x-full');
        }
      });

      tabs.forEach((tab, i) => {
        if (i === index) {
          tab.classList.add('active', 'text-white', 'bg-white/20', 'border', 'border-white/30');
          tab.classList.remove('text-white/70');
        } else {
          tab.classList.remove('active', 'text-white', 'bg-white/20', 'border', 'border-white/30');
          tab.classList.add('text-white/70');
        }
      });

      currentSlide = index;
    }

    function startAutoSlide() {
      stopAutoSlide();
      autoSlideInterval = setInterval(() => {
        goToSlide(currentSlide + 1);
      }, 5000);
    }

    function stopAutoSlide() {
      if (autoSlideInterval) clearInterval(autoSlideInterval);
    }

    tabs.forEach(tab => {
      tab.addEventListener('click', (e) => {
        const target = parseInt(e.currentTarget.getAttribute('data-target'));
        goToSlide(target);
        startAutoSlide();
      });
    });

    if (prevBtn) {
      prevBtn.addEventListener('click', () => {
        goToSlide(currentSlide - 1);
        startAutoSlide();
      });
    }

    if (nextBtn) {
      nextBtn.addEventListener('click', () => {
        goToSlide(currentSlide + 1);
        startAutoSlide();
      });
    }

    startAutoSlide();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initHeroSlider);
  } else {
    initHeroSlider();
  }
  document.addEventListener('astro:page-load', initHeroSlider);
</script>