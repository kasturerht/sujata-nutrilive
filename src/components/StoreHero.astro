// src/components/StoreHero.astro
interface Props {
  products?: any[];
}

const { products = [] } = Astro.props;

// Helper to look up product by handle in the live catalog
function findProduct(handles: string[]) {
  if (!products || !products.length) return null;
  for (const h of handles) {
    const found = products.find((p: any) => p?.node?.handle === h || p?.node?.handle?.includes(h));
    if (found) return found.node;
  }
  return null;
}

// 1. Spirulina Capsules (Primary Entry Offer - High Intent & Affordable Entry)
const spiriProduct = findProduct(['sujata-spirulina-capsules', 'sujata-spirulina-tablets']);
const spiriVariant = spiriProduct?.variants?.edges?.[0]?.node;
const spiriPrice = spiriVariant?.price?.amount ? Math.round(Number(spiriVariant.price.amount)) : 499;
const spiriCompare = spiriVariant?.compareAtPrice?.amount ? Math.round(Number(spiriVariant.compareAtPrice.amount)) : 550;
const spiriDiscount = spiriCompare > spiriPrice ? Math.round(((spiriCompare - spiriPrice) / spiriCompare) * 100) : 10;
const spiriHandle = spiriProduct?.handle || 'sujata-spirulina-capsules';

// 2. Synergy Combo (Flagship Routine Upsell)
const comboProduct = findProduct(['sujata-spirulina-sea-buckthorn-combo-pack', 'sujata-spirulina-sea-buckthorn-combo']);
const comboVariant = comboProduct?.variants?.edges?.[0]?.node;
const comboPrice = comboVariant?.price?.amount ? Math.round(Number(comboVariant.price.amount)) : 1100;
const comboCompare = comboVariant?.compareAtPrice?.amount ? Math.round(Number(comboVariant.compareAtPrice.amount)) : 1598;
const comboDiscount = comboCompare > comboPrice ? Math.round(((comboCompare - comboPrice) / comboCompare) * 100) : 30;
const comboHandle = comboProduct?.handle || 'sujata-spirulina-sea-buckthorn-combo-pack';

// 3. Sea Buckthorn Capsules (Skin Glow & Rare Omega 7)
const sbtProduct = findProduct(['sujata-sea-buckthorn-capsules']);
const sbtVariant = sbtProduct?.variants?.edges?.[0]?.node;
const sbtPrice = sbtVariant?.price?.amount ? Math.round(Number(sbtVariant.price.amount)) : 649;
const sbtCompare = sbtVariant?.compareAtPrice?.amount ? Math.round(Number(sbtVariant.compareAtPrice.amount)) : 799;
const sbtDiscount = sbtCompare > sbtPrice ? Math.round(((sbtCompare - sbtPrice) / sbtCompare) * 100) : 19;
const sbtHandle = sbtProduct?.handle || 'sujata-sea-buckthorn-capsules';
