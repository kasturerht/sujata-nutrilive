<style>
  /* Native swipe: scroll-snap. Slides stretch to the tallest one (flex default), so the track
     height is fixed at first paint and switching slides never moves content below (CLS 0). */
  .hero-track {
    scroll-snap-type: x mandatory;
    overscroll-behavior-x: contain;
    scrollbar-width: none;
    -webkit-overflow-scrolling: touch;
  }
  .hero-track::-webkit-scrollbar { display: none; }
  .hero-slide {
    flex: 0 0 92%; /* mobile: next slide peeks ~8% */
    scroll-snap-align: start;
    scroll-snap-stop: always;
    border-radius: 1rem;
    padding: 0.75rem;
    background: rgba(255, 255, 255, 0.025);
    border: 1px solid rgba(255, 255, 255, 0.06);
  }
  @media (min-width: 1024px) {
    .hero-slide { flex-basis: 100%; padding: 0; background: none; border: 0; }
  }
  @media (prefers-reduced-motion: no-preference) {
    .hero-track { scroll-behavior: smooth; }
  }
</style>

<script>
  // ~1 KB controller: active-slide tracking, dots, 5 s autoplay with pause rules.
  const root = document.getElementById('hero-carousel');
  const track = root?.querySelector<HTMLElement>('[data-track]');
  if (root && track) {
    const slides = Array.from(track.querySelectorAll<HTMLElement>('[data-slide]'));
    const dots = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-dot]'));
    const toggle = root.querySelector<HTMLButtonElement>('[data-toggle]')!;
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    let active = 0;
    let timer = 0;
    let stopped = reduce; // user/system turned autoplay off
    let hovering = false;
    let onScreen = true;

    const go = (n: number) => {
      const i = (n + slides.length) % slides.length;
      // Scroll the track only (never the page). Offsets are relative to slide 1 = snap position 0.
      track.scrollTo({ left: slides[i].offsetLeft - slides[0].offsetLeft });
    };

    const schedule = () => {
      window.clearTimeout(timer);
      if (stopped || hovering || !onScreen || document.hidden) return;
      timer = window.setTimeout(() => go(active + 1), 5000);
    };

    const setActive = (i: number) => {
      active = i;
      dots.forEach((d, n) => (n === i ? d.setAttribute('aria-current', 'true') : d.removeAttribute('aria-current')));
      schedule();
    };

    const setStopped = (v: boolean) => {
      stopped = v;
      toggle.setAttribute('aria-label', v ? 'Play slideshow' : 'Pause slideshow');
      toggle.querySelector('[data-icon-pause]')!.classList.toggle('hidden', v);
      toggle.querySelector('[data-icon-play]')!.classList.toggle('hidden', !v);
      schedule();
    };

    const io = new IntersectionObserver(
      (entries) => entries.forEach((e) => {
        if (e.isIntersecting) setActive(slides.indexOf(e.target as HTMLElement));
      }),
      { root: track, threshold: 0.6 }
    );
    slides.forEach((s) => io.observe(s));

    new IntersectionObserver(([e]) => { onScreen = e.isIntersecting; schedule(); }).observe(root);
    document.addEventListener('visibilitychange', schedule);

    dots.forEach((d, n) => d.addEventListener('click', () => go(n)));
    toggle.addEventListener('click', () => setStopped(!stopped));

    // Hover/focus = temporary pause. Touch = the visitor took control: stop autoplay for good.
    root.addEventListener('pointerenter', (e) => { if (e.pointerType === 'mouse') { hovering = true; schedule(); } });
    root.addEventListener('pointerleave', (e) => { if (e.pointerType === 'mouse') { hovering = false; schedule(); } });
    root.addEventListener('focusin', () => { hovering = true; schedule(); });
    root.addEventListener('focusout', (e) => {
      if (!root.contains(e.relatedTarget as Node)) { hovering = false; schedule(); }
    });
    track.addEventListener('touchstart', () => { if (!stopped) setStopped(true); }, { passive: true });

    setStopped(stopped);
  }
</script>
