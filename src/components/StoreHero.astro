    {/* ================= CONTROLS: dots + pause (WCAG 2.2.2) ================= */}
    <div class="flex items-center justify-center gap-3 mt-4 px-4">
      <div class="flex items-center gap-1" role="group" aria-label="Choose slide">
        {slideLabels.map((label, n) => (
          <button
