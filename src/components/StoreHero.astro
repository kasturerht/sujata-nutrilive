          </div>

        </div>
      </div>

    </div>

    {/* =========================================================================
        3. SLEEK PAGINATION INDICATOR DOTS (Touch Responsive)
        ========================================================================= */}
    <div class="flex items-center justify-center gap-2 mt-3 sm:mt-4">
      <button 
        type="button" 
        class="hero-dot-indicator w-6 h-1.5 rounded-full bg-amber-400 transition-all duration-300 cursor-pointer" 
        data-dot-index="0" 
        aria-label="Go to slide 1"
      ></button>
      <button 
        type="button" 
        class="hero-dot-indicator w-2 h-1.5 rounded-full bg-white/30 hover:bg-white/50 transition-all duration-300 cursor-pointer" 
        data-dot-index="1" 
        aria-label="Go to slide 2"
      ></button>
      <button 
        type="button" 
        class="hero-dot-indicator w-2 h-1.5 rounded-full bg-white/30 hover:bg-white/50 transition-all duration-300 cursor-pointer" 
        data-dot-index="2" 
        aria-label="Go to slide 3"
      ></button>
    </div>

  </div>

</section>

{/* =========================================================================
    4. ENGINE: TOUCH SWIPE + AUTO-ADVANCE + TAB/DOT SYNCHRONIZATION
    ========================================================================= */}
<script is:inline>
  function initProtocolHeroSwitcher() {
    const track = document.getElementById('hero-slider-track');
    const tabButtons = document.querySelectorAll('.hero-tab-btn');
    const dotIndicators = document.querySelectorAll('.hero-dot-indicator');
    const ambientGlow = document.getElementById('hero-ambient-glow');
    if (!track) return;

    const slides = track.querySelectorAll('.hero-slide-card');
    let currentIndex = 0;
    let autoPlayTimer = null;
    const SLIDE_DURATION = 6000; // 6s per protocol

    const glowColors = [
      'rgba(245, 158, 11, 0.14)', // Combo (Warm Amber Gold)
      'rgba(16, 185, 129, 0.16)', // Spirulina (Luminous Emerald)
      'rgba(217, 119, 6, 0.15)',  // Sea Buckthorn (Himalayan Amber)
    ];

    function updateUI(targetIndex) {
      if (targetIndex < 0 || targetIndex >= slides.length) return;
      currentIndex = targetIndex;

      // 1. Update Tabs
      tabButtons.forEach((btn, idx) => {
        const isCurrent = idx === currentIndex;
        btn.setAttribute('aria-selected', isCurrent ? 'true' : 'false');
        const progressLine = btn.querySelector('.tab-progress-line');

        if (isCurrent) {
          btn.classList.add('active', 'bg-[#064E3B]', 'text-white', 'shadow-md', 'border-emerald-400/40');
          btn.classList.remove('text-emerald-100/70', 'border-transparent');
          if (progressLine) {
            progressLine.style.transition = 'none';
            progressLine.style.transform = 'scaleX(0)';
            setTimeout(() => {
              progressLine.style.transition = `transform ${SLIDE_DURATION}ms linear`;
              progressLine.style.transform = 'scaleX(1)';
            }, 30);
          }
        } else {
          btn.classList.remove('active', 'bg-[#064E3B]', 'text-white', 'shadow-md', 'border-emerald-400/40');
          btn.classList.add('text-emerald-100/70', 'border-transparent');
          if (progressLine) {
            progressLine.style.transition = 'none';
            progressLine.style.transform = 'scaleX(0)';
          }
        }
      });

      // 2. Update Dots
      dotIndicators.forEach((dot, idx) => {
        const isCurrent = idx === currentIndex;
        if (isCurrent) {
          dot.className = 'hero-dot-indicator w-6 h-1.5 rounded-full bg-amber-400 transition-all duration-300 cursor-pointer';
        } else {
          dot.className = 'hero-dot-indicator w-2 h-1.5 rounded-full bg-white/30 hover:bg-white/50 transition-all duration-300 cursor-pointer';
        }
      });

      // 3. Update Ambient Glow
      if (ambientGlow && glowColors[currentIndex]) {
        ambientGlow.style.backgroundColor = glowColors[currentIndex];
      }
    }

    function scrollToIndex(targetIndex) {
      if (!slides[targetIndex]) return;
      const targetSlide = slides[targetIndex];
      track.scrollTo({
        left: targetSlide.offsetLeft,
        behavior: 'smooth'
      });
      updateUI(targetIndex);
    }

    function startAutoPlay() {
      stopAutoPlay();
      autoPlayTimer = setInterval(() => {
        const nextIndex = (currentIndex + 1) % slides.length;
        scrollToIndex(nextIndex);
      }, SLIDE_DURATION);
    }

    function stopAutoPlay() {
      if (autoPlayTimer) clearInterval(autoPlayTimer);
    }

    // Tab Clicks
    tabButtons.forEach(btn => {
      btn.addEventListener('click', () => {
        const idx = parseInt(btn.getAttribute('data-tab-index') || '0', 10);
        stopAutoPlay();
        scrollToIndex(idx);
        startAutoPlay();
      });
    });

    // Dot Clicks
    dotIndicators.forEach(dot => {
      dot.addEventListener('click', () => {
        const idx = parseInt(dot.getAttribute('data-dot-index') || '0', 10);
        stopAutoPlay();
        scrollToIndex(idx);
        startAutoPlay();
      });
    });

    // Track User Touch Scroll via Debounced Scroll Listener
    let scrollTimeout = null;
    track.addEventListener('scroll', () => {
      stopAutoPlay();
      if (scrollTimeout) clearTimeout(scrollTimeout);
      scrollTimeout = setTimeout(() => {
        const scrollLeft = track.scrollLeft;
        const trackWidth = track.clientWidth;
        const newIndex = Math.round(scrollLeft / trackWidth);
        if (newIndex !== currentIndex && newIndex >= 0 && newIndex < slides.length) {
          updateUI(newIndex);
        }
        startAutoPlay();
      }, 80);
    }, { passive: true });

    // Pause on Hover
    const heroSection = document.getElementById('hero-section');
    if (heroSection) {
      heroSection.addEventListener('mouseenter', stopAutoPlay);
      heroSection.addEventListener('mouseleave', startAutoPlay);
    }

    // Initialize UI on Mount
    updateUI(0);
    startAutoPlay();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initProtocolHeroSwitcher);
  } else {
    initProtocolHeroSwitcher();
  }
  document.addEventListener('astro:page-load', initProtocolHeroSwitcher);
</script>

<style>
  .no-scrollbar::-webkit-scrollbar {
    display: none;
  }
  .no-scrollbar {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }
</style>