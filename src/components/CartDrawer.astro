---
// src/components/CartDrawer.astro
import { BRAND_CONFIG } from '../config/brand';
const waOrderNumber = BRAND_CONFIG.supportWhatsAppNumber.replace(/\D/g, '');
const shopifyDomain = import.meta.env.PUBLIC_SHOPIFY_STOREFRONT_DOMAIN || "tvczdq-nu.myshopify.com";
const storefrontToken = import.meta.env.PUBLIC_SHOPIFY_STOREFRONT_TOKEN || "7e0a0176aede63ce4c6b199e18684018";

let noCodHandles = ["sujata-spiruglow-bath-soap"];
try {
  if (shopifyDomain && storefrontToken) {
    const catalogRes = await fetch(`https://${shopifyDomain}/api/2024-01/graphql.json`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', 'X-Shopify-Storefront-Access-Token': storefrontToken },
      body: JSON.stringify({
        query: `{ products(first: 50) { edges { node { id handle tags } } } }`
      })
    });
    const catalogData = await catalogRes.json();
    const fetchedNoCod: string[] = [];
    (catalogData?.data?.products?.edges || []).forEach(({ node }: any) => {
      const isNoCod = (node.tags || []).some((t: string) => {
        const s = String(t).toLowerCase().trim();
        return s === 'no-cod' || s === 'prepaid-only' || s === 'no_cod';
      });
      if (isNoCod) {
        fetchedNoCod.push(node.handle);
      }
    });
    if (fetchedNoCod.length > 0) {
      noCodHandles = fetchedNoCod;
    }
  }
} catch (e) {
  console.warn("Could not fetch no-cod tags from storefront:", e);
}
---

