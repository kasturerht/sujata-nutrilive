---
// src/components/CartDrawer.astro
const shopifyDomain = import.meta.env.PUBLIC_SHOPIFY_STOREFRONT_DOMAIN || "tvczdq-nu.myshopify.com";
const storefrontToken = import.meta.env.PUBLIC_SHOPIFY_STOREFRONT_TOKEN || "7e0a0176aede63ce4c6b199e18684018";
---

{/* The Dark Overlay (Background blur) */}
<div id="cart-overlay" class="fixed inset-0 bg-black/60 backdrop-blur-sm z-[9998] opacity-0 pointer-events-none transition-opacity duration-300 ease-out"></div>

{/* The Premium Drawer (Slides from Right with high z-index above everything) */}
<div id="cart-drawer" data-domain={shopifyDomain} data-token={storefrontToken} class="fixed top-0 right-0 w-full sm:w-[440px] h-[100dvh] h-screen bg-[#FAF9F6] z-[9999] translate-x-full transition-transform duration-500 ease-[cubic-bezier(0.16,1,0.3,1)] shadow-2xl flex flex-col border-l border-gray-200">
  
  {/* 1. Drawer Header (Always Visible & Padded) */}
  <div class="px-6 py-5 border-b border-gray-200 flex items-center justify-between bg-white shrink-0">
    <div class="flex items-center gap-3">
      <h2 class="text-xl font-serif font-normal text-[#111827]">Your Daily Routine</h2>
      <span class="bg-[#166534] text-white text-[11px] font-bold font-sans px-2.5 py-0.5 rounded-full" id="cart-count-badge">0</span>
    </div>
    <button id="close-cart-btn" aria-label="Close cart" class="w-9 h-9 rounded-full bg-gray-100 flex items-center justify-center text-gray-500 hover:bg-gray-200 hover:text-black transition-colors touch-manipulation cursor-pointer">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
    </button>
  </div>

  {/* 2. Clean Free Shipping Progress Card */}
  <div class="px-6 py-4 bg-white border-b border-gray-200 shrink-0 shadow-sm" id="shipping-meter-container">
    <div class="flex items-center justify-between text-xs mb-2 font-sans">
      <span class="font-bold text-[#166534]" id="shipping-meter-text">Add items for Free Express Shipping 🚚</span>
      <span class="text-[11px] font-medium text-gray-400 font-sans" id="shipping-threshold-text">Goal: ₹1,500</span>
    </div>
    <div class="w-full h-2.5 bg-gray-100 rounded-full overflow-hidden p-0.5 border border-gray-200/60">
      <div class="h-full bg-gradient-to-r from-emerald-600 to-[#166534] rounded-full transition-all duration-500" id="shipping-meter-bar" style="width: 0%;"></div>
    </div>
  </div>

  {/* 3. Cart Items Area (Scrollable with smooth momentum) */}
  <div class="flex-1 overflow-y-auto p-6 space-y-4" id="cart-items-container">
    {/* Dynamic Items rendered via JavaScript */}
  </div>

  {/* 4. Drawer Footer (Checkout Section with Safe Area Inset) */}
  <div class="px-6 pt-5 pb-8 pb-safe bg-white border-t border-gray-200 shadow-lg shrink-0">
    
    <div class="flex items-center justify-between mb-1.5">
      <span class="text-gray-500 font-medium text-xs uppercase tracking-wider font-sans">Subtotal</span>
      <span class="text-2xl font-black text-[#111827] font-sans" id="cart-subtotal">₹0</span>
    </div>
    <p class="text-xs text-gray-500 mb-4 flex items-center gap-1.5 font-sans">
      <span class="text-[#166534] font-bold">✓</span> Free express shipping & GST included.
    </p>

    <button id="checkout-action-btn" class="w-full bg-[#111827] hover:bg-[#166534] text-white font-bold text-xs uppercase tracking-[0.15em] py-4 rounded-xl flex items-center justify-center gap-3 transition-all duration-300 shadow-md active:scale-95 touch-manipulation cursor-pointer">
      <span>Proceed to Checkout</span>
      <span class="text-base">→</span>
    </button>
    
    {/* Trust Badges */}
    <div class="flex items-center justify-center gap-4 mt-4 text-[10px] text-gray-400 uppercase tracking-widest font-sans">
      <span>🔒 SSL 256-bit</span>
      <span>•</span>
      <a href="/refund-policy" target="_blank" class="hover:text-emerald-700 underline transition-colors">🛡️ 30-Day Guarantee</a>
      <span>•</span>
      <span>💵 Free COD</span>
    </div>
  </div>

</div>

<script is:inline>
  // High-Performance Hybrid Cart Engine (Shopify GraphQL + Optimistic Local State)
  (function() {
    const drawerEl = document.getElementById('cart-drawer');
    const DOMAIN = drawerEl?.getAttribute('data-domain') || "tvczdq-nu.myshopify.com";
    const TOKEN = drawerEl?.getAttribute('data-token') || "7e0a0176aede63ce4c6b199e18684018";
    const SHIPPING_THRESHOLD = 1500;

    // Local Cart Data Management
    function getLocalCart() {
      try {
        const stored = localStorage.getItem('sujata_cart_items');
        return stored ? JSON.parse(stored) : [];
      } catch (e) {
        return [];
      }
    }

    function saveLocalCart(items) {
      localStorage.setItem('sujata_cart_items', JSON.stringify(items));
    }

    function formatINR(amount) {
      return new Intl.NumberFormat('en-IN', {
        style: 'currency',
        currency: 'INR',
        maximumFractionDigits: 0
      }).format(amount);
    }

    // Open & Close Drawer
    window.openSujataCart = function() {
      const drawer = document.getElementById('cart-drawer');
      const overlay = document.getElementById('cart-overlay');
      if (drawer && overlay) {
        window.renderSujataCart();
        overlay.classList.remove('opacity-0', 'pointer-events-none');
        overlay.classList.add('opacity-100');
        drawer.classList.remove('translate-x-full');
        document.body.style.overflow = 'hidden';
      }
    };

    window.closeSujataCart = function() {
      const drawer = document.getElementById('cart-drawer');
      const overlay = document.getElementById('cart-overlay');
      if (drawer && overlay) {
        overlay.classList.add('opacity-0', 'pointer-events-none');
        overlay.classList.remove('opacity-100');
        drawer.classList.add('translate-x-full');
        document.body.style.overflow = '';
      }
    };

    // Render Cart HTML
    window.renderSujataCart = function() {
      const items = getLocalCart();
      const container = document.getElementById('cart-items-container');
      const subtotalEl = document.getElementById('cart-subtotal');
      const badgeEl = document.getElementById('cart-count-badge');
      const headerBadgeEl = document.getElementById('header-cart-badge');
      const shippingBar = document.getElementById('shipping-meter-bar');
      const shippingText = document.getElementById('shipping-meter-text');

      let totalCount = 0;
      let totalAmount = 0;

      items.forEach(item => {
        totalCount += item.quantity;
        totalAmount += item.price * item.quantity;
      });

      // Update Badges
      if (badgeEl) badgeEl.innerText = totalCount;
      if (headerBadgeEl) {
        headerBadgeEl.innerText = totalCount;
        headerBadgeEl.style.display = totalCount > 0 ? 'flex' : 'none';
      }

      // Update Subtotal
      if (subtotalEl) subtotalEl.innerText = formatINR(totalAmount);

      // Update Free Shipping Progress
      if (shippingBar && shippingText) {
        if (totalAmount === 0) {
          shippingBar.style.width = '0%';
          shippingText.innerHTML = `Add <strong>₹${SHIPPING_THRESHOLD}</strong> for Free Express Shipping 🚚`;
        } else if (totalAmount >= SHIPPING_THRESHOLD) {
          shippingBar.style.width = '100%';
          shippingText.innerHTML = `Free Express Shipping Unlocked! 🎉`;
        } else {
          const diff = SHIPPING_THRESHOLD - totalAmount;
          const pct = Math.min((totalAmount / SHIPPING_THRESHOLD) * 100, 100);
          shippingBar.style.width = `${pct}%`;
          shippingText.innerHTML = `Add <strong>₹${diff}</strong> more for Free Shipping 🚚`;
        }
      }

      if (!container) return;

      if (items.length === 0) {
        container.innerHTML = `
          <div class="py-16 text-center text-gray-500 font-sans">
            <div class="w-16 h-16 rounded-full bg-emerald-50 text-[#166534] flex items-center justify-center text-2xl mx-auto mb-4 border border-emerald-100">
              🌿
            </div>
            <h3 class="text-base font-bold text-[#111827] mb-1">Your Routine is Empty</h3>
            <p class="text-xs text-gray-500 max-w-[240px] mx-auto mb-6">Select a starter kit or daily formulation to begin your wellness protocol.</p>
            <button onclick="window.closeSujataCart()" class="bg-[#111827] hover:bg-[#166534] text-white px-6 py-2.5 rounded-xl font-bold text-xs uppercase tracking-wider transition-colors cursor-pointer">
              Explore Products →
            </button>
          </div>
        `;
        return;
      }

      container.innerHTML = items.map(item => `
        <div class="flex gap-4 p-4 bg-white rounded-2xl border border-gray-200 shadow-sm relative group">
          <div class="w-18 h-20 bg-[#FAF9F6] rounded-xl p-2 flex items-center justify-center shrink-0 border border-gray-100">
            <img src="${item.image || '/spirulina-bottle.png'}" alt="${item.title}" class="w-full h-full object-contain drop-shadow-sm" />
          </div>

          <div class="flex-1 flex flex-col justify-between min-w-0">
            <div class="flex items-start justify-between gap-2">
              <div>
                <h4 class="text-sm font-bold text-[#111827] font-sans truncate leading-snug">${item.title}</h4>
                <span class="text-[10px] text-[#166534] font-bold block mt-0.5">${item.subtitle || '100% Pure Cold-Pressed'}</span>
              </div>
              <button class="cart-remove-btn text-gray-400 hover:text-red-500 text-xs p-1 cursor-pointer transition-colors" data-id="${item.id}" title="Remove item">
                ✕
              </button>
            </div>

            <div class="flex items-center justify-between mt-3 pt-2 border-t border-gray-100">
              <div class="flex items-center gap-2 bg-gray-100 rounded-full px-2 py-0.5">
                <button class="cart-qty-btn text-xs font-bold text-gray-600 hover:text-black w-5 h-5 flex items-center justify-center cursor-pointer" data-id="${item.id}" data-action="dec">−</button>
                <span class="text-xs font-bold text-[#111827] px-1">${item.quantity}</span>
                <button class="cart-qty-btn text-xs font-bold text-gray-600 hover:text-black w-5 h-5 flex items-center justify-center cursor-pointer" data-id="${item.id}" data-action="inc">+</button>
              </div>

              <span class="text-sm font-black text-[#111827] font-sans">${formatINR(item.price * item.quantity)}</span>
            </div>
          </div>
        </div>
      `).join('');
    };

    // Add Item to Local Cart
    window.addItemToLocalCart = function(product) {
      const items = getLocalCart();
      const existing = items.find(i => i.id === product.id);

      if (existing) {
        existing.quantity += (product.quantity || 1);
      } else {
        items.push({
          id: product.id,
          title: product.title || 'Pure Spirulina Formulation',
          subtitle: product.subtitle || '100% Pure Cold-Pressed',
          price: product.price || 799,
          image: product.image || '/spirulina-bottle.png',
          quantity: product.quantity || 1
        });
      }

      saveLocalCart(items);
      window.openSujataCart();
    };

    // Reset Checkout Button State (Self-Healing State Machine)
    function resetCheckoutBtn() {
      const checkoutBtn = document.getElementById('checkout-action-btn');
      if (checkoutBtn) {
        checkoutBtn.disabled = false;
        checkoutBtn.classList.remove('opacity-75', 'cursor-not-allowed');
        checkoutBtn.innerHTML = `
          <span>Proceed to Checkout</span>
          <span class="text-base">→</span>
        `;
      }
    }
    window.resetSujataCheckoutBtn = resetCheckoutBtn;

    // Checkout Action Button Handler (Shopify GraphQL Mutation with Self-Healing)
    async function handleCheckout(e) {
      const checkoutBtn = e.target.closest('#checkout-action-btn') || document.getElementById('checkout-action-btn');
      if (!checkoutBtn || checkoutBtn.disabled) return;
      e.preventDefault();

      const items = getLocalCart();
      if (items.length === 0) return;

      // Enter Loading State
      checkoutBtn.disabled = true;
      checkoutBtn.classList.add('opacity-75', 'cursor-not-allowed');
      checkoutBtn.innerHTML = `
        <svg class="animate-spin -ml-1 mr-2 h-4 w-4 text-white inline-block" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
          <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
          <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
        </svg>
        <span>Securing Checkout...</span>
      `;

      // 🛡️ Circuit Breaker: Auto-reset button if navigation takes > 8 seconds or user cancels
      const recoveryTimer = setTimeout(resetCheckoutBtn, 8000);

      // Format lines for Shopify Storefront API
      const lines = items
        .filter(i => i.id && typeof i.id === 'string' && (i.id.includes('gid://shopify/ProductVariant/') || !isNaN(Number(i.id))))
        .map(i => {
          const merchandiseId = i.id.includes('gid://shopify/ProductVariant/') ? i.id : `gid://shopify/ProductVariant/${i.id}`;
          return { merchandiseId, quantity: i.quantity };
        });

      if (lines.length > 0) {
        const mutation = `
          mutation cartCreate($input: CartInput!) {
            cartCreate(input: $input) {
              cart {
                id
                checkoutUrl
              }
              userErrors {
                field
                message
              }
            }
          }
        `;

        try {
          const response = await fetch(`https://${DOMAIN}/api/2024-01/graphql.json`, {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json',
              'X-Shopify-Storefront-Access-Token': TOKEN,
            },
            body: JSON.stringify({
              query: mutation,
              variables: { input: { lines } }
            })
          });

          const data = await response.json();
          const checkoutUrl = data?.data?.cartCreate?.cart?.checkoutUrl;

          if (checkoutUrl) {
            clearTimeout(recoveryTimer);
            window.location.href = checkoutUrl;
          } else {
            console.warn("⚠️ Checkout URL missing from Shopify response, redirecting to store cart fallback");
            clearTimeout(recoveryTimer);
            window.location.href = `https://${DOMAIN}/cart`;
          }
        } catch (err) {
          console.error("❌ Shopify checkout network error:", err);
          clearTimeout(recoveryTimer);
          resetCheckoutBtn();
          window.location.href = `https://${DOMAIN}/cart`;
        }
      } else {
        // Fallback for custom bundle or trial items
        setTimeout(() => {
          clearTimeout(recoveryTimer);
          window.location.href = '/thank-you';
        }, 600);
      }
    }

    // Event Delegations
    document.addEventListener('click', (e) => {
      // Close Cart
      if (e.target.closest('#close-cart-btn') || e.target.id === 'cart-overlay') {
        window.closeSujataCart();
      }

      // Open Cart Trigger
      if (e.target.closest('#cart-drawer-trigger') || e.target.closest('.open-cart-trigger')) {
        e.preventDefault();
        window.openSujataCart();
      }

      // Quantity buttons (+ / -)
      const qtyBtn = e.target.closest('.cart-qty-btn');
      if (qtyBtn) {
        const id = qtyBtn.getAttribute('data-id');
        const action = qtyBtn.getAttribute('data-action');
        const items = getLocalCart();
        const item = items.find(i => i.id === id);

        if (item) {
          if (action === 'inc') {
            item.quantity += 1;
          } else if (action === 'dec') {
            item.quantity -= 1;
            if (item.quantity <= 0) {
              const idx = items.indexOf(item);
              items.splice(idx, 1);
            }
          }
          saveLocalCart(items);
          window.renderSujataCart();
        }
      }

      // Remove button
      const removeBtn = e.target.closest('.cart-remove-btn');
      if (removeBtn) {
        const id = removeBtn.getAttribute('data-id');
        let items = getLocalCart();
        items = items.filter(i => i.id !== id);
        saveLocalCart(items);
        window.renderSujataCart();
      }

      // Universal "Add to Cart" / "Add to Routine" Clicks
      const atcBtn = e.target.closest('.add-to-cart-btn') || e.target.closest('#add-to-cart-btn');
      if (atcBtn) {
        e.preventDefault();
        
        // Find parent product card data if available
        const card = atcBtn.closest('.product-card-item') || atcBtn.closest('#welcome-kit-builder');
        let title = atcBtn.getAttribute('data-title');
        let price = parseInt(atcBtn.getAttribute('data-price')) || 0;
        let image = atcBtn.getAttribute('data-image');
        let id = atcBtn.getAttribute('data-variant-id') || ('item_' + Date.now());

        if (card) {
          if (!title) {
            const titleEl = card.querySelector('h3, h2');
            if (titleEl) title = titleEl.innerText.trim();
          }
          if (!price) {
            const priceEl = card.querySelector('.font-extrabold, .font-black');
            if (priceEl) {
              const cleaned = priceEl.innerText.replace(/[^0-9]/g, '');
              if (cleaned) price = parseInt(cleaned);
            }
          }
          if (!image) {
            const imgEl = card.querySelector('img');
            if (imgEl) image = imgEl.src;
          }
        }

        // Fallback default
        if (!title) title = "Sujata Spirulina Daily Ritual";
        if (!price || price === 0) price = 799;
        if (!image) image = "/spirulina-bottle.png";

        window.addItemToLocalCart({
          id: id,
          title: title,
          price: price,
          image: image,
          quantity: 1
        });
      }

      // Checkout Action Click
      if (e.target.closest('#checkout-action-btn')) {
        handleCheckout(e);
      }
    });

    // 🚀 Silicon Valley Standard: Back-Forward Cache (bfcache) & Page Lifecycle Recovery
    // When a user hits the browser Back button from Shopify checkout, instant restoration happens!
    window.addEventListener('pageshow', (event) => {
      resetCheckoutBtn();
      window.renderSujataCart();
    });

    // When tab becomes active / visible again (e.g. after returning from payment/app)
    document.addEventListener('visibilitychange', () => {
      if (document.visibilityState === 'visible') {
        resetCheckoutBtn();
        window.renderSujataCart();
      }
    });

    window.addEventListener('focus', () => {
      resetCheckoutBtn();
    });

    window.addEventListener('popstate', () => {
      resetCheckoutBtn();
      window.renderSujataCart();
    });

    // Cross-tab Synchronization
    window.addEventListener('storage', (e) => {
      if (e.key === 'sujata_cart_items') {
        resetCheckoutBtn();
        window.renderSujataCart();
      }
    });

    // Custom Event Listener for Global Dispatch
    window.addEventListener('cart-add-item', (e) => {
      if (e.detail) {
        window.addItemToLocalCart(e.detail);
      }
    });

    // Initialize on page load & Astro View Transitions
    function init() {
      resetCheckoutBtn();
      window.renderSujataCart();
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', init);
    } else {
      init();
    }
    document.addEventListener('astro:page-load', init);
    document.addEventListener('astro:after-swap', init);

  })();
</script>