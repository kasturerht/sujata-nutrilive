      <button 
        type="button" 
        id="cart-tab-cod"
        class="py-1.5 px-2 rounded-lg text-xs font-bold transition-all text-gray-600 bg-transparent hover:bg-white/50 border border-transparent flex items-center justify-center gap-1.5 cursor-pointer touch-manipulation group"
        data-mode="cod"
      >
        <span class="text-xs">📦</span>
        <div class="flex flex-col text-left">
          <span class="text-[10px] font-bold text-gray-700 leading-tight">Cash on Delivery</span>
          <span class="text-[9px] font-semibold text-gray-500 leading-tight" id="cart-cod-total">₹0</span>
        </div>
