<div id="checkout-loader" class="hidden fixed inset-0 z-[10000] bg-white/90 backdrop-blur-sm flex-col items-center justify-center gap-3 px-8 text-center" role="status" aria-live="polite">
  <div class="w-10 h-10 border-[3px] border-emerald-700/20 border-t-emerald-700 rounded-full animate-spin"></div>
  <p class="text-sm font-bold text-[#111827] font-sans">Opening Secure Checkout…</p>
  <p class="text-[11px] text-gray-500 font-sans">UPI · Cash on Delivery · Cards — 🔒 secured by Razorpay</p>
</div>
<div id="cart-overlay" class="fixed inset-0 bg-black/60 backdrop-blur-sm z-[9998] opacity-0 pointer-events-none transition-opacity duration-300 ease-out"></div>

{/* The Premium Drawer (Responsive width across Mobile, Tablet, Laptop, Desktop) */}
