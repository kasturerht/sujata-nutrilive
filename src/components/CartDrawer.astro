            <div class="flex items-center justify-between mt-1.5 pt-1.5 border-t border-gray-100">
              <div class="flex items-center gap-1.5 bg-gray-100 rounded-full px-2 py-0.5">
                <button class="cart-qty-btn text-xs font-bold text-gray-600 hover:text-black w-4 h-4 sm:w-5 sm:h-5 flex items-center justify-center cursor-pointer touch-manipulation" data-id="${item.id}" data-action="dec" aria-label="Decrease quantity">−</button>
                <span class="text-xs font-bold text-[#111827] px-1">${item.quantity}</span>
                <button class="cart-qty-btn text-xs font-bold text-gray-600 hover:text-black w-4 h-4 sm:w-5 sm:h-5 flex items-center justify-center cursor-pointer touch-manipulation" data-id="${item.id}" data-action="inc" aria-label="Increase quantity">+</button>
              </div>

              <span class="text-xs sm:text-sm font-black text-[#111827] font-sans">${formatINR(item.price * item.quantity)}</span>
