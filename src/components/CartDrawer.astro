        <span class="text-[9.5px] font-bold text-emerald-700 font-sans" id="cart-upi-save">Save 10%</span>
      </div>
      <div class="flex items-baseline gap-1.5 font-sans">
        <span class="text-xl sm:text-2xl font-black text-emerald-700" id="cart-subtotal">₹0</span>
        <span class="text-xs text-gray-400 line-through hidden font-sans" id="cart-regular-price"></span>
      </div>
    </div>

    {/* Primary Checkout Action CTA */}
    <button id="checkout-action-btn" class="w-full bg-emerald-700 hover:bg-emerald-600 text-white font-black text-xs uppercase tracking-[0.12em] py-3 sm:py-3.5 rounded-xl flex items-center justify-center gap-2 transition-all duration-300 shadow-md active:scale-95 touch-manipulation cursor-pointer">
      <span id="checkout-btn-text">⚡ Proceed to Pay with UPI</span>
      <span class="text-base">→</span>
    </button>

    {/* WhatsApp order: for shoppers who stop at the mobile-number / OTP step of checkout */}
    <button id="cart-whatsapp-order-btn" type="button" data-wa={waOrderNumber} class="w-full mt-2 bg-white hover:bg-emerald-50 border border-[#25D366] text-[#128C7E] font-bold text-xs py-2.5 rounded-xl flex items-center justify-center gap-2 transition-colors touch-manipulation">
      <svg class="w-4 h-4 shrink-0" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M17.47 14.38c-.3-.15-1.76-.87-2.03-.97-.27-.1-.47-.15-.67.15-.2.3-.77.97-.94 1.17-.17.2-.35.22-.65.07-.3-.15-1.26-.46-2.4-1.48-.89-.79-1.49-1.77-1.66-2.07-.17-.3-.02-.46.13-.61.13-.13.3-.35.45-.52.15-.17.2-.3.3-.5.1-.2.05-.37-.02-.52-.08-.15-.67-1.62-.92-2.22-.24-.58-.49-.5-.67-.51h-.57c-.2 0-.52.07-.8.37-.27.3-1.04 1.02-1.04 2.48s1.07 2.88 1.21 3.08c.15.2 2.1 3.2 5.08 4.49.71.31 1.26.49 1.69.63.71.23 1.36.2 1.87.12.57-.08 1.76-.72 2.01-1.42.25-.7.25-1.29.17-1.42-.07-.12-.27-.2-.57-.35M12.05 21.8h-.01a9.8 9.8 0 0 1-5-1.37l-.36-.21-3.72.98 1-3.63-.24-.37a9.8 9.8 0 1 1 8.33 4.6m8.34-18.14A11.8 11.8 0 0 0 12.05 0C5.5 0 .16 5.34.16 11.89c0 2.1.55 4.14 1.59 5.95L.06 24l6.3-1.65a11.9 11.9 0 0 0 5.69 1.45h.01c6.55 0 11.89-5.34 11.89-11.89 0-3.18-1.24-6.16-3.48-8.41"/></svg>
      <span>1-Click Order on WhatsApp (No OTP)</span>
    </button>
    
    {/* Clean 4-Column Institutional Trust Badges */}
    <div class="grid grid-cols-4 gap-1 mt-2 pt-2 border-t border-gray-100 text-center">
      <div class="text-[9px] sm:text-[9.5px] font-bold text-gray-500 font-sans flex items-center justify-center gap-1 whitespace-nowrap">
        <span>🔒</span>
        <span>256-Bit SSL</span>
      </div>
      <a href="/refund-policy" target="_blank" class="text-[9px] sm:text-[9.5px] font-bold text-gray-500 hover:text-[#166534] font-sans flex items-center justify-center gap-1 whitespace-nowrap transition-colors">
        <span>🛡️</span>
        <span>90-Day Guarantee</span>
      </a>
      <div class="text-[9px] sm:text-[9.5px] font-bold text-gray-500 font-sans flex items-center justify-center gap-1 whitespace-nowrap">
        <span>💵</span>
        <span>Free COD</span>
      </div>
      <div class="text-[9px] sm:text-[9.5px] font-bold text-emerald-700 font-sans flex items-center justify-center gap-1 whitespace-nowrap">
        <span>⚡</span>
        <span>10% UPI Off</span>
      </div>
    </div>
  </div>

</div>

<style is:inline>
  .cart-custom-scrollbar::-webkit-scrollbar {
    width: 5px;
  }
  .cart-custom-scrollbar::-webkit-scrollbar-track {
    background: transparent;
  }
  .cart-custom-scrollbar::-webkit-scrollbar-thumb {
    background: rgba(0, 0, 0, 0.12);
    border-radius: 9999px;
  }
  .cart-custom-scrollbar::-webkit-scrollbar-thumb:hover {
    background: rgba(0, 0, 0, 0.25);
  }
  .cart-custom-scrollbar {
    scrollbar-width: thin;
    scrollbar-color: rgba(0, 0, 0, 0.12) transparent;
  }
</style>

<script is:inline>
  // High-Performance Hybrid Cart Engine (Shopify GraphQL + Optimistic Local State)
  (function() {
    const drawerEl = document.getElementById('cart-drawer');
    const DOMAIN = drawerEl?.getAttribute('data-domain') || "tvczdq-nu.myshopify.com";
    const TOKEN = drawerEl?.getAttribute('data-token') || "7e0a0176aede63ce4c6b199e18684018";

    // Local Cart Data Management (Strict Sanitization & Anti-Corruption)
    function getLocalCart() {
      try {
        const stored = localStorage.getItem('sujata_cart_items');
        const parsed = stored ? JSON.parse(stored) : [];
        if (!Array.isArray(parsed)) return [];
        return parsed.filter(item => 
          item && 
          typeof item === 'object' && 
          item.id && 
          typeof item.price === 'number' && 
          !isNaN(item.price) && 
          item.price >= 0 &&
          typeof item.quantity === 'number' && 
          item.quantity > 0
        );
      } catch (e) {
        return [];
      }
    }

    function saveLocalCart(items) {
      const sanitized = (items || []).filter(item => item && item.quantity > 0);
      localStorage.setItem('sujata_cart_items', JSON.stringify(sanitized));
    }

    function formatINR(amount) {
      return new Intl.NumberFormat('en-IN', {
        style: 'currency',
        currency: 'INR',
        maximumFractionDigits: 0
      }).format(amount || 0);
    }

    // 💰 Live price sync: every cart line is re-priced from Shopify (Storefront API) so the drawer total
    // always matches what checkout charges, even if an item was added from a page with a stale price or
    // the price changed since the cart was saved. Unavailable variants are flagged, not silently charged.
    let lastPriceSync = 0;
    async function syncCartPrices(force) {
      const items = getLocalCart();
      const ids = items.map(i => String(i.id)).filter(id => id.indexOf('gid://shopify/ProductVariant/') === 0);
      if (!ids.length || !TOKEN) return;
      if (!force && Date.now() - lastPriceSync < 60000) return;
      lastPriceSync = Date.now();
      try {
        const res = await fetch(`https://${DOMAIN}/api/2024-01/graphql.json`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', 'X-Shopify-Storefront-Access-Token': TOKEN },
          body: JSON.stringify({
            query: 'query($ids: [ID!]!) @inContext(country: IN) { nodes(ids: $ids) { ... on ProductVariant { id availableForSale price { amount } } } }',
            variables: { ids: Array.from(new Set(ids)) }
          })
        });
        if (!res.ok) return;
        const json = await res.json();
        const live = {};
        ((json && json.data && json.data.nodes) || []).forEach(n => { if (n && n.id) live[n.id] = n; });
        let changed = false;
        const current = getLocalCart();
        current.forEach(item => {
          const n = live[String(item.id)];
          if (!n) return;
          const livePrice = Math.round(parseFloat(n.price && n.price.amount));
          if (livePrice > 0 && livePrice !== item.price) { item.price = livePrice; changed = true; }
          const unavailable = n.availableForSale === false;
          if (!!item.unavailable !== unavailable) { item.unavailable = unavailable; changed = true; }
        });
        if (changed) { saveLocalCart(current); window.renderSujataCart(); }
      } catch (e) {}
    }
    window.syncSujataCartPrices = syncCartPrices;

    // Open & Close Drawer
    window.openSujataCart = function() {
      syncCartPrices(false);
      if (typeof window.ensureRazorpayLoaded === 'function') window.ensureRazorpayLoaded();
      const drawer = document.getElementById('cart-drawer');
      const overlay = document.getElementById('cart-overlay');
      if (drawer && overlay) {
        window.renderSujataCart();
        overlay.classList.remove('opacity-0', 'pointer-events-none');
        overlay.classList.add('opacity-100');
        drawer.classList.remove('translate-x-full');
        document.body.style.overflow = 'hidden';
        if (window.sujataOverlay) window.sujataOverlay.opened('cart', hideCartDrawer);
      }
    };

    function hideCartDrawer() {
      const drawer = document.getElementById('cart-drawer');
      const overlay = document.getElementById('cart-overlay');
      if (drawer && overlay) {
        overlay.classList.add('opacity-0', 'pointer-events-none');
        overlay.classList.remove('opacity-100');
        drawer.classList.add('translate-x-full');
        document.body.style.overflow = '';
      }
    }

    // On-screen close (X, backdrop, "continue shopping"): also pops the drawer's history entry.
    window.closeSujataCart = function() {
      hideCartDrawer();
      if (window.sujataOverlay) window.sujataOverlay.closed('cart');
    };

    // Render Cart HTML
    window.renderSujataCart = function() {
      const items = getLocalCart();
      const container = document.getElementById('cart-items-container');
      const subtotalEl = document.getElementById('cart-subtotal');
      const badgeEl = document.getElementById('cart-count-badge');
      const headerBadgeEl = document.getElementById('header-cart-badge');
      const shippingBar = document.getElementById('shipping-meter-bar');
      const shippingText = document.getElementById('shipping-meter-text');

      let totalCount = 0;
      let totalAmount = 0;

      items.forEach(item => {
        totalCount += item.quantity;
        totalAmount += item.price * item.quantity;
      });

      // Update Badges
      if (badgeEl) badgeEl.innerText = totalCount;
      if (headerBadgeEl) {
        headerBadgeEl.innerText = totalCount;
        headerBadgeEl.style.display = totalCount > 0 ? 'flex' : 'none';
      }

      // ⚡ Calculate UPI (10% Discount) vs COD Totals
      const upiTotal = Math.round(totalAmount * 0.9);
      const upiSavings = totalAmount - upiTotal;

      const drawerEl = document.getElementById('cart-drawer');
      let noCodList = ["sujata-spiruglow-bath-soap"];
      try {
        const raw = drawerEl?.getAttribute('data-no-cod-handles');
        if (raw) noCodList = JSON.parse(raw);
      } catch(e) {}

      const isItemNoCod = (item) => {
        if (item.noCod === true) return true;
        if (item.handle && noCodList.includes(item.handle)) return true;
        if (item.title && /soap|spiruglow/i.test(item.title)) return true;
        return false;
      };

      // ⚡ Smart Tag-Driven COD Rule (No Blanket Price Constraint):
      // If the cart has ONLY "no-cod" items (e.g. only 1 or 2 soaps, no regular products) -> COD is disabled!
      // If the cart contains ANY regular product (e.g. Spirulina Powder, Tablets, etc.) -> COD is 100% UNLOCKED!
      const hasOnlyNoCodItems = items.length > 0 && items.every(item => isItemNoCod(item));
      const isCodEligible = !hasOnlyNoCodItems;

      let selectedMode = localStorage.getItem('sujata_selected_payment_mode') || 'upi';
      if (!isCodEligible && selectedMode === 'cod') {
        selectedMode = 'upi';
        try { localStorage.setItem('sujata_selected_payment_mode', 'upi'); } catch(e) {}
      }

      const savedDiscount = localStorage.getItem('sujata_discount_code');
      const hasCoupon = !!savedDiscount;
      const codDiscount = hasCoupon ? Math.round(totalAmount * 0.1) : 0;
      const codPayable = totalAmount - codDiscount;

            const regularPriceEl = document.getElementById('cart-regular-price');
      const upiTotalEl = document.getElementById('cart-upi-total');
      const upiSaveEl = document.getElementById('cart-upi-save');
      const codTotalEl = document.getElementById('cart-cod-total');
      const codNoticeEl = document.getElementById('cart-cod-threshold-notice');
      const codNoticeText = document.getElementById('cart-cod-notice-text');
      const totalLabelEl = document.getElementById('cart-total-label');
      const tabUpiEl = document.getElementById('cart-tab-upi');
      const tabCodEl = document.getElementById('cart-tab-cod');
      const checkoutBtn = document.getElementById('checkout-action-btn');
      const checkoutBtnText = document.getElementById('checkout-btn-text');

      if (upiTotalEl) upiTotalEl.innerText = formatINR(upiTotal);
      if (codTotalEl) codTotalEl.innerText = formatINR(codPayable);

      // Handle COD Locking Visuals
      if (!isCodEligible && totalAmount > 0) {
        tabCodEl?.classList.add('opacity-60', 'cursor-not-allowed');
        if (codNoticeEl && codNoticeText) {
          codNoticeText.innerHTML = `<span>🔒 <strong>Prepaid only for low-ticket items.</strong> Add supplements to unlock COD.</span>`;
          codNoticeEl.classList.remove('hidden');
        }
      } else {
        tabCodEl?.classList.remove('opacity-60', 'cursor-not-allowed');
        if (codNoticeEl) codNoticeEl.classList.add('hidden');
      }

      if (selectedMode === 'upi' || !isCodEligible) {
        if (subtotalEl) {
          subtotalEl.innerText = formatINR(upiTotal);
          subtotalEl.className = 'text-xl sm:text-2xl font-black text-emerald-700 font-sans';
        }
        if (regularPriceEl) {
          if (totalAmount > upiTotal) {
            regularPriceEl.innerText = formatINR(totalAmount);
            regularPriceEl.classList.remove('hidden');
          } else {
            regularPriceEl.classList.add('hidden');
          }
        }
        if (totalLabelEl) totalLabelEl.innerText = 'UPI Payable (10% Instant Off)';
        if (upiSaveEl) {
          upiSaveEl.innerText = `Save ₹${upiSavings} (10% Instant)`;
          upiSaveEl.className = 'text-[9.5px] font-bold text-emerald-700 font-sans';
        }
        if (checkoutBtn) {
          checkoutBtn.className = 'w-full bg-emerald-700 hover:bg-emerald-600 text-white font-black text-xs uppercase tracking-[0.12em] py-3 sm:py-3.5 rounded-xl flex items-center justify-center gap-2 transition-all duration-300 shadow-md active:scale-95 touch-manipulation cursor-pointer';
        }
        if (checkoutBtnText) checkoutBtnText.innerText = '⚡ Proceed to Pay with UPI';

        tabUpiEl?.classList.remove('bg-transparent', 'border-transparent', 'text-gray-600');
        tabUpiEl?.classList.add('bg-white', 'border-emerald-500/50', 'text-emerald-950', 'shadow-sm');
        tabCodEl?.classList.remove('bg-white', 'border-gray-800', 'text-[#111827]', 'shadow-sm');
        tabCodEl?.classList.add('bg-transparent', 'border-transparent', 'text-gray-600');
      } else {
        if (subtotalEl) {
          subtotalEl.innerText = formatINR(codPayable);
          subtotalEl.className = 'text-xl sm:text-2xl font-black text-[#111827] font-sans';
        }
        if (regularPriceEl) {
          if (hasCoupon && codDiscount > 0) {
            regularPriceEl.innerText = formatINR(totalAmount);
            regularPriceEl.classList.remove('hidden');
          } else {
            regularPriceEl.classList.add('hidden');
          }
        }
        if (totalLabelEl) totalLabelEl.innerText = hasCoupon ? `Payable on Delivery (${savedDiscount} Applied)` : 'Payable on Delivery (COD)';
        if (upiSaveEl) {
          if (hasCoupon && codDiscount > 0) {
            upiSaveEl.innerText = `Coupon Discount: ₹${codDiscount}`;
            upiSaveEl.className = 'text-[9.5px] font-bold text-emerald-700 font-sans';
          } else {
            upiSaveEl.innerText = 'Standard Doorstep Delivery';
            upiSaveEl.className = 'text-[9.5px] font-medium text-gray-500 font-sans';
          }
        }
        if (checkoutBtn) {
          checkoutBtn.className = 'w-full bg-[#111827] hover:bg-black text-white font-black text-xs uppercase tracking-[0.12em] py-3 sm:py-3.5 rounded-xl flex items-center justify-center gap-2 transition-all duration-300 shadow-md active:scale-95 touch-manipulation cursor-pointer';
        }
        if (checkoutBtnText) checkoutBtnText.innerText = '📦 Proceed with Cash on Delivery';

        tabCodEl?.classList.remove('bg-transparent', 'border-transparent', 'text-gray-600');
        tabCodEl?.classList.add('bg-white', 'border-gray-800', 'text-[#111827]', 'shadow-sm');
        tabUpiEl?.classList.remove('bg-white', 'border-emerald-500/50', 'text-emerald-950', 'shadow-sm');
        tabUpiEl?.classList.add('bg-transparent', 'border-transparent', 'text-gray-600');
      }

      // 🚚 Free Express Delivery Banner
      if (shippingBar && shippingText) {
