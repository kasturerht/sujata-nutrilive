    <div class="flex items-center justify-between text-xs font-sans">
      <div class="flex items-center gap-1.5">
        <span class="w-4 h-4 rounded-full bg-emerald-600 text-white flex items-center justify-center text-[9px] font-black shrink-0 shadow-2xs">✓</span>
        <span class="font-bold text-emerald-950 text-[11px] sm:text-xs tracking-tight" id="shipping-meter-text">Free All-India Express Delivery Unlocked 🚚</span>
      </div>
      <span class="text-[9px] font-black text-emerald-800 bg-emerald-200/70 px-2 py-0.5 rounded-full uppercase tracking-wider shrink-0">₹0 Delivery</span>
    </div>
    <div class="w-full h-1 bg-emerald-200/60 rounded-full overflow-hidden mt-1.5">
      <div class="h-full bg-emerald-600 rounded-full w-full transition-all duration-500" id="shipping-meter-bar"></div>
    </div>
  </div>

  {/* 3. Cart Items Area (Scrollable with custom sleek scrollbar) */}
  <div class="flex-1 overflow-y-auto p-3 sm:p-4 space-y-2.5 cart-custom-scrollbar" id="cart-items-container">
    {/* Dynamic Items rendered via JavaScript */}
  </div>

  {/* 4. Drawer Footer (Ultra-Compact High-Converting Checkout Zone) */}
  <div class="px-4 sm:px-5 pt-2.5 pb-4 sm:pb-5 pb-safe bg-white border-t border-gray-200 shadow-[0_-4px_20px_rgba(0,0,0,0.06)] shrink-0">
    
    {/* Segmented Payment Mode Switcher (Sleek Apple-style 38px toggle) */}
    <div class="p-1 bg-gray-100/90 rounded-xl grid grid-cols-2 gap-1 mb-2" id="cart-payment-container">
      <button 
        type="button" 
