    </div>

    {/* Smart COD Threshold Notice (When low-ticket items exist) */}
    <div id="cart-cod-threshold-notice" class="hidden mb-2 px-2.5 py-1.5 bg-amber-50/90 border border-amber-200/90 rounded-lg flex items-center justify-between text-[10px] text-amber-900 font-medium">
      <span id="cart-cod-notice-text">📦 Low-ticket items: Add supplements to unlock COD</span>
      <span class="text-[9px] font-bold text-amber-800 bg-amber-200/80 px-1.5 py-0.5 rounded shrink-0">Prepaid</span>
