      `).join('') + `
        <div class="mt-2.5 p-3 bg-gradient-to-r from-amber-50/90 to-emerald-50/80 border border-amber-200/80 rounded-xl flex items-start gap-2.5 shadow-2xs">
          <span class="text-base shrink-0 mt-0.5">🛡️</span>
          <div class="text-[10px] sm:text-[10.5px] text-emerald-950 font-medium leading-relaxed">
            <strong class="font-bold text-emerald-900 block mb-0.5">90-Day Satisfaction Return:</strong>
            Food supplements, not medicines — no outcome guarantee. If not satisfied with the product after a 90-day routine, see our Refund Policy to initiate a return.
          </div>
        </div>
      `;
    };

    // Add Item to Local Cart
    window.addItemToLocalCart = function(product) {
      const items = getLocalCart();
      const existing = items.find(i => i.id === product.id);
      const safeQty = Math.max(1, Math.min(10, parseInt(product.quantity) || 1));
      const safePrice = Math.max(1, parseInt(product.price) || 299);

      if (existing) {
        existing.quantity = Math.max(1, Math.min(10, (existing.quantity || 1) + safeQty));
        if (product.noCod !== undefined) existing.noCod = product.noCod;
      } else {
        items.push({
          id: product.id,
          title: product.title || 'Pure Spirulina Formulation',
          subtitle: product.subtitle || '100% Pure Cold-Pressed',
          price: safePrice,
          image: product.image || '/spirulina-bottle.png',
          quantity: safeQty,
          noCod: !!product.noCod
        });
      }

      saveLocalCart(items);

      // 🌟 Dispatch E-Commerce AddToCart Event (Meta Pixel & Google Ads / GA4)
      if (typeof window.dispatchStoreEvent === 'function') {
        window.dispatchStoreEvent('AddToCart', {
          id: product.id,
          title: product.title,
          price: product.price,
          quantity: product.quantity || 1
        });
      }

      window.openSujataCart();
    };

    // Reset Checkout Button State (Institutional-Grade Self-Healing State Machine)
    let isCheckoutInProgress = false;
    function showCheckoutLoader() {
      const el = document.getElementById('checkout-loader');
      if (el) { el.classList.remove('hidden'); el.classList.add('flex'); }
    }
    function hideCheckoutLoader() {
      const el = document.getElementById('checkout-loader');
      if (el) { el.classList.add('hidden'); el.classList.remove('flex'); }
    }
    // Keep the loader until Razorpay's own sheet is on screen (max 8 s), so there is never a blank gap.
    function hideLoaderWhenRazorpayVisible() {
      const started = Date.now();
      (function poll() {
        const frame = document.querySelector('iframe[src*="razorpay"]');
        if ((frame && frame.getBoundingClientRect().height > 0) || Date.now() - started > 8000) { setTimeout(hideCheckoutLoader, 300); return; }
        setTimeout(poll, 100);
      })();
    }
    function resetCheckoutBtn() {
      isCheckoutInProgress = false;
      hideCheckoutLoader();

      // 1. Reset Cart Drawer Checkout Action Button
      const checkoutBtn = document.getElementById('checkout-action-btn');
      const selectedMode = localStorage.getItem('sujata_selected_payment_mode') || 'upi';
      if (checkoutBtn) {
        checkoutBtn.disabled = false;
        checkoutBtn.classList.remove('opacity-75', 'cursor-not-allowed');
        const btnLabel = selectedMode === 'upi' ? '⚡ Proceed to Pay with UPI' : '📦 Proceed with Cash on Delivery';
        checkoutBtn.innerHTML = `
          <span id="checkout-btn-text">${btnLabel}</span>
          <span class="text-base">→</span>
        `;
      }

      // 2. Reset All Shop Hub "1-Click Buy Now" Buttons across the DOM
      document.querySelectorAll('.hub-direct-buy-btn').forEach(btn => {
        btn.style.pointerEvents = '';
        btn.removeAttribute('data-busy');
        const spinner = btn.querySelector('.hub-btn-spinner');
        if (spinner) spinner.classList.add('hidden');
        const textSpan = btn.querySelector('.hub-btn-text');
        if (textSpan) {
          textSpan.innerHTML = `
            <span>⚡ Buy Now</span>
            <span class="hidden xl:inline text-[9px] font-normal opacity-90">(COD)</span>
          `;
        }
      });

      // 3. Reset PDP Buy Now & Sticky Buy Now Spinners and Buttons
      const pdpBuySpinner = document.getElementById('buy-now-spinner');
      if (pdpBuySpinner) pdpBuySpinner.classList.add('hidden');
      const pdpStickySpinner = document.getElementById('sticky-buynow-spinner');
      if (pdpStickySpinner) pdpStickySpinner.classList.add('hidden');
      const pdpAtcSpinner = document.getElementById('btn-spinner');
      if (pdpAtcSpinner) pdpAtcSpinner.classList.add('hidden');
      const buyNowBtn = document.getElementById('buy-now-btn');
      if (buyNowBtn) {
        buyNowBtn.style.pointerEvents = '';
        buyNowBtn.classList.remove('opacity-75', 'cursor-not-allowed');
      }
      const stickyBuyNowBtn = document.getElementById('sticky-buynow-btn');
      if (stickyBuyNowBtn) {
        stickyBuyNowBtn.style.pointerEvents = '';
        stickyBuyNowBtn.classList.remove('opacity-75', 'cursor-not-allowed');
      }

      // 4. Reset Science Page Direct Buy Buttons
      document.querySelectorAll('.science-direct-buy-btn').forEach(btn => {
        btn.style.pointerEvents = '';
        btn.removeAttribute('data-busy');
        const origText = btn.getAttribute('data-original-html');
        if (origText) {
          btn.innerHTML = origText;
        } else {
          btn.innerHTML = `<span>⚡ Buy Now (COD Available)</span>`;
        }
      });

      const scienceBottomBtn = document.getElementById('science-direct-checkout-btn');
      if (scienceBottomBtn) {
        scienceBottomBtn.style.pointerEvents = '';
        scienceBottomBtn.removeAttribute('data-busy');
        const sSpinner = scienceBottomBtn.querySelector('.btn-spinner');
        if (sSpinner) sSpinner.classList.add('hidden');
        const sText = scienceBottomBtn.querySelector('.btn-text');
        if (sText) {
          const price = scienceBottomBtn.getAttribute('data-price') || '799';
          sText.innerHTML = `<span>⚡ Buy Now — Cash on Delivery OK • ₹${price}</span>`;
        }
      }

      // 5. Reset Catalog "Add to Routine" Buttons
      document.querySelectorAll('.add-to-cart-btn').forEach(btn => {
        btn.style.pointerEvents = '';
        btn.disabled = false;
        const spinner = btn.querySelector('.btn-spinner');
        if (spinner) spinner.classList.add('opacity-0', 'pointer-events-none');
        const btnText = btn.querySelector('.btn-text');
        if (btnText) btnText.style.opacity = '1';
      });

      // 6. Broadcast global custom event
      try {
        window.dispatchEvent(new CustomEvent('sujata:buttons-reset'));
      } catch(e) {}
    }
    window.resetAllPurchaseButtons = resetCheckoutBtn;
    window.resetSujataCheckoutBtn = resetCheckoutBtn;

    // 🚀 Silicon Valley Sub-Second 1-Click Checkout Handler (Direct Magic Execution)
    // "Buy now" checks out ONLY the chosen item at the chosen quantity. It used to be merged into the cart,
    // so a second tap (after closing Razorpay) ordered quantity 2, and leftover cart items rode along.
    let buyNowItems = null;

    // After a successful payment, remove exactly the purchased lines from the saved cart (it used to clear a
    // non-existent 'sujata_cart' key, so paid items stayed in the cart and resurfaced on the next visit).
    function removePurchasedFromCart(purchasedItems) {
      try {
        const ids = new Set((purchasedItems || []).map(i => String(i.id)));
        if (!ids.size) return;
        saveLocalCart(getLocalCart().filter(i => !ids.has(String(i.id))));
        window.renderSujataCart && window.renderSujataCart();
      } catch (e) {}
    }
    window.removePurchasedFromSujataCart = removePurchasedFromCart;

    async function handleCheckout(e) {
      const pendingBuyNow = buyNowItems;
      buyNowItems = null;
      const checkoutBtn = (e && e.target && typeof e.target.closest === 'function') 
        ? (e.target.closest('#checkout-action-btn') || document.getElementById('checkout-action-btn')) 
        : document.getElementById('checkout-action-btn');
      if (!checkoutBtn || isCheckoutInProgress) return;
      if (e && typeof e.preventDefault === 'function') e.preventDefault();

      // 1. Offline Network Protection
      if (typeof navigator !== 'undefined' && 'onLine' in navigator && !navigator.onLine) {
        alert("⚠️ You appear to be offline. Please check your internet connection and try again.");
        resetCheckoutBtn();
        return;
      }

      const items = pendingBuyNow || getLocalCart();
      if (items.length === 0) return;
      if (items.some(i => i.unavailable)) {
        alert('One item in your cart is currently out of stock. Please remove it to continue.');
        return;
      }

      // 2. 🔒 Silicon Valley Tag-Driven COD Check (Managed directly from Shopify)
      const drawerEl = document.getElementById('cart-drawer');
      let noCodList = ["sujata-spiruglow-bath-soap"];
      try {
        const raw = drawerEl?.getAttribute('data-no-cod-handles');
        if (raw) noCodList = JSON.parse(raw);
      } catch(e) {}
      const isItemNoCod = (item) => {
        if (item.noCod === true) return true;
        if (item.handle && noCodList.includes(item.handle)) return true;
        if (item.title && /soap|spiruglow/i.test(item.title)) return true;
        return false;
      };
      const hasOnlyNoCodItems = items.length > 0 && items.every(item => isItemNoCod(item));
      const anyNoCodItem = items.some(item => isItemNoCod(item));
      const isCodEligible = !hasOnlyNoCodItems;

      let selectedMode = localStorage.getItem('sujata_selected_payment_mode') || 'upi';
      if (!isCodEligible && selectedMode === 'cod') {
        selectedMode = 'upi';
        try { localStorage.setItem('sujata_selected_payment_mode', 'upi'); } catch(e) {}
      }
      const savedDiscount = localStorage.getItem('sujata_discount_code');
      const totalAmount = items.reduce((acc, item) => acc + (Number(item.price || 0) * Number(item.quantity || 1)), 0);
      const totalCount = items.reduce((acc, item) => acc + Number(item.quantity || 1), 0);
      const finalOrderTotal = selectedMode === 'upi' ? Math.round(totalAmount * 0.9) : totalAmount;
      const discountCodeToSend = (selectedMode === 'upi' ? (savedDiscount || 'UPI10') : (savedDiscount !== 'UPI10' ? savedDiscount : undefined));

      // 🌟 Dispatch E-Commerce InitiateCheckout Event (Meta Pixel & Google Ads / GA4)
      if (typeof window.dispatchStoreEvent === 'function') {
        window.dispatchStoreEvent('InitiateCheckout', {
          total: finalOrderTotal,
          count: totalCount,
          items: items,
          payment_mode: selectedMode
        });
      }

      // In-flight locking (Prevents duplicate rapid clicks)
      isCheckoutInProgress = true;
      showCheckoutLoader();
      checkoutBtn.disabled = true;
      checkoutBtn.classList.add('opacity-75', 'cursor-not-allowed');
      checkoutBtn.innerHTML = `
        <svg class="animate-spin -ml-1 mr-2 h-4 w-4 text-white inline-block" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
          <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
          <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
        </svg>
        <span>Securing 1-Click Checkout...</span>
      `;

      // 🛡️ Circuit Breaker: Auto-reset button if navigation takes > 8 seconds or user cancels
      const recoveryTimer = setTimeout(resetCheckoutBtn, 8000);

      // 🌟 Cross-Domain Tracking: Extract Meta & UTM Attribution to forward to Shopify Checkout
      // First-touch + last-touch attribution (StoreLayout engine) is bound to the checkout session here and
      // written into Shopify order attributes + note by both the Magic Checkout and Storefront paths.
      const cartAttributes = [];
      let attributionNote = '';
      try {
        if (typeof window.sujataGetAttribution === 'function') {
          const attribution = window.sujataGetAttribution() || {};
          Object.keys(attribution).forEach(k => {
            if (attribution[k]) cartAttributes.push({ key: k, value: String(attribution[k]) });
          });
          if (typeof window.sujataAttributionNote === 'function') attributionNote = window.sujataAttributionNote();
        }
      } catch(e) {}
      const hasAttr = (k) => cartAttributes.some(a => a.key === k);
      try {
        if (!hasAttr('_fbp')) {
        const fbp = (document.cookie.match(/(^|;\s*)_fbp=([^;]+)/) || [])[2] || localStorage.getItem('sujata_fbp');
        const fbc = (document.cookie.match(/(^|;\s*)_fbc=([^;]+)/) || [])[2] || localStorage.getItem('sujata_fbc');
        if (fbp) cartAttributes.push({ key: '_fbp', value: fbp });
        if (fbc) cartAttributes.push({ key: '_fbc', value: fbc });
        }

        // Legacy fallback (only if the attribution engine did not run)
        if (!hasAttr('utm_source')) {
          const rawUtms = localStorage.getItem('sujata_utms');
          if (rawUtms) {
            const parsedUtms = JSON.parse(rawUtms);
            Object.keys(parsedUtms).forEach(k => {
              if (parsedUtms[k] && !hasAttr(k)) cartAttributes.push({ key: k, value: String(parsedUtms[k]) });
            });
          }
        }

        const activeHook = sessionStorage.getItem('sujata_active_hook') || localStorage.getItem('sujata_active_hook');
        if (activeHook) {
          cartAttributes.push({ key: '_ad_hook', value: String(activeHook) });
        }

        const storedEmail = localStorage.getItem('sujata_user_email');
        const storedPhone = localStorage.getItem('sujata_user_phone');
        if (storedEmail) cartAttributes.push({ key: '_lead_email', value: storedEmail });
        if (storedPhone) cartAttributes.push({ key: '_lead_phone', value: storedPhone });
      } catch(e) {}

      // 🚀 FAST PATH: Direct 1-Click Razorpay Magic Checkout (Sub-Second Latency)
      try {
        if (typeof window.ensureRazorpayLoaded === 'function' && typeof window.Razorpay !== 'function') {
          await window.ensureRazorpayLoaded();
        }

        if (typeof window.Razorpay === 'function') {
          const attrRecord = {};
          cartAttributes.forEach(a => { attrRecord[a.key] = a.value; });

          const magicPayload = {
            items: items,
            coupon_code: discountCodeToSend || undefined,
            payment_mode: selectedMode,
            attributes: attrRecord,
            note: attributionNote || undefined
          };

          const magicRes = await fetch('/api/magic-checkout', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(magicPayload)
          });

          if (magicRes.ok) {
            const magicData = await magicRes.json();
            if (magicData.success && magicData.order_id) {
              clearTimeout(recoveryTimer);

              // 🌟 Silicon Valley Order Snapshot (Stored for Thank-You attribution & in-app browser recovery)
              const orderSnapshot = {
                order_id: magicData.order_id,
                key_id: magicData.key_id,
                items: items.map(it => ({
                  id: it.id,
                  title: it.title,
                  price: it.price,
                  quantity: it.quantity,
                  image: it.image
                })),
                total: finalOrderTotal,
                raw_total: totalAmount,
                payment_mode: selectedMode,
                coupon_code: discountCodeToSend || '',
                created_at: Date.now()
              };
              try {
                sessionStorage.setItem('sujata_pending_order', JSON.stringify(orderSnapshot));
                localStorage.setItem('sujata_pending_order', JSON.stringify(orderSnapshot));
                // 🛡️ Active checkout sentinel for Instagram in-app webview recovery
                localStorage.setItem('sujata_active_checkout', JSON.stringify({
                  order_id: magicData.order_id,
                  shopify_checkout_id: magicData.shopify_checkout_id,
                  total: finalOrderTotal,
                  payment_mode: selectedMode,
                  initiated_at: Date.now()
                }));
              } catch(e) {}

              const rzpOptions = {
                key: magicData.key_id || "rzp_live_TV8wwiNECUNJs0",
                order_id: magicData.order_id,
                one_click_checkout: true,
                name: "Sujata Nutrilive",
                description: "100% Pure, Lab-Tested Superfoods",
                image: "https://www.sujatanutrilive.com/sujata-checkout-logo.png",
                prefill: {
                  contact: localStorage.getItem('sujata_user_phone') || undefined,
                  email: localStorage.getItem('sujata_user_email') || undefined,
                  coupon_code: discountCodeToSend || undefined
                },
                handler: function(response) {
                  try {
                    removePurchasedFromCart(items);
                    localStorage.removeItem('sujata_active_checkout');
                  } catch(e) {}
                  const resolvedOrderId = response.razorpay_order_id || magicData.order_id || '';
                  const resolvedPaymentId = response.razorpay_payment_id || '';
                  const purchaseValue = Number(magicData.order_amount) > 0 ? Number(magicData.order_amount) : finalOrderTotal;
                  const goToThankYou = () => {
                    window.location.href = '/thank-you?order_id=' + encodeURIComponent(resolvedOrderId) +
                      '&payment_id=' + encodeURIComponent(resolvedPaymentId) +
                      '&value=' + encodeURIComponent(purchaseValue) +
                      '&mode=' + encodeURIComponent(selectedMode);
                  };
                  // Track the purchase HERE (GTM is already loaded on this page), before navigating away:
                  // in-app webviews often lose the redirect, which is why GA4 saw only part of the orders.
                  // /thank-you re-uses the same idempotency key, so the order is counted exactly once.
                  if (typeof window.sujataTrackPurchase === 'function') {
                    let navigated = false;
                    const go = () => { if (!navigated) { navigated = true; goToThankYou(); } };
                    setTimeout(go, 1800);
                    window.sujataTrackPurchase({
                      transaction_id: resolvedOrderId,
                      payment_id: resolvedPaymentId,
                      value: purchaseValue,
                      currency: 'INR',
                      coupon: discountCodeToSend || '',
                      payment_mode: selectedMode,
                      items: orderSnapshot.items
                    }, { skipGa4: true }).then(go, go); // GA4 purchase is sent from /thank-you (survives no redirect)
                  } else {
                    goToThankYou();
                  }
                },
                modal: {
                  ondismiss: function() {
                    try { localStorage.removeItem('sujata_active_checkout'); } catch(e) {}
                    resetCheckoutBtn();
                  }
                }
              };

              // 🌟 Institutional-Grade Dynamic Intent-Based Sequencing Engine (October/November 2026 Standards)
              // Preserves customer intent: COD at #1 when COD is selected; UPI at #1 when UPI is selected.
              const isUpiDiscountActive = selectedMode === 'upi' || (/^upi/i.test(discountCodeToSend || ''));
              const shouldBlockCod = Boolean(magicData.hide_cod || anyNoCodItem || isUpiDiscountActive);

              let displayConfig = {};

              if (selectedMode === 'cod' && !shouldBlockCod) {
                // Scenario 1: Customer explicitly selected COD in Cart Drawer.
                // 1. Cash on Delivery is placed at the very top (#1 position).
                // 2. UPI is cleanly offered below as a secondary payment option.
                // 3. Cards & Netbanking are offered last.
                // 4. Cluttered default blocks (CRED cashback, EMI banners) are suppressed.
                displayConfig = {
                  blocks: {
                    cod_primary: {
                      name: "Cash on Delivery (घरपोच कॅश द्या)",
                      instruments: [
                        { method: "cod" }
                      ]
                    },
                    upi_secondary: {
                      name: "Pay Online via UPI (Fast & Secure)",
                      instruments: [
                        { method: "upi" }
                      ]
                    },
                    other_methods: {
                      name: "Cards & Netbanking",
                      instruments: [
                        { method: "card" },
                        { method: "netbanking" }
                      ]
                    }
                  },
                  sequence: [
                    "block.cod_primary",
                    "block.upi_secondary",
                    "block.other_methods"
                  ],
                  preferences: {
                    show_default_blocks: false
                  }
                };
              } else {
                // Scenario 2: Customer selected UPI (or cart items restrict COD).
                // 1. UPI is placed at the very top (#1 position) with 10% instant discount applied.
                // 2. COD is placed below if eligible, or strictly hidden if UPI discount / no-COD applies.
                // 3. Cards & Netbanking placed next.
                displayConfig = {
                  blocks: {
                    upi_primary: {
                      name: isUpiDiscountActive ? "Pay via UPI (⚡ 10% Instant Off Applied)" : "Pay via UPI (Fast & Secure)",
                      instruments: [
                        { method: "upi" }
                      ]
                    },
                    ...(!shouldBlockCod ? {
                      cod_secondary: {
                        name: "Cash on Delivery (Full Price)",
                        instruments: [
                          { method: "cod" }
                        ]
                      }
                    } : {}),
                    other_methods: {
                      name: "Cards & Netbanking",
                      instruments: [
                        { method: "card" },
                        { method: "netbanking" }
                      ]
                    }
                  },
                  sequence: [
                    "block.upi_primary",
                    ...(!shouldBlockCod ? ["block.cod_secondary"] : []),
                    "block.other_methods"
                  ],
                  preferences: {
                    show_default_blocks: false
                  },
                  ...(shouldBlockCod ? { hide: [{ method: "cod" }] } : {})
                };
              }

              rzpOptions.config = {
                display: displayConfig
              };
              rzpOptions.theme = {
                color: "#166534"
              };

              const rzp = new window.Razorpay(rzpOptions);
              rzp.open();
              hideLoaderWhenRazorpayVisible();
              return; // Fast path successful!
            }
          }
        }
      } catch(magicErr) {
        console.warn("⚠️ Razorpay Magic Checkout fast path failed, transitioning to Storefront fallback:", magicErr);
      }

      // 🛡️ FALLBACK PATH: Standard Shopify Storefront API GraphQL cartCreate
      // Format lines for Shopify Storefront API
      const lines = items
        .filter(i => i.id && typeof i.id === 'string' && (i.id.includes('gid://shopify/ProductVariant/') || !isNaN(Number(i.id))))
        .map(i => {
          const merchandiseId = i.id.includes('gid://shopify/ProductVariant/') ? i.id : `gid://shopify/ProductVariant/${i.id}`;
          return { merchandiseId, quantity: Math.max(1, Math.min(10, parseInt(i.quantity) || 1)) };
        });

      if (lines.length > 0) {
        const mutation = `
          mutation cartCreate($input: CartInput!) @inContext(country: IN) {
            cartCreate(input: $input) {
              cart {
                id
                checkoutUrl
              }
              userErrors {
                field
                message
              }
            }
          }
        `;

        try {
          const cartInput = { lines };
          if (cartAttributes.length > 0) {
            cartInput.attributes = cartAttributes;
          }
          if (attributionNote) cartInput.note = attributionNote;

          const response = await fetch(`https://${DOMAIN}/api/2024-01/graphql.json`, {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json',
              'X-Shopify-Storefront-Access-Token': TOKEN,
            },
            body: JSON.stringify({
              query: mutation,
              variables: { input: cartInput }
            })
          });

          const data = await response.json();
          let checkoutUrl = data?.data?.cartCreate?.cart?.checkoutUrl;

          if (checkoutUrl) {
            const discountToApply = discountCodeToSend;
            if (discountToApply && !checkoutUrl.includes('discount=')) {
              const sep = checkoutUrl.includes('?') ? '&' : '?';
              checkoutUrl = `${checkoutUrl}${sep}discount=${encodeURIComponent(discountToApply)}`;
            }
            clearTimeout(recoveryTimer);
            window.location.href = checkoutUrl;
          } else {
            clearTimeout(recoveryTimer);
            window.location.href = `https://${DOMAIN}/cart`;
          }
        } catch (err) {
          console.error("❌ Shopify checkout network error:", err);
          clearTimeout(recoveryTimer);
          resetCheckoutBtn();
          window.location.href = `https://${DOMAIN}/cart`;
        }
      } else {
        clearTimeout(recoveryTimer);
        window.location.href = `https://${DOMAIN}/cart`;
      }
    }

        // 🌟 Silicon Valley 1-Click Fast Checkout: Bypasses cart drawer friction for mobile & high-intent buyers
    window.directCheckoutItem = async function(product) {
      if (!product || !product.id) return;
      if (product.paymentMode) {
        try { localStorage.setItem('sujata_selected_payment_mode', product.paymentMode); } catch(e) {}
      }
      const safeQty = Math.max(1, Math.min(10, parseInt(product.quantity) || 1));
      const safePrice = Math.max(1, parseInt(product.price) || 299);
      const item = {
        id: product.id,
        title: product.title || 'Pure Spirulina Formulation',
        subtitle: product.subtitle || '100% Pure Cold-Pressed',
        price: safePrice,
        image: product.image || '/spirulina-bottle.png',
        quantity: safeQty,
        noCod: !!product.noCod,
        handle: product.handle
      };

      if (typeof window.dispatchStoreEvent === 'function') {
        window.dispatchStoreEvent('AddToCart', {
          id: product.id,
          title: product.title,
          price: safePrice,
          quantity: safeQty
        });
      }

      // Immediately initiate checkout for this item only
      buyNowItems = [item];
      await handleCheckout({ preventDefault: () => {} });
    };
    window.triggerSujataCheckout = handleCheckout;
    document.addEventListener('click', (e) => {
      // Close Cart
      if (e.target.closest('#close-cart-btn') || e.target.id === 'cart-overlay') {
        window.closeSujataCart();
      }

      // Open Cart Trigger
      if (e.target.closest('#cart-drawer-trigger') || e.target.closest('.open-cart-trigger')) {
        e.preventDefault();
        window.openSujataCart();
      }

      // ⚡ Cart Payment Mode Switcher Clicks
      const tabUpiClick = e.target.closest('#cart-tab-upi');
      if (tabUpiClick) {
        e.preventDefault();
        try { localStorage.setItem('sujata_selected_payment_mode', 'upi'); } catch(e) {}
        window.renderSujataCart();
      }

      const tabCodClick = e.target.closest('#cart-tab-cod');
      if (tabCodClick) {
        e.preventDefault();
        const items = getLocalCart();
        const drawerEl = document.getElementById('cart-drawer');
        let noCodList = ["sujata-spiruglow-bath-soap"];
        try {
          const raw = drawerEl?.getAttribute('data-no-cod-handles');
          if (raw) noCodList = JSON.parse(raw);
        } catch(e) {}

        const isItemNoCod = (item) => {
          if (item.noCod === true) return true;
          if (item.handle && noCodList.includes(item.handle)) return true;
          if (item.title && /soap|spiruglow/i.test(item.title)) return true;
          return false;
        };

        const hasOnlyNoCodItems = items.length > 0 && items.every(item => isItemNoCod(item));
        if (hasOnlyNoCodItems) {
          const noticeEl = document.getElementById('cart-cod-threshold-notice');
          if (noticeEl) {
            noticeEl.classList.remove('hidden');
            noticeEl.classList.add('ring-2', 'ring-amber-500', 'animate-pulse');
            setTimeout(() => {
              noticeEl.classList.remove('ring-2', 'ring-amber-500', 'animate-pulse');
            }, 1800);
          }
          return;
        }
        try { localStorage.setItem('sujata_selected_payment_mode', 'cod'); } catch(e) {}
        window.renderSujataCart();
      }

      // Quantity buttons (+ / -)
      const qtyBtn = e.target.closest('.cart-qty-btn');
      if (qtyBtn) {
        const id = qtyBtn.getAttribute('data-id');
        const action = qtyBtn.getAttribute('data-action');
        const items = getLocalCart();
        const item = items.find(i => i.id === id);

        if (item) {
          if (action === 'inc') {
            item.quantity = Math.min(10, (item.quantity || 1) + 1);
          } else if (action === 'dec') {
            item.quantity = (item.quantity || 1) - 1;
            if (item.quantity <= 0) {
              const idx = items.indexOf(item);
              items.splice(idx, 1);
            }
          }
          saveLocalCart(items);
          window.renderSujataCart();
        }
      }

      // Remove button
      const removeBtn = e.target.closest('.cart-remove-btn');
      if (removeBtn) {
        const id = removeBtn.getAttribute('data-id');
        let items = getLocalCart();
        items = items.filter(i => i.id !== id);
        saveLocalCart(items);
        window.renderSujataCart();
      }

      // Universal "Add to Cart" / "Add to Routine" Clicks (Catalog Cards / Bundles)
      const atcBtn = e.target.closest('.add-to-cart-btn') || e.target.closest('#add-to-cart-btn');
      if (atcBtn && !e.target.closest('#magnetic-btn-wrapper') && !e.target.closest('#sticky-atc-btn')) {
        e.preventDefault();
        
        // Find parent product card data if available
        const card = atcBtn.closest('.product-card-item') || atcBtn.closest('#welcome-kit-builder');
        let title = atcBtn.getAttribute('data-title');
        let price = parseInt(atcBtn.getAttribute('data-price')) || 0;
        let image = atcBtn.getAttribute('data-image');
        let id = atcBtn.getAttribute('data-variant-id') || ('item_' + Date.now());

        if (card) {
          if (!title) {
            const titleEl = card.querySelector('h3, h2');
            if (titleEl) title = titleEl.innerText.trim();
          }
          if (!price) {
            const priceEl = card.querySelector('.font-extrabold, .font-black');
            if (priceEl) {
              const cleaned = priceEl.innerText.replace(/[^0-9]/g, '');
              if (cleaned) price = parseInt(cleaned);
            }
          }
          if (!image) {
            const imgEl = card.querySelector('img');
            if (imgEl) image = imgEl.src;
          }
        }

        // Fallback default
        if (!title) title = "Sujata Spirulina Daily Ritual";
        if (!price || price === 0) price = 799;
        if (!image) image = "/spirulina-bottle.png";

        window.addItemToLocalCart({
          id: id,
          title: title,
          price: price,
          image: image,
          quantity: 1
        });
      }

      // Checkout Action Click
      if (e.target.closest('#checkout-action-btn')) {
        handleCheckout(e);
      }

      // WhatsApp order (no OTP): pre-filled message with the cart, opened in WhatsApp
      const waBtn = e.target.closest('#cart-whatsapp-order-btn');
      if (waBtn) {
        const items = getLocalCart();
        if (!items.length) return;
        const total = items.reduce((sum, it) => sum + it.price * it.quantity, 0);
        const lines = items.map(it => `• ${it.title} × ${it.quantity} — ${formatINR(it.price * it.quantity)}`);
        const msg = [
          'Namaste Sujata Nutrilive, I would like to order:',
          ...lines,
          `Total: ${formatINR(total)} (Cash on Delivery) or ${formatINR(Math.round(total * 0.9))} with UPI`,
          '',
          'Name:',
          'Full address with pincode:'
        ].join('\n');
        if (typeof window.dispatchStoreEvent === 'function') {
          window.dispatchStoreEvent('Contact', { channel: 'WhatsApp Order (Cart)', total: total });
        }
        const num = waBtn.getAttribute('data-wa') || '919834783503';
        window.location.href = `https://wa.me/${num}?text=${encodeURIComponent(msg)}`;
      }
    });

    // 🚀 Silicon Valley Standard: Back-Forward Cache (bfcache) & Page Lifecycle Recovery
    // When a user hits the browser Back button from Shopify checkout, instant restoration happens!
    // `persisted` only: on a normal load `pageshow` also fires, and init() below already renders.
    window.addEventListener('pageshow', (event) => {
      if (!event.persisted) return;
      resetCheckoutBtn();
      window.renderSujataCart();
    });

    // When tab becomes active / visible again (e.g. after returning from payment/app)
    document.addEventListener('visibilitychange', () => {
      if (document.visibilityState === 'visible') {
        resetCheckoutBtn();
        window.renderSujataCart();
      }
    });

    window.addEventListener('focus', () => {
      resetCheckoutBtn();
    });

    // Cross-tab Synchronization
    window.addEventListener('storage', (e) => {
      if (e.key === 'sujata_cart_items') {
        resetCheckoutBtn();
        window.renderSujataCart();
      }
    });

    // Custom Event Listener for Global Dispatch
    window.addEventListener('cart-add-item', (e) => {
      if (e.detail) {
        window.addItemToLocalCart(e.detail);
      }
    });

    // Initialize on page load
    function init() {
      resetCheckoutBtn();
      window.renderSujataCart();
      syncCartPrices(true);
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', init);
    } else {
      init();
    }

  })();
</script>