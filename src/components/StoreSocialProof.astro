---
// src/components/StoreSocialProof.astro
// 🏛️ Silicon Valley "Clean Editorial Split" Architecture (Oct 2026)
// MasterClass & Apple Health Aesthetic: Zero clutter on thumbnails, clean editorial white card below

interface VideoStory {
  id: string;
  videoId: string;
  category: string;
  filterKey: string;
  duration: string;
  rating: number;
  highlight: string;
  quote: string;
  patientName: string;
  location: string;
  posterUrl: string;
  productTitle: string;
  productPrice: string;
  productHandle: string;
}

const videoStories: VideoStory[] = [
  {
    id: "sciatica-relief",
    videoId: "RrlZeX3CyRk",
    category: "Joint & Sciatica",
    filterKey: "sciatica",
    duration: "1:15",
    rating: 5,
    highlight: "15-Year Chronic Sciatica Completely Relieved",
    quote: "After trying multiple injections and pain tablets with no relief, the Sujata Spirulina + Sea Buckthorn protocol completely stopped the nerve pinching and lower back stiffness.",
    patientName: "Verified Patient Review",
    location: "Age 58 • Maharashtra",
    posterUrl: "https://i.ytimg.com/vi/RrlZeX3CyRk/hqdefault.jpg",
    productTitle: "Spirulina + Sea Buckthorn Combo",
    productPrice: "₹1,299",
    productHandle: "/product/sujata-spirulina-sea-buckthorn-combo-pack"
  },
  {
    id: "glass-skin-acne",
    videoId: "M51vkSh7JLE",
    category: "Skin & Glow",
    filterKey: "skin",
    duration: "0:15",
    rating: 5,
    highlight: "Acne & Dark Spots Cleared in 45 Days",
    quote: "Stubborn hormonal breakouts and dark marks refused to fade with chemical creams. The Spirulina Korean Cream repaired my skin barrier and gave a real natural glow.",
    patientName: "Pooja S. (Verified Buyer)",
    location: "Age 26 • Pune",
    posterUrl: "https://i.ytimg.com/vi/M51vkSh7JLE/hqdefault.jpg",
    productTitle: "Spirulina Korean Glow Cream",
    productPrice: "₹599",
    productHandle: "/product/sujata-spirulina-korean-cream"
  },
  {
    id: "daily-energy-vitality",
    videoId: "gMis3c4ivKo",
    category: "Energy & Gut",
    filterKey: "energy",
    duration: "1:20",
    rating: 5,
    highlight: "Zero Afternoon Fatigue & Acid Reflux Gone",
    quote: "I used to wake up sluggish with constant acid reflux and bloating. Within 3 weeks on pure cold-pressed spirulina, digestion smoothed out and energy stays steady till late night.",
    patientName: "Sandeep P. (Verified Buyer)",
    location: "Age 42 • Nashik",
    posterUrl: "https://i.ytimg.com/vi/gMis3c4ivKo/hqdefault.jpg",
    productTitle: "100% Pure Spirulina Capsules",
    productPrice: "₹699",
    productHandle: "/product/sujata-spirulina-capsules"
  },
  {
    id: "doctor-authority",
    videoId: "ugm6QqndEzQ",
    category: "Doctor Backed",
    filterKey: "doctors",
    duration: "1:36",
    rating: 5,
    highlight: "Farm-Fresh Pure Algae Trusted by 100+ Doctors",
    quote: "Grown in our own bio-secure closed ponds in Nashik without synthetic binders. Certified under FSSAI and ICP-MS lab tests with heavy metals below 0.01 ppm.",
    patientName: "Yash Suryavanshi (Founder)",
    location: "Nashik Cultivation Facility",
    posterUrl: "https://i.ytimg.com/vi/ugm6QqndEzQ/hqdefault.jpg",
    productTitle: "Spirulina Cold-Pressed Tablets",
    productPrice: "₹699",
    productHandle: "/product/sujata-spirulina-tablets"
  }
];

// Rich Google Search Schema (VideoObject & Review for AI & SEO)
const socialProofSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Product",
      "name": "Sujata Nutrilive Organic Superfoods",
      "aggregateRating": {
        "@type": "AggregateRating",
        "ratingValue": "4.9",
        "reviewCount": "50000",
        "bestRating": "5",
        "worstRating": "1"
      },
      "review": videoStories.map((story) => ({
        "@type": "Review",
        "author": { "@type": "Person", "name": story.patientName },
        "reviewRating": { "@type": "Rating", "ratingValue": "5", "bestRating": "5" },
        "reviewBody": `${story.highlight} - ${story.quote}`,
        "itemReviewed": {
          "@type": "Product",
          "name": story.productTitle
        }
      }))
    },
    ...videoStories.map((story) => ({
      "@type": "VideoObject",
      "name": story.highlight,
      "description": story.quote,
      "thumbnailUrl": [story.posterUrl],
      "uploadDate": "2026-10-10",
      "contentUrl": `https://www.youtube.com/watch?v=${story.videoId}`,
      "embedUrl": `https://www.youtube-nocookie.com/embed/${story.videoId}`,
      "publisher": {
        "@type": "Organization",
        "name": "Sujata Nutrilive",
        "logo": { "@type": "ImageObject", "url": "https://www.sujatanutrilive.com/favicon.svg" }
      }
    }))
  ]
};
---

<!-- 🎯 Google & AI Engine Schema Injection -->
<script type="application/ld+json" set:html={JSON.stringify(socialProofSchema)} />

<section id="social-proof-engine" class="relative bg-[#FCFBF7] py-20 lg:py-28 font-sans selection:bg-[#166534] selection:text-white border-t border-b border-gray-100 text-[#111827] overflow-hidden z-10">
  
  <div class="max-w-[92rem] mx-auto px-5 md:px-8 lg:px-12 relative z-10">
    
    <!-- ==========================================
        ZONE 1: CLEAN LUXURY EDITORIAL HEADER
        ========================================== -->
    <div class="flex flex-col items-center text-center mb-12 sm:mb-16">
      
      <!-- Stars & Verified Rating Badge -->
      <div class="inline-flex items-center gap-3 mb-4 bg-white px-5 py-2 rounded-full border border-gray-200/70 shadow-sm">
        <div class="flex gap-1 text-[#D97706]">
          {[...Array(5)].map(() => (
            <svg class="w-4 h-4 fill-current" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
          ))}
        </div>
        <span class="text-sm font-bold text-[#111827] font-sans">4.9/5.0</span>
        <div class="w-1 h-1 bg-gray-300 rounded-full"></div>
        <span class="text-xs font-bold text-gray-500 uppercase tracking-widest font-sans">50,000+ Verified Buyers</span>
      </div>

      <h2 class="text-3xl sm:text-5xl lg:text-6xl font-serif font-normal text-[#111827] tracking-tight mb-4">
        Real People. <span class="italic text-[#166534]">Real Transformations.</span>
      </h2>
      
      <p class="text-gray-600 text-sm sm:text-base max-w-2xl mx-auto leading-relaxed font-sans">
        Watch authentic, unscripted recovery journeys and clinical results shared directly by verified patients and daily users.
      </p>

      <!-- Category Filter Pills -->
      <div class="flex flex-wrap items-center justify-center gap-2.5 mt-8" id="video-filter-group">
        <button data-filter="all" class="video-filter-btn px-6 py-2.5 rounded-full bg-[#111827] text-white text-xs font-bold shadow-sm transition-all touch-manipulation">All Stories</button>
        <button data-filter="sciatica" class="video-filter-btn px-6 py-2.5 rounded-full bg-white border border-gray-200 text-gray-700 text-xs font-bold hover:border-gray-400 shadow-sm transition-all touch-manipulation">🦵 Joint & Sciatica</button>
        <button data-filter="skin" class="video-filter-btn px-6 py-2.5 rounded-full bg-white border border-gray-200 text-gray-700 text-xs font-bold hover:border-gray-400 shadow-sm transition-all touch-manipulation">✨ Glass Skin & Acne</button>
        <button data-filter="energy" class="video-filter-btn px-6 py-2.5 rounded-full bg-white border border-gray-200 text-gray-700 text-xs font-bold hover:border-gray-400 shadow-sm transition-all touch-manipulation">⚡ Energy & Digestion</button>
        <button data-filter="doctors" class="video-filter-btn px-6 py-2.5 rounded-full bg-white border border-gray-200 text-gray-700 text-xs font-bold hover:border-gray-400 shadow-sm transition-all touch-manipulation">🩺 Doctor Backed</button>
      </div>

    </div>

    <!-- ==========================================
        ZONE 2: 4 CLEAN EDITORIAL CARDS (No Khichadi)
        ========================================== -->
    <div id="video-stories-track" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 lg:gap-8 pb-8 scroll-smooth">
      
      {videoStories.map((story) => (
        <div 
          data-category={story.filterKey}
          data-video-id={story.videoId}
          data-video-title={story.highlight}
          data-video-quote={story.quote}
          data-product-title={story.productTitle}
          data-product-price={story.productPrice}
          data-product-url={story.productHandle}
          class="video-story-card bg-white rounded-3xl overflow-hidden border border-gray-200/70 shadow-[0_4px_25px_rgba(0,0,0,0.04)] hover:shadow-[0_15px_35px_rgba(22,101,52,0.1)] transition-all duration-300 group flex flex-col cursor-pointer"
        >
          <!-- TOP 60%: CLEAN VIDEO THUMBNAIL (100% Uncluttered Human Face) -->
          <div class="relative aspect-[4/3] w-full overflow-hidden bg-gray-900">
            <img 
              src={story.posterUrl} 
              alt={story.highlight}
              loading="lazy"
              decoding="async"
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500 opacity-95"
            />

            <!-- Subtle Vignette Only -->
            <div class="absolute inset-0 bg-black/15 group-hover:bg-black/5 transition-colors"></div>

            <!-- Single Minimalist Duration Pill (Top Right) -->
            <div class="absolute top-3.5 right-3.5 z-10">
              <span class="bg-black/60 backdrop-blur-md text-white/90 px-2.5 py-1 rounded-full text-[11px] font-mono font-medium border border-white/20 flex items-center gap-1">
                <span class="w-1.5 h-1.5 rounded-full bg-[#10B981] animate-pulse"></span>
                {story.duration}
              </span>
            </div>

            <!-- Pure Minimalist Play Button (Center) -->
            <div class="absolute inset-0 flex items-center justify-center z-10">
              <div class="w-13 h-13 sm:w-14 sm:h-14 rounded-full bg-white/95 text-[#166534] flex items-center justify-center shadow-lg backdrop-blur-sm group-hover:scale-115 group-hover:bg-white transition-all duration-300">
                <svg class="w-6 h-6 fill-current translate-x-0.5" viewBox="0 0 24 24">
                  <path d="M8 5v14l11-7z"/>
                </svg>
              </div>
            </div>
          </div>

          <!-- BOTTOM 40%: CLEAN EDITORIAL CONTENT (Breathing Room on Crisp White) -->
          <div class="p-6 flex flex-col flex-1 justify-between bg-white border-t border-gray-100">
            
            <div>
              <!-- Gold Stars -->
              <div class="flex gap-1 text-[#D97706] mb-2.5">
                {[...Array(story.rating)].map(() => (
                  <svg class="w-4 h-4 fill-current" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
                ))}
              </div>

              <!-- Punchy Headline -->
              <h3 class="text-base font-bold text-[#111827] leading-snug group-hover:text-[#166534] transition-colors mb-2">
                "{story.highlight}"
              </h3>

              <!-- Patient Line -->
              <p class="text-xs text-gray-500 font-medium">
                {story.patientName} • <span class="text-gray-400">{story.location}</span>
              </p>
            </div>

            <!-- Subtle Product Link at Bottom -->
            <div class="pt-4 mt-4 border-t border-gray-100 flex items-center justify-between text-xs">
              <span class="font-bold text-[#166534] group-hover:underline flex items-center gap-1">
                {story.productTitle}
              </span>
              <span class="font-mono text-gray-500">{story.productPrice} ➔</span>
            </div>

          </div>

        </div>
      ))}

    </div>

    <!-- ==========================================
        ZONE 3: REFINED TRUST FOOTER
        ========================================== -->
    <div class="mt-8 pt-8 border-t border-gray-200/80 flex flex-wrap items-center justify-between gap-4 text-xs text-gray-500">
      <div class="flex items-center gap-2">
        <svg class="w-4 h-4 text-[#166534]" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/></svg>
        <span class="font-medium text-gray-700">100% Verified Customer & Patient Stories (Zero Scripted Actors)</span>
      </div>
      <div class="flex items-center gap-4 text-gray-600">
        <span>FSSAI Lic. #11521999000284</span>
        <span>•</span>
        <span>Nashik Bio-Dome Facility</span>
        <span>•</span>
        <a href="#product-ecosystem" class="text-[#166534] hover:underline font-bold">Explore Full Catalog ➔</a>
      </div>
    </div>

  </div>

  <!-- ==========================================
      🎥 SILICON VALLEY DYNAMIC VIDEO MODAL
      ========================================== -->
  <div 
    id="video-story-modal" 
    class="fixed inset-0 z-[10000] bg-black/80 backdrop-blur-md opacity-0 pointer-events-none transition-all duration-300 flex items-center justify-center p-3 sm:p-6"
    role="dialog"
    aria-modal="true"
    aria-label="Customer Video Story Player"
  >
    <div class="relative w-full max-w-lg bg-[#111827] rounded-3xl overflow-hidden shadow-2xl border border-gray-700/50 flex flex-col max-h-[92vh]">
      
      <!-- Modal Close Button -->
      <button 
        id="close-story-modal" 
        aria-label="Close Video" 
        class="absolute top-3 right-3 z-30 w-10 h-10 rounded-full bg-black/60 hover:bg-black text-white flex items-center justify-center border border-white/20 transition-all cursor-pointer touch-manipulation"
      >
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M6 18L18 6M6 6l12 12"/></svg>
      </button>

      <!-- Video Player Frame Container -->
      <div id="modal-video-frame-container" class="relative aspect-video w-full bg-black flex items-center justify-center">
        <!-- Dynamic Iframe injected on demand -->
      </div>

      <!-- Modal Bottom Conversion Tray -->
      <div class="p-5 bg-[#1F2937] border-t border-gray-700 flex flex-col gap-3">
        <h4 id="modal-story-title" class="text-white text-base sm:text-lg font-bold leading-tight"></h4>
        <p id="modal-story-quote" class="text-gray-300 text-xs sm:text-sm leading-relaxed"></p>
        
        <!-- Direct Buy Button -->
        <a 
          id="modal-product-cta" 
          href="#" 
          class="w-full py-3.5 px-6 rounded-2xl bg-[#166534] hover:bg-[#15803d] text-white font-bold text-sm flex items-center justify-between shadow-lg transition-all"
        >
          <span id="modal-product-title">Order Featured Formulation</span>
          <span class="flex items-center gap-1">
            <span id="modal-product-price"></span>
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
          </span>
        </a>
      </div>

    </div>
  </div>

</section>

<style>
  .no-scrollbar::-webkit-scrollbar { display: none; }
  .no-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }
</style>

<script>
  function initVideoStoriesEngine() {
    // 1. Filter Buttons
    const filterBtns = document.querySelectorAll('.video-filter-btn');
    const cards = document.querySelectorAll('.video-story-card');

    filterBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        const filter = btn.getAttribute('data-filter');

        filterBtns.forEach(b => {
          b.classList.remove('bg-[#111827]', 'text-white');
          b.classList.add('bg-white', 'text-gray-700', 'border', 'border-gray-200');
        });

        btn.classList.remove('bg-white', 'text-gray-700', 'border', 'border-gray-200');
        btn.classList.add('bg-[#111827]', 'text-white');

        cards.forEach(card => {
          const cardEl = card as HTMLElement;
          const cat = cardEl.getAttribute('data-category');
          if (filter === 'all' || cat === filter) {
            cardEl.style.display = 'flex';
          } else {
            cardEl.style.display = 'none';
          }
        });
      });
    });

    // 2. Dynamic Video Modal Engine
    const modal = document.getElementById('video-story-modal');
    const closeBtn = document.getElementById('close-story-modal');
    const frameContainer = document.getElementById('modal-video-frame-container');
    const titleEl = document.getElementById('modal-story-title');
    const quoteEl = document.getElementById('modal-story-quote');
    const productTitleEl = document.getElementById('modal-product-title');
    const productPriceEl = document.getElementById('modal-product-price');
    const productCtaEl = document.getElementById('modal-product-cta') as HTMLAnchorElement | null;

    const openModal = (card: HTMLElement) => {
      if (!modal || !frameContainer) return;
      const videoId = card.getAttribute('data-video-id');
      const title = card.getAttribute('data-video-title') || '';
      const quote = card.getAttribute('data-video-quote') || '';
      const productTitle = card.getAttribute('data-product-title') || '';
      const productPrice = card.getAttribute('data-product-price') || '';
      const productUrl = card.getAttribute('data-product-url') || '#';

      if (titleEl) titleEl.textContent = `"${title}"`;
      if (quoteEl) quoteEl.textContent = quote;
      if (productTitleEl) productTitleEl.textContent = `Order ${productTitle}`;
      if (productPriceEl) productPriceEl.textContent = productPrice;
      if (productCtaEl) productCtaEl.href = productUrl;

      // On-demand iframe injection (Zero performance penalty on initial page load)
      frameContainer.innerHTML = `
        <iframe 
          src="https://www.youtube-nocookie.com/embed/${videoId}?autoplay=1&rel=0&modestbranding=1&playsinline=1" 
          title="${title}" 
          class="w-full h-full border-0" 
          allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" 
          allowfullscreen>
        </iframe>
      `;

      modal.classList.remove('opacity-0', 'pointer-events-none');
      modal.classList.add('opacity-100', 'pointer-events-auto');
      document.body.style.overflow = 'hidden';
    };

    const closeModal = () => {
      if (!modal || !frameContainer) return;
      modal.classList.remove('opacity-100', 'pointer-events-auto');
      modal.classList.add('opacity-0', 'pointer-events-none');
      
      // Destroy iframe immediately to stop audio and conserve mobile RAM
      frameContainer.innerHTML = '';
      document.body.style.overflow = '';
    };

    cards.forEach(card => {
      card.addEventListener('click', () => openModal(card as HTMLElement));
    });

    closeBtn?.addEventListener('click', closeModal);
    modal?.addEventListener('click', (e) => {
      if (e.target === modal) closeModal();
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && modal?.classList.contains('opacity-100')) {
        closeModal();
      }
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initVideoStoriesEngine);
  } else {
    initVideoStoriesEngine();
  }
  document.addEventListener('astro:page-load', initVideoStoriesEngine);
</script>