<!-- 🛍️ ZONE 2: Core Trio (99% of revenue) + Explore Rail (rest of catalogue). Single SSR render, zero client fetch. -->
<section id="product-ecosystem" class="pt-7 sm:pt-12 pb-14 md:py-20 bg-[#FBF9F5] text-[#111827] relative">
  <div id="bundle-offers" class="absolute -top-24 left-0 w-full pointer-events-none"></div>
  <div class="max-w-7xl mx-auto px-2.5 sm:px-6 lg:px-12">
    {/* 1. HEADER */}
    <div class="mb-4 sm:mb-8">
      <span class="text-[9.5px] sm:text-[11px] font-bold uppercase tracking-[0.2em] text-[#166534] block mb-1 font-sans">
        Lab-Tested Pure Nutrition
      </span>
      <h2 class="text-2xl sm:text-4xl md:text-5xl font-serif font-normal text-[#111827] tracking-tight leading-tight">
        Our <span class="italic text-[#166534]">Bestsellers.</span>
      </h2>
    </div>

    {/* 2a. DEGRADED STATE — Shopify unreachable: static links to core PDPs (no prices shown) */}
    {coreProducts.length === 0 && (
      <div class="bg-white rounded-2xl border border-gray-200 p-5 sm:p-6 text-center">
        <p class="text-sm text-gray-600 mb-4">Live prices are loading slowly right now. Choose a product to see today's price:</p>
        <div class="flex flex-col sm:flex-row gap-2.5 justify-center">
          <a href="/product/sujata-spirulina-sea-buckthorn-combo-pack" class="bg-[#166534] hover:bg-[#15803d] text-white font-bold text-sm px-5 py-3 rounded-xl">Spirulina + Sea Buckthorn Combo</a>
          <a href="/product/sujata-spirulina-capsules" class="bg-gray-100 hover:bg-gray-200 border border-gray-200 text-gray-800 font-bold text-sm px-5 py-3 rounded-xl">Spirulina Capsules</a>
          <a href="/product/sujata-sea-buckthorn-capsules" class="bg-gray-100 hover:bg-gray-200 border border-gray-200 text-gray-800 font-bold text-sm px-5 py-3 rounded-xl">Sea Buckthorn Capsules</a>
        </div>
      </div>
    )}

    {/* 2. CORE TRIO — mobile: anchor full-width + 2-col; desktop: 3-col */}
    <div class="grid grid-cols-2 md:grid-cols-3 gap-2.5 sm:gap-4 lg:gap-6" id="shop-products-grid">
      {coreProducts.map((product: any, index: number) => {
        const isAnchor = index === 0;
        const category = getProductCategory(product);
        const priceAmount = product.priceRange?.minVariantPrice?.amount || product.variants?.edges[0]?.node?.price?.amount || "799";
        const numPrice = parseFloat(priceAmount) || 799;
        const meta = getProductBadgeAndBenefit(product, numPrice);
        const productImg = getImageUrl(product);
        const cardImg = product.card?.url || productImg;
        const showLabChip = isSpirulinaProduct(product);

        const rawVariants = product.variants?.edges?.map((e: any) => e.node) || [];
        const hasMultipleVariants = rawVariants.length > 1;
        const firstVariant = rawVariants[0];
        const initialPrice = firstVariant?.price?.amount ? parseFloat(firstVariant.price.amount) : numPrice;
        const initialCompare = firstVariant?.compareAtPrice?.amount ? parseFloat(firstVariant.compareAtPrice.amount) : 0;

        return (
          <div class={`product-card-item bg-white rounded-2xl sm:rounded-3xl p-2.5 sm:p-4 md:p-5 border border-gray-200/90 shadow-sm hover:shadow-md hover:border-[#166534]/40 transition-all flex flex-col justify-between group ${isAnchor ? 'col-span-2 md:col-span-1' : ''}`} data-category={category} data-tier="core">

            <div>
              {/* Product Visual Container with Floating Badges */}
              <a href={`/product/${product.handle}`} class={`block relative bg-[#FAF9F6] rounded-xl sm:rounded-2xl p-2 sm:p-3 mb-2 sm:mb-3 overflow-hidden group-hover:bg-emerald-50/30 transition-colors flex items-center justify-center ${isAnchor ? 'aspect-[16/10] md:aspect-square' : 'aspect-square'}`}>
                {/* Top-Left Trust Badge */}
                <span class="absolute top-1.5 left-1.5 sm:top-2.5 sm:left-2.5 z-10 text-[8px] sm:text-[9.5px] font-bold uppercase tracking-wider bg-[#064E3B] text-white px-2 py-0.5 rounded-full shadow-sm">
                  {meta.tag}
                </span>

                <img
                  src={cardImg}
                  alt={product.title}
                  width="640"
                  height="640"
                  class="w-full h-full object-contain drop-shadow-sm group-hover:scale-105 transition-transform duration-500"
                  loading="lazy"
                  decoding="async"
                />

                {/* Proof at point of decision (verified Lilaba report figure only) */}
                {showLabChip && (
                  <span class="absolute bottom-1.5 left-1.5 right-1.5 sm:bottom-2.5 sm:left-2.5 sm:right-auto z-10 text-[8px] sm:text-[9.5px] font-bold text-[#064E3B] bg-white/95 border border-emerald-200 px-2 py-0.5 rounded-full shadow-sm truncate text-center">
                    🔬 Lab-tested · {lab.proteinPct}% protein
                  </span>
                )}
              </a>

              {/* Title with Fixed 2-Line Min-Height for Consistent Symmetry */}
              <a href={`/product/${product.handle}`} class="block mb-0.5">
                <h3 class="text-xs sm:text-sm md:text-base font-bold font-sans text-[#111827] group-hover:text-[#166534] transition-colors leading-tight line-clamp-2 min-h-[2.4em]">
                  {product.title}
                </h3>
              </a>

              {/* Micro-Benefit / Form subtitle */}
              <span class="text-[9.5px] sm:text-xs text-gray-500 font-medium block truncate mb-2">
                {meta.benefit}
              </span>

              {/* In-Card Multi-Variant Pill Selector or Purity Differentiator (Symmetric min-h-[26px]) */}
              {hasMultipleVariants ? (
                <div class="product-variant-pills flex items-center gap-1 mb-1.5 overflow-x-auto no-scrollbar min-h-[44px]">
                  {rawVariants.slice(0, 3).map((v: any, vIdx: number) => {
                    const vPrice = parseFloat(v.price?.amount || "0");
                    const vCompare = v.compareAtPrice?.amount ? parseFloat(v.compareAtPrice.amount) : 0;
                    const shortTitle = v.title
                      .replace(/Tablets/i, 'Tabs')
                      .replace(/Capsules/i, 'Caps')
                      .replace(/\(500mg\)/i, '')
                      .replace(/\(30 Days\)/i, '')
                      .trim();
                    return (
                      <button 
                        type="button" 
                        class="variant-pill-btn group/pill h-11 min-w-[44px] flex items-center justify-center shrink-0 cursor-pointer touch-manipulation"
                        aria-pressed={vIdx === 0 ? 'true' : 'false'}
                        data-variant-id={v.id}
                        data-price={vPrice}
                        data-compare-price={vCompare}
                        data-title={v.title}
                      >
                        <span class={`pill-face text-[8.5px] sm:text-[9.5px] font-bold px-2 py-1 rounded-lg border transition-all whitespace-nowrap ${vIdx === 0 ? 'bg-[#166534] text-white border-[#166534] active-pill shadow-sm' : 'bg-gray-50 text-gray-700 border-gray-200 group-hover/pill:border-gray-400'}`}>
                          {shortTitle}
                        </span>
                      </button>
                    );
                  })}
                </div>
              ) : (
                <div class="min-h-[44px] flex items-center gap-1.5 mb-1.5 text-[8.5px] sm:text-[9.5px] font-mono text-[#166534] bg-emerald-50/70 border border-emerald-100/80 rounded-lg px-2 py-0.5">
                  <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 shrink-0"></span>
                  <span class="truncate font-semibold">{meta.purityDifferentiator}</span>
                </div>
              )}
            </div>

            <div>
              {/* Pricing Line */}
              <div class="flex items-baseline justify-between gap-1 pt-2 sm:pt-2.5 border-t border-gray-100 mb-2 sm:mb-2.5">
                <div class="flex items-baseline gap-1 sm:gap-1.5 flex-wrap">
                  <span class="card-current-price text-sm sm:text-base md:text-lg font-black text-[#111827] font-sans">
                    {formatPrice(initialPrice)}
                  </span>
                  <span class={`card-old-price text-[10px] sm:text-xs text-gray-400 line-through font-sans ${initialCompare > initialPrice ? '' : 'hidden'}`}>
                    ₹{Math.round(initialCompare)}
                  </span>
                </div>
                <span class={`card-save-badge text-[8px] sm:text-[9.5px] font-black text-[#166534] bg-emerald-50 border border-emerald-100/60 px-1.5 py-0.5 rounded font-sans shrink-0 whitespace-nowrap ${initialCompare > initialPrice ? '' : 'hidden'}`}>
                  Save ₹{Math.round(initialCompare - initialPrice)}
                </span>
              </div>

              {/* Delivery Micro-Badge */}
              <div class="block sm:hidden text-[8px] text-[#166534] font-medium bg-emerald-50/70 border border-emerald-100/70 rounded-lg px-1.5 py-0.5 mb-2 truncate text-center">
                🚚 Free COD • Dispatches in 24h
              </div>

              <div class="product-delivery-badge hidden sm:flex items-center justify-between gap-1.5 bg-emerald-50/70 border border-emerald-100 rounded-xl px-2.5 py-1 mb-2.5 text-[9.5px] text-[#064E3B]">
                <div class="flex items-center gap-1 min-w-0">
                  <span class="text-xs">🚚</span>
                  <span class="delivery-date-text truncate text-gray-700 font-medium">Dispatches in 24h</span>
                </div>
                <span class="text-[8.5px] font-bold bg-[#166534] text-white px-1.5 py-0.5 rounded uppercase tracking-wider shrink-0">Express</span>
              </div>

              {/* Dual Action CTAs: 1-Click Buy Now & Add to Routine */}
              <div class="grid grid-cols-12 gap-1.5">
                <button 
                  type="button"
                  class="hub-direct-buy-btn col-span-8 min-h-[44px] bg-[#166534] hover:bg-[#15803d] active:scale-[0.98] text-white py-2 sm:py-2.5 rounded-xl font-black text-[10px] sm:text-xs uppercase tracking-wider transition-all shadow-sm flex items-center justify-center gap-1 cursor-pointer touch-manipulation group/buy"
                  data-variant-id={firstVariant?.id || ('prod_' + index)}
                  data-title={product.title}
                  data-price={initialPrice.toString()}
                  data-image={productImg}
                  data-subtitle={meta.benefit}
                >
                  <span class="hub-btn-spinner hidden w-3 h-3 border-2 border-white border-t-transparent rounded-full animate-spin"></span>
                  <span class="hub-btn-text flex items-center gap-1">
                    <span>⚡ Buy Now</span>
                    <span class="hidden xl:inline text-[9px] font-normal opacity-90">(COD)</span>
                  </span>
                </button>

                <button 
                  type="button"
                  class="hub-add-cart-btn col-span-4 min-h-[44px] bg-gray-100 hover:bg-gray-200 active:scale-[0.98] text-gray-800 border border-gray-200 py-2 sm:py-2.5 rounded-xl font-bold text-[10px] sm:text-xs uppercase tracking-wider transition-all flex items-center justify-center gap-0.5 cursor-pointer touch-manipulation"
                  data-variant-id={firstVariant?.id || ('prod_' + index)}
                  data-title={product.title}
                  data-price={initialPrice.toString()}
                  data-image={productImg}
                  data-subtitle={meta.benefit}
                  title="Add to cart"
                >
                  <span>+ 🛒</span>
                  <span class="hidden sm:inline text-[9.5px]">Cart</span>
                </button>
              </div>

            </div>

          </div>
        );
      })}
    </div>

    {/* 3. EXPLORE RAIL — rest of catalogue. One row on every breakpoint (scroll-snap), pure CSS. */}
    {exploreProducts.length > 0 && (
      <div class="mt-8 sm:mt-12" id="explore-formulations" data-tier="explore">
        <div class="flex items-end justify-between gap-3 mb-3 sm:mb-4">
          <div>
            <span class="text-[9.5px] sm:text-[11px] font-bold uppercase tracking-[0.2em] text-[#166534] block mb-1 font-sans">
              Also from the Sujata Spirulina Lab
            </span>
            <h3 class="text-lg sm:text-2xl md:text-3xl font-serif font-normal text-[#111827] tracking-tight leading-tight">
              More Formulations
            </h3>
          </div>
          <span class="text-[10px] sm:text-xs font-semibold text-gray-500 font-sans whitespace-nowrap">{exploreProducts.length} more · <span class="md:hidden">Swipe</span><span class="hidden md:inline">Scroll</span> →</span>
        </div>

        <div class="flex gap-2.5 sm:gap-4 overflow-x-auto snap-x snap-mandatory scroll-px-2.5 sm:scroll-px-6 md:scroll-px-0 no-scrollbar -mx-2.5 px-2.5 sm:-mx-6 sm:px-6 md:mx-0 md:px-0 pb-1" role="list">
          {exploreProducts.map((product: any) => {
            const firstVariant = product.variants?.edges?.[0]?.node;
            const price = parseFloat(firstVariant?.price?.amount || product.priceRange?.minVariantPrice?.amount || "0");
            const compare = firstVariant?.compareAtPrice?.amount ? parseFloat(firstVariant.compareAtPrice.amount) : 0;
            const meta = getProductBadgeAndBenefit(product, price);
            const productImg = getImageUrl(product);
            const thumbImg = product.thumb?.url || productImg;
            const available = product.availableForSale !== false && firstVariant?.availableForSale !== false;

            return (
              <div role="listitem" class="product-card-item snap-start shrink-0 w-[42%] sm:w-[30%] md:w-[23%] lg:w-[18.5%] bg-white rounded-2xl border border-gray-200/90 shadow-sm hover:shadow-md hover:border-[#166534]/40 transition-all p-2 sm:p-3 flex flex-col group" data-category={getProductCategory(product)} data-tier="explore">
                <a href={`/product/${product.handle}`} class="block relative aspect-square bg-[#FAF9F6] rounded-xl overflow-hidden mb-2 p-2 flex items-center justify-center">
                  {!available && (
                    <span class="absolute top-1.5 left-1.5 z-10 text-[8px] font-bold uppercase tracking-wider bg-gray-700 text-white px-2 py-0.5 rounded-full">Sold out</span>
                  )}
                  <img
                    src={thumbImg}
                    alt={product.title}
                    width="360"
                    height="360"
                    class={`w-full h-full object-contain group-hover:scale-105 transition-transform duration-500 ${available ? '' : 'opacity-60 grayscale'}`}
                    loading="lazy"
                    decoding="async"
                  />
                </a>
                <a href={`/product/${product.handle}`} class="block">
                  <h4 class="text-[11px] sm:text-sm font-bold font-sans text-[#111827] group-hover:text-[#166534] transition-colors leading-tight line-clamp-2 min-h-[2.5em]">
                    {product.title}
                  </h4>
                </a>
                <div class="mt-auto pt-1.5 flex items-center justify-between gap-1">
                  <div class="flex items-baseline gap-1 min-w-0">
                    <span class="text-xs sm:text-sm font-black text-[#111827] font-sans">{formatPrice(price)}</span>
                    {compare > price && (
                      <span class="text-[9px] sm:text-[10px] text-gray-400 line-through font-sans">₹{Math.round(compare)}</span>
                    )}
                  </div>
                  {available && firstVariant?.id && (
                    <button
                      type="button"
                      class="hub-add-cart-btn shrink-0 min-h-[44px] min-w-[44px] inline-flex items-center justify-center bg-gray-100 hover:bg-gray-200 active:scale-[0.98] text-gray-800 border border-gray-200 px-3 py-1 rounded-lg font-bold text-[9.5px] sm:text-[10.5px] uppercase tracking-wider transition-all cursor-pointer touch-manipulation"
                      data-variant-id={firstVariant.id}
                      data-title={product.title}
                      data-price={price.toString()}
                      data-image={productImg}
                      data-subtitle={meta.benefit}
                      title="Add to cart"
                    >
                      + Add
                    </button>
                  )}
                </div>
              </div>
            );
          })}
        </div>
      </div>
    )}

  </div>
</section>

<script is:inline>
  function initShopHubInteractions() {
    // 1. Variant Pill Switching
    document.querySelectorAll('.product-card-item').forEach(card => {
      const pills = card.querySelectorAll('.variant-pill-btn');
      const directBuyBtn = card.querySelector('.hub-direct-buy-btn');
      const addCartBtn = card.querySelector('.hub-add-cart-btn');
      const priceSpan = card.querySelector('.card-current-price');
      const oldPriceSpan = card.querySelector('.card-old-price');
      const saveBadge = card.querySelector('.card-save-badge');

      pills.forEach(pill => {
        pill.addEventListener('click', (e) => {
          e.preventDefault();
          e.stopPropagation();

          pills.forEach(p => {
            p.setAttribute('aria-pressed', 'false');
            const face = p.querySelector('.pill-face');
            face?.classList.remove('bg-[#166534]', 'text-white', 'border-[#166534]', 'active-pill', 'shadow-sm');
            face?.classList.add('bg-gray-50', 'text-gray-700', 'border-gray-200');
          });

          pill.setAttribute('aria-pressed', 'true');
          const activeFace = pill.querySelector('.pill-face');
          activeFace?.classList.remove('bg-gray-50', 'text-gray-700', 'border-gray-200');
          activeFace?.classList.add('bg-[#166534]', 'text-white', 'border-[#166534]', 'active-pill', 'shadow-sm');

          const variantId = pill.getAttribute('data-variant-id');
          const price = parseFloat(pill.getAttribute('data-price') || '0');
          const comparePrice = parseFloat(pill.getAttribute('data-compare-price') || '0');

          if (directBuyBtn) {
            directBuyBtn.setAttribute('data-variant-id', variantId);
            directBuyBtn.setAttribute('data-price', price.toString());
          }
          if (addCartBtn) {
            addCartBtn.setAttribute('data-variant-id', variantId);
            addCartBtn.setAttribute('data-price', price.toString());
          }

          if (priceSpan) {
            priceSpan.innerText = new Intl.NumberFormat('en-IN', { style: 'currency', currency: 'INR', maximumFractionDigits: 0 }).format(price);
          }

          if (comparePrice > price) {
            if (oldPriceSpan) {
              oldPriceSpan.innerText = `₹${Math.round(comparePrice)}`;
              oldPriceSpan.classList.remove('hidden');
            }
            if (saveBadge) {
              saveBadge.innerText = `Save ₹${Math.round(comparePrice - price)}`;
              saveBadge.classList.remove('hidden');
            }
          } else {
            if (oldPriceSpan) oldPriceSpan.classList.add('hidden');
            if (saveBadge) saveBadge.classList.add('hidden');
          }
        });
      });
    });

    // 2. Direct 1-Click Buy Now (Silicon Valley Self-Healing Lifecycle Architecture)
    function resetHubBuyButtons() {
      document.querySelectorAll('.hub-direct-buy-btn').forEach(btn => {
        btn.style.pointerEvents = '';
        btn.removeAttribute('data-busy');
        const spinner = btn.querySelector('.hub-btn-spinner');
        if (spinner) spinner.classList.add('hidden');
        const textSpan = btn.querySelector('.hub-btn-text');
        if (textSpan) {
          textSpan.innerHTML = `
            <span>⚡ Buy Now</span>
            <span class="hidden xl:inline text-[9px] font-normal opacity-90">(COD)</span>
          `;
        }
      });
    }
    window.resetHubBuyButtons = resetHubBuyButtons;

    document.querySelectorAll('.hub-direct-buy-btn').forEach(btn => {
      btn.addEventListener('click', async (e) => {
        e.preventDefault();
        e.stopPropagation();

        if (btn.getAttribute('data-busy') === 'true') return;
        btn.setAttribute('data-busy', 'true');

        const id = btn.getAttribute('data-variant-id');
        const title = btn.getAttribute('data-title');
        const price = parseFloat(btn.getAttribute('data-price')) || 350;
        const image = btn.getAttribute('data-image');
        const subtitle = btn.getAttribute('data-subtitle') || '100% Pure Cold-Pressed';

        const spinner = btn.querySelector('.hub-btn-spinner');
        const textSpan = btn.querySelector('.hub-btn-text');

        spinner?.classList.remove('hidden');
        if (textSpan) textSpan.innerHTML = `<span>Preparing...</span>`;
        btn.style.pointerEvents = 'none';

        // 🛡️ Circuit Breaker: Auto-reset button after 5 seconds if navigation takes long or user cancels
        const circuitBreaker = setTimeout(resetHubBuyButtons, 5000);

        try {
          if (typeof window.directCheckoutItem === 'function') {
            await window.directCheckoutItem({
              id: id,
              title: title,
              price: price,
              image: image,
              subtitle: subtitle,
              quantity: 1
            });
          } else if (typeof window.addItemToLocalCart === 'function') {
            clearTimeout(circuitBreaker);
            window.addItemToLocalCart({
              id: id,
              title: title,
              price: price,
              image: image,
              subtitle: subtitle,
              quantity: 1
            });
            resetHubBuyButtons();
          }
        } catch (err) {
          console.error("Direct checkout error:", err);
          clearTimeout(circuitBreaker);
          resetHubBuyButtons();
        }
      });
    });

    // 🚀 Silicon Valley Standard: Back-Forward Cache (bfcache) & Tab Lifecycle Listeners
    window.addEventListener('pageshow', (e) => { resetHubBuyButtons(); });
    document.addEventListener('visibilitychange', () => { if (document.visibilityState === 'visible') resetHubBuyButtons(); });
    window.addEventListener('focus', resetHubBuyButtons);
    window.addEventListener('popstate', resetHubBuyButtons);
    window.addEventListener('sujata:buttons-reset', resetHubBuyButtons);
    document.addEventListener('astro:page-load', resetHubBuyButtons);
    document.addEventListener('astro:after-swap', resetHubBuyButtons);

    // 3. Quick-Add to Cart
    document.querySelectorAll('.hub-add-cart-btn').forEach(btn => {
      btn.addEventListener('click', (e) => {
        e.preventDefault();
        e.stopPropagation();

        const id = btn.getAttribute('data-variant-id');
        const title = btn.getAttribute('data-title');
        const price = parseFloat(btn.getAttribute('data-price')) || 350;
        const image = btn.getAttribute('data-image');
        const subtitle = btn.getAttribute('data-subtitle') || '100% Pure Cold-Pressed';

        if (typeof window.addItemToLocalCart === 'function') {
          window.addItemToLocalCart({
            id: id,
            title: title,
            price: price,
            image: image,
            subtitle: subtitle,
            quantity: 1
          });
        }

        const origHtml = btn.innerHTML;
        btn.innerHTML = `<span>✓</span>`;
        btn.classList.add('bg-emerald-600', 'text-white', 'border-emerald-600');
        setTimeout(() => {
          btn.innerHTML = origHtml;
          btn.classList.remove('bg-emerald-600', 'text-white', 'border-emerald-600');
        }, 1500);
      });
    });
  }

  function updateDeliveryEstimators() {
    const savedPincode = localStorage.getItem('sujata_pincode') || localStorage.getItem('user_pincode') || '411001';
    const badges = document.querySelectorAll('.product-delivery-badge .delivery-date-text');
    
    // Calculate delivery date (+3 business days)
    const targetDate = new Date();
    targetDate.setDate(targetDate.getDate() + 3);
    if (targetDate.getDay() === 0) targetDate.setDate(targetDate.getDate() + 1); // skip Sunday
    
    const options = { weekday: 'short', month: 'short', day: 'numeric' };
    const dateStr = targetDate.toLocaleDateString('en-IN', options);

    badges.forEach(badge => {
      badge.innerHTML = `Get it by <strong>${dateStr}</strong> (to ${savedPincode})`;
    });
  }

  function initAllShopHub() {
    initShopHubInteractions();
    updateDeliveryEstimators();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initAllShopHub);
  } else {
    initAllShopHub();
  }

  document.addEventListener('astro:page-load', initAllShopHub);

  window.addEventListener('pincode-updated', () => {
    updateDeliveryEstimators();
  });
</script>
