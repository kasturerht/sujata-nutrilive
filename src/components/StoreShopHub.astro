// src/components/StoreShopHub.astro
import StoreBundleBuilder from './StoreBundleBuilder.astro';

const { products = [] } = Astro.props;

// Allow all products exactly in the sequence set in Shopify Admin
const filteredProducts = products;
const shopifyDomain = import.meta.env.PUBLIC_SHOPIFY_STOREFRONT_DOMAIN || "tvczdq-nu.myshopify.com"; 
const storefrontToken = import.meta.env.PUBLIC_SHOPIFY_STOREFRONT_TOKEN || "7e0a0176aede63ce4c6b199e18684018";

function formatPrice(amount: string | number) {
  const num = typeof amount === 'string' ? parseFloat(amount) : amount;
  return new Intl.NumberFormat('en-IN', {
    style: 'currency',
    currency: 'INR',
    maximumFractionDigits: 0
  }).format(num);
}

const productLocalImageMap: Record<string, string> = {
  'sujata-spirulina-powder': '/products/sujata-spirulina-powder-pouch.jpg',
  'spirulin-powder': '/products/sujata-spirulina-powder-pouch.jpg',
  'sujata-spirulina-tablets': '/products/sujata-spirulina-tablets-bottle.jpg',
  'spirulina-tablets': '/products/sujata-spirulina-tablets-bottle.jpg',
  'sujata-spirulina-capsules': '/products/sujata-spirulina-capsules-bottle.jpg',
  'sujata-sea-buckthorn-capsules': '/products/sujata-sea-buckthorn-capsules-bottle.jpg',
  'sujata-plant-based-vitamin-b12': '/products/sujata-plant-based-b12-bottle.jpg',
  'sujata-pure-himalayan-shilajit': '/products/sujata-himalayan-shilajit-bottle.jpg',
  'sujata-moringa-powder': '/products/sujata-moringa-powder-pouch.jpg',
  'sujata-spirulina-facewash': '/products/sujata-spirulina-facewash-bottle.jpg',
  'sujata-spirulina-facepack-powder': '/products/sujata-spirulina-facepack-pouch.jpg',
  'sujata-spiruglow-bath-soap': '/products/sujata-spiruglow-bath-soap-box.jpg',
  'sujata-spirulina-korean-cream': '/products/sujata-spirulina-korean-cream-jar.jpg',
  'sujata-bridal-whitening-cream': '/products/sujata-bridal-whitening-cream-jar.jpg',
  'sujata-spirulina-coconut-hair-oil': '/products/sujata-spirulina-hair-oil-bottle.png',
  'sujata-spirushine-shampoo-conditioner': '/products/sujata-spirushine-shampoo-bottle.jpg',
  'sujata-spirulina-sea-buckthorn-combo': '/products/sujata-combo-spirulina-sea-buckthorn.jpg',
  'sujata-spirulina-sea-buckthorn-combo-pack': '/products/sujata-combo-spirulina-sea-buckthorn.jpg',
};

function getImageUrl(product: any) {
  if (product.featuredImage?.url) return product.featuredImage.url;
  if (product.images?.edges?.[0]?.node?.url) return product.images.edges[0].node.url;
  
  const handle = (product.handle || '').toLowerCase();
  if (productLocalImageMap[handle]) return productLocalImageMap[handle];
  
  const title = (product.title || '').toLowerCase();
  if (title.includes('shampoo')) return '/products/sujata-spirushine-shampoo-bottle.jpg';
  if (title.includes('hair oil') || title.includes('oil')) return '/products/sujata-spirulina-hair-oil-bottle.png';
  if (title.includes('face wash') || title.includes('facewash')) return '/products/sujata-spirulina-facewash-bottle.jpg';
  if (title.includes('face pack') || title.includes('facepack')) return '/products/sujata-spirulina-facepack-pouch.jpg';
  if (title.includes('soap') || title.includes('spiruglow')) return '/products/sujata-spiruglow-bath-soap-box.jpg';
  if (title.includes('korean')) return '/products/sujata-spirulina-korean-cream-jar.jpg';
  if (title.includes('bridal') || title.includes('whitening')) return '/products/sujata-bridal-whitening-cream-jar.jpg';
  if (title.includes('shilajit')) return '/products/sujata-himalayan-shilajit-bottle.jpg';
  if (title.includes('b12') || title.includes('vitamin b12')) return '/products/sujata-plant-based-b12-bottle.jpg';
  if (title.includes('sea buckthorn')) return '/products/sujata-sea-buckthorn-capsules-bottle.jpg';
  if (title.includes('moringa')) return '/products/sujata-moringa-powder-pouch.jpg';
  if (title.includes('combo') || title.includes('bundle')) return '/products/sujata-combo-spirulina-sea-buckthorn.jpg';
  if (title.includes('capsule')) return '/products/sujata-spirulina-capsules-bottle.jpg';
  if (title.includes('tablet')) return '/products/sujata-spirulina-tablets-bottle.jpg';
  if (title.includes('powder')) return '/products/sujata-spirulina-powder-pouch.jpg';
  
  return '/products/sujata-spirulina-powder-pouch.jpg';
}

function getProductCategory(product: any) {
  const t = (product.title + ' ' + (product.tags || []).join(' ') + ' ' + product.handle).toLowerCase();
  if (t.includes('combo') || t.includes('bundle')) return 'combos';
  if (t.includes('shampoo') || t.includes('hair oil') || t.includes('hair')) return 'haircare';
  if (t.includes('face') || t.includes('soap') || t.includes('cream') || t.includes('whitening') || t.includes('skin')) return 'skincare';
  if (t.includes('capsule') || t.includes('tablet') || t.includes('shilajit') || t.includes('b12') || t.includes('sea buckthorn')) return 'nutrition';
  if (t.includes('powder') || t.includes('moringa')) return 'nutrition';
  return 'nutrition';
}

function getProductBadgeAndBenefit(product: any, currentPrice: number) {
  // 🌟 PRIORITY 1: Direct Shopify Admin Content (Metafields / Tags)
  const metaBenefit = product.keyBenefit?.value || product.subtitle?.value;
  const metaBadge = product.badgeTag?.value || product.badgeTagAlt?.value;
  
  // Check if merchant added tags like "badge:Custom Name" or "benefit:Custom Benefit"
  const tagList = (product.tags || []) as string[];
  const tagBadge = tagList.find((t: string) => t.toLowerCase().startsWith('badge:'))?.split(':')[1]?.trim();
  const tagBenefit = tagList.find((t: string) => t.toLowerCase().startsWith('benefit:'))?.split(':')[1]?.trim();

  const customBadge = metaBadge || tagBadge;
  const customBenefit = metaBenefit || tagBenefit;

  // Real Shopify compare-at price check
  const rawCompare = product.variants?.edges?.[0]?.node?.compareAtPrice?.amount;
  const shopifyComparePrice = rawCompare ? Math.round(parseFloat(rawCompare)) : 0;

  // 🌟 PRIORITY 2: Smart Semantic Fallback (Used ONLY if merchant left it blank in Shopify Admin)
  const t = (product.title || '').toLowerCase();
  let defaultTag = "Bestseller";
  let defaultBenefit = "⚡ Cellular Vitality & Immunity";
  let rating = "4.9 (1.8k)";
  let oldPrice = shopifyComparePrice > currentPrice ? shopifyComparePrice : Math.round(currentPrice * 1.35);

  if (shopifyComparePrice > currentPrice) {
    oldPrice = shopifyComparePrice;
  } else if (t.includes('combo') || t.includes('bundle') || t.includes('healthy life')) {
    defaultTag = "360° VALUE COMBO";
    defaultBenefit = "⚡ All-Day Energy, Immunity & Skin Synergy";
    rating = "4.9 (1.5k)";
    oldPrice = Math.round(currentPrice * 1.3);
  } else if (t.includes('powder') && t.includes('spirulina')) {
    defaultTag = "100% Raw Pure";
    defaultBenefit = "🌱 Complete Cellular Detox & Protein";
    rating = "4.9 (2.4k)";
    oldPrice = 799;
  } else if (t.includes('tablet')) {
    defaultTag = "Zero Binder";
    defaultBenefit = "⚡ Daily Energy, Iron & Stamina";
    rating = "4.9 (3.1k)";
    oldPrice = 650;
  } else if (t.includes('sea buckthorn')) {
    defaultTag = "Rare Omega 7";
    defaultBenefit = "🛡️ Heart, Skin & Mucosal Defense";
    rating = "4.9 (1.2k)";
    oldPrice = 999;
  } else if (t.includes('b12')) {
    defaultTag = "Plant Based B12";
    defaultBenefit = "🧠 Active Nerve & RBC Formation";
    rating = "4.8 (940)";
    oldPrice = 1099;
  } else if (t.includes('shilajit')) {
    defaultTag = "Gold Grade 75%+";
    defaultBenefit = "💪 Peak Physical Strength & Vitality";
    rating = "5.0 (1.5k)";
    oldPrice = 1299;
  } else if (t.includes('moringa')) {
    defaultTag = "Super Detox";
    defaultBenefit = "🍃 Blood Sugar Balance & Cleansing";
    rating = "4.8 (820)";
    oldPrice = 299;
  } else if (t.includes('face wash') || t.includes('facewash')) {
    defaultTag = "Anti-Acne";
    defaultBenefit = "✨ Deep Pore Detox & Oil Control";
    rating = "4.9 (1.9k)";
    oldPrice = 499;
  } else if (t.includes('face pack') || t.includes('facepack')) {
    defaultTag = "Instant Glow";
    defaultBenefit = "🌸 Botanical Tan & Blemish Removal";
    rating = "4.8 (750)";
    oldPrice = 399;
  } else if (t.includes('soap')) {
    defaultTag = "100% Organic";
    defaultBenefit = "🧼 Handcrafted Ayurvedic Herbal Bar";
    rating = "4.9 (1.1k)";
    oldPrice = 249;
  } else if (t.includes('korean')) {
    defaultTag = "K-Beauty Formula";
    defaultBenefit = "✨ Glass Skin & Dark Spot Corrector";
    rating = "4.9 (880)";
    oldPrice = 799;
  } else if (t.includes('bridal') || t.includes('whitening')) {
    defaultTag = "Luxury Radiance";
    defaultBenefit = "👑 Saffron & Sandalwood Bridal Glow";
    rating = "5.0 (620)";
    oldPrice = 899;
  } else if (t.includes('hair oil') || t.includes('oil')) {
    defaultTag = "Hair Fall Control";
    defaultBenefit = "💆 Scalp Nourishment & Active Biotin";
    rating = "4.9 (1.4k)";
    oldPrice = 399;
  } else if (t.includes('shampoo')) {
    defaultTag = "2-in-1 Therapy";
    defaultBenefit = "🌿 Anti-Thinning & Keratin Strength";
    rating = "4.8 (910)";
    oldPrice = 499;
  }

  // Clinical Purity Differentiator (NABL tested & scientifically verified)
  let purityDifferentiator = "NABL Tested • 0.00% Heavy Metals";
  if (t.includes('powder') && t.includes('spirulina')) {
    purityDifferentiator = "Sub-40°C Cryo-Milled • 21.4% Phycocyanin";
  } else if (t.includes('tablet')) {
    purityDifferentiator = "Sub-40°C Cold Compressed • Zero Binders";
  } else if (t.includes('capsule') && t.includes('spirulina')) {
    purityDifferentiator = "100% Plant Veggie Caps • 500mg Pure";
  } else if (t.includes('b12')) {
    purityDifferentiator = "Active Methylcobalamin • Zero Cyanide";
  } else if (t.includes('shilajit')) {
    purityDifferentiator = ">75% Fulvic Acid • Lead < 0.01 ppm";
  } else if (t.includes('sea buckthorn')) {
    purityDifferentiator = "Wild Himalayan • Rare Omega 7";
  } else if (t.includes('moringa')) {
    purityDifferentiator = "Raw Leaves • Zero Artificial Colors";
  } else if (t.includes('combo') || t.includes('bundle')) {
    purityDifferentiator = "Synergistic Bio-Absorption Protocol";
  } else if (t.includes('skin') || t.includes('face') || t.includes('cream')) {
    purityDifferentiator = "Spirulina Botanical • Zero Parabens";
  } else if (t.includes('hair') || t.includes('shampoo')) {
    purityDifferentiator = "Ayurvedic Scalp Therapy • Sulphate Free";
  }

  const finalOldPrice = oldPrice;
  const savedPrice = Math.max(0, finalOldPrice - currentPrice);

  return {
    tag: customBadge || defaultTag,
    benefit: customBenefit || defaultBenefit,
    purityDifferentiator,
    rating,
    oldPrice: finalOldPrice,
    savedPrice
  };
}
---

<!-- 🛍️ ZONE 2: The Unified Shop Engine (Featured Kit + Segmented Catalog) -->
<section id="product-ecosystem" class="pt-7 sm:pt-12 pb-14 md:py-20 bg-[#FBF9F5] text-[#111827] relative">
  <div id="bundle-offers" class="absolute -top-24 left-0 w-full pointer-events-none"></div>
  <div class="max-w-7xl mx-auto px-2.5 sm:px-6 lg:px-12">
    {/* 1. CATALOG HEADER & FILTER PILLS */}
    <div class="mb-4 sm:mb-8">
      
      <div class="flex flex-col md:flex-row md:items-end justify-between gap-3 md:gap-6 mb-4 sm:mb-6">
        <div>
          <span class="text-[9.5px] sm:text-[11px] font-bold uppercase tracking-[0.2em] text-[#166534] block mb-1 font-sans">
            Doctor-Curated Pure Nutrition
          </span>
          <h2 class="text-2xl sm:text-4xl md:text-5xl font-serif font-normal text-[#111827] tracking-tight leading-tight">
            Explore All <span class="italic text-[#166534]">Formulations.</span>
          </h2>
        </div>

        {/* Filter Pills - Horizontal Scroll on Mobile with no-scrollbar */}
        <div class="flex items-center gap-1.5 sm:gap-2 overflow-x-auto sm:flex-wrap no-scrollbar py-1" id="shop-catalog-filters">
          <button class="shop-filter-btn active px-3 sm:px-4 py-1.5 sm:py-2 rounded-full text-[11px] sm:text-xs font-bold font-sans transition-all bg-[#111827] text-white cursor-pointer whitespace-nowrap shrink-0" data-filter="all">
            All Products ({filteredProducts.length})
          </button>
          <button class="shop-filter-btn px-3 sm:px-4 py-1.5 sm:py-2 rounded-full text-[11px] sm:text-xs font-bold font-sans transition-all bg-white border border-gray-200 text-gray-700 hover:border-gray-400 cursor-pointer whitespace-nowrap shrink-0" data-filter="nutrition">
            🌿 Nutrition & Superfoods
          </button>
          <button class="shop-filter-btn px-3 sm:px-4 py-1.5 sm:py-2 rounded-full text-[11px] sm:text-xs font-bold font-sans transition-all bg-white border border-gray-200 text-gray-700 hover:border-gray-400 cursor-pointer whitespace-nowrap shrink-0" data-filter="skincare">
            🌸 Skin & Face Care
          </button>
          <button class="shop-filter-btn px-3 sm:px-4 py-1.5 sm:py-2 rounded-full text-[11px] sm:text-xs font-bold font-sans transition-all bg-white border border-gray-200 text-gray-700 hover:border-gray-400 cursor-pointer whitespace-nowrap shrink-0" data-filter="haircare">
            💆 Hair Care
          </button>
          <button class="shop-filter-btn px-3 sm:px-4 py-1.5 sm:py-2 rounded-full text-[11px] sm:text-xs font-bold font-sans transition-all bg-white border border-gray-200 text-gray-700 hover:border-gray-400 cursor-pointer whitespace-nowrap shrink-0" data-filter="combos">
            📦 Value Combos
          </button>
        </div>
      </div>

    </div>

    {/* 3. PRODUCT SALES GRID (2-Column Mobile, 4-Column Desktop) */}
    <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-2.5 sm:gap-4 lg:gap-6" id="shop-products-grid">
      {filteredProducts.map((edge: any, index: number) => {
        const product = edge.node;
        const category = getProductCategory(product);
        const priceAmount = product.priceRange?.minVariantPrice?.amount || product.variants?.edges[0]?.node?.price?.amount || "799";
        const numPrice = parseFloat(priceAmount) || 799;
        const meta = getProductBadgeAndBenefit(product, numPrice);
        const productImg = getImageUrl(product);
        
        const rawVariants = product.variants?.edges?.map((e: any) => e.node) || [];
        const hasMultipleVariants = rawVariants.length > 1;
        const firstVariant = rawVariants[0];
        const initialPrice = firstVariant?.price?.amount ? parseFloat(firstVariant.price.amount) : numPrice;
        const initialCompare = firstVariant?.compareAtPrice?.amount ? parseFloat(firstVariant.compareAtPrice.amount) : meta.oldPrice;

        return (
          <div class={`product-card-item bg-white rounded-2xl sm:rounded-3xl p-2.5 sm:p-4 md:p-5 border border-gray-200/90 shadow-xs hover:shadow-md hover:border-[#166534]/40 transition-all flex flex-col justify-between group`} data-category={category}>
            
            <div>
              {/* Product Visual Container with Floating Badges */}
              <a href={`/product/${product.handle}`} class="block relative aspect-square bg-[#FAF9F6] rounded-xl sm:rounded-2xl p-2 sm:p-3 mb-2 sm:mb-3 overflow-hidden group-hover:bg-emerald-50/30 transition-colors flex items-center justify-center">
                {/* Top-Left Trust Badge */}
                <span class="absolute top-1.5 left-1.5 sm:top-2.5 sm:left-2.5 z-10 text-[8px] sm:text-[9.5px] font-bold uppercase tracking-wider bg-[#064E3B] text-white px-2 py-0.5 rounded-full shadow-xs">
                  {meta.tag}
                </span>

                {/* Bottom-Left Rating Badge */}
                <span class="absolute bottom-1.5 left-1.5 sm:bottom-2.5 sm:left-2.5 z-10 text-[8.5px] sm:text-[10px] font-bold bg-black/60 text-white backdrop-blur-xs px-1.5 py-0.5 rounded flex items-center gap-0.5 shadow-xs">
                  <span class="text-amber-400 text-[9px] sm:text-[10px]">★</span>
                  <span>{meta.rating.split(' ')[0]}</span>
                </span>

                <img 
                  src={productImg} 
                  alt={product.title} 
                  class="w-full h-full object-contain drop-shadow-sm group-hover:scale-105 transition-transform duration-500"
                  loading="lazy"
                />
              </a>

              {/* Title with Fixed 2-Line Min-Height for Consistent Symmetry */}
              <a href={`/product/${product.handle}`} class="block mb-0.5">
                <h3 class="text-xs sm:text-sm md:text-base font-bold font-sans text-[#111827] group-hover:text-[#166534] transition-colors leading-tight line-clamp-2 min-h-[2.4em]">
                  {product.title}
                </h3>
              </a>

              {/* Micro-Benefit / Form subtitle */}
              <span class="text-[9.5px] sm:text-xs text-gray-500 font-medium block truncate mb-2">
                {meta.benefit}
              </span>

              {/* In-Card Multi-Variant Pill Selector or Purity Differentiator (Symmetric min-h-[26px]) */}
              {hasMultipleVariants ? (
                <div class="product-variant-pills flex items-center gap-1 mb-2.5 overflow-x-auto no-scrollbar py-0.5 min-h-[26px]">
                  {rawVariants.slice(0, 3).map((v: any, vIdx: number) => {
                    const vPrice = parseFloat(v.price?.amount || "0");
                    const vCompare = v.compareAtPrice?.amount ? parseFloat(v.compareAtPrice.amount) : 0;
                    const shortTitle = v.title
                      .replace(/Tablets/i, 'Tabs')
                      .replace(/Capsules/i, 'Caps')
                      .replace(/\(500mg\)/i, '')
                      .replace(/\(30 Days\)/i, '')
                      .trim();
                    return (
                      <button 
                        type="button" 
                        class={`variant-pill-btn text-[8.5px] sm:text-[9.5px] font-bold px-2 py-0.5 rounded-lg border transition-all cursor-pointer whitespace-nowrap ${vIdx === 0 ? 'bg-[#166534] text-white border-[#166534] active-pill shadow-xs' : 'bg-gray-50 text-gray-700 border-gray-200 hover:border-gray-400'}`}
                        data-variant-id={v.id}
                        data-price={vPrice}
                        data-compare-price={vCompare}
                        data-title={v.title}
                      >
                        {shortTitle}
                      </button>
                    );
                  })}
                </div>
              ) : (
                <div class="min-h-[26px] flex items-center gap-1.5 mb-2.5 text-[8.5px] sm:text-[9.5px] font-mono text-[#166534] bg-emerald-50/70 border border-emerald-100/80 rounded-lg px-2 py-0.5">
                  <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 shrink-0"></span>
                  <span class="truncate font-semibold">{meta.purityDifferentiator}</span>
                </div>
              )}
            </div>

            <div>
              {/* Pricing Line */}
              <div class="flex items-baseline justify-between gap-1 pt-2 sm:pt-2.5 border-t border-gray-100 mb-2 sm:mb-2.5">
                <div class="flex items-baseline gap-1 sm:gap-1.5 flex-wrap">
                  <span class="card-current-price text-sm sm:text-base md:text-lg font-black text-[#111827] font-sans">
                    {formatPrice(initialPrice)}
                  </span>
                  <span class={`card-old-price text-[10px] sm:text-xs text-gray-400 line-through font-sans ${initialCompare > initialPrice ? '' : 'hidden'}`}>
                    ₹{Math.round(initialCompare)}
                  </span>
                </div>
                <span class={`card-save-badge text-[8px] sm:text-[9.5px] font-black text-[#166534] bg-emerald-50 border border-emerald-100/60 px-1.5 py-0.5 rounded font-sans shrink-0 whitespace-nowrap ${initialCompare > initialPrice ? '' : 'hidden'}`}>
                  Save ₹{Math.round(initialCompare - initialPrice)}
                </span>
              </div>

              {/* Delivery Micro-Badge */}
              <div class="block sm:hidden text-[8px] text-[#166534] font-medium bg-emerald-50/70 border border-emerald-100/70 rounded-lg px-1.5 py-0.5 mb-2 truncate text-center">
                🚚 Free COD • Dispatches in 24h
              </div>

              <div class="product-delivery-badge hidden sm:flex items-center justify-between gap-1.5 bg-emerald-50/70 border border-emerald-100 rounded-xl px-2.5 py-1 mb-2.5 text-[9.5px] text-[#064E3B]">
                <div class="flex items-center gap-1 min-w-0">
                  <span class="text-xs">🚚</span>
                  <span class="delivery-date-text truncate text-gray-700 font-medium">Dispatches in 24h</span>
                </div>
                <span class="text-[8.5px] font-bold bg-[#166534] text-white px-1.5 py-0.5 rounded uppercase tracking-wider shrink-0">Express</span>
              </div>

              {/* Dual Action CTAs: 1-Click Buy Now & Add to Routine */}
              <div class="grid grid-cols-12 gap-1.5">
                <button 
                  type="button"
                  class="hub-direct-buy-btn col-span-8 bg-[#166534] hover:bg-[#15803d] active:scale-[0.98] text-white py-2 sm:py-2.5 rounded-xl font-black text-[10px] sm:text-xs uppercase tracking-wider transition-all shadow-xs flex items-center justify-center gap-1 cursor-pointer touch-manipulation group/buy"
                  data-variant-id={firstVariant?.id || ('prod_' + index)}
                  data-title={product.title}
                  data-price={initialPrice.toString()}
                  data-image={productImg}
                  data-subtitle={meta.benefit}
                >
                  <span class="hub-btn-spinner hidden w-3 h-3 border-2 border-white border-t-transparent rounded-full animate-spin"></span>
                  <span class="hub-btn-text flex items-center gap-1">
                    <span>⚡ Buy Now</span>
                    <span class="hidden xl:inline text-[9px] font-normal opacity-90">(COD)</span>
                  </span>
                </button>

                <button 
                  type="button"
                  class="hub-add-cart-btn col-span-4 bg-gray-100 hover:bg-gray-200 active:scale-[0.98] text-gray-800 border border-gray-200 py-2 sm:py-2.5 rounded-xl font-bold text-[10px] sm:text-xs uppercase tracking-wider transition-all flex items-center justify-center gap-0.5 cursor-pointer touch-manipulation"
                  data-variant-id={firstVariant?.id || ('prod_' + index)}
                  data-title={product.title}
                  data-price={initialPrice.toString()}
                  data-image={productImg}
                  data-subtitle={meta.benefit}
                  title="Add to cart"
                >
                  <span>+ 🛒</span>
                  <span class="hidden sm:inline text-[9.5px]">Cart</span>
                </button>
              </div>

            </div>

          </div>
        );
      })}
    </div>

  </div>
</section>

<script is:inline>
  function initShopHubFilters() {
    const filterBtns = document.querySelectorAll('.shop-filter-btn');
    const productCards = document.querySelectorAll('.product-card-item');

    filterBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        const filter = btn.getAttribute('data-filter');

        filterBtns.forEach(b => {
          b.classList.remove('active', 'bg-[#111827]', 'text-white');
          b.classList.add('bg-white', 'text-gray-700');
        });

        btn.classList.add('active', 'bg-[#111827]', 'text-white');
        btn.classList.remove('bg-white', 'text-gray-700');

        productCards.forEach(card => {
          const category = card.getAttribute('data-category');
          if (filter === 'all' || category === filter) {
            card.style.display = 'flex';
          } else {
            card.style.display = 'none';
          }
        });
      });
    });

    // 🌟 Auto-activate "Value Combos" filter when navigating to #bundle-offers
    function checkHashFilter() {
      if (window.location.hash === '#bundle-offers') {
        const comboBtn = document.querySelector('.shop-filter-btn[data-filter="combos"]');
        if (comboBtn) {
          comboBtn.click();
        }
      }
    }
    checkHashFilter();
    window.addEventListener('hashchange', checkHashFilter);
  }

  function initShopHubInteractions() {
    // 1. Variant Pill Switching
    document.querySelectorAll('.product-card-item').forEach(card => {
      const pills = card.querySelectorAll('.variant-pill-btn');
      const directBuyBtn = card.querySelector('.hub-direct-buy-btn');
      const addCartBtn = card.querySelector('.hub-add-cart-btn');
      const priceSpan = card.querySelector('.card-current-price');
      const oldPriceSpan = card.querySelector('.card-old-price');
      const saveBadge = card.querySelector('.card-save-badge');

      pills.forEach(pill => {
        pill.addEventListener('click', (e) => {
          e.preventDefault();
          e.stopPropagation();

          pills.forEach(p => {
            p.classList.remove('bg-[#166534]', 'text-white', 'border-[#166534]', 'active-pill');
            p.classList.add('bg-gray-50', 'text-gray-700', 'border-gray-200');
          });

          pill.classList.remove('bg-gray-50', 'text-gray-700', 'border-gray-200');
          pill.classList.add('bg-[#166534]', 'text-white', 'border-[#166534]', 'active-pill');

          const variantId = pill.getAttribute('data-variant-id');
          const price = parseFloat(pill.getAttribute('data-price') || '0');
          const comparePrice = parseFloat(pill.getAttribute('data-compare-price') || '0');

          if (directBuyBtn) {
            directBuyBtn.setAttribute('data-variant-id', variantId);
            directBuyBtn.setAttribute('data-price', price.toString());
          }
          if (addCartBtn) {
            addCartBtn.setAttribute('data-variant-id', variantId);
            addCartBtn.setAttribute('data-price', price.toString());
          }

          if (priceSpan) {
            priceSpan.innerText = new Intl.NumberFormat('en-IN', { style: 'currency', currency: 'INR', maximumFractionDigits: 0 }).format(price);
          }

          if (comparePrice > price) {
            if (oldPriceSpan) {
              oldPriceSpan.innerText = `₹${Math.round(comparePrice)}`;
              oldPriceSpan.classList.remove('hidden');
            }
            if (saveBadge) {
              saveBadge.innerText = `Save ₹${Math.round(comparePrice - price)}`;
              saveBadge.classList.remove('hidden');
            }
          } else {
            if (oldPriceSpan) oldPriceSpan.classList.add('hidden');
            if (saveBadge) saveBadge.classList.add('hidden');
          }
        });
      });
    });

    // 2. Direct 1-Click Buy Now
    document.querySelectorAll('.hub-direct-buy-btn').forEach(btn => {
      btn.addEventListener('click', async (e) => {
        e.preventDefault();
        e.stopPropagation();

        const id = btn.getAttribute('data-variant-id');
        const title = btn.getAttribute('data-title');
        const price = parseFloat(btn.getAttribute('data-price')) || 350;
        const image = btn.getAttribute('data-image');
        const subtitle = btn.getAttribute('data-subtitle') || '100% Pure Cold-Pressed';

        const spinner = btn.querySelector('.hub-btn-spinner');
        const textSpan = btn.querySelector('.hub-btn-text');

        spinner?.classList.remove('hidden');
        if (textSpan) textSpan.innerHTML = `<span>Preparing...</span>`;
        btn.style.pointerEvents = 'none';

        try {
          if (typeof window.directCheckoutItem === 'function') {
            await window.directCheckoutItem({
              id: id,
              title: title,
              price: price,
              image: image,
              subtitle: subtitle,
              quantity: 1
            });
          } else if (typeof window.addItemToLocalCart === 'function') {
            window.addItemToLocalCart({
              id: id,
              title: title,
              price: price,
              image: image,
              subtitle: subtitle,
              quantity: 1
            });
            spinner?.classList.add('hidden');
            if (textSpan) textSpan.innerHTML = `<span>⚡ Buy Now</span>`;
            btn.style.pointerEvents = '';
          }
        } catch (err) {
          console.error("Direct checkout error:", err);
          spinner?.classList.add('hidden');
          if (textSpan) textSpan.innerHTML = `<span>⚡ Buy Now</span>`;
          btn.style.pointerEvents = '';
        }
      });
    });

    // 3. Quick-Add to Cart
    document.querySelectorAll('.hub-add-cart-btn').forEach(btn => {
      btn.addEventListener('click', (e) => {
        e.preventDefault();
        e.stopPropagation();

        const id = btn.getAttribute('data-variant-id');
        const title = btn.getAttribute('data-title');
        const price = parseFloat(btn.getAttribute('data-price')) || 350;
        const image = btn.getAttribute('data-image');
        const subtitle = btn.getAttribute('data-subtitle') || '100% Pure Cold-Pressed';

        if (typeof window.addItemToLocalCart === 'function') {
          window.addItemToLocalCart({
            id: id,
            title: title,
            price: price,
            image: image,
            subtitle: subtitle,
            quantity: 1
          });
        }

        const origHtml = btn.innerHTML;
        btn.innerHTML = `<span>✓</span>`;
        btn.classList.add('bg-emerald-600', 'text-white', 'border-emerald-600');
        setTimeout(() => {
          btn.innerHTML = origHtml;
          btn.classList.remove('bg-emerald-600', 'text-white', 'border-emerald-600');
        }, 1500);
      });
    });
  }

  function updateDeliveryEstimators() {
    const savedPincode = localStorage.getItem('sujata_pincode') || localStorage.getItem('user_pincode') || '411001';
    const badges = document.querySelectorAll('.product-delivery-badge .delivery-date-text');
    
    // Calculate delivery date (+3 business days)
    const targetDate = new Date();
    targetDate.setDate(targetDate.getDate() + 3);
    if (targetDate.getDay() === 0) targetDate.setDate(targetDate.getDate() + 1); // skip Sunday
    
    const options = { weekday: 'short', month: 'short', day: 'numeric' };
    const dateStr = targetDate.toLocaleDateString('en-IN', options);

    badges.forEach(badge => {
      badge.innerHTML = `Get it by <strong>${dateStr}</strong> (to ${savedPincode})`;
    });
  }

  function initAllShopHub() {
    initShopHubFilters();
    initShopHubInteractions();
    updateDeliveryEstimators();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initAllShopHub);
  } else {
    initAllShopHub();
  }

  document.addEventListener('astro:page-load', initAllShopHub);

  window.addEventListener('pincode-updated', () => {
    updateDeliveryEstimators();
  });
</script>
