---
// src/components/StoreRelatedFormulations.astro
// 🧬 NEURAL MESH INTERNAL LINKING ENGINE (Silicon Valley 2026 Spec)
// Bridges PageRank & Crawl Priority across all 16 Formulations
// Prices are LIVE from Shopify (src/lib/catalog.ts). No ratings are shown: the store has almost no
// published reviews yet, and invented star counts mislead buyers (Consumer Protection Act / CCPA).
import { getCatalogProducts, formatINR, type CatalogHandle } from '../lib/catalog';

interface Props {
  currentHandle: string;
}

const { currentHandle } = Astro.props;

interface CatalogItem {
  handle: string;
  title: string;
  subtitle: string;
  image: string;
  badge: string;
  category: 'nutrition' | 'skincare' | 'haircare' | 'combos';
}

const ALL_CATALOG: CatalogItem[] = [
  {
    handle: 'sujata-spirulina-tablets',
    title: 'Sujata Spirulina Tablets (500mg)',
    subtitle: 'Cold-Compressed • Zero Chemical Binders',
    image: '/products/sujata-spirulina-tablets-bottle.jpg',
    badge: 'Flagship Superfood',
    category: 'nutrition'
  },
  {
    handle: 'sujata-spirulina-powder',
    title: 'Sujata Pure Spirulina Powder (100g)',
    subtitle: 'Cryo-Milled • 21.4% Phycocyanin',
    image: '/products/sujata-spirulina-powder-pouch.jpg',
    badge: 'Cryo-Milled Pure',
    category: 'nutrition'
  },
  {
    handle: 'sujata-spirulina-capsules',
    title: 'Sujata Spirulina Veggie Capsules',
    subtitle: '500mg Plant Shell • Instant Absorption',
    image: '/products/sujata-spirulina-capsules-bottle.jpg',
    badge: '100% Veggie Shell',
    category: 'nutrition'
  },
  {
    handle: 'sujata-pure-himalayan-shilajit',
    title: 'Pure Himalayan Shilajit Resin (Gold Grade)',
    subtitle: '>75% Fulvic Acid • NABL Certified Purity',
    image: '/products/sujata-himalayan-shilajit-bottle.jpg',
    badge: 'Gold Grade >75%',
    category: 'nutrition'
  },
  {
    handle: 'sujata-sea-buckthorn-capsules',
    title: 'Wild Himalayan Sea Buckthorn Capsules',
    subtitle: 'Rare Omega 7 & 12x Natural Vitamin C',
    image: '/products/sujata-sea-buckthorn-capsules-bottle.jpg',
    badge: 'Rare Omega 7',
    category: 'nutrition'
  },
  {
    handle: 'sujata-plant-based-vitamin-b12',
    title: 'Plant-Based Vitamin B12 (Active Co-Enzyme)',
    subtitle: 'Methylcobalamin • 0% Synthetic Cyanide',
    image: '/products/sujata-plant-based-b12-bottle.png',
    badge: 'Active Co-Enzyme',
    category: 'nutrition'
  },
  {
    handle: 'sujata-moringa-powder',
    title: 'Raw Moringa Leaf Detox Powder (100g)',
    subtitle: 'Shade-Dried Organic Moringa • Natural Detox',
    image: '/products/sujata-moringa-powder-pouch.jpg',
    badge: 'Super Detox Leaf',
    category: 'nutrition'
  },
  {
    handle: 'sujata-spirulina-facewash',
    title: 'Spirulina Botanical Detox Face Wash',
    subtitle: 'Anti-Acne • Deep Pore Cleansing & Zinc',
    image: '/products/sujata-spirulina-facewash-bottle.jpg',
    badge: 'Anti-Acne Detox',
    category: 'skincare'
  },
  {
    handle: 'sujata-spiruglow-bath-soap',
    title: 'SpiruGlow Ayurvedic Herbal Bath Bar',
    subtitle: 'Handcrafted Cold-Pressed Coconut & Spirulina',
    image: '/products/sujata-spiruglow-bath-soap-box.jpg',
    badge: 'Handcrafted Herbal',
    category: 'skincare'
  },
  {
    handle: 'sujata-spirulina-korean-cream',
