    title: 'Bridal Whitening & Radiance Day Cream',
    subtitle: 'Pure Sandalwood & Saffron Botanical Glow',
    image: '/products/sujata-bridal-whitening-cream-jar.jpg',
    badge: 'Luxury Bridal Glow',
    category: 'skincare'
  },
  {
    handle: 'sujata-spirulina-facepack-powder',
    title: 'Spirulina Tan-Removal Face Pack Powder',
    subtitle: 'Instant Botanical Radiance & Blemish Detox',
    image: '/products/sujata-spirulina-facepack-pouch.jpg',
    badge: 'Instant Glow Pack',
    category: 'skincare'
  },
  {
    handle: 'sujata-spirulina-coconut-hair-oil',
    title: 'Spirulina & Biotin Cold-Pressed Hair Oil',
    subtitle: 'Active Scalp Therapy • Hair Fall Defense',
    image: '/products/sujata-spirulina-hair-oil-bottle.png',
    badge: 'Scalp Root Defense',
    category: 'haircare'
  },
  {
    handle: 'sujata-spirushine-shampoo-conditioner',
    title: 'SpiruShine 2-in-1 Shampoo & Conditioner',
    subtitle: 'Keratin & Spirulina Anti-Thinning Wash',
    image: '/products/sujata-spirushine-shampoo-bottle.jpg',
    badge: '2-in-1 Therapy',
    category: 'haircare'
  },
  {
    handle: 'sujata-spirulina-sea-buckthorn-combo-pack',
    title: 'Spirulina Veg Capsules + Sea Buckthorn Combo Pack',
    subtitle: '100% Veg Capsules Dual Cellular Rejuvenation',
    image: '/products/sujata-combo-spirulina-sea-buckthorn.jpg',
    badge: '100% Veg Capsules Duo',
    category: 'combos'
  },
  {
    handle: 'sujata-spirulina-sea-buckthorn-combo',
    title: 'Daily Super Immunity Combo (Tablets + Capsules)',
    subtitle: 'Pure Tablets (0% Binders) + Wild Himalayan Berry Oil',
    image: '/products/sujata-combo-spirulina-tablets-sea-buckthorn.jpg',
    badge: 'Tablets + Capsules Duo',
    category: 'combos'
  }
];

// Determine related items: prioritize same category + cross-category flagship, excluding self
const currentItem = ALL_CATALOG.find(i => i.handle === currentHandle);
const currentCat = currentItem?.category || 'nutrition';

let recommendations = ALL_CATALOG.filter(i => i.handle !== currentHandle && i.category === currentCat);

// If less than 4, pad with flagship nutrition formulations
if (recommendations.length < 4) {
  const others = ALL_CATALOG.filter(i => i.handle !== currentHandle && !recommendations.some(r => r.handle === i.handle));
  recommendations = [...recommendations, ...others];
}

const displayItems = recommendations.slice(0, 4);
const live = await getCatalogProducts(displayItems.map((i) => i.handle as CatalogHandle));
const priceOf = (handle: string) => {
  const variants = live[handle]?.variants || [];
  const v = variants.find((x) => x.available) || variants[0];
  return v ? { price: formatINR(v.price), compare: v.compareAt && v.compareAt > v.price ? formatINR(v.compareAt) : null, from: variants.length > 1 } : null;
};
---

<section class="py-12 sm:py-16 bg-[#FBF9F5] border-t border-gray-200/80 text-[#111827]">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-12">
    
    <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-3 mb-8">
      <div>
        <span class="text-[10px] sm:text-xs font-bold uppercase tracking-[0.2em] text-[#166534] block mb-1">
          Synergistic Bio-Active Protocol
        </span>
        <h2 class="text-2xl sm:text-3xl font-serif font-bold text-[#111827] tracking-tight">
          Explore Related <span class="italic text-[#166534]">Formulations</span>
        </h2>
      </div>
      <a href="/#product-ecosystem" class="text-xs sm:text-sm font-bold text-[#166534] hover:text-[#111827] transition-colors flex items-center gap-1">
        <span>View Complete Catalog (16)</span>
        <span>→</span>
      </a>
    </div>

    <div class="grid grid-cols-2 lg:grid-cols-4 gap-3 sm:gap-5">
      {displayItems.map((item) => (
        <div class="bg-white rounded-2xl p-3 sm:p-4 border border-gray-200/90 hover:border-[#166534]/50 hover:shadow-md transition-all flex flex-col justify-between group">
          <div>
            <a href={`/product/${item.handle}`} class="block relative aspect-square bg-[#FAF9F6] rounded-xl p-2 mb-2.5 overflow-hidden group-hover:bg-emerald-50/20 transition-colors flex items-center justify-center">
              <span class="absolute top-1.5 left-1.5 z-10 text-[8px] sm:text-[9px] font-bold uppercase tracking-wider bg-[#064E3B] text-white px-2 py-0.5 rounded-full shadow-xs">
                {item.badge}
              </span>
              <img 
                src={item.image} 
                alt={item.title} 
                class="w-full h-full object-contain drop-shadow-sm group-hover:scale-105 transition-transform duration-300"
                loading="lazy"
              />
            </a>

            <a href={`/product/${item.handle}`} class="block mb-1">
              <h3 class="text-xs sm:text-sm font-bold text-[#111827] group-hover:text-[#166534] transition-colors leading-tight line-clamp-2 min-h-[2.5em]">
                {item.title}
              </h3>
            </a>

            <p class="text-[9.5px] sm:text-[11px] text-gray-500 font-medium truncate mb-2">
              {item.subtitle}
            </p>
          </div>

          <div class="pt-2 border-t border-gray-100 flex items-center justify-between gap-1">
            <div class="flex items-baseline gap-1">
              {priceOf(item.handle) && (
                <span class="text-sm sm:text-base font-black text-[#111827]">
                  {priceOf(item.handle)!.from && <span class="text-[10px] font-semibold text-gray-500">from </span>}{priceOf(item.handle)!.price}
                </span>
              )}
              {priceOf(item.handle)?.compare && (
                <span class="text-[10px] text-gray-400 line-through">
                  {priceOf(item.handle)!.compare}
                </span>
              )}
            </div>
            <a 
              href={`/product/${item.handle}`} 
              class="bg-[#166534] hover:bg-[#15803d] text-white text-[10px] sm:text-xs font-bold px-2.5 py-1 rounded-lg transition-colors cursor-pointer"
            >
              View ➔
            </a>
          </div>
        </div>
      ))}
    </div>

  </div>
</section>
