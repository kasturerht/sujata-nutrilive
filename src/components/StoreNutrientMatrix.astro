            <td class="py-3 px-2 font-bold">0.058 g</td>
            <td class="py-3 px-2 text-gray-500 hidden sm:table-cell font-sans">LAL/CHEM/SOP/FD/GF/02</td>
          </tr>
          <tr>
            <td class="py-3 px-2 font-bold text-[#111827] font-sans">Moisture (Sub-40°C Dried)</td>
            <td class="py-3 px-2">4.12%</td>
            <td class="py-3 px-2 text-[#064E3B] font-bold">&lt; 0.124 g</td>
