---
// src/components/StoreNutrientMatrix.astro
---

<!-- 🥗 2026 Genuine Architectural Radial Infographic Diagram (Zero Bento Grid • Pure Visual Flow) -->
<section id="nutrient-matrix" class="py-20 md:py-32 bg-[#FAF9F6] text-[#111827] border-t border-gray-200/80 relative overflow-hidden">
  
  {/* Atmospheric Soft Light */}
  <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[800px] h-[800px] bg-[#166534]/[0.03] rounded-full blur-[160px] pointer-events-none"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-12 relative z-10">
    
    {/* 1. Editorial Header */}
    <div class="text-center max-w-2xl mx-auto mb-14 md:mb-20">
      <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-[#166534]/10 border border-[#166534]/20 mb-3">
        <span class="w-2 h-2 rounded-full bg-[#166534]"></span>
        <span class="text-[11px] font-black uppercase tracking-[0.2em] text-[#166534]">The Equivalence Diagram</span>
      </div>
      <h2 class="text-3xl sm:text-4xl md:text-5xl lg:text-6xl font-black font-['Playfair_Display'] text-[#111827] tracking-tight leading-tight mb-3">
        The Anatomy of 1 Scoop<span class="text-[#166534]">.</span>
      </h2>
      <p class="text-xs sm:text-sm md:text-base text-gray-600 font-normal max-w-lg mx-auto">
        How a single 3g daily serving replaces the concentrated micronutrients of five whole foods.
      </p>
    </div>

    {/* 2. THE INFOGRAPHIC DIAGRAM CANVAS (Central Hub with Radiating Connector Nodes) */}
    <div class="relative max-w-5xl mx-auto hidden lg:block my-8">
      
      {/* SVG Hairline Radial Connectors */}
      <svg class="absolute inset-0 w-full h-full pointer-events-none z-0" viewBox="0 0 1000 650" fill="none" stroke="currentColor">
        {/* Connector to Top Left (Carrots) */}
        <path d="M 500 325 L 260 140" stroke="#166534" stroke-width="1.5" stroke-dasharray="4 4" class="opacity-30" />
        <circle cx="260" cy="140" r="4" fill="#166534" class="opacity-60" />

        {/* Connector to Top Right (Egg) */}
        <path d="M 500 325 L 740 140" stroke="#166534" stroke-width="1.5" stroke-dasharray="4 4" class="opacity-30" />
        <circle cx="740" cy="140" r="4" fill="#166534" class="opacity-60" />

        {/* Connector to Mid Left (Spinach) */}
        <path d="M 500 325 L 180 340" stroke="#166534" stroke-width="1.5" stroke-dasharray="4 4" class="opacity-30" />
        <circle cx="180" cy="340" r="4" fill="#166534" class="opacity-60" />

        {/* Connector to Mid Right (Milk) */}
        <path d="M 500 325 L 820 340" stroke="#166534" stroke-width="1.5" stroke-dasharray="4 4" class="opacity-30" />
        <circle cx="820" cy="340" r="4" fill="#166534" class="opacity-60" />

        {/* Connector to Bottom (Berries) */}
        <path d="M 500 325 L 500 560" stroke="#166534" stroke-width="1.5" stroke-dasharray="4 4" class="opacity-30" />
        <circle cx="500" cy="560" r="4" fill="#166534" class="opacity-60" />

        {/* Central Outer Orbital Ring */}
        <circle cx="500" cy="325" r="170" stroke="#166534" stroke-width="1" class="opacity-15" stroke-dasharray="6 6" />
      </svg>

      {/* Main Diagram Layout Grid */}
      <div class="relative z-10 w-full h-[650px] flex items-center justify-center">
        
        {/* 🌟 CENTRAL HUB: 1 Daily Scoop */}
        <div class="w-64 h-64 rounded-full bg-gradient-to-b from-[#064E3B] to-[#022c22] text-white p-6 flex flex-col items-center justify-center text-center shadow-[0_20px_50px_rgba(6,78,59,0.25)] border-4 border-white relative z-20">
          <span class="text-[9px] font-black uppercase tracking-[0.2em] text-emerald-300 mb-1">1 Daily Dose (3g)</span>
          <img src="/spirulina-powder.png" alt="Sujata Spirulina" class="w-20 h-20 object-contain drop-shadow-lg my-1" />
          <h3 class="text-base font-black font-['Playfair_Display'] text-white leading-tight">100% Pure Spirulina</h3>
          <span class="text-[10px] text-emerald-200/80 mt-1">65% Protein • 0.00% Heavy Metals</span>
        </div>

        {/* 🥕 NODE 1: TOP LEFT - 10 CARROTS */}
        <div class="absolute top-4 left-6 max-w-[240px] text-right bg-white p-4 rounded-2xl border border-gray-200/80 shadow-md hover:border-amber-400 transition-all z-10">
          <div class="flex items-center justify-end gap-2 mb-1">
            <span class="text-[10px] font-black uppercase tracking-wider text-amber-600">Vitamin A</span>
            <span class="text-xl">🥕</span>
          </div>
          <h4 class="text-base font-bold text-[#111827] font-['Playfair_Display']">Equal to 10 Carrots</h4>
          <p class="text-[11px] text-gray-500 mt-0.5 leading-snug">Plant beta-carotene for macular vision & collagen.</p>
        </div>

        {/* 🥚 NODE 2: TOP RIGHT - 1 EGG */}
        <div class="absolute top-4 right-6 max-w-[240px] text-left bg-white p-4 rounded-2xl border border-gray-200/80 shadow-md hover:border-amber-400 transition-all z-10">
          <div class="flex items-center gap-2 mb-1">
            <span class="text-xl">🥚</span>
            <span class="text-[10px] font-black uppercase tracking-wider text-amber-700">Complete Protein</span>
          </div>
          <h4 class="text-base font-bold text-[#111827] font-['Playfair_Display']">Equal to 1 Whole Egg</h4>
          <p class="text-[11px] text-gray-500 mt-0.5 leading-snug">All 9 essential amino acids for daily cell repair.</p>
        </div>

        {/* 🥬 NODE 3: MID LEFT - 2 BOWLS SPINACH */}
        <div class="absolute top-[280px] left-0 max-w-[250px] text-right bg-white p-4 rounded-2xl border border-gray-200/80 shadow-md hover:border-emerald-500 transition-all z-10">
          <div class="flex items-center justify-end gap-2 mb-1">
            <span class="text-[10px] font-black uppercase tracking-wider text-[#166534]">Organic Bio-Iron</span>
            <span class="text-xl">🥬</span>
          </div>
          <h4 class="text-base font-bold text-[#111827] font-['Playfair_Display']">Equal to 2 Bowls Spinach</h4>
          <p class="text-[11px] text-gray-500 mt-0.5 leading-snug">Boosts hemoglobin with non-constipating organic iron.</p>
        </div>

        {/* 🥛 NODE 4: MID RIGHT - 1 GLASS MILK */}
        <div class="absolute top-[280px] right-0 max-w-[250px] text-left bg-white p-4 rounded-2xl border border-gray-200/80 shadow-md hover:border-blue-400 transition-all z-10">
          <div class="flex items-center gap-2 mb-1">
            <span class="text-xl">🥛</span>
            <span class="text-[10px] font-black uppercase tracking-wider text-blue-700">Bio-Calcium</span>
          </div>
          <h4 class="text-base font-bold text-[#111827] font-['Playfair_Display']">Equal to 1 Glass Milk</h4>
          <p class="text-[11px] text-gray-500 mt-0.5 leading-snug">Plant-derived calcium for bone mineral density (lactose-free).</p>
        </div>

        {/* 🫐 NODE 5: BOTTOM CENTER - 3 HANDFULS BLUEBERRIES */}
        <div class="absolute bottom-2 left-1/2 -translate-x-1/2 max-w-sm w-full text-center bg-white p-4 rounded-2xl border border-gray-200/80 shadow-md hover:border-purple-400 transition-all z-10">
          <div class="flex items-center justify-center gap-2 mb-1">
            <span class="text-xl">🫐</span>
            <span class="text-[10px] font-black uppercase tracking-wider text-purple-700">Phycocyanin Antioxidants</span>
          </div>
          <h4 class="text-base font-bold text-[#111827] font-['Playfair_Display']">Equal to 3 Handfuls of Wild Blueberries</h4>
          <p class="text-[11px] text-gray-500 mt-0.5">Exclusive blue antioxidant for cellular anti-inflammation and liver detox.</p>
        </div>

      </div>

    </div>

    {/* 📱 MOBILE DIAGRAM VIEW: Connected Vertical Timeline Infographic */}
    <div class="block lg:hidden relative my-6">
      
      {/* Central Hub on Mobile */}
      <div class="bg-[#064E3B] text-white rounded-3xl p-6 text-center mb-8 shadow-lg">
        <span class="text-[10px] font-black uppercase tracking-widest text-emerald-300 block mb-1">1 Daily Dose (3g)</span>
        <img src="/spirulina-powder.png" alt="1 Scoop" class="w-16 h-16 object-contain mx-auto my-2" />
        <h3 class="text-xl font-bold font-['Playfair_Display'] text-white">1 Scoop Sujata Spirulina</h3>
        <p class="text-xs text-emerald-200 mt-1">Equals the 5 whole foods below:</p>
      </div>

      {/* Connected Timeline Spine */}
      <div class="relative pl-6 space-y-4 border-l-2 border-dashed border-[#166534]/40">
        
        {/* Mobile Item 1 */}
        <div class="relative bg-white p-4 rounded-2xl border border-gray-200 shadow-sm">
          <div class="absolute -left-[31px] top-4 w-4 h-4 rounded-full bg-[#166534] border-2 border-white"></div>
          <div class="flex items-center justify-between gap-2 mb-1">
            <span class="text-xs font-bold text-[#111827] font-['Playfair_Display']">10 Whole Carrots</span>
            <span class="text-lg">🥕</span>
          </div>
          <span class="text-[11px] text-amber-600 font-bold block">Vitamin A (Carotenoids)</span>
          <p class="text-[11px] text-gray-500 mt-0.5">Macular eye health and natural collagen support.</p>
        </div>

        {/* Mobile Item 2 */}
        <div class="relative bg-white p-4 rounded-2xl border border-gray-200 shadow-sm">
          <div class="absolute -left-[31px] top-4 w-4 h-4 rounded-full bg-[#166534] border-2 border-white"></div>
          <div class="flex items-center justify-between gap-2 mb-1">
            <span class="text-xs font-bold text-[#111827] font-['Playfair_Display']">2 Bowls Cooked Spinach</span>
            <span class="text-lg">🥬</span>
          </div>
          <span class="text-[11px] text-[#166534] font-bold block">Organic Bio-Iron</span>
          <p class="text-[11px] text-gray-500 mt-0.5">Non-constipating iron for stamina and hemoglobin.</p>
        </div>

        {/* Mobile Item 3 */}
        <div class="relative bg-white p-4 rounded-2xl border border-gray-200 shadow-sm">
          <div class="absolute -left-[31px] top-4 w-4 h-4 rounded-full bg-[#166534] border-2 border-white"></div>
          <div class="flex items-center justify-between gap-2 mb-1">
            <span class="text-xs font-bold text-[#111827] font-['Playfair_Display']">1 Whole Free-Range Egg</span>
            <span class="text-lg">🥚</span>
          </div>
          <span class="text-[11px] text-amber-700 font-bold block">Complete Protein (All 9 Aminos)</span>
          <p class="text-[11px] text-gray-500 mt-0.5">95% net digestibility score for muscle and tissue repair.</p>
        </div>

        {/* Mobile Item 4 */}
        <div class="relative bg-white p-4 rounded-2xl border border-gray-200 shadow-sm">
          <div class="absolute -left-[31px] top-4 w-4 h-4 rounded-full bg-[#166534] border-2 border-white"></div>
          <div class="flex items-center justify-between gap-2 mb-1">
            <span class="text-xs font-bold text-[#111827] font-['Playfair_Display']">1 Glass of Fresh Milk</span>
            <span class="text-lg">🥛</span>
          </div>
          <span class="text-[11px] text-blue-700 font-bold block">Plant Bio-Calcium</span>
          <p class="text-[11px] text-gray-500 mt-0.5">100% lactose-free bone density minerals.</p>
        </div>

        {/* Mobile Item 5 */}
        <div class="relative bg-white p-4 rounded-2xl border border-gray-200 shadow-sm">
          <div class="absolute -left-[31px] top-4 w-4 h-4 rounded-full bg-[#166534] border-2 border-white"></div>
          <div class="flex items-center justify-between gap-2 mb-1">
            <span class="text-xs font-bold text-[#111827] font-['Playfair_Display']">3 Handfuls of Wild Blueberries</span>
            <span class="text-lg">🫐</span>
          </div>
          <span class="text-[11px] text-purple-700 font-bold block">Phycocyanin Antioxidants</span>
          <p class="text-[11px] text-gray-500 mt-0.5">Rare blue anti-inflammatory pigment for cellular longevity.</p>
        </div>

      </div>

    </div>

    {/* 3. Scientific Bio-Absorption Comparison Footer */}
    <div class="bg-white rounded-2xl p-6 sm:p-7 border border-gray-200 shadow-sm flex flex-col md:flex-row items-center justify-between gap-6 mt-8">
      
      <div class="w-full md:w-1/2 space-y-2.5">
        <span class="text-[11px] font-bold uppercase tracking-widest text-[#166534] block">Human Cellular Bio-Absorption Rate</span>
        
        {/* Sujata Rate */}
        <div>
          <div class="flex items-center justify-between text-xs font-bold mb-1">
            <span class="text-[#166534]">🌿 Sujata Raw Cold-Pressed Spirulina</span>
            <span class="text-[#166534] font-black">95% Absorbed</span>
          </div>
          <div class="w-full h-2.5 bg-gray-100 rounded-full overflow-hidden">
            <div class="w-[95%] h-full bg-[#166534] rounded-full"></div>
          </div>
        </div>

        {/* Synthetic Pill Rate */}
        <div>
          <div class="flex items-center justify-between text-xs font-medium text-gray-500 mb-1">
            <span>💊 Synthetic Multivitamin Tablets</span>
            <span>22% Absorbed (78% Excreted)</span>
          </div>
          <div class="w-full h-2.5 bg-gray-100 rounded-full overflow-hidden">
            <div class="w-[22%] h-full bg-gray-400 rounded-full"></div>
          </div>
        </div>
      </div>

      <div class="text-center md:text-right shrink-0">
        <a 
          href="/#product-ecosystem" 
          class="inline-block bg-[#111827] hover:bg-[#166534] text-white px-7 py-3.5 rounded-xl font-bold text-xs uppercase tracking-wider transition-colors shadow-sm active:scale-95 touch-manipulation"
        >
          Explore Formulations →
        </a>
      </div>

    </div>

  </div>
</section>
