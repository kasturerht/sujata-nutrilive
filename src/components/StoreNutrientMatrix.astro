    {/* 2. Side-by-Side Dual Serving Architecture (Powder vs. Capsules) */}
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 max-w-4xl mx-auto mb-12">
      
      {/* Serving A: 3g Whole-Food Powder Scoop */}
      <div class="bg-gradient-to-br from-[#022C22] to-[#064E3B] text-white rounded-3xl p-6 sm:p-8 shadow-xl border border-emerald-400/20 flex flex-col justify-between relative overflow-hidden">
