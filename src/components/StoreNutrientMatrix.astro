<!-- 🥗 Block 6: The Transparent Nutrient & Serving Matrix -->
<section id="nutrient-matrix" class="py-16 md:py-24 bg-[#FAF9F6] text-[#111827] border-t border-gray-200/80 relative overflow-hidden font-sans">
  
  {/* Atmospheric Soft Emerald Glow */}
  <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] md:w-[900px] h-[600px] md:h-[900px] bg-emerald-500/[0.04] rounded-full blur-[140px] pointer-events-none"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-12 relative z-10">
    
    {/* 1. Editorial Header */}
    <div class="text-center max-w-3xl mx-auto mb-10 md:mb-14">
      <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-emerald-100/70 border border-emerald-300/50 mb-3.5 shadow-sm">
        <span class="w-2 h-2 rounded-full bg-emerald-700 animate-pulse"></span>
