---
// src/components/ExitPopup.astro
import { Image } from 'astro:assets';
---

{/* 🌟 1. THE OVERLAY (Background Blur & Safe Areas) */}
<div id="exit-popup-overlay" class="fixed inset-0 z-[100] flex items-center justify-center opacity-0 pointer-events-none transition-all duration-700 ease-[cubic-bezier(0.1,0,0,1)] bg-black/50 backdrop-blur-md p-4 sm:p-6 pb-safe pt-safe" role="dialog" aria-modal="true" aria-label="Special Offer Modal">
  
  {/* 🌟 2. THE POPUP CARD (Keyboard safe with max-h-[90dvh] & vertical scroll) */}
  <div id="exit-popup-card" class="relative w-full max-w-3xl max-h-[90dvh] overflow-y-auto bg-white rounded-[2rem] shadow-[0_40px_80px_rgba(0,0,0,0.25)] transform scale-95 translate-y-4 transition-all duration-700 delay-100 flex flex-col sm:flex-row my-auto border border-gray-100">
    
    {/* Close Button */}
    <button id="close-exit-popup" aria-label="Close popup" class="absolute top-4 right-4 z-50 w-11 h-11 rounded-full bg-gray-100 hover:bg-gray-200 flex items-center justify-center text-gray-500 hover:text-black transition-colors touch-manipulation">
      <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2.5" d="M6 18L18 6M6 6l12 12"></path></svg>
    </button>
 
    {/* LEFT SIDE: Visual Hook (Image & Glowing Background) */}
    <div class="hidden sm:flex sm:w-2/5 bg-[#f0fdf4] relative overflow-hidden items-center justify-center p-8">
      <div class="absolute inset-0 bg-[radial-gradient(circle_at_50%_50%,#166534_0%,transparent_70%)] opacity-10"></div>
      <div class="absolute w-[150%] h-[150%] bg-white rounded-full blur-[60px] opacity-60"></div>
      
      {/* Floating Product Image */}
      <Image src="/spirulina-bottle.png" alt="Sujata Nutrilive" width={180} height={240} class="relative z-10 w-full max-w-[180px] object-contain drop-shadow-2xl animate-[float_4s_ease-in-out_infinite]"/>
      
      {/* Premium Badge */}
      <div class="absolute bottom-6 left-1/2 -translate-x-1/2 bg-white/80 backdrop-blur-sm px-4 py-2 rounded-full shadow-lg border border-white flex items-center gap-2 w-max">
        <div class="flex items-center gap-0.5">
          {[...Array(5)].map((_) => (
            <svg class="w-3 h-3 text-[#F59E0B] fill-current" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
          ))}
        </div>
        <span class="text-[10px] font-bold text-gray-900 uppercase tracking-widest">10k+ Customers</span>
      </div>
    </div>
 
    {/* RIGHT SIDE: The Offer & Form */}
    <div class="w-full sm:w-3/5 p-6 sm:p-12 flex flex-col justify-center">
      
      <span class="text-[#166534] text-xs font-black uppercase tracking-[0.2em] mb-3 flex items-center gap-2">
        <span class="w-2 h-2 rounded-full bg-red-500 animate-pulse"></span>
        Wait! Don't leave your peak behind.
      </span>
      
      <h2 class="text-2xl sm:text-3xl font-['Playfair_Display'] font-black text-[#111827] leading-[1.15] mb-3">
        Unsure what to buy? Get a <span class="text-[#166534] italic">Free Consultation + 10% Off</span>.
      </h2>
      
      <p class="text-gray-500 text-xs sm:text-sm mb-6 leading-relaxed max-w-sm">
        Enter your email below to instantly receive your personalized routine recommendation report and a VIP 10% discount code.
      </p>

      {/* The Form */}
      <div id="promo-form-container">
        <form id="promo-form" class="flex flex-col gap-3">
          <input 
            type="email" 
            id="promo-email"
            placeholder="Enter your best email address" 
            required
            class="w-full bg-gray-50 border border-gray-200 text-gray-900 text-base rounded-xl px-5 py-3.5 focus:ring-2 focus:ring-[#166534] focus:bg-white focus:border-transparent outline-none transition-all"
          />
          <button type="submit" id="unlock-btn" class="w-full bg-[#111827] text-white font-bold text-sm uppercase tracking-widest px-8 py-4 rounded-xl flex items-center justify-center gap-3 transition-all duration-300 hover:bg-[#166534] shadow-[0_10px_20px_rgba(0,0,0,0.1)] touch-manipulation group">
            <span class="btn-text">Reveal My Code</span>
            <svg class="w-4 h-4 transform group-hover:translate-x-1 transition-transform btn-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3"></path></svg>
          </button>
        </form>
        
        {/* The 'No Thanks' link */}
        <div class="text-center mt-4">
          <button id="decline-offer" class="text-xs text-gray-600 uppercase tracking-wider font-semibold hover:text-gray-800 underline decoration-gray-300 underline-offset-4 transition-colors py-2 px-4 touch-manipulation inline-block">
            No thanks, I prefer paying full price
          </button>
        </div>
      </div>

      {/* SUCCESS STATE (Hidden by default) */}
      <div id="promo-success-container" class="hidden flex-col items-center justify-center text-center py-4">
        <div class="w-12 h-12 bg-emerald-100 text-emerald-600 rounded-full flex items-center justify-center mb-4">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"></path></svg>
        </div>
        <h3 class="text-xl font-bold text-[#111827] mb-2">You're In!</h3>
        <p class="text-sm text-gray-500 mb-6">Use this exact code at checkout:</p>
        
        <div class="border-2 border-dashed border-[#166534] bg-[#f0fdf4] px-8 py-4 rounded-xl cursor-pointer hover:bg-emerald-100 transition-colors group" id="copy-code-btn">
          <span class="text-2xl font-black text-[#166534] tracking-widest group-hover:hidden" id="the-code">PEAK10</span>
          <span class="text-sm font-bold text-[#166534] uppercase tracking-widest hidden group-hover:block">Click to Copy</span>
        </div>
      </div>

    </div>
  </div>
</div>

{/* CSS for animations */}
<style is:global>
  @keyframes float {
    0% { transform: translateY(0px); }
    50% { transform: translateY(-10px); }
    100% { transform: translateY(0px); }
  }

  @keyframes fadeInUp {
    from { opacity: 0; transform: translateY(12px); }
    to   { opacity: 1; transform: translateY(0); }
  }
</style>

{/* 🌟 3. THE SMART JAVASCRIPT ENGINE (Cross-Device & Mobile Ready) */}
<script>
  function initExitPopup() {
    const overlay = document.getElementById('exit-popup-overlay');
    const card = document.getElementById('exit-popup-card');
    const closeBtn = document.getElementById('close-exit-popup');
    const declineBtn = document.getElementById('decline-offer');
    
    const formContainer = document.getElementById('promo-form-container');
    const successContainer = document.getElementById('promo-success-container');
    const form = document.getElementById('promo-form');
    const unlockBtn = document.getElementById('unlock-btn');
    const copyBtn = document.getElementById('copy-code-btn');

    if (!overlay || !card) return;

    let popupShown = false;
    const hasSeenPopup = localStorage.getItem('sujata_exit_popup_shown'); 

    const showPopup = () => {
      if (popupShown || hasSeenPopup) return; 

      overlay.classList.remove('opacity-0', 'pointer-events-none');
      overlay.classList.add('opacity-100', 'pointer-events-auto');
      
      card.classList.remove('scale-95', 'translate-y-4');
      card.classList.add('scale-100', 'translate-y-0');
      
      document.body.style.overflow = 'hidden';
      popupShown = true;
      localStorage.setItem('sujata_exit_popup_shown', 'true');
    };

    const hidePopup = () => {
      overlay.classList.remove('opacity-100', 'pointer-events-auto');
      overlay.classList.add('opacity-0', 'pointer-events-none');
      
      card.classList.remove('scale-100', 'translate-y-0');
      card.classList.add('scale-95', 'translate-y-4');
      
      document.body.style.overflow = '';
    };

    // 1. Desktop Trigger: Mouse Leave
    const handleMouseOut = (e: MouseEvent) => {
      if (e.clientY < 0 || e.relatedTarget == null) {
        showPopup();
      }
    };
    setTimeout(() => {
      document.addEventListener('mouseout', handleMouseOut);
    }, 2000);

    // 2. Mobile Trigger: Rapid Scroll Up after reading down
    let maxScrollY = 0;
    let lastScrollY = window.scrollY;
    const handleScroll = () => {
      const currentScrollY = window.scrollY;
      if (currentScrollY > maxScrollY) {
        maxScrollY = currentScrollY;
      }
      
      // If user scrolled down at least 400px and then scrolls up rapidly by 150px
      if (maxScrollY > 400 && (maxScrollY - currentScrollY > 150) && currentScrollY < 300) {
        showPopup();
      }
      lastScrollY = currentScrollY;
    };
    window.addEventListener('scroll', handleScroll, { passive: true });

    // 3. Fallback Trigger: Inactivity / Time on page (30s)
    const timerTrigger = setTimeout(() => {
      showPopup();
    }, 30000);

    // Close Events
    closeBtn?.addEventListener('click', hidePopup);
    declineBtn?.addEventListener('click', hidePopup);
    overlay?.addEventListener('click', (e) => {
      if (e.target === overlay) hidePopup();
    });

    // Keyboard Dismiss
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && popupShown) {
        hidePopup();
      }
    });

    // Form Submission
    form?.addEventListener('submit', (e) => {
      e.preventDefault();
      clearTimeout(timerTrigger);
      
      const btnText = unlockBtn?.querySelector('.btn-text') as HTMLElement | null;
      const btnIcon = unlockBtn?.querySelector('.btn-icon');
      
      if (unlockBtn && btnText) {
        unlockBtn.classList.add('pointer-events-none', '!bg-[#166534]');
        btnText.innerText = 'GENERATING...';
        btnIcon?.classList.add('hidden');
      }

      setTimeout(() => {
        try {
          localStorage.setItem('sujata_discount_code', 'PEAK10');
        } catch(e) {}
        formContainer?.classList.add('hidden');
        successContainer?.classList.remove('hidden');
        successContainer?.classList.add('flex', 'animate-[fadeInUp_0.5s_ease-out]');
      }, 800);
    });

    // Copy Code Feature
    copyBtn?.addEventListener('click', () => {
      const theCodeEl = document.getElementById('the-code');
      const code = theCodeEl ? theCodeEl.innerText.trim() : 'PEAK10';
      try {
        localStorage.setItem('sujata_discount_code', code);
      } catch(e) {}
      navigator.clipboard.writeText(code);
      
      copyBtn.innerHTML = `<span class="text-sm font-bold text-[#166534] uppercase tracking-widest">✔ COPIED!</span>`;
      
      setTimeout(() => {
        hidePopup();
      }, 1500);
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initExitPopup);
  } else {
    initExitPopup();
  }
  document.addEventListener('astro:page-load', initExitPopup);
</script>