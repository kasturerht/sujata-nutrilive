---
// src/components/LearnRelatedGuides.astro
// Topic-cluster mesh for /learn: every guide links to every other guide and to the core product pages
// with descriptive anchors, so no article (or money page) depends on the footer alone to be discovered.
interface Props {
  current: string; // slug of the current guide, e.g. "spirulina-in-marathi"
}
const { current } = Astro.props;

const guides = [
  { slug: 'spirulina-price-in-india-buyers-guide', title: 'Spirulina price in India: cost per day and per gram', tag: 'Buyer guide' },
  { slug: 'spirulina-tablets-vs-capsules-vs-powder', title: 'Spirulina tablets vs capsules vs powder: which to buy', tag: 'Buyer guide' },
  { slug: 'best-spirulina-brand-in-india', title: 'Best spirulina brand in India: how to check purity', tag: 'Buyer guide' },
  { slug: 'how-to-take-spirulina', title: 'How to take spirulina: dosage, timing & 5 mistakes', tag: 'How-to' },
  { slug: 'spirulina-for-weight-loss', title: 'Spirulina for an active lifestyle: daily plant protein', tag: 'Daily routine' },
  { slug: 'spirulina-benefits-for-women', title: 'Spirulina for women: natural plant iron & complete protein', tag: "Women's nutrition" },
  { slug: 'sea-buckthorn-capsules-buyers-guide', title: 'Sea buckthorn capsules: uses, dosage and price', tag: 'Buyer guide' },
  { slug: 'which-company-sea-buckthorn-is-best', title: 'Which sea buckthorn company is best', tag: 'Buyer guide' },
  { slug: 'sea-buckthorn-for-dry-eyes', title: 'Himalayan Omega-7: a rare daily plant nutrient', tag: 'Daily nutrient' },
  { slug: 'sea-buckthorn-for-fatty-liver-and-diabetes', title: 'Himalayan Omega-7: daily metabolic wellness routine', tag: 'Daily nutrient' },
  { slug: 'sea-buckthorn-benefits-for-skin-in-hindi', title: 'सी बकथॉर्न त्वचा के लिए: ग्लोइंग स्किन', tag: 'हिंदी' },
  { slug: 'spirulina-in-marathi', title: 'स्पिरुलिना म्हणजे काय? फायदे व किंमत', tag: 'मराठी' },
  { slug: 'spirulina-side-effects-in-marathi', title: 'स्पिरुलिनाचे दुष्परिणाम आणि कोणी घेऊ नये', tag: 'मराठी' },
  { slug: 'spirulina-in-hindi', title: 'स्पिरुलिना क्या है? फायदे, खुराक और कीमत', tag: 'हिंदी' },
  { slug: 'sea-buckthorn-in-hindi', title: 'सी बकथॉर्न क्या है? फायदे, खुराक और नुकसान', tag: 'हिंदी' }
].filter((g) => g.slug !== current);

const products = [
  { href: '/product/sujata-spirulina-capsules', label: 'Spirulina capsules (500mg veg)' },
  { href: '/product/sujata-spirulina-tablets', label: 'Spirulina tablets (no binders)' },
  { href: '/product/sujata-spirulina-powder', label: 'Organic spirulina powder (100g)' },
  { href: '/product/sujata-sea-buckthorn-capsules', label: 'Himalayan sea buckthorn capsules' },
  { href: '/product/sujata-spirulina-sea-buckthorn-combo-pack', label: 'Spirulina + sea buckthorn combo pack' }
];
---

<nav aria-labelledby="related-guides-heading" class="bg-[#FAF9F6] border-t border-gray-200 py-12 px-4 sm:px-6">
  <div class="max-w-4xl mx-auto">
    <h2 id="related-guides-heading" class="font-['Playfair_Display'] text-2xl font-bold text-[#111827]">More Sujata buyer guides</h2>
    <ul class="mt-5 grid gap-3 sm:grid-cols-2">
      {guides.map((g) => (
        <li>
          <a href={`/learn/${g.slug}`} class="group flex items-start justify-between gap-3 rounded-2xl border border-gray-200 bg-white px-4 py-3.5 hover:border-emerald-700 transition-colors">
            <span class="text-sm font-semibold text-[#111827] group-hover:text-emerald-800">{g.title}</span>
            <span class="shrink-0 text-[10px] font-bold uppercase tracking-wider text-emerald-800 bg-emerald-50 rounded-full px-2 py-0.5">{g.tag}</span>
          </a>
        </li>
      ))}
    </ul>
    <p class="mt-7 text-xs font-bold uppercase tracking-[0.18em] text-gray-500">Shop the lab-tested range</p>
    <ul class="mt-3 flex flex-wrap gap-2">
      {products.map((p) => (
        <li><a href={p.href} class="inline-block rounded-full border border-emerald-800/20 bg-white px-3.5 py-1.5 text-xs font-semibold text-emerald-900 hover:bg-emerald-50">{p.label}</a></li>
      ))}
    </ul>
  </div>
</nav>
