---
// src/components/StoreConviction.astro
// "Why Sujata?" comparison. Every Sujata-side claim must be provable (lab report, formulation,
// licence). The facility video tour moved to StoreAuthorityVault (Founder & Proof section).
import { BRAND_CONFIG } from '../config/brand';
const lab = BRAND_CONFIG.labReport;

const rows = [
  {
    param: "Lab Transparency",
    hint: "Can you see the test results yourself?",
    sujata: `Full lab report published (#${lab.number})`,
    other: "Test reports rarely shared with buyers",
  },
  {
    param: "Binders & Fillers",
    hint: "What else is inside the tablet or capsule?",
    sujata: "0% binders, talc or fillers. 100% spirulina",
    other: "Often uses binders like PVP K30, talc or magnesium stearate",
  },
  {
    param: "Cultivation",
    hint: "How and where the algae is grown",
    sujata: "100% pure, chemical-free hydro-cultivated",
    other: "Often open ponds exposed to dust and runoff",
  },
  {
    param: "Drying Temperature",
    hint: "High heat can damage delicate proteins and pigments",
    sujata: "Dried at low temperature (below 40°C)",
    other: "Often high-heat spray drying",
  },
  {
    param: "Taste & Odour",
    hint: "Crucial for sticking to a daily habit",
    sujata: "No fishy smell. Odourless veg capsules",
    other: "Pond-like, swampy smell and bitter taste",
  },
];
---

<section id="why-sujata" aria-labelledby="why-sujata-heading" class="py-16 md:py-24 bg-[#FCFBF7] text-[#111827] font-sans border-t border-gray-200/80">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-12">

    <div class="text-center max-w-3xl mx-auto mb-10 md:mb-14">
      <span class="inline-block text-[11px] font-bold uppercase tracking-[0.2em] text-[#166534] mb-3">The Purity Standard</span>
      <h2 id="why-sujata-heading" class="text-3xl sm:text-4xl md:text-5xl font-serif font-normal tracking-tight leading-tight mb-3">
        Sujata vs Ordinary <span class="italic text-[#166534]">Market Spirulina</span>
      </h2>
      <p class="text-xs sm:text-sm md:text-base text-gray-600 max-w-xl mx-auto leading-relaxed">
        Five things to check before you buy any spirulina, and how Sujata compares.
      </p>
    </div>

    {/* Desktop table */}
    <div class="hidden md:block overflow-hidden bg-white rounded-3xl border border-gray-200/90 shadow-xl">
      <table class="w-full border-collapse text-left">
        <thead>
          <tr class="border-b border-gray-200">
            <th scope="col" class="p-5 lg:p-6 text-xs font-bold text-gray-500 uppercase tracking-wider w-[32%] bg-gray-50/70">What to check</th>
            <th scope="col" class="p-5 lg:p-6 bg-[#064E3B] text-white text-xs font-black uppercase tracking-wider text-center w-[36%]">Sujata Nutrilive</th>
            <th scope="col" class="p-5 lg:p-6 bg-gray-50 text-xs font-bold text-gray-400 uppercase tracking-wider text-center w-[32%]">Ordinary Market Spirulina</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-100 text-sm">
          {rows.map((r) => (
            <tr>
              <th scope="row" class="p-5 lg:p-6 font-bold text-[#111827]">
                {r.param}
                <span class="block text-xs font-normal text-gray-500 mt-0.5">{r.hint}</span>
              </th>
              <td class="p-5 lg:p-6 bg-emerald-50/40 text-center font-bold text-[#064E3B] border-x border-emerald-600/10">
                <span class="text-emerald-600 mr-1.5" aria-hidden="true">✓</span>{r.sujata}
              </td>
              <td class="p-5 lg:p-6 text-gray-500 text-center">{r.other}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    {/* Mobile cards */}
    <div class="md:hidden space-y-3">
      {rows.map((r) => (
        <div class="bg-white rounded-2xl border border-gray-200 p-4 shadow-sm">
          <h3 class="text-sm font-bold text-[#111827] mb-2.5">{r.param}</h3>
          <div class="space-y-2">
            <p class="bg-[#064E3B] text-white p-3 rounded-xl text-xs font-semibold leading-snug">
              <span class="block text-[10px] font-bold text-emerald-300 uppercase tracking-wider mb-0.5">✓ Sujata</span>{r.sujata}
            </p>
            <p class="bg-gray-50 border border-gray-200 p-2.5 rounded-xl text-gray-500 text-xs leading-snug">
              <span class="block text-[10px] font-bold uppercase tracking-wider text-gray-400 mb-0.5">✕ Ordinary brands</span>{r.other}
            </p>
          </div>
        </div>
      ))}
    </div>

  </div>
</section>
