---
// src/components/StoreTrustBadges.astro
---

<section id="trust-signals-bar" class="w-full bg-white border-y border-gray-200/70 py-8 md:py-10 font-sans relative overflow-hidden">
  
  <div class="max-w-[92rem] mx-auto px-4 sm:px-6 lg:px-12 relative z-10">
    
    {/* 5-Pillar High-Trust Indian Wellness Grid */}
    <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-4 sm:gap-6 lg:gap-8">
      
      {/* 1. FSSAI Approved */}
      <div class="flex items-center gap-3 p-3 sm:p-3.5 rounded-2xl bg-[#FAF9F6] border border-gray-100 shadow-sm hover:border-emerald-200 transition-colors">
        <div class="w-10 h-10 rounded-xl bg-emerald-50 border border-emerald-100 flex items-center justify-center text-emerald-800 text-lg shrink-0">
          🇮🇳
        </div>
        <div class="min-w-0">
          <h4 class="text-xs font-bold text-[#111827] uppercase tracking-wider font-sans truncate">FSSAI Approved</h4>
          <p class="text-[11px] text-gray-500 font-medium font-sans truncate">Govt Safety Certified</p>
        </div>
      </div>

      {/* 2. NABL Lab Tested */}
      <div class="flex items-center gap-3 p-3 sm:p-3.5 rounded-2xl bg-[#FAF9F6] border border-gray-100 shadow-sm hover:border-emerald-200 transition-colors">
        <div class="w-10 h-10 rounded-xl bg-emerald-50 border border-emerald-100 flex items-center justify-center text-emerald-800 text-lg shrink-0">
          🧪
        </div>
        <div class="min-w-0">
          <h4 class="text-xs font-bold text-[#111827] uppercase tracking-wider font-sans truncate">NABL Lab Tested</h4>
          <p class="text-[11px] text-gray-500 font-medium font-sans truncate">0.00% Lead & Mercury</p>
        </div>
      </div>

      {/* 3. 100% Vegetarian (Green Dot) */}
      <div class="flex items-center gap-3 p-3 sm:p-3.5 rounded-2xl bg-[#FAF9F6] border border-gray-100 shadow-sm hover:border-emerald-200 transition-colors">
        <div class="w-10 h-10 rounded-xl bg-emerald-50 border border-emerald-100 flex items-center justify-center text-emerald-800 text-lg shrink-0">
          🟢
        </div>
        <div class="min-w-0">
          <h4 class="text-xs font-bold text-[#111827] uppercase tracking-wider font-sans truncate">100% Vegetarian</h4>
          <p class="text-[11px] text-gray-500 font-medium font-sans truncate">Zero Gelatin Capsules</p>
        </div>
      </div>

      {/* 4. Sub-40°C Cold-Pressed */}
      <div class="flex items-center gap-3 p-3 sm:p-3.5 rounded-2xl bg-[#FAF9F6] border border-gray-100 shadow-sm hover:border-emerald-200 transition-colors">
        <div class="w-10 h-10 rounded-xl bg-emerald-50 border border-emerald-100 flex items-center justify-center text-emerald-800 text-lg shrink-0">
          ❄️
        </div>
        <div class="min-w-0">
          <h4 class="text-xs font-bold text-[#111827] uppercase tracking-wider font-sans truncate">Cold-Pressed</h4>
          <p class="text-[11px] text-gray-500 font-medium font-sans truncate">Live Active Enzymes</p>
        </div>
      </div>

      {/* 5. Free COD Across India */}
      <div class="flex items-center gap-3 p-3 sm:p-3.5 rounded-2xl bg-[#FAF9F6] border border-gray-100 shadow-sm hover:border-emerald-200 transition-colors col-span-2 sm:col-span-1">
        <div class="w-10 h-10 rounded-xl bg-emerald-50 border border-emerald-100 flex items-center justify-center text-emerald-800 text-lg shrink-0">
          💵
        </div>
        <div class="min-w-0">
          <h4 class="text-xs font-bold text-[#111827] uppercase tracking-wider font-sans truncate">Free Cash on Delivery</h4>
          <p class="text-[11px] text-gray-500 font-medium font-sans truncate">25,000+ Pincodes</p>
        </div>
      </div>

    </div>

  </div>

</section>
