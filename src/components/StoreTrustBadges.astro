---
// src/components/StoreTrustBadges.astro
// Compact trust strip. Every badge is a checkable fact (licence number, downloadable report).
import { BRAND_CONFIG } from '../config/brand';
const lab = BRAND_CONFIG.labReport;

const badges = [
  { icon: '🇮🇳', title: 'FSSAI Registered', detail: `Lic. ${BRAND_CONFIG.fssaiNumber}`, href: null },
  { icon: '🧪', title: 'Lab Report Published', detail: `#${lab.number} ↗`, href: lab.pdfUrl },
  { icon: '🟢', title: '100% Vegetarian', detail: 'Plant-based capsule shells', href: null },
  { icon: '💵', title: 'Free COD', detail: 'Dispatches in 24h', href: null },
];
---

<section id="trust-signals-bar" aria-label="Trust and quality" class="w-full bg-[#FAF9F6] border-b border-gray-200/70 py-2.5 sm:py-3.5 font-sans">
  <ul class="max-w-[94rem] mx-auto px-3 sm:px-6 lg:px-12 grid grid-cols-2 lg:grid-cols-4 gap-1.5 sm:gap-3 lg:gap-4">
    {badges.map((b) => {
      const inner = (
        <>
          <span aria-hidden="true" class="w-7 h-7 sm:w-8 sm:h-8 rounded-lg bg-emerald-50/80 border border-emerald-100 flex items-center justify-center text-xs sm:text-sm shrink-0">{b.icon}</span>
          <span class="min-w-0">
            <span class="block text-[10.5px] sm:text-xs font-bold text-[#111827] uppercase tracking-wide truncate leading-tight">{b.title}</span>
            <span class="block text-[9.5px] sm:text-[10.5px] text-[#166534] font-medium font-mono truncate leading-tight">{b.detail}</span>
          </span>
        </>
      );
      return (
        <li class="rounded-xl bg-white border border-gray-200/80 shadow-sm hover:border-emerald-300 transition-colors">
          {b.href ? (
            <a href={b.href} target="_blank" rel="noopener" class="flex items-center gap-2 sm:gap-2.5 p-1.5 sm:p-2.5">{inner}</a>
          ) : (
            <div class="flex items-center gap-2 sm:gap-2.5 p-1.5 sm:p-2.5">{inner}</div>
          )}
        </li>
      );
    })}
  </ul>
</section>
