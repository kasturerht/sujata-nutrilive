---
// src/components/StoreBundles.astro
import { Image } from 'astro:assets';
---

<section id="bundles-section" class="relative bg-[#F3F4F6] py-20 lg:py-32 font-['Inter'] overflow-hidden border-t border-gray-200">
  
  <div class="max-w-[85rem] mx-auto px-6 lg:px-12 relative z-10">
    
    {/* Section Header */}
    <div class="text-center max-w-3xl mx-auto mb-16 md:mb-24">
      <span class="text-[#166534] text-[10px] md:text-xs font-bold tracking-[0.3em] uppercase mb-4 block">
        Bestselling Combos
      </span>
      <h2 class="text-3xl md:text-5xl font-['Playfair_Display'] font-black text-gray-900 leading-tight">
        Save Extra With Our <span class="italic text-[#166534]">Value Bundles.</span>
      </h2>
      <p class="text-gray-600 text-sm md:text-base mt-4">
        Save up to 17% with our specially curated wellness kits. Free Shipping & Cash on Delivery (COD) included on all bundles.
      </p>
    </div>

    {/* Bundles Grid / Mobile Horizontal Slider */}
    <div class="flex md:grid md:grid-cols-3 gap-6 md:gap-8 lg:gap-10 overflow-x-auto md:overflow-x-visible snap-x snap-mandatory no-scrollbar pb-8 -mx-6 px-6 md:mx-0 md:px-0 scroll-smooth">
      
      {/* BUNDLE 1: Starter Combo */}
      <div class="group relative bg-white border border-gray-200/80 rounded-[2.5rem] p-6 lg:p-8 hover:border-emerald-500/30 hover:shadow-[0_30px_60px_rgba(22,101,52,0.06)] transition-all duration-500 flex flex-col justify-between h-full w-[85vw] md:w-auto snap-center shrink-0">
        
        {/* Hot badge */}
        <div class="absolute -top-3.5 left-8 bg-[#166534] text-white text-[11px] font-black uppercase tracking-widest px-4 py-1.5 rounded-full border border-emerald-400/30 shadow-md">
          Most Popular Combo
        </div>

        <div>
          {/* Images preview */}
          <div class="h-44 bg-[#F9FAFB] rounded-2xl flex items-center justify-center p-4 gap-2 relative overflow-hidden mb-6">
            <Image src="/spirulina-bottle.png" alt="Capsules" width={100} height={120} class="h-32 object-contain drop-shadow-md transform group-hover:-translate-y-1 transition-transform duration-500" />
            <span class="text-2xl font-black text-[#166534] z-10">+</span>
            <Image src="/spirulina-powder.png" alt="Powder" width={100} height={120} class="h-32 object-contain drop-shadow-md transform group-hover:translate-y-1 transition-transform duration-500" />
          </div>

          {/* Details */}
          <div class="flex items-center gap-1.5 mb-3">
            <div class="flex text-[#D97706] text-xs">★★★★★</div>
            <span class="text-xs font-bold text-gray-500 tracking-wider">4.9 (420+ reviews)</span>
          </div>

          <h3 class="text-xl lg:text-2xl font-['Playfair_Display'] font-black text-gray-900 mb-2">Sujata Starter Combo</h3>
          <p class="text-gray-500 text-xs mb-6">1x Premium Capsules (120 Caps) + 1x Pure Powder (100g). Perfect kit to experience both formats.</p>

          <div class="border-t border-gray-100 pt-4 mb-6">
            <div class="flex items-center gap-2 mb-1">
              <span class="text-xs text-gray-400 line-through">₹1,800</span>
              <span class="text-[11px] font-black text-[#166534] bg-[#f0fdf4] px-2 py-0.5 rounded-sm uppercase tracking-widest">SAVE ₹301</span>
            </div>
            <div class="flex items-baseline gap-2">
              <span class="text-3xl font-black text-gray-900">₹1,499</span>
              <span class="text-xs font-semibold text-gray-500">/ Complete Kit</span>
            </div>
            <div class="text-xs text-emerald-700 font-bold mt-2 flex items-center gap-1">
              <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
              Paisa-Vasool: Only ₹25/day per serving
            </div>
          </div>
        </div>

        <button 
          class="add-to-cart-btn w-full bg-[#111827] hover:bg-[#166534] text-white py-4 rounded-xl font-bold text-sm uppercase tracking-wider transition-all duration-300 touch-manipulation"
          data-variant-ids="gid://shopify/ProductVariant/52738357854340,gid://shopify/ProductVariant/52738357985412"
        >
          Add to Routine
        </button>

      </div>

      {/* BUNDLE 2: Double Capsules Pack */}
      <div class="group relative bg-white border border-gray-200/80 rounded-[2.5rem] p-6 lg:p-8 hover:border-emerald-500/30 hover:shadow-[0_30px_60px_rgba(22,101,52,0.06)] transition-all duration-500 flex flex-col justify-between h-full w-[85vw] md:w-auto snap-center shrink-0">
        
        {/* Hot badge */}
        <div class="absolute -top-3.5 left-8 bg-[#D97706] text-white text-[11px] font-black uppercase tracking-widest px-4 py-1.5 rounded-full border border-amber-400/30 shadow-md">
          Best Value
        </div>

        <div>
          <span class="text-xs font-mono font-bold tracking-widest text-emerald-800 uppercase block mb-1">Double Energy Protocol</span>
          <h3 class="text-2xl font-bold font-['Playfair_Display'] text-gray-900 mb-2">Double Capsules Pack</h3>
          <p class="text-xs text-gray-500 mb-6 leading-relaxed">
            Two 60-count bottles of sub-40°C cold-pressed Spirulina capsules. Total 120 capsules for a complete 60-day protocol.
          </p>

          <ul class="space-y-2.5 text-xs text-gray-600 mb-6">
            <li class="flex items-center gap-2">
              <span class="text-[#166534] font-bold">✓</span>
              <span><strong>120 Pure Vegan Capsules</strong></span>
            </li>
            <li class="flex items-center gap-2">
              <span class="text-[#166534] font-bold">✓</span>
              <span><strong>Full 60-Day Protocol</strong> (Save More)</span>
            </li>
            <li class="flex items-center gap-2">
              <span class="text-[#166534] font-bold">✓</span>
              <span>Free Air-Express Delivery</span>
            </li>
          </ul>

          <div class="border-t border-gray-100 pt-4 mb-6">
            <div class="flex items-center gap-2 mb-1">
              <span class="text-xs text-gray-400 line-through">₹2,400</span>
              <span class="text-[11px] font-black text-[#166534] bg-[#f0fdf4] px-2 py-0.5 rounded-sm uppercase tracking-widest">SAVE ₹501</span>
            </div>
            <div class="flex items-baseline gap-2">
              <span class="text-3xl font-black text-gray-900">₹1,899</span>
              <span class="text-xs font-semibold text-gray-500">/ 2 Bottles</span>
            </div>
            <div class="text-xs text-emerald-700 font-bold mt-2 flex items-center gap-1">
              <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
              Family Pack: Only ₹15/capsule
            </div>
          </div>
        </div>

        <button 
          class="add-to-cart-btn w-full bg-[#111827] hover:bg-[#166534] text-white py-4 rounded-xl font-bold text-sm uppercase tracking-wider transition-all duration-300 touch-manipulation"
          data-variant-ids="gid://shopify/ProductVariant/52738357985412,gid://shopify/ProductVariant/52738357985412"
        >
          Add to Routine
        </button>

      </div>

      {/* BUNDLE 3: Powder Double Value */}
      <div class="group relative bg-white border border-gray-200/80 rounded-[2.5rem] p-6 lg:p-8 hover:border-emerald-500/30 hover:shadow-[0_30px_60px_rgba(22,101,52,0.06)] transition-all duration-500 flex flex-col justify-between h-full w-[85vw] md:w-auto snap-center shrink-0">
        
        <div>
          <span class="text-xs font-mono font-bold tracking-widest text-emerald-800 uppercase block mb-1">Smoothie Lovers Protocol</span>
          <h3 class="text-2xl font-bold font-['Playfair_Display'] text-gray-900 mb-2">Powder Double Pack</h3>
          <p class="text-xs text-gray-500 mb-6 leading-relaxed">
            Two 100g resealable pouches of pure raw cryo-milled spirulina. Total 200g of high-potency green gold.
          </p>

          <ul class="space-y-2.5 text-xs text-gray-600 mb-6">
            <li class="flex items-center gap-2">
              <span class="text-[#166534] font-bold">✓</span>
              <span><strong>200g Pure Cryo Powder</strong></span>
            </li>
            <li class="flex items-center gap-2">
              <span class="text-[#166534] font-bold">✓</span>
              <span><strong>60+ Superfood Smoothies</strong></span>
            </li>
            <li class="flex items-center gap-2">
              <span class="text-[#166534] font-bold">✓</span>
              <span>Free Airtight Measuring Scoop</span>
            </li>
          </ul>

          <div class="border-t border-gray-100 pt-4 mb-6">
            <div class="flex items-center gap-2 mb-1">
              <span class="text-xs text-gray-400 line-through">₹1,200</span>
              <span class="text-[11px] font-black text-[#166534] bg-[#f0fdf4] px-2 py-0.5 rounded-sm uppercase tracking-widest">SAVE ₹201</span>
            </div>
            <div class="flex items-baseline gap-2">
              <span class="text-3xl font-black text-gray-900">₹999</span>
              <span class="text-xs font-semibold text-gray-500">/ 200 Grams</span>
            </div>
            <div class="text-xs text-emerald-700 font-bold mt-2 flex items-center gap-1">
              <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
              Ultra Economical: ₹5/gram
            </div>
          </div>
        </div>

        <button 
          class="add-to-cart-btn w-full bg-[#111827] hover:bg-[#166534] text-white py-4 rounded-xl font-bold text-sm uppercase tracking-wider transition-all duration-300 touch-manipulation"
          data-variant-ids="gid://shopify/ProductVariant/52738357854340,gid://shopify/ProductVariant/52738357854340"
        >
          Add to Routine
        </button>

      </div>

    </div>

  </div>
</section>

<style>
  .no-scrollbar::-webkit-scrollbar { display: none; }
  .no-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }
</style>
