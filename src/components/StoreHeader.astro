---
// src/components/StoreHeader.astro
import { BRAND_CONFIG, getWhatsAppLink } from '../config/brand';
---

<header id="main-header" class="fixed top-0 w-full z-[100] transition-all duration-300 pt-safe bg-[#022C22]">
  
  {/* 1. ANNOUNCEMENT BAR (High-Trust Clinical Strip) */}
  <div class="w-full bg-[#022C22] text-white overflow-hidden py-2 border-b border-white/10">
    <div class="flex whitespace-nowrap animate-[marquee_25s_linear_infinite] hover:pause">
      {BRAND_CONFIG.announcementTickers.map((ticker) => (
        <span class="text-[9px] md:text-[10px] font-bold uppercase tracking-[0.2em] px-6 border-r border-white/10 flex items-center gap-2 opacity-95">
          <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
          {ticker}
        </span>
      ))}
      {/* Loop duplicate for seamless infinite scrolling */}
      {BRAND_CONFIG.announcementTickers.map((ticker) => (
        <span class="text-[9px] md:text-[10px] font-bold uppercase tracking-[0.2em] px-6 border-r border-white/10 flex items-center gap-2 opacity-95">
          <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
          {ticker}
        </span>
      ))}
    </div>
  </div>

  {/* 2. THE LUXURY UTILITY HEADER */}
  <nav id="main-nav" class="bg-[#064E3B] border-b border-[#043d2e] px-4 md:px-8 py-3 lg:py-4 shadow-xl transition-all duration-500 ease-in-out">
    <div class="max-w-[95rem] mx-auto flex items-center justify-between gap-4 md:gap-8">
      
      {/* Left: Mobile Menu Button & Brand Logo */}
      <div class="flex items-center gap-3">
        <!-- Hamburger Menu Button (Mobile/Tablet) -->
        <button 
          id="mobile-menu-trigger" 
          aria-label="Open Navigation Menu" 
          class="lg:hidden w-11 h-11 rounded-full bg-white/10 hover:bg-white/20 border border-white/10 flex items-center justify-center text-white transition-colors touch-manipulation focus:outline-none"
        >
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
          </svg>
        </button>

        {/* Logo */}
        <a href="/" class="flex-shrink-0">
          <h1 class="text-2xl md:text-3xl font-black text-white tracking-tighter font-['Playfair_Display']">
            SUJATA<span class="text-emerald-400">.</span>
          </h1>
        </a>
      </div>

      {/* Desktop Links (Hidden on small screens) */}
      <div class="hidden xl:flex items-center gap-6 text-xs font-bold uppercase tracking-widest text-emerald-100/80">
        <a href="/#product-ecosystem" class="hover:text-emerald-300 transition-colors">Products</a>
        <a href="/science" class="hover:text-emerald-300 transition-colors">The Science</a>
        <a href="/quiz" class="hover:text-emerald-300 transition-colors flex items-center gap-1.5"><span class="text-amber-400">⚡</span> <span>Routine Quiz</span></a>
        <a href="/#bundle-offers" class="hover:text-emerald-300 transition-colors">Value Bundles</a>
        <a href="/#reviews-section" class="hover:text-emerald-300 transition-colors">Reviews</a>
      </div>

      {/* Desktop Pincode Tracker */}
      <div class="hidden lg:flex items-center gap-2.5 cursor-pointer group relative" id="pincode-trigger">
        <div class="w-9 h-9 rounded-full bg-white/10 flex items-center justify-center group-hover:bg-white/20 transition-colors border border-white/10">
          <svg class="w-4 h-4 text-emerald-100 group-hover:text-white transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path></svg>
        </div>
        <div class="flex flex-col">
          <span class="text-[9px] uppercase font-bold text-emerald-200/70 tracking-wider">Deliver to</span>
          <span class="text-[11px] font-bold text-white transition-colors" id="display-pincode">Check Pincode</span>
        </div>
        
        {/* Sleek Popup */}
        <div id="pincode-popup" class="absolute top-[120%] left-0 w-64 bg-white shadow-[0_20px_40px_rgba(0,0,0,0.2)] rounded-2xl p-5 border border-gray-100 opacity-0 pointer-events-none transition-all duration-300 scale-95 origin-top-left z-50">
          <p class="text-xs font-bold text-[#111827] mb-3">Verify Pincode</p>
          <div class="flex gap-2">
            <input type="text" id="pincode-input" maxlength="6" placeholder="e.g. 411001" class="w-full bg-gray-50 border border-gray-200 rounded-xl px-3 py-2 text-xs focus:ring-2 focus:ring-[#166534] focus:bg-white outline-none transition-all text-black" />
            <button id="verify-btn" class="bg-[#111827] text-white px-4 py-2 rounded-xl text-[10px] font-bold uppercase tracking-widest hover:bg-[#166534] transition-colors shadow-md">Set</button>
          </div>
          <p id="pincode-status" class="text-[9px] mt-2 hidden"></p>
        </div>
      </div>

      {/* Main Search Trigger (Desktop) */}
      <div id="desktop-search-trigger" class="hidden md:block flex-1 max-w-md lg:max-w-lg relative group cursor-pointer" role="button" tabindex="0" aria-label="Open Product Search">
        <div class="w-full bg-black/20 hover:bg-black/30 border border-white/10 text-white rounded-full px-5 py-2.5 md:py-3 text-xs md:text-sm flex items-center justify-between transition-all pl-12 shadow-inner group-hover:border-emerald-400/40">
          <span class="text-emerald-100/60 font-medium">Search formulations, powders, capsules...</span>
          <kbd class="hidden lg:inline-flex items-center gap-0.5 px-2 py-0.5 bg-white/10 rounded text-[10px] font-mono text-emerald-200/80 border border-white/10">⌘K</kbd>
        </div>
        <svg class="absolute left-4 top-1/2 -translate-y-1/2 w-4 h-4 text-emerald-100/60 group-hover:text-emerald-400 transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path></svg>
      </div>

      {/* Action Icons */}
      <div class="flex items-center gap-2 sm:gap-4">
        {/* Mobile Search Button */}
        <button 
          id="mobile-search-btn" 
          type="button"
          aria-label="Search Formulations" 
          class="md:hidden w-11 h-11 rounded-full bg-white/10 hover:bg-white/20 border border-white/10 flex items-center justify-center text-white transition-colors touch-manipulation"
        >
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path></svg>
        </button>

        {/* Track Order / Account Link */}
        <a href="/track-order" aria-label="Track Order" title="Track Your Order" class="hidden sm:flex flex-col items-center gap-1 group">
          <div class="w-10 h-10 rounded-full hover:bg-white/10 flex items-center justify-center transition-colors">
            <svg class="w-5 h-5 text-emerald-50 group-hover:text-white transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path></svg>
          </div>
        </a>
        
        {/* Cart Trigger */}
        <button id="cart-drawer-trigger" aria-label="View Shopping Cart" class="relative group bg-emerald-800/60 border border-white/20 p-2.5 sm:px-5 sm:py-2.5 rounded-full flex items-center gap-2.5 hover:bg-white hover:border-white transition-all shadow-lg hover:shadow-xl touch-manipulation">
          <svg class="w-5 h-5 text-white group-hover:text-[#064E3B] transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"></path></svg>
          <span class="hidden md:block text-xs font-bold uppercase tracking-widest text-white group-hover:text-[#064E3B] transition-colors">Cart</span>
          <span id="header-cart-badge" style="display: none;" class="absolute -top-1 -right-1 sm:top-auto sm:right-auto sm:relative w-5 h-5 bg-amber-500 text-white text-[10px] font-black rounded-full flex items-center justify-center shadow-[0_0_10px_rgba(245,158,11,0.4)]">0</span>
        </button>
      </div>

    </div>
  </nav>
</header>

  {/* 🌟 3. MOBILE SLIDE-OUT NAVIGATION DRAWER (Silicon Valley / Luxury D2C Architecture) */}
  <div id="mobile-nav-overlay" class="fixed inset-0 z-[240] bg-black/75 backdrop-blur-md opacity-0 pointer-events-none transition-opacity duration-500 ease-out lg:hidden"></div>
  
  <aside 
    id="mobile-nav-drawer" 
    class="fixed top-0 left-0 bottom-0 z-[250] w-[88vw] sm:w-[380px] max-w-full h-[100dvh] bg-[#022C22] text-white shadow-[25px_0_60px_rgba(0,0,0,0.75)] transform -translate-x-full transition-transform duration-500 ease-[cubic-bezier(0.16,1,0.3,1)] flex flex-col justify-between lg:hidden border-r border-emerald-500/20 font-sans"
    aria-label="Mobile Navigation"
  >
    {/* 1. Header (Pinned Top) */}
    <div class="px-5 py-4 border-b border-white/10 flex items-center justify-between bg-black/20 shrink-0">
      <div class="flex flex-col">
        <span class="text-xl font-black text-white font-serif tracking-tight">
          SUJATA<span class="text-emerald-400">.</span>
        </span>
        <span class="text-[9px] uppercase tracking-[0.2em] text-emerald-200/60 font-bold font-sans">Pure Cryo-Nutraceuticals</span>
      </div>
      <button 
        id="close-mobile-menu" 
        type="button"
        aria-label="Close navigation menu" 
        class="w-10 h-10 rounded-full bg-white/10 hover:bg-white/20 active:scale-95 flex items-center justify-center text-white transition-all touch-manipulation cursor-pointer border border-white/10"
      >
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"></path></svg>
      </button>
    </div>

    {/* 2. Scrollable Drawer Body (Zero Bloat, High-Conversion Navigation) */}
    <div class="flex-1 overflow-y-auto overscroll-contain px-4 py-4 space-y-5 no-scrollbar">
      
      {/* 1-Min Routine Quiz Card */}
      <a 
        href="/quiz" 
        class="mobile-nav-link block p-3.5 rounded-2xl bg-gradient-to-r from-emerald-900/80 via-[#064E3B] to-emerald-900/80 border border-emerald-400/30 shadow-md group active:scale-98 transition-all touch-manipulation cursor-pointer"
      >
        <div class="flex items-center justify-between gap-2">
          <div class="flex items-center gap-2.5">
            <span class="text-xl">🧬</span>
            <div>
              <div class="text-xs font-bold text-white font-sans flex items-center gap-1.5">
                <span>1-Min Formulation Quiz</span>
                <span class="bg-amber-400 text-black text-[8px] font-black uppercase px-1.5 py-0.2 rounded-full leading-none">Smart</span>
              </div>
              <p class="text-[10px] text-emerald-200/70 font-sans mt-0.5">Find your custom Ayurvedic dose</p>
            </div>
          </div>
          <span class="text-amber-400 text-sm font-bold group-hover:translate-x-1 transition-transform">→</span>
        </div>
      </a>

      {/* Categories / Formulations List */}
      <div>
        <span class="text-[9.5px] font-bold uppercase tracking-[0.2em] text-emerald-300/70 block mb-2 px-1 font-sans">
          Shop By Category
        </span>
        <div class="space-y-1">
          {/* All Formulations */}
          <a 
            href="/#product-ecosystem" 
            data-category="all" 
            class="mobile-nav-link mobile-category-link flex items-center justify-between p-2.5 rounded-xl hover:bg-white/5 active:bg-white/10 transition-colors group cursor-pointer"
          >
            <div class="flex items-center gap-3">
              <span class="w-8 h-8 rounded-lg bg-white/5 border border-white/10 flex items-center justify-center text-sm">✨</span>
              <div>
                <span class="text-xs font-bold text-white group-hover:text-emerald-300 transition-colors font-sans block">All Formulations</span>
                <span class="text-[10px] text-emerald-100/50 font-sans">Explore full 16 products</span>
              </div>
            </div>
            <span class="text-emerald-100/40 group-hover:text-emerald-300 text-xs transition-colors">›</span>
          </a>

          {/* Nutrition & Superfoods */}
          <a 
            href="/#product-ecosystem" 
            data-category="nutrition" 
            class="mobile-nav-link mobile-category-link flex items-center justify-between p-2.5 rounded-xl hover:bg-white/5 active:bg-white/10 transition-colors group cursor-pointer"
          >
            <div class="flex items-center gap-3">
              <span class="w-8 h-8 rounded-lg bg-white/5 border border-white/10 flex items-center justify-center text-sm">🌿</span>
              <div>
                <span class="text-xs font-bold text-white group-hover:text-emerald-300 transition-colors font-sans block">Nutrition & Superfoods</span>
                <span class="text-[10px] text-emerald-100/50 font-sans">Spirulina, Sea Buckthorn, Shilajit</span>
              </div>
            </div>
            <span class="text-emerald-100/40 group-hover:text-emerald-300 text-xs transition-colors">›</span>
          </a>

          {/* Skin & Face Care */}
          <a 
            href="/#product-ecosystem" 
            data-category="skincare" 
            class="mobile-nav-link mobile-category-link flex items-center justify-between p-2.5 rounded-xl hover:bg-white/5 active:bg-white/10 transition-colors group cursor-pointer"
          >
            <div class="flex items-center gap-3">
              <span class="w-8 h-8 rounded-lg bg-white/5 border border-white/10 flex items-center justify-center text-sm">🌸</span>
              <div>
                <span class="text-xs font-bold text-white group-hover:text-emerald-300 transition-colors font-sans block">Skin & Face Care</span>
                <span class="text-[10px] text-emerald-100/50 font-sans">K-Beauty Cream, Facewash, Pack</span>
              </div>
            </div>
            <span class="text-emerald-100/40 group-hover:text-emerald-300 text-xs transition-colors">›</span>
          </a>

          {/* Hair Care */}
          <a 
            href="/#product-ecosystem" 
            data-category="haircare" 
            class="mobile-nav-link mobile-category-link flex items-center justify-between p-2.5 rounded-xl hover:bg-white/5 active:bg-white/10 transition-colors group cursor-pointer"
          >
            <div class="flex items-center gap-3">
              <span class="w-8 h-8 rounded-lg bg-white/5 border border-white/10 flex items-center justify-center text-sm">💆</span>
              <div>
                <span class="text-xs font-bold text-white group-hover:text-emerald-300 transition-colors font-sans block">Hair Care</span>
                <span class="text-[10px] text-emerald-100/50 font-sans">Hair Oil, Shampoo & Conditioner</span>
              </div>
            </div>
            <span class="text-emerald-100/40 group-hover:text-emerald-300 text-xs transition-colors">›</span>
          </a>

          {/* Value Combos */}
          <a 
            href="/#product-ecosystem" 
            data-category="combos" 
            class="mobile-nav-link mobile-category-link flex items-center justify-between p-2.5 rounded-xl hover:bg-white/5 active:bg-white/10 transition-colors group cursor-pointer"
          >
            <div class="flex items-center gap-3">
              <span class="w-8 h-8 rounded-lg bg-amber-500/10 border border-amber-400/20 flex items-center justify-center text-sm">📦</span>
              <div>
                <span class="text-xs font-bold text-white group-hover:text-amber-300 transition-colors font-sans block">Value Combos & Kits</span>
                <span class="text-[10px] text-amber-200/70 font-sans">Curated Synergy (Save 30%)</span>
              </div>
            </div>
            <span class="text-amber-400 text-xs font-bold bg-amber-400/15 px-2 py-0.5 rounded-full">30% OFF</span>
          </a>
        </div>
      </div>

      {/* Brand & Proof Links */}
      <div>
        <span class="text-[9.5px] font-bold uppercase tracking-[0.2em] text-emerald-300/70 block mb-2 px-1 font-sans">
          Trust & Authority
        </span>
        <div class="space-y-1">
          <a 
            href="/science" 
            class="mobile-nav-link flex items-center justify-between p-2.5 rounded-xl hover:bg-white/5 transition-colors group cursor-pointer"
          >
            <div class="flex items-center gap-3">
              <span class="text-sm">🧪</span>
              <span class="text-xs font-semibold text-emerald-100/90 group-hover:text-white font-sans">Clinical Science & Lab Tests</span>
            </div>
            <span class="text-[9.5px] text-emerald-300 font-sans font-medium bg-emerald-500/15 px-2 py-0.5 rounded">NABL 0.00%</span>
          </a>
          <a 
            href="/#reviews-section" 
            class="mobile-nav-link flex items-center justify-between p-2.5 rounded-xl hover:bg-white/5 transition-colors group cursor-pointer"
          >
            <div class="flex items-center gap-3">
              <span class="text-sm">⭐</span>
              <span class="text-xs font-semibold text-emerald-100/90 group-hover:text-white font-sans">50,000+ Verified Patient Reviews</span>
            </div>
            <span class="text-[10px] text-amber-400 font-bold font-sans">4.9 ★</span>
          </a>
        </div>
      </div>

      {/* Support & Orders */}
      <div>
        <span class="text-[9.5px] font-bold uppercase tracking-[0.2em] text-emerald-300/70 block mb-2 px-1 font-sans">
          Help & Tracking
        </span>
        <div class="space-y-1">
          <a 
            href="/track-order" 
            class="mobile-nav-link flex items-center justify-between p-2.5 rounded-xl hover:bg-white/5 transition-colors group cursor-pointer"
          >
            <div class="flex items-center gap-3">
              <span class="text-sm">🚚</span>
              <span class="text-xs font-semibold text-emerald-100/90 group-hover:text-white font-sans">Track Your Order</span>
            </div>
            <span class="text-emerald-100/40 text-xs">›</span>
          </a>
          <a 
            href="/contact" 
            class="mobile-nav-link flex items-center justify-between p-2.5 rounded-xl hover:bg-white/5 transition-colors group cursor-pointer"
          >
            <div class="flex items-center gap-3">
              <span class="text-sm">📞</span>
              <span class="text-xs font-semibold text-emerald-100/90 group-hover:text-white font-sans">Contact & Vaidya Support</span>
            </div>
            <span class="text-emerald-100/40 text-xs">›</span>
          </a>
        </div>
      </div>

    </div>

    {/* 3. Footer (Native App Safe Area Clearance) */}
    <div class="p-4 border-t border-white/10 bg-black/20 shrink-0" style="padding-bottom: max(1rem, calc(0.75rem + env(safe-area-inset-bottom, 0px)));">
      <a 
        href={getWhatsAppLink('Hello Sujata Nutrilive, I need help with my wellness order.')} 
        target="_blank" 
        rel="noopener noreferrer" 
        class="w-full bg-[#25D366]/15 hover:bg-[#25D366]/25 border border-[#25D366]/40 text-[#25D366] py-3 px-4 rounded-xl font-bold text-xs uppercase tracking-wider flex items-center justify-center gap-2 transition-all active:scale-95 touch-manipulation shadow-xs font-sans"
      >
        <svg class="w-4 h-4 fill-current shrink-0" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51a12.8 12.8 0 00-.57-.01c-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/></svg>
        <span>WhatsApp Vaidya Support</span>
      </a>
      <p class="text-[10px] text-center text-emerald-200/50 mt-2 font-sans font-medium">
        🔒 100% Genuine • FSSAI Govt Safety Certified
      </p>
    </div>
  </aside>

<style is:global>
  @keyframes marquee { 0% { transform: translateX(0); } 100% { transform: translateX(-50%); } }
  .no-scrollbar::-webkit-scrollbar { display: none; }
  .no-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }
</style>

<script>
  function initHeaderSystem() {
    // 1. Pincode System (Desktop & Mobile Synchronized)
    const trigger = document.getElementById('pincode-trigger');
    const popup = document.getElementById('pincode-popup');
    const input = document.getElementById('pincode-input') as HTMLInputElement | null;
    const verifyBtn = document.getElementById('verify-btn');
    const status = document.getElementById('pincode-status');
    const display = document.getElementById('display-pincode');

    // Mobile Pincode elements
    const mobileDisplay = document.getElementById('mobile-display-pincode');
    const mobileInput = document.getElementById('mobile-pincode-input') as HTMLInputElement | null;
    const mobileVerifyBtn = document.getElementById('mobile-verify-btn');
    const mobileStatus = document.getElementById('mobile-pincode-status');

    const updatePincodeDisplay = (val: string) => {
      if (display) display.innerText = `Deliver to ${val}`;
      if (mobileDisplay) mobileDisplay.innerText = `Deliver to: ${val} ✓`;
      if (input) input.value = val;
      if (mobileInput) mobileInput.value = val;
      window.dispatchEvent(new CustomEvent('pincode-updated', { detail: { pincode: val } }));
    };

    const savedPincode = localStorage.getItem('sujata_pincode');
    if (savedPincode) {
      updatePincodeDisplay(savedPincode);
    }

    const togglePopup = (show: boolean) => {
      if (!popup || !input) return;
      if (show) {
        popup.classList.remove('opacity-0', 'pointer-events-none', 'scale-95');
        popup.classList.add('opacity-100', 'pointer-events-auto', 'scale-100');
        input.focus();
      } else {
        popup.classList.remove('opacity-100', 'pointer-events-auto', 'scale-100');
        popup.classList.add('opacity-0', 'pointer-events-none', 'scale-95');
      }
    };

    trigger?.addEventListener('click', (e) => {
      const target = e.target as HTMLElement;
      if (target.closest('#pincode-popup')) return;
      const isVisible = popup?.classList.contains('opacity-100');
      togglePopup(!isVisible);
    });

    document.addEventListener('click', (e) => {
      const target = e.target as HTMLElement;
      if (trigger && !trigger.contains(target)) {
        togglePopup(false);
      }
    });

    const handlePincodeSubmit = (val: string, statusEl: HTMLElement | null, onSuccess?: () => void) => {
      const cleanVal = (val || '').trim();
      const isValid = /^[1-9]\d{5}$/.test(cleanVal);
      if (!statusEl) return;
      statusEl.classList.remove('hidden', 'text-red-400', 'text-red-500', 'text-emerald-400', 'text-emerald-600');

      if (!isValid) {
        statusEl.innerText = 'Please enter a valid 6-digit Indian PIN code.';
        statusEl.classList.add('text-red-400');
      } else {
        statusEl.innerText = 'Serviceable! Express delivery available. 🚚';
        statusEl.classList.add('text-emerald-400');
        localStorage.setItem('sujata_pincode', cleanVal);
        updatePincodeDisplay(cleanVal);
        if (onSuccess) setTimeout(onSuccess, 1200);
      }
    };

    verifyBtn?.addEventListener('click', (e) => {
      e.stopPropagation();
      if (input) handlePincodeSubmit(input.value.trim(), status, () => {
        togglePopup(false);
        if (status) status.classList.add('hidden');
      });
    });

    mobileVerifyBtn?.addEventListener('click', () => {
      if (mobileInput) handlePincodeSubmit(mobileInput.value.trim(), mobileStatus);
    });

    // 2. Mobile Navigation Drawer System
    const menuTrigger = document.getElementById('mobile-menu-trigger');
    const menuOverlay = document.getElementById('mobile-nav-overlay');
    const menuDrawer = document.getElementById('mobile-nav-drawer');
    const closeMenuBtn = document.getElementById('close-mobile-menu');
    const mobileSearchBtn = document.getElementById('mobile-search-btn');
    const mobileSearchInput = document.getElementById('mobile-search-input');
    const navLinks = document.querySelectorAll('.mobile-nav-link');

    const openMenu = () => {
      if (!menuDrawer || !menuOverlay) return;
      menuOverlay.classList.remove('opacity-0', 'pointer-events-none');
      menuOverlay.classList.add('opacity-100', 'pointer-events-auto');
      menuDrawer.classList.remove('-translate-x-full');
      menuDrawer.classList.add('translate-x-0');
      document.body.style.overflow = 'hidden';
    };

    const closeMenu = () => {
      if (!menuDrawer || !menuOverlay) return;
      menuOverlay.classList.remove('opacity-100', 'pointer-events-auto');
      menuOverlay.classList.add('opacity-0', 'pointer-events-none');
      menuDrawer.classList.remove('translate-x-0');
      menuDrawer.classList.add('-translate-x-full');
      document.body.style.overflow = '';
    };

    const desktopSearchTrigger = document.getElementById('desktop-search-trigger');
    const drawerSearchTrigger = document.getElementById('drawer-search-trigger');

    menuTrigger?.addEventListener('click', openMenu);
    closeMenuBtn?.addEventListener('click', closeMenu);
    menuOverlay?.addEventListener('click', closeMenu);

    desktopSearchTrigger?.addEventListener('click', () => {
      if (typeof window.openSearchModal === 'function') {
        window.openSearchModal();
      }
    });

    mobileSearchBtn?.addEventListener('click', () => {
      if (typeof window.openSearchModal === 'function') {
        window.openSearchModal();
      }
    });

    drawerSearchTrigger?.addEventListener('click', () => {
      closeMenu();
      setTimeout(() => {
        if (typeof window.openSearchModal === 'function') {
          window.openSearchModal();
        }
      }, 250);
    });

    navLinks.forEach(link => {
      link.addEventListener('click', closeMenu);
    });

    const categoryLinks = document.querySelectorAll('.mobile-category-link');
    categoryLinks.forEach(link => {
      link.addEventListener('click', (e) => {
        const cat = link.getAttribute('data-category');
        closeMenu();
        if (window.location.pathname === '/' || window.location.pathname === '') {
          e.preventDefault();
          const target = document.getElementById('product-ecosystem');
          if (target) {
            const offsetTop = target.offsetTop - 70;
            window.scrollTo({ top: offsetTop, behavior: 'smooth' });
            if (cat) {
              setTimeout(() => {
                const filterBtn = document.querySelector(`.shop-filter-btn[data-filter="${cat}"]`) as HTMLElement | null;
                if (filterBtn) filterBtn.click();
              }, 300);
            }
          }
        }
      });
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        closeMenu();
        togglePopup(false);
      }
    });

    // 3. Header Scroll Glassmorphism
    const nav = document.getElementById('main-nav');
    if (nav) {
      const handleScroll = () => {
        if (window.scrollY > 50) {
          nav.classList.remove('bg-[#064E3B]', 'py-3', 'lg:py-4', 'border-[#043d2e]');
          nav.classList.add('bg-[#064E3B]/90', 'backdrop-blur-md', 'py-2.5', 'lg:py-3', 'border-b', 'border-[#043d2e]/50', 'shadow-lg');
        } else {
          nav.classList.remove('bg-[#064E3B]/90', 'backdrop-blur-md', 'py-2.5', 'lg:py-3', 'border-b', 'border-[#043d2e]/50', 'shadow-lg');
          nav.classList.add('bg-[#064E3B]', 'py-3', 'lg:py-4', 'border-[#043d2e]');
        }
      };
      window.addEventListener('scroll', handleScroll, { passive: true });
      handleScroll();
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initHeaderSystem);
  } else {
    initHeaderSystem();
  }
  document.addEventListener('astro:page-load', initHeaderSystem);
</script>