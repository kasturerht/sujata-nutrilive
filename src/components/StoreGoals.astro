---
// src/components/StoreGoals.astro
---

<section id="shop-by-goal" class="relative bg-[#022C22] py-16 md:py-24 font-sans overflow-hidden border-b border-white/5 text-white">
  
  {/* Ambient Background Light */}
  <div class="absolute top-0 right-0 w-[40vw] h-[40vw] bg-emerald-500/10 rounded-full blur-[100px] pointer-events-none"></div>

  <div class="max-w-[92rem] mx-auto px-5 sm:px-8 lg:px-12 relative z-10">
    
    {/* Section Header */}
    <div class="text-center max-w-2xl mx-auto mb-12 md:mb-16">
      <span class="text-emerald-400 text-[10px] md:text-xs font-bold tracking-[0.25em] uppercase mb-2.5 block font-sans">
        Targeted Ayurvedic Nutrition
      </span>
      <h2 class="text-3xl sm:text-4xl md:text-5xl font-serif font-normal text-white leading-tight">
        Shop By Health <span class="italic text-emerald-300">Need.</span>
      </h2>
      <p class="text-emerald-100/70 text-xs sm:text-sm md:text-base mt-3 leading-relaxed font-sans">
        Select your primary concern to discover the doctor-curated protocol formulated for your body.
      </p>
    </div>

    {/* 4 Targeted Intent Cards (Mobile Horizontal Scroll / Desktop 4-Col Grid) */}
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5 sm:gap-6">
      
      {/* 1. All-Day Energy & Stamina */}
      <a 
        href="#product-ecosystem" 
        data-goal-filter="nutrition"
        class="goal-card group bg-white/5 hover:bg-white/10 border border-white/10 hover:border-emerald-400/40 rounded-3xl p-6 sm:p-7 flex flex-col justify-between transition-all duration-300 cursor-pointer shadow-lg hover:-translate-y-1"
      >
        <div>
          <div class="w-14 h-14 rounded-2xl bg-amber-400/15 border border-amber-400/30 flex items-center justify-center text-2xl mb-5 group-hover:scale-110 transition-transform">
            ⚡
          </div>
          <span class="text-[10px] font-bold uppercase tracking-widest text-amber-300 block mb-1 font-sans">For Low Stamina</span>
          <h3 class="text-lg sm:text-xl font-bold text-white mb-2.5 font-serif leading-snug">All-Day Energy & Iron</h3>
          <p class="text-xs text-emerald-100/70 leading-relaxed font-sans mb-6">
            Banish 3 PM fatigue, morning brain fog, and low hemoglobin with natural organic non-heme iron.
          </p>
        </div>
        <span class="text-xs font-bold text-emerald-300 uppercase tracking-wider flex items-center gap-1.5 group-hover:gap-2.5 transition-all font-sans">
          <span>Explore Formulations</span>
          <span>→</span>
        </span>
      </a>

      {/* 2. Gut Cleanse & Acidity */}
      <a 
        href="#product-ecosystem" 
        data-goal-filter="nutrition"
        class="goal-card group bg-white/5 hover:bg-white/10 border border-white/10 hover:border-emerald-400/40 rounded-3xl p-6 sm:p-7 flex flex-col justify-between transition-all duration-300 cursor-pointer shadow-lg hover:-translate-y-1"
      >
        <div>
          <div class="w-14 h-14 rounded-2xl bg-emerald-400/15 border border-emerald-400/30 flex items-center justify-center text-2xl mb-5 group-hover:scale-110 transition-transform">
            🌿
          </div>
          <span class="text-[10px] font-bold uppercase tracking-widest text-emerald-300 block mb-1 font-sans">For Digestion</span>
          <h3 class="text-lg sm:text-xl font-bold text-white mb-2.5 font-serif leading-snug">Gut Cleanse & Acidity</h3>
          <p class="text-xs text-emerald-100/70 leading-relaxed font-sans mb-6">
            Alkalize gut pH, eliminate chronic acid reflux, and restore microbiome balance via pure chlorophyll.
          </p>
        </div>
        <span class="text-xs font-bold text-emerald-300 uppercase tracking-wider flex items-center gap-1.5 group-hover:gap-2.5 transition-all font-sans">
          <span>Explore Formulations</span>
          <span>→</span>
        </span>
      </a>

      {/* 3. Hair Density & Skin Radiance */}
      <a 
        href="#product-ecosystem" 
        data-goal-filter="skincare"
        class="goal-card group bg-white/5 hover:bg-white/10 border border-white/10 hover:border-emerald-400/40 rounded-3xl p-6 sm:p-7 flex flex-col justify-between transition-all duration-300 cursor-pointer shadow-lg hover:-translate-y-1"
      >
        <div>
          <div class="w-14 h-14 rounded-2xl bg-pink-400/15 border border-pink-400/30 flex items-center justify-center text-2xl mb-5 group-hover:scale-110 transition-transform">
            ✨
          </div>
          <span class="text-[10px] font-bold uppercase tracking-widest text-pink-300 block mb-1 font-sans">For Glow & Hair Fall</span>
          <h3 class="text-lg sm:text-xl font-bold text-white mb-2.5 font-serif leading-snug">Hair Density & Glow</h3>
          <p class="text-xs text-emerald-100/70 leading-relaxed font-sans mb-6">
            Stop hair thinning and hydrate deep skin dermal layers with rare Himalayan Omega 7 & bio-antioxidants.
          </p>
        </div>
        <span class="text-xs font-bold text-emerald-300 uppercase tracking-wider flex items-center gap-1.5 group-hover:gap-2.5 transition-all font-sans">
          <span>Explore Formulations</span>
          <span>→</span>
        </span>
      </a>

      {/* 4. 360° Value Combos */}
      <a 
        href="#product-ecosystem" 
        data-goal-filter="combos"
        class="goal-card group bg-white/5 hover:bg-white/10 border border-white/10 hover:border-emerald-400/40 rounded-3xl p-6 sm:p-7 flex flex-col justify-between transition-all duration-300 cursor-pointer shadow-lg hover:-translate-y-1"
      >
        <div>
          <div class="w-14 h-14 rounded-2xl bg-purple-400/15 border border-purple-400/30 flex items-center justify-center text-2xl mb-5 group-hover:scale-110 transition-transform">
            📦
          </div>
          <span class="text-[10px] font-bold uppercase tracking-widest text-purple-300 block mb-1 font-sans">Best Household Value</span>
          <h3 class="text-lg sm:text-xl font-bold text-white mb-2.5 font-serif leading-snug">360° Wellness Combos</h3>
          <p class="text-xs text-emerald-100/70 leading-relaxed font-sans mb-6">
            Synergistic kits combining daily spirulina with wild sea buckthorn. Maximum immunity and savings.
          </p>
        </div>
        <span class="text-xs font-bold text-emerald-300 uppercase tracking-wider flex items-center gap-1.5 group-hover:gap-2.5 transition-all font-sans">
          <span>Explore Combos (Save 30%)</span>
          <span>→</span>
        </span>
      </a>

    </div>

  </div>

</section>

<script is:inline>
  document.addEventListener('click', (e) => {
    const goalCard = e.target.closest('.goal-card');
    if (goalCard) {
      const filter = goalCard.getAttribute('data-goal-filter');
      if (filter) {
        const filterBtn = document.querySelector(`.shop-filter-btn[data-filter="${filter}"]`);
        if (filterBtn) {
          filterBtn.click();
        }
      }
    }
  });
</script>