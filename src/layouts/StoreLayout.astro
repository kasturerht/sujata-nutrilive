    "@type": "Product",
    "@id": `${siteUrl}/#product-spirulina`,
    "name": "Sujata Cold-Pressed Spirulina (Tablets & Raw Powder)",
    "description": "100% pure, sub-40°C cold-pressed Spirulina with 62.3% plant protein (IS 7219), 291.15 mg/kg natural iron (as Fe), and zero fishy odour. Laboratory certified with FSSAI statutory safety compliance.",
    "sku": "SJT-SP-TAB-60",
    "mpn": "SJT-SP-TAB-60",
    "asin": "B0GMQYS6M4",
    "sameAs": [
