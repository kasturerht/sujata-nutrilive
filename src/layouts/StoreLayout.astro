      "priceCurrency": "INR",
      "offerCount": "4",
      "validFrom": "2024-01-01",
      "priceValidUntil": "2027-12-31",
      "availability": "https://schema.org/InStock",
      "seller": {
        "@id": `${siteUrl}/#organization`
      },
      "shippingDetails": {
        "@type": "OfferShippingDetails",
        "shippingRate": {
          "@type": "MonetaryAmount",
          "value": "0",
          "currency": "INR"
        },
        "shippingDestination": {
          "@type": "DefinedRegion",
          "addressCountry": "IN"
        },
        "deliveryTime": {
          "@type": "ShippingDeliveryTime",
          "handlingTime": {
            "@type": "QuantitativeValue",
            "minValue": 0,
            "maxValue": 1,
            "unitCode": "d"
          },
          "transitTime": {
            "@type": "QuantitativeValue",
            "minValue": 2,
            "maxValue": 5,
            "unitCode": "d"
          }
        }
      },
      "hasMerchantReturnPolicy": {
        "@type": "MerchantReturnPolicy",
        "applicableCountry": "IN",
        "returnPolicyCategory": "https://schema.org/MerchantReturnFiniteReturnWindow",
        "merchantReturnDays": 40,
        "returnMethod": "https://schema.org/ReturnByMail",
        "returnFees": "https://schema.org/FreeReturn"
      }
    }
  });

  // Flagship Sea Buckthorn Product Showcase
  schemaGraphItems.push({
    "@type": "Product",
    "@id": `${siteUrl}/#product-seabuckthorn`,
    "name": "Sujata Pure Himalayan Sea Buckthorn Capsules (60 Veg Caps)",
    "description": "100% wild-harvested Himalayan Sea Buckthorn Capsules. Richest plant source of rare Omega-7, 3, 6, 9 and 12x Vitamin C. Zero sugar, zero preservatives, NABL lab tested.",
    "sku": "SJT-SB-CAP-60",
    "mpn": "SJT-SB-CAP-60",
    "gtin13": "8908012345077",
    "image": [
      new URL("/products/sujata-sea-buckthorn-capsules-bottle-transparent.png", siteUrl).toString()
    ],
    "brand": {
      "@type": "Brand",
      "@id": `${siteUrl}/#organization`,
