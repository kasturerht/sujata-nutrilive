---
// src/layouts/StoreLayout.astro
import CartDrawer from '../components/CartDrawer.astro';
import StoreSearchModal from '../components/StoreSearchModal.astro';
import StoreBottomNav from '../components/StoreBottomNav.astro';
import WhatsAppConcierge from '../components/WhatsAppConcierge.astro';
import { BRAND_CONFIG } from '../config/brand';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  isHomePage?: boolean;
  noindex?: boolean;
  hideBottomNav?: boolean;
  extraSchema?: any[];
}

const { 
  title = "Buy Pure Organic Spirulina in India | Cold-Pressed Tablets & Powder - Sujata Nutrilive",
  description = "Buy 100% pure cold-pressed Spirulina in India. NABL lab-certified, FSSAI-approved, odorless vegetarian capsules & raw powder. Free express delivery & 40-day evaluation guarantee.",
  image = "/products/sujata-combo-spirulina-sea-buckthorn.jpg",
  isHomePage = false,
  noindex = false,
  hideBottomNav = false,
  extraSchema = []
} = Astro.props;

const siteUrl = BRAND_CONFIG.siteUrl || "https://www.sujatanutrilive.com";
const canonicalURL = new URL(Astro.url.pathname, siteUrl).toString();
const ogImageURL = new URL(image, siteUrl).toString();

const metaPixelId = import.meta.env.PUBLIC_META_PIXEL_ID || "1314112957191765";
const googleTagId = import.meta.env.PUBLIC_GA4_ID || import.meta.env.PUBLIC_GTAG_ID || "G-5WZ8DNW2PD";
const fbDomainVerification = import.meta.env.PUBLIC_FACEBOOK_DOMAIN_VERIFICATION || "4u1oycwawhemmpli8xnp0mencq1puj";

// =========================================================================
// 🌟 SILICON VALLEY UNIFIED SCHEMA.ORG @GRAPH (Knowledge Graph & GEO Rich Snippets)
// =========================================================================
const schemaGraphItems: any[] = [
  // 1. Organization & HealthAndBeautyBusiness Entity
