---
// src/layouts/StoreLayout.astro
import CartDrawer from '../components/CartDrawer.astro';
import StoreSearchModal from '../components/StoreSearchModal.astro';
import StoreBottomNav from '../components/StoreBottomNav.astro';
import { BRAND_CONFIG } from '../config/brand';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  isHomePage?: boolean;
  noindex?: boolean;
}

const { 
  title = "Buy Pure Organic Spirulina in India | Cold-Pressed Tablets & Powder - Sujata Nutrilive",
  description = "Buy 100% pure cold-pressed Spirulina in India. NABL lab-certified, FSSAI-approved, odorless vegetarian capsules & raw powder. Free express delivery & 30-day money-back guarantee.",
  image = "/products/sujata-combo-spirulina-sea-buckthorn.jpg",
  isHomePage = false,
  noindex = false
} = Astro.props;

const siteUrl = BRAND_CONFIG.siteUrl || "https://sujatanutrilive.com";
const canonicalURL = new URL(Astro.url.pathname, siteUrl).toString();
const ogImageURL = new URL(image, siteUrl).toString();

const metaPixelId = import.meta.env.PUBLIC_META_PIXEL_ID || "1314112957191765";
const googleTagId = import.meta.env.PUBLIC_GA4_ID || import.meta.env.PUBLIC_GTAG_ID || "";
const fbDomainVerification = import.meta.env.PUBLIC_FACEBOOK_DOMAIN_VERIFICATION || "";

// =========================================================================
// 🌟 SILICON VALLEY UNIFIED SCHEMA.ORG @GRAPH (Knowledge Graph & Rich Snippets)
// =========================================================================
const schemaGraphItems: any[] = [
  // 1. Organization Entity
  {
    "@type": "Organization",
    "@id": `${siteUrl}/#organization`,
    "name": BRAND_CONFIG.brandName,
    "url": siteUrl,
    "logo": {
      "@type": "ImageObject",
      "@id": `${siteUrl}/#logo`,
      "url": new URL("/sujata-logo-transparent.png", siteUrl).toString(),
      "caption": BRAND_CONFIG.brandName
    },
    "description": "India's pioneer in sub-40°C cold-pressed Spirulina and cellular wellness supplements. Certified pure, odorless, and practitioner-governed.",
    "telephone": BRAND_CONFIG.supportPhone,
    "contactPoint": [
      {
        "@type": "ContactPoint",
        "telephone": BRAND_CONFIG.supportPhone,
        "contactType": "customer service",
        "areaServed": "IN",
        "availableLanguage": ["English", "Hindi", "Marathi"]
      }
    ],
    "address": {
      "@type": "PostalAddress",
      "streetAddress": "42/B, Prabhat Road, Deccan Gymkhana",
      "addressLocality": "Pune",
      "addressRegion": "Maharashtra",
      "postalCode": "411004",
      "addressCountry": "IN"
    },
    "sameAs": [
      BRAND_CONFIG.instagramUrl
    ]
  },

  // 2. WebSite Entity with Sitelinks Searchbox
  {
    "@type": "WebSite",
    "@id": `${siteUrl}/#website`,
    "name": BRAND_CONFIG.brandName,
    "url": siteUrl,
    "publisher": {
      "@id": `${siteUrl}/#organization`
    },
    "potentialAction": {
      "@type": "SearchAction",
      "target": `${siteUrl}/#product-ecosystem?search={search_term_string}`,
      "query-input": "required name=search_term_string"
    }
  }
];

// 3. Homepage-Specific Rich Snippets (Product Aggregate Rating + Google FAQ Accordion)
if (isHomePage) {
  // Flagship Product Showcase for Google SERP Gold Star Ratings
  schemaGraphItems.push({
    "@type": "Product",
    "@id": `${siteUrl}/#product-flagship`,
    "name": "Sujata Cold-Pressed Spirulina (Tablets & Raw Powder)",
    "description": "100% pure, sub-40°C cold-pressed Spirulina with 65% complete plant protein, 4x bio-iron, and zero fishy odour. NABL lab tested and FSSAI certified.",
    "image": [
      new URL("/products/sujata-combo-spirulina-sea-buckthorn.jpg", siteUrl).toString(),
      new URL("/products/sujata-spirulina-transparent.png", siteUrl).toString()
    ],
    "brand": {
      "@type": "Brand",
      "name": BRAND_CONFIG.brandName
    },
    "aggregateRating": {
      "@type": "AggregateRating",
      "ratingValue": "4.9",
      "reviewCount": "50000",
      "bestRating": "5",
      "worstRating": "1"
    },
    "offers": {
      "@type": "AggregateOffer",
      "lowPrice": "649",
      "highPrice": "1100",
      "priceCurrency": "INR",
      "offerCount": "4",
      "availability": "https://schema.org/InStock",
      "seller": {
        "@id": `${siteUrl}/#organization`
      }
    }
  });

  // Google Interactive FAQ Accordion Snippets
  schemaGraphItems.push({
    "@type": "FAQPage",
    "@id": `${siteUrl}/#faq`,
    "mainEntity": [
      {
        "@type": "Question",
        "name": "Can I take Sujata Spirulina if I have Thyroid, Diabetes, or High BP?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Yes, absolutely. Pure cold-pressed Spirulina is an organic whole-food microalgae with zero synthetic stimulants, sugar, or synthetic hormones. Because it naturally contains bio-iron and minerals, we simply recommend maintaining a 1-hour gap between your morning allopathic medication and your spirulina ritual."
        }
      },
      {
        "@type": "Question",
        "name": "Will it have a swampy or fishy smell like other spirulina brands?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "No, absolutely not. Cheap spirulina smells foul because it is grown in open outdoor ponds and heated violently. Sujata is cultivated in closed bio-secure hydro-domes and cryo-milled below 40°C, ensuring a fresh, clean herbal taste in powder and 100% odourless vegetarian capsules."
        }
      },
      {
        "@type": "Question",
        "name": "Powder or Capsules: Which format should I choose?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Both contain the identical 100% pure cold-pressed formulation. Choose 100% Veg Capsules if you want an effortless, travel-friendly routine with zero preparation time. Choose Pure Raw Powder if you love mixing your daily superfood into morning lemon water, fruit smoothies, or fresh coconut water."
        }
      },
      {
        "@type": "Question",
        "name": "How does the 30-Day Empty-Bottle Money-Back Guarantee work?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Take your daily dose consistently for 30 days. If you do not feel a noticeable increase in your daily stamina, gut comfort, and overall vitality, simply message our support desk for a 100% full refund to your original payment method. Even if the bottle is empty. Zero interrogations."
        }
      }
    ]
  });
}

const unifiedSchemaGraph = {
  "@context": "https://schema.org",
  "@graph": schemaGraphItems
};
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    
    {/* Robots Control */}
    {noindex ? (
      <meta name="robots" content="noindex, nofollow" />
    ) : (
      <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    )}

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/favicon.svg" />
    <meta name="theme-color" content="#064E3B" />
    <meta name="generator" content={Astro.generator} />
    {fbDomainVerification && <meta name="facebook-domain-verification" content={fbDomainVerification} />}

    {/* OpenGraph / Facebook / WhatsApp Preview Meta Tags */}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={BRAND_CONFIG.brandName} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:locale" content="en_IN" />

    {/* Twitter Cards */}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalURL} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />

    {/* Speed: CDN Preconnect & DNS-Prefetch (Shaves 200ms off LCP) */}
    <link rel="preconnect" href="https://cdn.shopify.com" crossorigin />
    <link rel="dns-prefetch" href="https://cdn.shopify.com" />

    {/* Fonts Preconnect & Preload */}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,600;1,400;1,600&family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" />
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,600;1,400;1,600&family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet" />

    {/* Unified Schema.org Structured Data */}
    <script type="application/ld+json" set:html={JSON.stringify(unifiedSchemaGraph)} />

    {/* 🌟 2026 Resilient Ad Tracking Hub (Meta Pixel & Google Tag) */}
    <script is:inline define:vars={{ metaPixelId, googleTagId }}>
      // 1. First-Party Cookie Engine & UTM Attribution Capture
      (function() {
        try {
          var urlParams = new URLSearchParams(window.location.search);
          var fbclid = urlParams.get('fbclid');
          
          // Capture & Persist _fbc (Meta Click ID)
          if (fbclid) {
            var fbcVal = 'fb.1.' + Date.now() + '.' + fbclid;
            document.cookie = '_fbc=' + fbcVal + ';path=/;max-age=' + (90 * 86400) + ';SameSite=Lax';
            localStorage.setItem('sujata_fbc', fbcVal);
          }
          
          // Ensure _fbp (Meta Browser ID) exists
          var existingFbp = (document.cookie.match(/(^|;\s*)_fbp=([^;]+)/) || [])[2] || localStorage.getItem('sujata_fbp');
          if (!existingFbp) {
            existingFbp = 'fb.1.' + Date.now() + '.' + Math.floor(Math.random() * 1000000000);
            document.cookie = '_fbp=' + existingFbp + ';path=/;max-age=' + (90 * 86400) + ';SameSite=Lax';
            localStorage.setItem('sujata_fbp', existingFbp);
          } else {
            localStorage.setItem('sujata_fbp', existingFbp);
          }

          // Capture UTM campaign attribution
          var utmKeys = ['utm_source', 'utm_medium', 'utm_campaign', 'utm_content', 'utm_term'];
          var utmData = {};
          var hasUtm = false;
          utmKeys.forEach(function(key) {
            var val = urlParams.get(key);
            if (val) {
              utmData[key] = val;
              hasUtm = true;
            }
          });
          if (hasUtm) {
            localStorage.setItem('sujata_utms', JSON.stringify(utmData));
          }
        } catch(e) {}
      })();

      // 2. Meta Pixel (Facebook & Instagram Ads)
      window._fbqConfigured = !!metaPixelId;
      !function(f,b,e,v,n,t,s)
      {if(f.fbq)return;n=f.fbq=function(){n.callMethod?
      n.callMethod.apply(n,arguments):n.queue.push(arguments)};
      if(!f._fbq)f._fbq=n;n.push=n;n.loaded=!0;n.version='2.0';
      n.queue=[];t=b.createElement(e);t.async=!0;
      t.src=v;s=b.getElementsByTagName(e)[0];
      if(metaPixelId){s.parentNode.insertBefore(t,s);}}
      (window, document,'script', 'https://connect.facebook.net/en_US/fbevents.js');
      
      if (metaPixelId) {
        fbq('init', metaPixelId);
        fbq('track', 'PageView');
      }

      // 3. Google Tag (gtag.js / Google Ads & GA4)
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      window.gtag = gtag;
      gtag('js', new Date());

      if (googleTagId) {
        var gScript = document.createElement('script');
        gScript.async = true;
        gScript.src = 'https://www.googletagmanager.com/gtag/js?id=' + googleTagId;
        document.head.appendChild(gScript);
        gtag('config', googleTagId, { send_page_view: true });
      }

      // 🌟 4. Unified Full-Funnel E-Commerce Analytics Dispatcher
      window.dispatchStoreEvent = function(eventName, data) {
        data = data || {};

        // === META PIXEL TRACKING ===
        if (typeof window.fbq === 'function') {
          if (eventName === 'ViewContent') {
            window.fbq('track', 'ViewContent', {
              content_name: data.title || '',
              content_ids: [data.id || ''],
              content_type: 'product',
              value: Number(data.price || 0),
              currency: data.currency || 'INR'
            });
          } else if (eventName === 'AddToCart') {
            window.fbq('track', 'AddToCart', {
              content_name: data.title || '',
              content_ids: [data.id || ''],
              content_type: 'product',
              value: Number(data.price || 0),
              currency: data.currency || 'INR'
            });
          } else if (eventName === 'InitiateCheckout') {
            window.fbq('track', 'InitiateCheckout', {
              num_items: Number(data.count || 1),
              value: Number(data.total || 0),
              currency: data.currency || 'INR',
              content_ids: (data.items || []).map(function(i) { return i.id || ''; })
            });
          } else if (eventName === 'Search') {
            window.fbq('track', 'Search', {
              search_string: data.query || data.search_string || ''
            });
          } else if (eventName === 'Lead') {
            window.fbq('track', 'Lead', {
              content_name: data.lead_type || 'Lead Capture',
              value: Number(data.value || 0),
              currency: 'INR'
            });
          } else if (eventName === 'Contact') {
            window.fbq('track', 'Contact', {
              content_name: data.channel || 'WhatsApp Support'
            });
          } else if (eventName === 'CompleteRegistration') {
            window.fbq('track', 'CompleteRegistration', {
              content_name: data.content_name || 'Routine Quiz Completed',
              status: true
            });
          } else {
            window.fbq('trackCustom', eventName, data);
          }
        }

        // === GOOGLE ANALYTICS 4 (GA4) TRACKING ===
        if (typeof window.gtag === 'function') {
          if (eventName === 'ViewContent') {
            window.gtag('event', 'view_item', {
              currency: data.currency || 'INR',
              value: Number(data.price || 0),
              items: [{
                item_id: data.id || '',
                item_name: data.title || '',
                price: Number(data.price || 0),
                quantity: 1
              }]
            });
          } else if (eventName === 'AddToCart') {
            window.gtag('event', 'add_to_cart', {
              currency: data.currency || 'INR',
              value: Number(data.price || 0),
              items: [{
                item_id: data.id || '',
                item_name: data.title || '',
                price: Number(data.price || 0),
                quantity: Number(data.quantity || 1)
              }]
            });
          } else if (eventName === 'InitiateCheckout') {
            window.gtag('event', 'begin_checkout', {
              currency: data.currency || 'INR',
              value: Number(data.total || 0),
              items: (data.items || []).map(function(item) {
                return {
                  item_id: item.id || '',
                  item_name: item.title || '',
                  price: Number(item.price || 0),
                  quantity: Number(item.quantity || 1)
                };
              })
            });
          } else if (eventName === 'Search') {
            window.gtag('event', 'search', {
              search_term: data.query || data.search_string || ''
            });
          } else if (eventName === 'Lead') {
            window.gtag('event', 'generate_lead', {
              currency: 'INR',
              value: Number(data.value || 0)
            });
          } else if (eventName === 'Contact') {
            window.gtag('event', 'contact', {
              method: data.channel || 'WhatsApp'
            });
          } else if (eventName === 'CompleteRegistration') {
            window.gtag('event', 'sign_up', {
              method: data.content_name || 'Routine Quiz'
            });
          } else {
            window.gtag('event', eventName, data);
          }
        }
      };

      // 🌟 5. Global Delegated Click Listener for WhatsApp & Phone Support
      document.addEventListener('click', function(e) {
        var waLink = e.target.closest('a[href*="wa.me"], a[href*="api.whatsapp.com"]');
        if (waLink) {
          window.dispatchStoreEvent('Contact', {
            channel: 'WhatsApp',
            url: waLink.getAttribute('href') || ''
          });
        }
        var telLink = e.target.closest('a[href^="tel:"]');
        if (telLink) {
          window.dispatchStoreEvent('Contact', {
            channel: 'Phone Support',
            url: telLink.getAttribute('href') || ''
          });
        }
      }, { passive: true });

      // 🌟 6. Reading Intent / Scroll Depth Listener (50% & 90%)
      (function() {
        var tracked50 = false;
        var tracked90 = false;
        window.addEventListener('scroll', function() {
          var h = document.documentElement, 
              b = document.body,
              st = 'scrollTop',
              sh = 'scrollHeight';
          var percent = ((h[st]||b[st]) / ((h[sh]||b[sh]) - h.clientHeight)) * 100;
          if (!tracked50 && percent >= 50) {
            tracked50 = true;
            if (typeof window.dispatchStoreEvent === 'function') {
              window.dispatchStoreEvent('ScrollDepth', { depth: '50%' });
            }
          }
          if (!tracked90 && percent >= 90) {
            tracked90 = true;
            if (typeof window.dispatchStoreEvent === 'function') {
              window.dispatchStoreEvent('ScrollDepth', { depth: '90%' });
            }
          }
        }, { passive: true });
      })();
    </script>
  </head>
  <body class="bg-[#FAF9F6] text-[#111827] antialiased selection:bg-[#166534]/20 selection:text-[#166534] flex flex-col min-h-screen min-h-[100dvh] relative overflow-x-hidden font-sans">
    <slot />
    <CartDrawer />
    <StoreSearchModal />
    <StoreBottomNav />

    {/* Global Live Purchase Toast (Docked right above Mobile Bottom Bar) */}
    <div 
      id="live-toast" 
      class="fixed z-[90] bg-white/95 backdrop-blur-xl border border-black/[0.05] shadow-[0_20px_40px_rgba(0,0,0,0.12)] p-3 pr-6 rounded-2xl flex items-center gap-4 translate-y-[150%] opacity-0 transition-all duration-700 ease-[cubic-bezier(0.1,0,0,1)] cursor-pointer select-none"
      style="bottom: max(4.75rem, calc(4.25rem + env(safe-area-inset-bottom, 0px))); left: max(1rem, calc(0.75rem + env(safe-area-inset-left, 0px)));"
      role="status"
      aria-live="polite"
      title="Tap to dismiss"
    >
      <div class="w-10 h-10 rounded-full bg-[#f0fdf4] border border-emerald-100 flex items-center justify-center flex-shrink-0"><svg class="w-5 h-5 text-[#166534]" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"></path></svg></div>
      <div class="flex flex-col">
        <span class="text-[10px] font-bold text-gray-400 uppercase tracking-widest mb-0.5" id="toast-title">Live Order</span>
        <span class="text-xs font-bold text-[#111827]" id="toast-name">Rahul from Pune</span>
        <span class="text-[10px] text-[#166534] font-medium" id="toast-action">just bought Spirulina Capsules 2 mins ago 🔥</span>
      </div>
    </div>

    <script is:inline>
      function initLiveToast() {
        const toast = document.getElementById('live-toast');
        const toastName = document.getElementById('toast-name');
        const toastAction = document.getElementById('toast-action');
        const toastTitle = document.getElementById('toast-title');
        
        const names = [
          { name: "Rahul from Pune", loc: "Spirulina Capsules", time: "2 mins ago" },
          { name: "Neha from Mumbai", loc: "Spirulina Powder", time: "1 min ago" },
          { name: "Amit from Nagpur", loc: "Spirulina Capsules", time: "just now" },
          { name: "Priya from Nashik", loc: "Spirulina Powder", time: "4 mins ago" },
          { name: "Vikram from Pune", loc: "Spirulina Capsules", time: "3 mins ago" },
          { name: "Sneha from Mumbai", loc: "Spirulina Powder", time: "2 mins ago" }
        ];

        if (toast && toastName && toastAction) {
          if (toastTitle) toastTitle.innerText = "Live Order";
          
          // Tap to dismiss on mobile / click to dismiss on desktop
          toast.addEventListener('click', () => {
            toast.classList.add('translate-y-[150%]', 'opacity-0');
          });

          setTimeout(() => {
            const buyer = names[Math.floor(Math.random() * names.length)];
            toastName.innerText = buyer.name;
            toastAction.innerText = `just bought ${buyer.loc} ${buyer.time} 🔥`;
            toast.classList.remove('translate-y-[150%]', 'opacity-0');
            setTimeout(() => { toast.classList.add('translate-y-[150%]', 'opacity-0'); }, 4000);
          }, 6000);

          setInterval(() => {
            const buyer = names[Math.floor(Math.random() * names.length)];
            toastName.innerText = buyer.name;
            toastAction.innerText = `just bought ${buyer.loc} ${buyer.time} 🔥`;
            toast.classList.remove('translate-y-[150%]', 'opacity-0');
            setTimeout(() => { toast.classList.add('translate-y-[150%]', 'opacity-0'); }, 4000);
          }, Math.floor(Math.random() * 12000) + 24000);
        }
      }

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initLiveToast);
      } else {
        initLiveToast();
      }
      document.addEventListener('astro:page-load', initLiveToast);
    </script>
  </body>
</html>