---
// src/layouts/StoreLayout.astro
import { alternatesFor } from '../config/hreflang.mjs';
import CartDrawer from '../components/CartDrawer.astro';
import StoreSearchModal from '../components/StoreSearchModal.astro';
import StoreBottomNav from '../components/StoreBottomNav.astro';
import WhatsAppConcierge from '../components/WhatsAppConcierge.astro';
import { BRAND_CONFIG } from '../config/brand';
import { homeFaqs } from '../lib/homeFaqs';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  isHomePage?: boolean;
  noindex?: boolean;
  hideBottomNav?: boolean;
  extraSchema?: any[];
  /** BCP-47 language of the page content: 'en' | 'hi' | 'mr'. Sets <html lang>. */
  lang?: 'en' | 'hi' | 'mr';
}

const { 
  title = "Buy Pure Spirulina in India | Lab-Tested Capsules & Powder - Sujata Nutrilive",
  description = "Buy 100% pure, chemical-free hydro-cultivated Spirulina in India. Lab-tested 62.39% protein, FSSAI licensed, odourless veg capsules & powder. Free COD & 90-day guarantee.",
  image = "/products/sujata-combo-spirulina-sea-buckthorn.jpg",
  isHomePage = false,
  noindex = false,
  hideBottomNav = false,
  extraSchema = [],
  lang = 'en'
} = Astro.props;

const siteUrl = BRAND_CONFIG.siteUrl || "https://www.sujatanutrilive.com";
const canonicalURL = new URL(Astro.url.pathname, siteUrl).toString();
// hreflang alternates for /learn language clusters (src/config/hreflang.mjs); empty for other pages.
const hreflangAlternates = alternatesFor(Astro.url.pathname).map((a) => ({ lang: a.lang, href: new URL(a.path, siteUrl).toString() }));
const ogImageURL = new URL(image, siteUrl).toString();

const metaPixelId = import.meta.env.PUBLIC_META_PIXEL_ID || "1314112957191765";
const googleTagId = import.meta.env.PUBLIC_GA4_ID || import.meta.env.PUBLIC_GTAG_ID || "G-5WZ8DNW2PD";
// When GA4_API_SECRET is set, GA4 purchases are sent server-side from the Shopify orders/create webhook
// (exact order value), and the browser skips its own GA4 purchase hit to avoid double counting.
const serverPurchaseTracking = Boolean(import.meta.env.GA4_API_SECRET || (typeof process !== 'undefined' && process.env?.GA4_API_SECRET));
const fbDomainVerification = import.meta.env.PUBLIC_FACEBOOK_DOMAIN_VERIFICATION || "4u1oycwawhemmpli8xnp0mencq1puj";

// =========================================================================
// 🌟 SILICON VALLEY UNIFIED SCHEMA.ORG @GRAPH (Knowledge Graph & GEO Rich Snippets)
// =========================================================================
const schemaGraphItems: any[] = [
  // 1. Organization & HealthAndBeautyBusiness Entity
  {
    "@type": ["Organization", "HealthAndBeautyBusiness"],
    "@id": `${siteUrl}/#organization`,
    "name": BRAND_CONFIG.brandName,
    "legalName": BRAND_CONFIG.legalName || "Sujata Nutrilive Agrotech",
    "url": siteUrl,
    "logo": {
      "@type": "ImageObject",
      "@id": `${siteUrl}/#logo`,
      "url": new URL("/sujata-logo-transparent.png", siteUrl).toString(),
      "caption": BRAND_CONFIG.brandName
    },
    "foundingDate": "2024",
    "founder": {
      "@type": "Person",
      "@id": `${siteUrl}/#founder`,
      "name": "Yash Rajendra Suryawanshi",
      "alternateName": ["Yash Suryawanshi", "Yash Suryavanshi"],
      "jobTitle": "Founder & Head of Operations",
      "worksFor": {
        "@id": `${siteUrl}/#organization`
      },
      "address": {
        "@type": "PostalAddress",
        "addressLocality": "Nashik",
        "addressRegion": "Maharashtra",
        "addressCountry": "IN"
      },
      "knowsAbout": [
        "Cold-Compressed Spirulina Cultivation",
        "Dietary Supplement Manufacturing & FSSAI Compliance",
        "Phycocyanin Bio-Extraction"
      ]
    },
    "description": "Nashik-based brand of 100% pure, chemical-free hydro-cultivated Spirulina and Himalayan Sea Buckthorn supplements. Lab-tested 62.39% protein (Lilaba report LAL-NN-131125023), no binders or fillers, FSSAI licensed.",
    "telephone": BRAND_CONFIG.supportPhone,
    "email": BRAND_CONFIG.supportEmail,
    "contactPoint": [
      {
        "@type": "ContactPoint",
        "telephone": BRAND_CONFIG.supportPhone,
        "contactType": "customer service",
        "areaServed": "IN",
        "availableLanguage": ["English", "Hindi", "Marathi"]
      }
    ],
    "address": {
      "@type": "PostalAddress",
      "streetAddress": "Plot No 125, Sai Niwas, Dhandai Colony, Khutwad Nagar, Kamatwade",
      "addressLocality": "Nashik",
      "addressRegion": "Maharashtra",
      "postalCode": "422008",
      "addressCountry": "IN"
    },
    "hasMap": "https://share.google/R7aB2MCG9AN5l3RF1",
    "hasCredential": [
      {
        "@type": "EducationalOccupationalCredential",
        "name": "FSSAI Central License (Categories 12, 13 and 102)",
        "credentialCategory": "Government Regulatory Registration",
        "recognizedBy": {
          "@type": "GovernmentOrganization",
          "name": "Food Safety and Standards Authority of India (FSSAI)",
          "url": "https://www.fssai.gov.in"
        },
        "identifier": BRAND_CONFIG.fssaiNumber
      },
      {
        "@type": "EducationalOccupationalCredential",
        "name": `Independent Laboratory Nutritional Test Report #${BRAND_CONFIG.labReport.number}`,
        "credentialCategory": "Laboratory Test Report",
        "url": new URL(BRAND_CONFIG.labReport.pdfUrl, siteUrl).toString(),
        "recognizedBy": {
          "@type": "Organization",
          "name": BRAND_CONFIG.labReport.lab,
          "url": "https://www.lilabalabs.com"
        }
      }
    ],
    "knowsAbout": [
      {
        "@type": "Thing",
        "name": "Spirulina (Dietary Supplement)",
        "sameAs": "https://en.wikipedia.org/wiki/Spirulina_(dietary_supplement)"
      },
      {
        "@type": "Thing",
        "name": "Sea Buckthorn (Hippophae)",
        "sameAs": "https://en.wikipedia.org/wiki/Hippophae"
      },
      {
        "@type": "Thing",
        "name": "Palmitoleic acid (Omega-7)",
        "sameAs": "https://en.wikipedia.org/wiki/Palmitoleic_acid"
      },
      {
        "@type": "Thing",
        "name": "Phycocyanin",
        "sameAs": "https://en.wikipedia.org/wiki/Phycocyanin"
      },
      {
        "@type": "Thing",
        "name": "Chlorophyll",
        "sameAs": "https://en.wikipedia.org/wiki/Chlorophyll"
      },
      {
        "@type": "Thing",
        "name": "Superoxide Dismutase",
        "sameAs": "https://en.wikipedia.org/wiki/Superoxide_dismutase"
      },
      {
        "@type": "Thing",
        "name": "Non-Heme Iron",
        "sameAs": "https://en.wikipedia.org/wiki/Human_iron_metabolism"
      },
    ],
    "alternateName": ["Sujata Nutrilive Agrotech", "SUJATA NUTRITIVE"],
    "brand": { "@id": `${siteUrl}/#brand` },
    "sameAs": [
      "https://www.wikidata.org/wiki/Q141656957",
      "https://www.amazon.in/dp/B0GMQYS6M4",
      "https://www.amazon.in/dp/B0DNSXGGTN",
      "https://www.amazon.in/dp/B0DP2FWN4J",
      "https://www.sujatanutriliveagrotech.in/",
      "https://www.facebook.com/sujatanutrilive",
      BRAND_CONFIG.instagramUrl,
      BRAND_CONFIG.googleMapsUrl || "https://share.google/R7aB2MCG9AN5l3RF1"
    ]
  },

  // 2. WebSite Entity with Sitelinks Searchbox
  {
    "@type": "WebSite",
    "@id": `${siteUrl}/#website`,
    "name": BRAND_CONFIG.brandName,
    "url": siteUrl,
    "publisher": {
      "@id": `${siteUrl}/#organization`
    },
    "inLanguage": "en-IN"
  },

  // 3. Brand Entity (distinct from the Organization that owns it)
  {
    "@type": "Brand",
    "@id": `${siteUrl}/#brand`,
    "name": BRAND_CONFIG.brandName,
    "logo": { "@id": `${siteUrl}/#logo` }
  }
];

// 3. Homepage-Specific Structured Data
// Google Product snippets / Merchant listings are only valid on a page about ONE product. The homepage
// lists the catalogue, so it ships an ItemList that points to each product page (where the full Product +
// Offer + MerchantReturnPolicy markup lives) instead of standalone Product/DietarySupplement nodes.
// DietarySupplement is a schema.org subtype of Product, so it triggered "offers/review/aggregateRating
// missing" errors when used here.
if (isHomePage) {
  const homepageCatalog: Array<[string, string]> = [
    ['sujata-spirulina-sea-buckthorn-combo-pack', 'Sujata Spirulina + Sea Buckthorn Healthy Life Combo Pack'],
    ['sujata-spirulina-capsules', 'Sujata Premium Spirulina Capsules'],
    ['sujata-spirulina-tablets', 'Sujata Spirulina Tablets'],
    ['sujata-sea-buckthorn-capsules', 'Sujata Himalayan Sea Buckthorn Capsules'],
  ];
  schemaGraphItems.push({
    "@type": "ItemList",
    "@id": `${siteUrl}/#bestsellers`,
    "name": "Sujata Nutrilive Bestsellers",
    "itemListOrder": "https://schema.org/ItemListOrderAscending",
    "numberOfItems": homepageCatalog.length,
    "itemListElement": homepageCatalog.map(([handle, name], idx) => ({
      "@type": "ListItem",
      "position": idx + 1,
      "name": name,
      "url": `${siteUrl}/product/${handle}`
    }))
  });

  // FAQPage — generated from src/lib/homeFaqs.ts, the same data rendered visibly in
  // StoreAuthorityVault, so schema and on-page FAQ always match (Google requirement).
  schemaGraphItems.push({
    "@type": "FAQPage",
    "@id": `${siteUrl}/#faq`,
    "mainEntity": homeFaqs.map((faq) => ({
      "@type": "Question",
      "name": faq.question,
      ...(faq.lang && faq.lang !== 'en' ? { "inLanguage": faq.lang === 'hi' ? 'hi-IN' : 'mr-IN' } : {}),
      "acceptedAnswer": { "@type": "Answer", "text": faq.answer }
    }))
  });
}

// 4. Inject Extra Schema (e.g. Product, Breadcrumb, Merchant Listings)
if (extraSchema && Array.isArray(extraSchema) && extraSchema.length > 0) {
  schemaGraphItems.push(...extraSchema);
}

// 5. WebPage node — ties this URL to WebSite, Organization & Brand, and declares what it is `about`.
// Skipped when the page already ships its own WebPage-family node (policy pages, contact, science).
const WEBPAGE_TYPES = ['WebPage', 'AboutPage', 'ContactPage', 'CollectionPage', 'ItemPage', 'MedicalWebPage', 'ProfilePage', 'CheckoutPage', 'SearchResultsPage'];
const typesOf = (n: any): string[] => (Array.isArray(n?.['@type']) ? n['@type'] : [n?.['@type']]);
const hasOwnWebPage = schemaGraphItems.some((n: any) => typesOf(n).some((t) => WEBPAGE_TYPES.includes(t)));
if (!hasOwnWebPage) {
  const productRefs = schemaGraphItems
    .filter((n: any) => n?.['@id'] && typesOf(n).includes('Product'))
    .map((n: any) => ({ "@id": n['@id'] }));
  schemaGraphItems.push({
    "@type": "WebPage",
    "@id": `${canonicalURL}#webpage`,
    "url": canonicalURL,
    "name": title,
    "description": description,
    "inLanguage": "en-IN",
    "isPartOf": [
      { "@id": `${siteUrl}/#website` },
      { "@id": `${siteUrl}/#organization` },
      { "@id": `${siteUrl}/#brand` }
    ],
    "publisher": { "@id": `${siteUrl}/#organization` },
    "primaryImageOfPage": { "@type": "ImageObject", "url": ogImageURL },
    ...(productRefs.length ? { "about": productRefs, ...(productRefs.length === 1 ? { "mainEntity": productRefs[0] } : {}) } : { "about": { "@id": `${siteUrl}/#brand` } }),
    ...(isHomePage ? { "speakable": { "@type": "SpeakableSpecification", "cssSelector": ["#hero-heading", "#aeo-definition"] } } : {})
  });
}

const unifiedSchemaGraph = {
  "@context": "https://schema.org",
  "@graph": schemaGraphItems
};
---
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <!-- 🛡️ Storage Guard — MUST be the first script. Instagram/Facebook/WhatsApp webviews, Safari Private
         Mode and blocked-cookie browsers throw SecurityError on storage access or QuotaExceededError on
         write. Unusable storage is swapped for an in-memory polyfill, and runtime write failures are
         swallowed, so the 80+ storage call sites site-wide (cart, checkout, attribution) never crash. -->
    <script is:inline>
      (function () {
        function memoryStorage() {
          var d = {};
          return {
            getItem: function (k) { k = String(k); return Object.prototype.hasOwnProperty.call(d, k) ? d[k] : null; },
            setItem: function (k, v) { d[String(k)] = String(v); },
            removeItem: function (k) { delete d[String(k)]; },
            clear: function () { d = {}; },
            key: function (i) { var ks = Object.keys(d); return i < ks.length ? ks[i] : null; },
            get length() { return Object.keys(d).length; }
          };
        }
        ['localStorage', 'sessionStorage'].forEach(function (name) {
          try {
            var s = window[name], t = '__sj_probe__';
            s.setItem(t, t); s.removeItem(t);
          } catch (e) {
            try { Object.defineProperty(window, name, { value: memoryStorage(), configurable: true }); } catch (e2) {}
          }
        });
        try {
          var P = window.Storage && window.Storage.prototype;
          if (P && !P.__sjSafe) {
            var nativeSet = P.setItem;
            P.setItem = function (k, v) {
              try { return nativeSet.call(this, k, v); }
              catch (e) { if (window.console) console.warn('[storage] write skipped:', k, e && e.name); }
            };
            P.__sjSafe = true;
          }
        } catch (e) {}
      })();
    </script>
    <!-- 🛡️ Internal Staff Exclusion & Google Consent Mode v2 -->
    <script is:inline>
      (function() {
        try {
          var params = new URLSearchParams(window.location.search);
          if (params.get('internal_staff') === 'true') {
            localStorage.setItem('sujata_staff_mode', 'true');
            document.cookie = 'sujata_staff_mode=true;path=/;max-age=31536000;SameSite=Lax';
            alert('🛡️ Sujata Staff Mode Active!\nYour visits and clicks on this browser will NOT be tracked in GA4 or Meta Ads.');
          } else if (params.get('internal_staff') === 'false') {
            localStorage.removeItem('sujata_staff_mode');
            document.cookie = 'sujata_staff_mode=;path=/;max-age=0;SameSite=Lax';
            alert('🔄 Sujata Staff Mode Deactivated.\nTracking has been restored for this browser.');
          }
        } catch(e) {}
      })();

      var isInternalStaff = false;
      try {
        isInternalStaff = localStorage.getItem('sujata_staff_mode') === 'true' || document.cookie.indexOf('sujata_staff_mode=true') !== -1;
      } catch(e) {}
      window.__SUJATA_STAFF__ = isInternalStaff;

      if (isInternalStaff) {
        window['ga-disable-G-5WZ8DNW2PD'] = true;
        console.log('🛡️ [Sujata Analytics] Internal Staff Mode detected. GA4 & Meta Tracking DISABLED for this session.');
      } else {
        window.dataLayer = window.dataLayer || [];
        function gtag(){dataLayer.push(arguments);}
        window.gtag = gtag;
        gtag('consent', 'default', {
          'ad_storage': 'granted',
          'ad_user_data': 'granted',
          'ad_personalization': 'granted',
          'analytics_storage': 'granted',
          'functionality_storage': 'granted',
          'personalization_storage': 'granted',
          'security_storage': 'granted',
          'wait_for_update': 500
        });
      }
    </script>
    <!-- Google Tag Manager -->
    <script is:inline>
      if (!window.__SUJATA_STAFF__) {
        (function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
        new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
        j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
        'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
        })(window,document,'script','dataLayer','GTM-5BCC6JL8');
      }
    </script>
    <!-- End Google Tag Manager -->

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    {hreflangAlternates.map((a) => <link rel="alternate" hreflang={a.lang} href={a.href} />)}
    
    {/* Generative Engine Optimization (GEO) & Machine Readability Declarations */}
    <meta name="author" content="Sujata Nutrilive" />
    <meta name="category" content="Dietary Supplements & Functional Cellular Nutrition" />
    <meta name="coverage" content="India" />
    
    {/* Robots Control */}
    {noindex ? (
      <meta name="robots" content="noindex, nofollow" />
    ) : (
      <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    )}

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/favicon.svg" />
    <meta name="theme-color" content="#064E3B" />
    <meta name="generator" content={Astro.generator} />
    {fbDomainVerification && <meta name="facebook-domain-verification" content={fbDomainVerification} />}
    
    {/* Google Search Console & Bing Webmaster Verification */}
    <meta name="google-site-verification" content="cG4EqdD7WTbhGVJldMNkWcjjiHrpy2AQk9Io-nunmU0" />
    <meta name="msvalidate.01" content="414A8DDFD5DC4EFEE1E9CE86F38F7263" />

    {/* OpenGraph / Facebook / WhatsApp Preview Meta Tags */}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={BRAND_CONFIG.brandName} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:locale" content="en_IN" />

    {/* Twitter Cards */}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalURL} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />

    {/* Speed: CDN Preconnect & DNS-Prefetch (Shaves 200ms off LCP) */}
    <link rel="preconnect" href="https://cdn.shopify.com" crossorigin />
    <link rel="dns-prefetch" href="https://cdn.shopify.com" />

    {/* Non-Blocking High-Performance Google Fonts */}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,600;1,400;1,600&family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" media="print" onload="this.media='all'" />
    <noscript>
      <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,600;1,400;1,600&family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" />
    </noscript>

    {/* Unified Schema.org Structured Data */}
    <script type="application/ld+json" set:html={JSON.stringify(unifiedSchemaGraph)} />

    {/* 🌟 2026 Resilient Ad Tracking Hub (Meta Pixel & Google Tag) */}
    <script is:inline define:vars={{ metaPixelId, googleTagId, serverPurchaseTracking }}>
      // 1. First-Party Attribution Engine (first touch + last non-direct touch)
      // Every landing is classified (UTMs > click IDs > referrer > direct), so organic, WhatsApp, AI and
      // social visits are attributed even without UTMs. Stored in localStorage AND a first-party cookie
      // (in-app webviews often wipe localStorage). Read at checkout via window.sujataGetAttribution().
      (function() {
        var LS_FT = 'sujata_attr_ft', LS_LT = 'sujata_attr_lt', COOKIE = 'sj_attr';
        var MAX_AGE_DAYS = 90, DIRECT_GRACE_DAYS = 30;
        var OWN_HOSTS = /(^|\.)(sujatanutrilive\.com|myshopify\.com|razorpay\.com|rzp\.io|gokwik\.co|shopify\.com|localhost)$/i;

        function readCookie(name) {
          var parts = document.cookie ? document.cookie.split(/;\s*/) : [];
          for (var i = 0; i < parts.length; i++) {
            var eq = parts[i].indexOf('=');
            if (eq > 0 && parts[i].slice(0, eq) === name) return parts[i].slice(eq + 1);
          }
          return '';
        }
        function writeCookie(name, value, days) {
          try { document.cookie = name + '=' + value + ';path=/;max-age=' + (days * 86400) + ';SameSite=Lax' + (location.protocol === 'https:' ? ';Secure' : ''); } catch (e) {}
        }
        function clip(v, n) { return v == null ? '' : String(v).slice(0, n || 200); }
        function readJson(key) { try { var v = localStorage.getItem(key); return v ? JSON.parse(v) : null; } catch (e) { return null; } }
        function fresh(t, days) { return !!(t && t.at && (Date.now() - Date.parse(t.at)) < days * 86400000); }

        function classifyReferrer(host) {
          host = String(host || '').toLowerCase().replace(/^www\./, '');
          var rules = [
            [/(^|\.)gemini\.google\.com$/, 'gemini', 'ai'],
            [/(^|\.)google\./, 'google', 'organic'], [/(^|\.)bing\.com$/, 'bing', 'organic'],
            [/(^|\.)yahoo\./, 'yahoo', 'organic'], [/(^|\.)duckduckgo\.com$/, 'duckduckgo', 'organic'],
            [/(^|\.)yandex\./, 'yandex', 'organic'], [/(^|\.)ecosia\.org$/, 'ecosia', 'organic'],
            [/(^|\.)(chatgpt\.com|chat\.openai\.com)$/, 'chatgpt', 'ai'], [/(^|\.)perplexity\.ai$/, 'perplexity', 'ai'],
            [/(^|\.)copilot\.microsoft\.com$/, 'copilot', 'ai'], [/(^|\.)claude\.ai$/, 'claude', 'ai'],
            [/(^|\.)instagram\.com$/, 'instagram', 'social'], [/(^|\.)(facebook\.com|fb\.com|fb\.me)$/, 'facebook', 'social'],
            [/(^|\.)(wa\.me|whatsapp\.com|wl\.co)$/, 'whatsapp', 'social'],
            [/(^|\.)(youtube\.com|youtu\.be)$/, 'youtube', 'social'], [/(^|\.)(t\.co|twitter\.com|x\.com)$/, 'x', 'social'],
            [/(^|\.)linkedin\.com$/, 'linkedin', 'social'], [/(^|\.)pinterest\./, 'pinterest', 'social'],
            [/(^|\.)amazon\./, 'amazon', 'referral']
          ];
          for (var i = 0; i < rules.length; i++) if (rules[i][0].test(host)) return { source: rules[i][1], medium: rules[i][2] };
          return { source: host, medium: 'referral' };
        }

        function currentTouch(params) {
          var refHost = '';
          try { refHost = document.referrer ? new URL(document.referrer).hostname : ''; } catch (e) {}
          var internalRef = !!refHost && OWN_HOSTS.test(refHost);
          var t = {
            source: '', medium: '', campaign: clip(params.get('utm_campaign')), content: clip(params.get('utm_content')),
            term: clip(params.get('utm_term')), id: clip(params.get('utm_id'), 100),
            gclid: clip(params.get('gclid') || params.get('gbraid') || params.get('wbraid'), 150),
            fbclid: clip(params.get('fbclid'), 250),
            landing: clip(location.pathname + location.search, 250),
            referrer: internalRef ? '' : clip(document.referrer, 250),
            at: new Date().toISOString()
          };
          var utmSource = clip(params.get('utm_source'), 100).toLowerCase();
          var utmMedium = clip(params.get('utm_medium'), 100).toLowerCase();
          if (utmSource || utmMedium) {
            t.source = utmSource || '(not set)'; t.medium = utmMedium || '(not set)';
          } else if (t.gclid) {
            t.source = 'google'; t.medium = 'cpc';
          } else if (t.fbclid) {
            t.source = classifyReferrer(refHost).source === 'instagram' ? 'instagram' : 'facebook'; t.medium = 'social';
