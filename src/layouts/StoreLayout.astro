---
// src/layouts/StoreLayout.astro
import CartDrawer from '../components/CartDrawer.astro';
import StoreSearchModal from '../components/StoreSearchModal.astro';
import StoreBottomNav from '../components/StoreBottomNav.astro';
import WhatsAppConcierge from '../components/WhatsAppConcierge.astro';
import { BRAND_CONFIG } from '../config/brand';
import { homeFaqs } from '../lib/homeFaqs';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  isHomePage?: boolean;
  noindex?: boolean;
  hideBottomNav?: boolean;
  extraSchema?: any[];
}

const { 
  title = "Buy Pure Spirulina in India | Lab-Tested Capsules & Powder - Sujata Nutrilive",
  description = "Buy 100% pure, chemical-free hydro-cultivated Spirulina in India. Lab-tested 62.39% protein, FSSAI registered, odourless veg capsules & powder. Free COD & 90-day guarantee.",
  image = "/products/sujata-combo-spirulina-sea-buckthorn.jpg",
  isHomePage = false,
  noindex = false,
  hideBottomNav = false,
  extraSchema = []
} = Astro.props;

const siteUrl = BRAND_CONFIG.siteUrl || "https://www.sujatanutrilive.com";
const canonicalURL = new URL(Astro.url.pathname, siteUrl).toString();
const ogImageURL = new URL(image, siteUrl).toString();

const metaPixelId = import.meta.env.PUBLIC_META_PIXEL_ID || "1314112957191765";
const googleTagId = import.meta.env.PUBLIC_GA4_ID || import.meta.env.PUBLIC_GTAG_ID || "G-5WZ8DNW2PD";
const fbDomainVerification = import.meta.env.PUBLIC_FACEBOOK_DOMAIN_VERIFICATION || "4u1oycwawhemmpli8xnp0mencq1puj";

// =========================================================================
// 🌟 SILICON VALLEY UNIFIED SCHEMA.ORG @GRAPH (Knowledge Graph & GEO Rich Snippets)
// =========================================================================
const schemaGraphItems: any[] = [
  // 1. Organization & HealthAndBeautyBusiness Entity
  {
    "@type": ["Organization", "HealthAndBeautyBusiness"],
    "@id": `${siteUrl}/#organization`,
    "name": BRAND_CONFIG.brandName,
    "legalName": BRAND_CONFIG.legalName || "Sujata Nutrilive Agrotech",
    "url": siteUrl,
    "logo": {
      "@type": "ImageObject",
      "@id": `${siteUrl}/#logo`,
      "url": new URL("/sujata-logo-transparent.png", siteUrl).toString(),
      "caption": BRAND_CONFIG.brandName
    },
    "foundingDate": "2024",
    "founder": {
      "@type": "Person",
      "@id": `${siteUrl}/#founder`,
      "name": "Yash Rajendra Surywanshi",
      "alternateName": ["Yash Suryawanshi", "Yash Suryavanshi"],
      "jobTitle": "Founder & Head of Operations",
      "worksFor": {
        "@id": `${siteUrl}/#organization`
      },
      "address": {
        "@type": "PostalAddress",
        "addressLocality": "Nashik",
        "addressRegion": "Maharashtra",
        "addressCountry": "IN"
      },
      "knowsAbout": [
        "Cold-Compressed Spirulina Cultivation",
        "Dietary Supplement Manufacturing & FSSAI Compliance",
        "Phycocyanin Bio-Extraction"
      ]
    },
    "description": "Nashik-based brand of 100% pure, chemical-free hydro-cultivated Spirulina and Himalayan Sea Buckthorn supplements. Lab-tested 62.39% protein (Lilaba report LAL-NN-131125023), no binders or fillers, FSSAI registered.",
    "telephone": BRAND_CONFIG.supportPhone,
    "email": BRAND_CONFIG.supportEmail,
    "contactPoint": [
      {
        "@type": "ContactPoint",
        "telephone": BRAND_CONFIG.supportPhone,
        "contactType": "customer service",
        "areaServed": "IN",
        "availableLanguage": ["English", "Hindi", "Marathi"]
      }
    ],
    "address": {
      "@type": "PostalAddress",
      "streetAddress": "Plot No 125, Sai Niwas, Dhandai Colony, Khutwad Nagar, Kamatwade",
      "addressLocality": "Nashik",
      "addressRegion": "Maharashtra",
      "postalCode": "422008",
      "addressCountry": "IN"
    },
    "hasMap": "https://share.google/R7aB2MCG9AN5l3RF1",
    "hasCredential": [
      {
        "@type": "EducationalOccupationalCredential",
        "name": "FSSAI Food Safety & Dietary Supplement Registration (Category 13)",
        "credentialCategory": "Government Regulatory Registration",
        "recognizedBy": {
          "@type": "GovernmentOrganization",
          "name": "Food Safety and Standards Authority of India (FSSAI)",
          "url": "https://www.fssai.gov.in"
        },
        "identifier": BRAND_CONFIG.fssaiNumber
      },
      {
        "@type": "EducationalOccupationalCredential",
        "name": `Independent Laboratory Nutritional Test Report #${BRAND_CONFIG.labReport.number}`,
        "credentialCategory": "Laboratory Test Report",
        "url": new URL(BRAND_CONFIG.labReport.pdfUrl, siteUrl).toString(),
        "recognizedBy": {
          "@type": "Organization",
          "name": BRAND_CONFIG.labReport.lab,
          "url": "https://www.lilabalabs.com"
        }
      }
    ],
    "knowsAbout": [
      {
        "@type": "Thing",
        "name": "Spirulina (Dietary Supplement)",
        "sameAs": "https://en.wikipedia.org/wiki/Spirulina_(dietary_supplement)"
      },
      {
        "@type": "Thing",
        "name": "Sea Buckthorn (Hippophae)",
        "sameAs": "https://en.wikipedia.org/wiki/Hippophae"
      },
      {
        "@type": "Thing",
        "name": "Palmitoleic acid (Omega-7)",
        "sameAs": "https://en.wikipedia.org/wiki/Palmitoleic_acid"
      },
      {
        "@type": "Thing",
        "name": "Phycocyanin",
        "sameAs": "https://en.wikipedia.org/wiki/Phycocyanin"
      },
      {
        "@type": "Thing",
        "name": "Chlorophyll",
        "sameAs": "https://en.wikipedia.org/wiki/Chlorophyll"
      },
      {
        "@type": "Thing",
        "name": "Superoxide Dismutase",
        "sameAs": "https://en.wikipedia.org/wiki/Superoxide_dismutase"
      },
      {
        "@type": "Thing",
        "name": "Non-Heme Iron",
        "sameAs": "https://en.wikipedia.org/wiki/Human_iron_metabolism"
      },
    ],
    "alternateName": ["Sujata Nutrilive Agrotech", "SUJATA NUTRITIVE"],
    "sameAs": [
      "https://www.wikidata.org/wiki/Q141656957",
      "https://www.amazon.in/dp/B0GMQYS6M4",
      "https://www.amazon.in/dp/B0DNSXGGTN",
      "https://www.amazon.in/dp/B0DP2FWN4J",
      "https://www.sujatanutriliveagrotech.in/",
      "https://www.facebook.com/sujatanutrilive",
      BRAND_CONFIG.instagramUrl,
      BRAND_CONFIG.googleMapsUrl || "https://share.google/R7aB2MCG9AN5l3RF1"
    ]
  },

  // 2. WebSite Entity with Sitelinks Searchbox
  {
    "@type": "WebSite",
    "@id": `${siteUrl}/#website`,
    "name": BRAND_CONFIG.brandName,
    "url": siteUrl,
    "publisher": {
      "@id": `${siteUrl}/#organization`
    },
    "potentialAction": {
      "@type": "SearchAction",
      "target": `${siteUrl}/#product-ecosystem?search={search_term_string}`,
      "query-input": "required name=search_term_string"
    }
  }
];

// 3. Homepage-Specific Rich Snippets (Product Aggregate Rating + DietarySupplement + Google FAQ Accordion)
if (isHomePage) {
  // Flagship Spirulina Product Showcase for Google SERP Gold Star Ratings
  schemaGraphItems.push({
    "@type": "Product",
    "@id": `${siteUrl}/#product-spirulina`,
    "name": "Sujata Cold-Pressed Spirulina (Tablets & Raw Powder)",
    "description": "100% pure, chemical-free hydro-cultivated Spirulina dried below 40°C. Lab-tested 62.39% protein and 290.89 mg/kg natural iron (Lilaba report LAL-NN-131125023). No binders or fillers, no fishy odour. FSSAI licence 21526027000179.",
    "sku": "SJT-SP-TAB-60",
    "mpn": "SJT-SP-TAB-60",
    "asin": "B0GMQYS6M4",
    "sameAs": [
      "https://www.amazon.in/dp/B0GMQYS6M4",
      "https://www.amazon.in/dp/B0DNSXGGTN",
      "https://www.amazon.in/dp/B0DP2FWN4J"
    ],
    "image": [
      new URL("/products/sujata-combo-spirulina-sea-buckthorn.jpg", siteUrl).toString(),
      new URL("/products/sujata-spirulina-transparent.png", siteUrl).toString()
    ],
    "brand": {
      "@type": "Brand",
      "@id": `${siteUrl}/#organization`,
      "name": BRAND_CONFIG.brandName
    },
    // NOTE: No aggregateRating here on purpose. Google only allows product ratings that are
    // backed by individual reviews visible on the same page. Add it back on product pages once
    // a reviews app supplies real per-product review counts.
    "offers": {
      "@type": "AggregateOffer",
      "lowPrice": "350",
      "highPrice": "1100",
      "priceCurrency": "INR",
      "offerCount": "4",
      "validFrom": "2024-01-01",
      "priceValidUntil": "2027-12-31",
      "availability": "https://schema.org/InStock",
      "seller": {
        "@id": `${siteUrl}/#organization`
      },
      "shippingDetails": {
        "@type": "OfferShippingDetails",
        "shippingRate": {
          "@type": "MonetaryAmount",
          "value": "0",
          "currency": "INR"
        },
        "shippingDestination": {
          "@type": "DefinedRegion",
          "addressCountry": "IN"
        },
        "deliveryTime": {
          "@type": "ShippingDeliveryTime",
          "handlingTime": {
            "@type": "QuantitativeValue",
            "minValue": 0,
            "maxValue": 1,
            "unitCode": "d"
          },
          "transitTime": {
            "@type": "QuantitativeValue",
            "minValue": 2,
            "maxValue": 5,
            "unitCode": "d"
          }
        }
      },
      "hasMerchantReturnPolicy": {
        "@type": "MerchantReturnPolicy",
        "applicableCountry": "IN",
        "returnPolicyCategory": "https://schema.org/MerchantReturnFiniteReturnWindow",
        "merchantReturnDays": 90,
        "returnMethod": "https://schema.org/ReturnByMail",
        "returnFees": "https://schema.org/FreeReturn"
      }
    }
  });

  // Flagship Sea Buckthorn Product Showcase
  schemaGraphItems.push({
    "@type": "Product",
    "@id": `${siteUrl}/#product-seabuckthorn`,
    "name": "Sujata Pure Himalayan Sea Buckthorn Capsules (60 Veg Caps)",
    "description": "Himalayan Sea Buckthorn vegetarian capsules (60 caps, 30 days). A natural source of Omega-7 (palmitoleic acid), Omega 3, 6, 9 and Vitamin C. No added sugar, no preservatives.",
    "sku": "SJT-SB-CAP-60",
    "mpn": "SJT-SB-CAP-60",
    "image": [
      new URL("/products/sujata-sea-buckthorn-capsules-bottle-transparent.png", siteUrl).toString()
    ],
    "brand": {
      "@type": "Brand",
      "@id": `${siteUrl}/#organization`,
      "name": BRAND_CONFIG.brandName
    },
    "offers": {
      "@type": "Offer",
      "price": "649",
      "priceCurrency": "INR",
      "priceSpecification": {
        "@type": "UnitPriceSpecification",
        "price": "649",
        "priceCurrency": "INR",
        "valueAddedTaxIncluded": true
      },
      "validFrom": "2024-01-01",
      "priceValidUntil": "2027-12-31",
      "availability": "https://schema.org/InStock",
      "seller": {
        "@id": `${siteUrl}/#organization`
      },
      "shippingDetails": {
        "@type": "OfferShippingDetails",
        "shippingRate": {
          "@type": "MonetaryAmount",
          "value": "0",
          "currency": "INR"
        },
        "shippingDestination": {
          "@type": "DefinedRegion",
          "addressCountry": "IN"
        },
        "deliveryTime": {
          "@type": "ShippingDeliveryTime",
          "handlingTime": {
            "@type": "QuantitativeValue",
            "minValue": 0,
            "maxValue": 1,
            "unitCode": "d"
          },
          "transitTime": {
            "@type": "QuantitativeValue",
            "minValue": 2,
            "maxValue": 5,
            "unitCode": "d"
          }
        }
      },
      "hasMerchantReturnPolicy": {
        "@type": "MerchantReturnPolicy",
        "applicableCountry": "IN",
        "returnPolicyCategory": "https://schema.org/MerchantReturnFiniteReturnWindow",
        "merchantReturnDays": 90,
        "returnMethod": "https://schema.org/ReturnByMail",
        "returnFees": "https://schema.org/FreeReturn"
      }
    }
  });

  // Biomedical & Dietary Supplement Entity for LLMs & Knowledge Graph (Spirulina)
  schemaGraphItems.push({
    "@type": "DietarySupplement",
    "@id": `${siteUrl}/#supplement-spirulina`,
    "name": "Sujata Pure Hydro-Cultivated Spirulina",
    "targetPopulation": "Healthy adults looking to add plant protein and natural nutrients to their daily diet",
    "activeIngredient": "100% Spirulina (Arthrospira platensis)",
    "nonProprietaryName": "Spirulina",
    "safetyConsideration": "Food supplement, not a medicine. Consult a doctor before use if you have an autoimmune condition, take blood thinners, have phenylketonuria (PKU), or are pregnant or breastfeeding.",
    "recommendedIntake": {
      "@type": "RecommendedIntake",
      "name": "2 capsules (1 g) daily after breakfast with water; start with 1 capsule in week 1"
    },
    "manufacturer": {
      "@id": `${siteUrl}/#organization`
    }
  });

  // Biomedical & Dietary Supplement Entity for LLMs & Knowledge Graph (Sea Buckthorn)
  schemaGraphItems.push({
    "@type": "DietarySupplement",
    "@id": `${siteUrl}/#supplement-seabuckthorn`,
    "name": "Sujata Pure Himalayan Sea Buckthorn Capsules",
    "targetPopulation": "Healthy adults looking for a natural source of Omega-7 and Vitamin C for everyday skin nutrition",
    "activeIngredient": "Himalayan Sea Buckthorn (Hippophae rhamnoides)",
    "safetyConsideration": "Food supplement, not a medicine. No added sugar, no preservatives. Consult a doctor before use if pregnant, breastfeeding, or taking blood thinners.",
    "recommendedIntake": {
      "@type": "RecommendedIntake",
      "name": "1 capsule twice daily after meals with water"
    },
    "manufacturer": {
      "@id": `${siteUrl}/#organization`
    }
  });

  // FAQPage — generated from src/lib/homeFaqs.ts, the same data rendered visibly in
  // StoreAuthorityVault, so schema and on-page FAQ always match (Google requirement).
  schemaGraphItems.push({
    "@type": "FAQPage",
    "@id": `${siteUrl}/#faq`,
    "mainEntity": homeFaqs.map((faq) => ({
      "@type": "Question",
      "name": faq.question,
      ...(faq.lang && faq.lang !== 'en' ? { "inLanguage": faq.lang === 'hi' ? 'hi-IN' : 'mr-IN' } : {}),
      "acceptedAnswer": { "@type": "Answer", "text": faq.answer }
    }))
  });
}

// 4. Inject Extra Schema (e.g. Product, Breadcrumb, Merchant Listings)
if (extraSchema && Array.isArray(extraSchema) && extraSchema.length > 0) {
  schemaGraphItems.push(...extraSchema);
}

const unifiedSchemaGraph = {
  "@context": "https://schema.org",
  "@graph": schemaGraphItems
};
---
<html lang="en">
  <head>
    <!-- 🛡️ Internal Staff Exclusion & Google Consent Mode v2 -->
    <script is:inline>
      (function() {
        try {
          var params = new URLSearchParams(window.location.search);
          if (params.get('internal_staff') === 'true') {
            localStorage.setItem('sujata_staff_mode', 'true');
            document.cookie = 'sujata_staff_mode=true;path=/;max-age=31536000;SameSite=Lax';
            alert('🛡️ Sujata Staff Mode Active!\nYour visits and clicks on this browser will NOT be tracked in GA4 or Meta Ads.');
          } else if (params.get('internal_staff') === 'false') {
            localStorage.removeItem('sujata_staff_mode');
            document.cookie = 'sujata_staff_mode=;path=/;max-age=0;SameSite=Lax';
            alert('🔄 Sujata Staff Mode Deactivated.\nTracking has been restored for this browser.');
          }
        } catch(e) {}
      })();

      var isInternalStaff = false;
      try {
        isInternalStaff = localStorage.getItem('sujata_staff_mode') === 'true' || document.cookie.indexOf('sujata_staff_mode=true') !== -1;
      } catch(e) {}
      window.__SUJATA_STAFF__ = isInternalStaff;

      if (isInternalStaff) {
        window['ga-disable-G-5WZ8DNW2PD'] = true;
        console.log('🛡️ [Sujata Analytics] Internal Staff Mode detected. GA4 & Meta Tracking DISABLED for this session.');
      } else {
        window.dataLayer = window.dataLayer || [];
        function gtag(){dataLayer.push(arguments);}
        window.gtag = gtag;
        gtag('consent', 'default', {
          'ad_storage': 'granted',
          'ad_user_data': 'granted',
          'ad_personalization': 'granted',
          'analytics_storage': 'granted',
          'functionality_storage': 'granted',
          'personalization_storage': 'granted',
          'security_storage': 'granted',
          'wait_for_update': 500
        });
      }
    </script>
    <!-- Google Tag Manager -->
    <script is:inline>
      if (!window.__SUJATA_STAFF__) {
        (function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
        new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
        j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
        'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
        })(window,document,'script','dataLayer','GTM-5BCC6JL8');
      }
    </script>
    <!-- End Google Tag Manager -->

    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    
    {/* Generative Engine Optimization (GEO) & Machine Readability Declarations */}
    <meta name="author" content="Sujata Nutrilive" />
    <meta name="category" content="Dietary Supplements & Functional Cellular Nutrition" />
    <meta name="coverage" content="India" />
    
    {/* Robots Control */}
    {noindex ? (
      <meta name="robots" content="noindex, nofollow" />
    ) : (
      <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    )}

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/favicon.svg" />
    <meta name="theme-color" content="#064E3B" />
    <meta name="generator" content={Astro.generator} />
    {fbDomainVerification && <meta name="facebook-domain-verification" content={fbDomainVerification} />}
    
    {/* Google Search Console & Bing Webmaster Verification */}
    <meta name="google-site-verification" content="cG4EqdD7WTbhGVJldMNkWcjjiHrpy2AQk9Io-nunmU0" />
    <meta name="msvalidate.01" content="414A8DDFD5DC4EFEE1E9CE86F38F7263" />

    {/* OpenGraph / Facebook / WhatsApp Preview Meta Tags */}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={BRAND_CONFIG.brandName} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:locale" content="en_IN" />

    {/* Twitter Cards */}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalURL} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />

    {/* Speed: CDN Preconnect & DNS-Prefetch (Shaves 200ms off LCP) */}
    <link rel="preconnect" href="https://cdn.shopify.com" crossorigin />
    <link rel="dns-prefetch" href="https://cdn.shopify.com" />

    {/* Non-Blocking High-Performance Google Fonts */}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,600;1,400;1,600&family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" media="print" onload="this.media='all'" />
    <noscript>
      <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,600;1,400;1,600&family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" />
    </noscript>

    {/* Unified Schema.org Structured Data */}
    <script type="application/ld+json" set:html={JSON.stringify(unifiedSchemaGraph)} />

    {/* 🌟 2026 Resilient Ad Tracking Hub (Meta Pixel & Google Tag) */}
    <script is:inline define:vars={{ metaPixelId, googleTagId }}>
      // 1. First-Party Cookie Engine & UTM Attribution Capture
      (function() {
        try {
          var urlParams = new URLSearchParams(window.location.search);
          var fbclid = urlParams.get('fbclid');
          
          // Capture & Persist _fbc (Meta Click ID)
          if (fbclid) {
            var fbcVal = 'fb.1.' + Date.now() + '.' + fbclid;
            document.cookie = '_fbc=' + fbcVal + ';path=/;max-age=' + (90 * 86400) + ';SameSite=Lax';
            localStorage.setItem('sujata_fbc', fbcVal);
          }
          
          // Ensure _fbp (Meta Browser ID) exists
          var existingFbp = (document.cookie.match(/(^|;\s*)_fbp=([^;]+)/) || [])[2] || localStorage.getItem('sujata_fbp');
          if (!existingFbp) {
            existingFbp = 'fb.1.' + Date.now() + '.' + Math.floor(Math.random() * 1000000000);
            document.cookie = '_fbp=' + existingFbp + ';path=/;max-age=' + (90 * 86400) + ';SameSite=Lax';
            localStorage.setItem('sujata_fbp', existingFbp);
          } else {
            localStorage.setItem('sujata_fbp', existingFbp);
          }

          // Capture UTM campaign attribution
          var utmKeys = ['utm_source', 'utm_medium', 'utm_campaign', 'utm_content', 'utm_term'];
          var utmData = {};
          var hasUtm = false;
          utmKeys.forEach(function(key) {
            var val = urlParams.get(key);
            if (val) {
              utmData[key] = val;
              hasUtm = true;
            }
          });
          if (hasUtm) {
            localStorage.setItem('sujata_utms', JSON.stringify(utmData));
          }
        } catch(e) {}
      })();

      // 🌟 2. Unified Enterprise E-Commerce DataLayer Dispatcher (GA4 & Meta GTM Standard)
      // Single Source of Truth: All events are routed exclusively via GTM (GTM-5BCC6JL8).
      // Zero direct fbq() or gtag() calls to eliminate 200% double-counting.
      window.dispatchStoreEvent = function(eventName, data) {
        if (window.__SUJATA_STAFF__) {
          console.log('🛡️ [Staff Mode - Event Suppressed]:', eventName);
          return;
        }
        data = data || {};
        window.dataLayer = window.dataLayer || [];

        // High-entropy deterministic event_id for CAPI deduplication
        // High-entropy deterministic event_id for CAPI deduplication (respects passed event_id if available)
        var eventId = data.event_id || ('sujata_' + Date.now() + '_' + Math.random().toString(36).substr(2, 7));
        var fbpVal = localStorage.getItem('sujata_fbp') || '';
        var fbcVal = localStorage.getItem('sujata_fbc') || '';
        var utmsVal = {};
        try { utmsVal = JSON.parse(localStorage.getItem('sujata_utms') || '{}'); } catch(e) {}

        // 🌟 Meta Advanced Matching: Capture & persist email / phone if available
        if (data.email) {
          try { localStorage.setItem('sujata_user_email', String(data.email).trim().toLowerCase()); } catch(e) {}
        }
        if (data.phone) {
          try { localStorage.setItem('sujata_user_phone', String(data.phone).trim()); } catch(e) {}
        }

        var storedEmail = localStorage.getItem('sujata_user_email') || '';
        var storedPhone = localStorage.getItem('sujata_user_phone') || '';

        var userData = {
          fbp: fbpVal,
          fbc: fbcVal,
          country: 'IN',
          traffic_source: utmsVal.utm_source || 'direct',
          campaign: utmsVal.utm_campaign || ''
        };
        if (storedEmail) userData.email = storedEmail;
        if (storedPhone) userData.phone = storedPhone;

        function cleanShopifyId(rawId) {
          if (!rawId) return '';
          var s = String(rawId).trim();
          var match = s.match(/(?:ProductVariant|Product)\/(\d+)/);
          return match ? match[1] : (s.replace(/^gid:\/\/shopify\/[^\/]+\//, '') || s);
        }

        var cleanId = cleanShopifyId(data.id || (data.items && data.items[0] && data.items[0].id) || '');
        var enrichedData = Object.assign({}, data, {
          clean_id: cleanId,
          content_ids: cleanId ? [cleanId, String(data.id || '')] : [String(data.id || '')]
        });

        // 1. Dual-Compatibility: Push custom event for GTM custom event triggers
        window.dataLayer.push({
          event: eventName,
          event_id: eventId,
          user_data: userData,
          order_total: data.total || data.price || 0,
          contact_channel: data.channel || 'WhatsApp Support',
          quantity: Number(data.quantity || 1),
          clean_id: cleanId,
          event_data: enrichedData
        });

        // 2. Official Google Analytics 4 (GA4) Enhanced E-Commerce Specification
        if (eventName === 'ViewContent') {
          window.dataLayer.push({ ecommerce: null });
          window.dataLayer.push({
            event: 'view_item',
            event_id: eventId,
            user_data: userData,
            ecommerce: {
              currency: data.currency || 'INR',
              value: Number(data.price || 0),
              items: [{
                item_id: cleanId || String(data.id || ''),
                item_name: data.title || '',
                price: Number(data.price || 0),
                quantity: 1
              }]
            }
          });
        } else if (eventName === 'AddToCart') {
          var atcQty = Number(data.quantity || 1);
          var atcTotalVal = Number(data.price || 0) * atcQty;
          window.dataLayer.push({ ecommerce: null });
          window.dataLayer.push({
            event: 'add_to_cart',
            event_id: eventId,
            user_data: userData,
            ecommerce: {
              currency: data.currency || 'INR',
              value: atcTotalVal,
              items: [{
                item_id: cleanId || String(data.id || ''),
                item_name: data.title || '',
                price: Number(data.price || 0),
                quantity: atcQty
              }]
            }
          });
        } else if (eventName === 'InitiateCheckout') {
          var pModeGA = data.payment_mode || (typeof localStorage !== 'undefined' ? localStorage.getItem('sujata_selected_payment_mode') : '') || 'upi';
          var totalNumItems = (data.items || []).reduce(function(sum, it) { return sum + Number(it.quantity || 1); }, 0) || (data.items || []).length || 1;
          window.dataLayer.push({ ecommerce: null });
          window.dataLayer.push({
            event: 'begin_checkout',
            event_id: eventId,
            user_data: userData,
            num_items: totalNumItems,
            ecommerce: {
              currency: data.currency || 'INR',
              value: Number(data.total || 0),
              payment_type: pModeGA,
              items: (data.items || []).map(function(item) {
                return {
                  item_id: cleanShopifyId(item.id || ''),
                  item_name: item.title || '',
                  price: Number(item.price || 0),
                  quantity: Number(item.quantity || 1)
                };
              })
            }
          });
        } else if (eventName === 'Search') {
          window.dataLayer.push({
            event: 'search',
            event_id: eventId,
            search_term: data.query || data.search_string || ''
          });
        } else if (eventName === 'Lead') {
          window.dataLayer.push({
            event: 'generate_lead',
            event_id: eventId,
            user_data: userData,
            value: Number(data.value || 0),
            currency: 'INR'
          });
        } else if (eventName === 'Contact') {
          window.dataLayer.push({
            event: 'contact',
            event_id: eventId,
            channel: data.channel || 'WhatsApp Support'
          });
        } else if (eventName === 'Purchase') {
          var pModePurchase = data.payment_mode || (typeof localStorage !== 'undefined' ? localStorage.getItem('sujata_selected_payment_mode') : '') || 'upi';
          window.dataLayer.push({ ecommerce: null });
          window.dataLayer.push({
            event: 'purchase',
            event_id: eventId,
            user_data: userData,
            ecommerce: {
              transaction_id: String(data.order_id || eventId),
              value: Number(data.value || data.total || 0),
              currency: data.currency || 'INR',
              payment_type: pModePurchase,
              items: (data.items || []).map(function(item) {
                return {
                  item_id: cleanShopifyId(item.id || ''),
                  item_name: item.title || '',
                  price: Number(item.price || 0),
                  quantity: Number(item.quantity || 1)
                };
              })
            }
          });
        } else if (eventName === 'CompleteRegistration') {
          window.dataLayer.push({
            event: 'sign_up',
            event_id: eventId,
            method: data.content_name || 'Routine Quiz'
          });
        }
      };

      // 🌟 5. Global Delegated Click Listener for WhatsApp & Phone Support
      document.addEventListener('click', function(e) {
        var waLink = e.target.closest('a[href*="wa.me"], a[href*="api.whatsapp.com"]');
        if (waLink) {
          window.dispatchStoreEvent('Contact', {
            channel: 'WhatsApp',
            url: waLink.getAttribute('href') || ''
          });
        }
        var telLink = e.target.closest('a[href^="tel:"]');
        if (telLink) {
          window.dispatchStoreEvent('Contact', {
            channel: 'Phone Support',
            url: telLink.getAttribute('href') || ''
          });
        }
      }, { passive: true });

      // 🌟 6. Reading Intent / Scroll Depth Listener (50% & 90%)
      (function() {
        var tracked50 = false;
        var tracked90 = false;
        window.addEventListener('scroll', function() {
          var h = document.documentElement, 
              b = document.body,
              st = 'scrollTop',
              sh = 'scrollHeight';
          var percent = ((h[st]||b[st]) / ((h[sh]||b[sh]) - h.clientHeight)) * 100;
          if (!tracked50 && percent >= 50) {
            tracked50 = true;
            if (typeof window.dispatchStoreEvent === 'function') {
              window.dispatchStoreEvent('ScrollDepth', { depth: '50%' });
            }
          }
          if (!tracked90 && percent >= 90) {
            tracked90 = true;
            if (typeof window.dispatchStoreEvent === 'function') {
              window.dispatchStoreEvent('ScrollDepth', { depth: '90%' });
            }
          }
        }, { passive: true });
      })();

      // 🌟 7. Silicon Valley In-App Browser & External UPI App Recovery Sentinel
      (function() {
        var isSentinelChecking = false;
        async function checkInAppBrowserRecovery() {
          if (isSentinelChecking) return;
          try {
            var raw = localStorage.getItem('sujata_active_checkout');
            if (!raw) return;
            var session = JSON.parse(raw);
            // Session must have order_id and be under 15 minutes old
            if (!session.order_id || (Date.now() - (session.initiated_at || 0)) > 900000) {
              localStorage.removeItem('sujata_active_checkout');
              return;
            }

            // Only check if user is not already on thank-you page
            if (window.location.pathname.includes('/thank-you')) return;

            isSentinelChecking = true;
            var res = await fetch('/api/check-order-status?order_id=' + encodeURIComponent(session.order_id));
            if (res.ok) {
              var data = await res.json();
              if (data.is_paid) {
                console.log('🎉 [Sujata Sentinel] External app payment verified! Recovering user to Thank-You page.');
                localStorage.removeItem('sujata_active_checkout');
                localStorage.removeItem('sujata_cart');
                var redirUrl = '/thank-you?order_id=' + encodeURIComponent(session.order_id) +
                  '&value=' + encodeURIComponent(session.total || data.amount || 0) +
                  '&mode=' + encodeURIComponent(session.payment_mode || 'upi');
                if (data.shopify_order_number) {
                  redirUrl += '&receipt=' + encodeURIComponent('#' + data.shopify_order_number);
                }
                window.location.href = redirUrl;
              }
            }
          } catch(e) {
            // Non-blocking
          } finally {
            isSentinelChecking = false;
          }
        }

        document.addEventListener('visibilitychange', function() {
          if (document.visibilityState === 'visible') {
            checkInAppBrowserRecovery();
          }
        });
        window.addEventListener('pageshow', function(e) {
          if (e.persisted) {
            checkInAppBrowserRecovery();
          }
        });
      })();
    </script>
    <!-- Razorpay Magic Checkout 1-Click Engine -->
    <!-- ⚡ Silicon Valley JIT Razorpay Magic Checkout Engine (Zero Bloat on Initial Page Load) -->
    <script is:inline>
      (function() {
        var rzpLoading = false;
        var rzpQueue = [];

        window.ensureRazorpayLoaded = function(callback) {
          if (typeof window.Razorpay === 'function') {
            if (typeof callback === 'function') callback();
            return Promise.resolve();
          }

          return new Promise(function(resolve) {
            var cb = function() {
              if (typeof callback === 'function') {
                try { callback(); } catch(e) { console.error(e); }
              }
              resolve();
            };

            if (rzpLoading) {
              rzpQueue.push(cb);
              return;
            }

            rzpLoading = true;
            rzpQueue.push(cb);

            var script = document.createElement('script');
            script.src = 'https://checkout.razorpay.com/v1/magic-checkout.js';
            script.async = true;
            script.onload = function() {
              rzpLoading = false;
              while (rzpQueue.length > 0) {
                var qCb = rzpQueue.shift();
                if (typeof qCb === 'function') qCb();
              }
            };
            script.onerror = function() {
              rzpLoading = false;
              console.warn('⚠️ Razorpay script load failed, Storefront fallback will handle checkout.');
              while (rzpQueue.length > 0) {
                var qCb = rzpQueue.shift();
                if (typeof qCb === 'function') qCb();
              }
            };
            document.head.appendChild(script);
          });
        };

        // 🧠 Pure Interaction-Based JIT Engine (Zero Background Download during Browsing)
        // Only loads when customer explicitly interacts with a purchase action
        document.addEventListener('pointerdown', function(e) {
          if (e.target.closest('#buy-now-btn, #sticky-buynow-btn, #atc-btn, #sticky-atc-btn, .add-to-cart-btn, #checkout-button, #cart-drawer-trigger, .open-cart-trigger')) {
            window.ensureRazorpayLoaded();
          }
        }, { passive: true, once: true });
      })();
    </script>
