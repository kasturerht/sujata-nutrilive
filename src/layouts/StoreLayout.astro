    "telephone": BRAND_CONFIG.supportPhone,
    "email": BRAND_CONFIG.supportEmail,
    "contactPoint": [
      {
        "@type": "ContactPoint",
        "telephone": BRAND_CONFIG.supportPhone,
        "contactType": "customer service",
        "areaServed": "IN",
        "availableLanguage": ["English", "Hindi", "Marathi"]
      }
    ],
    "address": {
      "@type": "PostalAddress",
      "streetAddress": "Plot No 125, Sai Niwas, Dhandai Colony, Khutwad Nagar, Kamatwade",
      "addressLocality": "Nashik",
      "addressRegion": "Maharashtra",
      "postalCode": "422008",
      "addressCountry": "IN"
    },
    "hasMap": "https://share.google/R7aB2MCG9AN5l3RF1",
    "hasCredential": [
      {
        "@type": "EducationalOccupationalCredential",
