    "@type": "WebSite",
    "@id": `${siteUrl}/#website`,
    "name": BRAND_CONFIG.brandName,
    "url": siteUrl,
    "publisher": {
      "@id": `${siteUrl}/#organization`
    },
    "potentialAction": {
      "@type": "SearchAction",
      "target": `${siteUrl}/#product-ecosystem?search={search_term_string}`,
      "query-input": "required name=search_term_string"
    }
  }
];

// 3. Homepage-Specific Rich Snippets (Product Aggregate Rating + DietarySupplement + Google FAQ Accordion)
if (isHomePage) {
  // Flagship Spirulina Product Showcase for Google SERP Gold Star Ratings
