      "url": new URL("/sujata-logo-transparent.png", siteUrl).toString(),
      "caption": BRAND_CONFIG.brandName
    },
    "foundingDate": "2024",
    "founder": {
      "@type": "Person",
      "@id": `${siteUrl}/#founder`,
      "name": "Yash Rajendra Surywanshi",
      "alternateName": ["Yash Suryavanshi"],
      "jobTitle": "Founder & Head of Operations",
      "worksFor": {
        "@id": `${siteUrl}/#organization`
      },
      "address": {
        "@type": "PostalAddress",
        "addressLocality": "Nashik",
        "addressRegion": "Maharashtra",
        "addressCountry": "IN"
      },
      "knowsAbout": [
        "Cold-Compressed Spirulina Cultivation",
