          "@type": "MonetaryAmount",
          "value": "0",
          "currency": "INR"
        },
        "shippingDestination": {
          "@type": "DefinedRegion",
          "addressCountry": "IN"
        },
        "deliveryTime": {
          "@type": "ShippingDeliveryTime",
          "handlingTime": {
            "@type": "QuantitativeValue",
            "minValue": 0,
            "maxValue": 1,
            "unitCode": "d"
          },
          "transitTime": {
            "@type": "QuantitativeValue",
            "minValue": 2,
            "maxValue": 5,
            "unitCode": "d"
          }
        }
      },
      "hasMerchantReturnPolicy": {
        "@type": "MerchantReturnPolicy",
        "applicableCountry": "IN",
        "returnPolicyCategory": "https://schema.org/MerchantReturnFiniteReturnWindow",
        "merchantReturnDays": 40,
        "returnMethod": "https://schema.org/ReturnByMail",
        "returnFees": "https://schema.org/FreeReturn"
      }
    }
  });

  // Biomedical & Dietary Supplement Entity for LLMs & Knowledge Graph (Spirulina)
  schemaGraphItems.push({
    "@type": "DietarySupplement",
    "@id": `${siteUrl}/#supplement-spirulina`,
    "name": "Sujata Cold-Pressed Organic Spirulina",
    "targetPopulation": "Adults seeking pure non-synthetic energy, athletes, individuals with iron deficiency, and plant-based vitality",
    "activeIngredient": "100% Organic Arthrospira Platensis",
    "mechanismOfAction": "Mitochondrial oxygenation via natural non-heme iron and cellular free-radical scavenging via 21.4% intact C-Phycocyanin",
    "safetyConsideration": "Laboratory verified 62.3% plant protein (IS 7219) and natural iron (291.15 mg/kg as Fe). 100% compliant with FSSAI statutory safety standards.",
    "recommendedIntake": {
      "@type": "RecommendedIntake",
      "name": "2 to 4 tablets daily with warm water in the morning"
    },
    "manufacturer": {
      "@id": `${siteUrl}/#organization`
    }
  });

  // Biomedical & Dietary Supplement Entity for LLMs & Knowledge Graph (Sea Buckthorn)
  schemaGraphItems.push({
    "@type": "DietarySupplement",
    "@id": `${siteUrl}/#supplement-seabuckthorn`,
