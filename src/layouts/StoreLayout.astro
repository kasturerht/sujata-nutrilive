              resolve();
            };

            if (rzpLoading) {
              rzpQueue.push(cb);
              return;
            }

            rzpLoading = true;
            rzpQueue.push(cb);

            var script = document.createElement('script');
            script.src = 'https://checkout.razorpay.com/v1/magic-checkout.js';
            script.async = true;
            script.onload = function() {
              rzpLoading = false;
              while (rzpQueue.length > 0) {
                var qCb = rzpQueue.shift();
                if (typeof qCb === 'function') qCb();
              }
            };
            script.onerror = function() {
              rzpLoading = false;
              console.warn('⚠️ Razorpay script load failed, Storefront fallback will handle checkout.');
              while (rzpQueue.length > 0) {
                var qCb = rzpQueue.shift();
                if (typeof qCb === 'function') qCb();
              }
            };
            document.head.appendChild(script);
          });
        };

        // 🧠 Pure Interaction-Based JIT Engine (Zero Background Download during Browsing)
        // Only loads when customer explicitly interacts with a purchase action
        // Intent preload: desktop hover (pointerover) + mobile first touch (touchstart/pointerdown).
        // Not `once` — the listener must survive taps on non-purchase elements; it detaches after the first hit.
        var RZP_INTENT = '.hub-direct-buy-btn, .hub-add-cart-btn, #buy-now-btn, #sticky-buynow-btn, #atc-btn, #sticky-atc-btn, .add-to-cart-btn, #checkout-button, #cart-drawer-trigger, .open-cart-trigger';
        var rzpIntentEvents = ['pointerover', 'touchstart', 'pointerdown', 'focusin'];
        function onRzpIntent(e) {
          var t = e.target;
          if (!t || typeof t.closest !== 'function' || !t.closest(RZP_INTENT)) return;
          rzpIntentEvents.forEach(function(ev) { document.removeEventListener(ev, onRzpIntent, true); });
          window.ensureRazorpayLoaded();
        }
        rzpIntentEvents.forEach(function(ev) { document.addEventListener(ev, onRzpIntent, { passive: true, capture: true }); });
      })();
    </script>
  </head>
