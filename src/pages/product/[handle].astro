// Resolve Clinical Dossier for current product
const resolvedDossier = (handle && productClinicalDossierMap[handle.toLowerCase()]) 
  ? productClinicalDossierMap[handle.toLowerCase()]
  : (handle && handle.toLowerCase().includes('oil')) ? productClinicalDossierMap['sujata-spirulina-coconut-hair-oil']
  : (handle && handle.toLowerCase().includes('shampoo')) ? productClinicalDossierMap['sujata-spirushine-shampoo-conditioner']
  : (handle && (handle.toLowerCase().includes('facewash') || handle.toLowerCase().includes('face-wash'))) ? productClinicalDossierMap['sujata-spirulina-facewash']
  : (handle && (handle.toLowerCase().includes('facepack') || handle.toLowerCase().includes('face-pack'))) ? productClinicalDossierMap['sujata-spirulina-facepack-powder']
  : (handle && handle.toLowerCase().includes('soap')) ? productClinicalDossierMap['sujata-spiruglow-bath-soap']
  : (handle && (handle.toLowerCase().includes('korean') || handle.toLowerCase().includes('cream'))) ? productClinicalDossierMap['sujata-spirulina-korean-cream']
  : (handle && handle.toLowerCase().includes('bridal')) ? productClinicalDossierMap['sujata-bridal-whitening-cream']
  : (handle && handle.toLowerCase().includes('shilajit')) ? productClinicalDossierMap['sujata-pure-himalayan-shilajit']
  : (handle && handle.toLowerCase().includes('b12')) ? productClinicalDossierMap['sujata-plant-based-vitamin-b12']
  : (handle && handle.toLowerCase().includes('moringa')) ? productClinicalDossierMap['sujata-moringa-powder']
  : (handle && handle.toLowerCase().includes('buckthorn')) ? productClinicalDossierMap['sujata-sea-buckthorn-capsules']
  : (handle && handle.toLowerCase().includes('combo')) ? productClinicalDossierMap['sujata-spirulina-sea-buckthorn-combo']
  : (handle && handle.toLowerCase().includes('tablet')) ? productClinicalDossierMap['sujata-spirulina-tablets']
  : (handle && handle.toLowerCase().includes('capsule')) ? productClinicalDossierMap['sujata-spirulina-capsules']
  : productClinicalDossierMap['sujata-spirulina-powder'];

let ingredientsData = resolvedDossier.ingredients;
let timelineData = resolvedDossier.timeline;

// If Shopify metafields provide custom JSON, let them override
try {
  if (product.ingredients?.value && product.ingredients.value.trim().length > 2) {
    const parsed = JSON.parse(product.ingredients.value);
    if (Array.isArray(parsed) && parsed.length > 0) ingredientsData = parsed;
  }
} catch (e) {}

try {
  if (product.timeline?.value && product.timeline.value.trim().length > 2) {
    const parsed = JSON.parse(product.timeline.value);
    if (Array.isArray(parsed) && parsed.length > 0) timelineData = parsed;
  }
} catch (e) {}

const labReportUrl = product.labReport?.value || "/NABL-Report-Sujata.pdf";

const videoTestimonials = [
