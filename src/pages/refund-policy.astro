---
// src/pages/refund-policy.astro
import StoreLayout from '../layouts/StoreLayout.astro';
import StoreHeader from '../components/StoreHeader.astro';
import StoreFooter from '../components/StoreFooter.astro';
import { BRAND_CONFIG } from '../config/brand';

const shopifyDomain = import.meta.env.PUBLIC_SHOPIFY_STOREFRONT_DOMAIN || "tvczdq-nu.myshopify.com";
const storefrontToken = import.meta.env.PUBLIC_SHOPIFY_STOREFRONT_TOKEN || "7e0a0176aede63ce4c6b199e18684018";

let policy = null;
try {
  if (shopifyDomain && storefrontToken) {
    const res = await fetch(`https://${shopifyDomain}/api/2024-01/graphql.json`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', 'X-Shopify-Storefront-Access-Token': storefrontToken },
      body: JSON.stringify({ query: `{ shop { refundPolicy { title body } } }` })
    });
    const data = await res.json();
    policy = data.data?.shop?.refundPolicy;
  }
} catch (e) {
  console.warn("Shopify refundPolicy fetch fallback active:", e);
}

const siteUrl = BRAND_CONFIG.siteUrl || "https://www.sujatanutrilive.com";
const pageUrl = `${siteUrl}/refund-policy`;

const refundPolicySchemas = [
  {
    "@type": "WebPage",
    "@id": `${pageUrl}/#webpage`,
    "name": "90-Day Vitality Guarantee & Refund Policy | Sujata Nutrilive",
    "description": "Official 90-Day Vitality Guarantee: Complete a 90-day cellular rejuvenation routine with 100% full money-back promise, even on empty bottles. Zero-risk trial with transparent terms.",
    "url": pageUrl,
    "mainEntity": {
      "@type": "MerchantReturnPolicy",
      "@id": `${siteUrl}/#merchant-return-policy`,
      "name": "Sujata 90-Day Vitality Guarantee",
      "applicableCountry": "IN",
      "returnPolicyCategory": "https://schema.org/MerchantReturnFiniteReturnWindow",
      "merchantReturnDays": 90,
      "returnMethod": "https://schema.org/ReturnByMail",
      "returnFees": "https://schema.org/FreeReturn",
      "refundType": "https://schema.org/FullRefund",
      "customerRemorseReturnFees": "https://schema.org/FreeReturn"
    }
  },
  {
    "@type": "BreadcrumbList",
    "@id": `${pageUrl}/#breadcrumb`,
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "Home",
        "item": siteUrl
      },
      {
        "@type": "ListItem",
        "position": 2,
        "name": "Refund Policy & 90-Day Guarantee",
        "item": pageUrl
      }
    ]
  }
];
---

<StoreLayout 
  title="90-Day Guarantee & Refund Policy | Sujata Nutrilive"
  description="Sujata Nutrilive 90-Day Vitality Guarantee: 100% money-back refund even on empty bottles. Zero-risk trial with full cellular rejuvenation cycle."
  extraSchema={refundPolicySchemas}
>

  {/* UNIFIED LUXURY STORE HEADER */}
  <StoreHeader />

  <main class="bg-[#FAF9F6] min-h-screen pt-32 md:pt-40 pb-20 selection:bg-[#166534] selection:text-white">
    
    <div class="max-w-4xl mx-auto px-6 lg:px-8">
      
      {/* Breadcrumb Navigation */}
      <nav class="flex items-center gap-3 mb-8">
        <a href="/" class="text-[10px] font-bold tracking-[0.25em] uppercase text-gray-400 hover:text-[#166534] transition-colors py-2 touch-manipulation flex items-center gap-1.5 group">
          <svg class="w-3.5 h-3.5 transition-transform duration-300 group-hover:-translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 12H5m7-7-7 7 7 7"/></svg>
          <span>Store</span>
        </a>
        <span class="w-6 h-[1px] bg-gray-300"></span>
        <span class="text-[10px] font-bold tracking-[0.25em] uppercase text-[#166534]">Refund &amp; Return Policy</span>
      </nav>

      {/* Policy Switcher Bar */}
      <div class="flex items-center gap-2 overflow-x-auto pb-4 mb-8 border-b border-gray-200 text-xs font-bold text-gray-500 uppercase tracking-wider">
        <a href="/privacy-policy" class="hover:text-[#166534] px-4 py-2 rounded-xl shrink-0 hover:bg-gray-100 transition-colors">Privacy Policy</a>
        <a href="/terms-of-service" class="hover:text-[#166534] px-4 py-2 rounded-xl shrink-0 hover:bg-gray-100 transition-colors">Terms of Service</a>
        <a href="/refund-policy" class="bg-[#166534] text-white px-4 py-2 rounded-xl shrink-0 shadow-sm">Refund &amp; Returns</a>
        <a href="/shipping-policy" class="hover:text-[#166534] px-4 py-2 rounded-xl shrink-0 hover:bg-gray-100 transition-colors">Shipping Policy</a>
      </div>

      {/* Header Context Hero */}
      <div class="mb-12">
        <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-emerald-50 border border-emerald-900/10 mb-4 shadow-sm">
          <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
          <span class="text-emerald-900 text-[10px] font-black uppercase tracking-[0.25em]">90-Day Cellular Protocol • Zero-Risk Guarantee</span>
        </div>
        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-['Playfair_Display'] font-black text-[#111827] leading-[1.12] mb-3">
          90-Day Vitality Guarantee.
        </h1>
        <p class="text-xs font-mono text-gray-400 uppercase tracking-widest">
          90-Day Cellular Renewal Protocol • 100% Full Money-Back Promise
        </p>
      </div>

      {/* Golden Guarantee Banner */}
      <div class="bg-gradient-to-br from-[#064E3B] to-[#022219] rounded-3xl p-6 sm:p-8 text-white border border-emerald-500/30 shadow-xl mb-12 relative overflow-hidden">
        <div class="absolute top-0 right-0 w-64 h-64 bg-emerald-400/10 rounded-full blur-[60px] pointer-events-none"></div>
        <div class="relative z-10">
          <span class="text-[10px] font-mono text-amber-400 uppercase tracking-widest block mb-1">The Sujata Promise</span>
          <h2 class="text-xl sm:text-2xl font-['Playfair_Display'] font-bold text-white mb-2">
            The 90-Day Empty-Bottle Vitality Guarantee.
          </h2>
          <p class="text-xs sm:text-sm text-emerald-100/90 leading-relaxed font-light">
            In human biology and Ayurveda, deep tissue repair and cellular turnover (erythropoiesis and mucosal regeneration) take approximately 90 days. If you follow the Sujata daily protocol consistently for 90 days and do not experience a noticeable surge in your daily energy, stamina, digestion, or general wellness, you can request a 100% refund. We will refund every single rupee back to your bank account — <strong>even if all your bottles are completely empty</strong>. No interrogations.
          </p>
        </div>
      </div>

      {/* Structured Legal Content */}
        {/* Master Clause: 90-Day Vitality Guarantee Supersedes Standard Terms */}
        <div class="bg-emerald-950 text-white p-6 sm:p-8 rounded-2xl border-2 border-emerald-500/50">
          <span class="text-amber-400 text-[10px] font-bold uppercase tracking-widest block mb-1">Official Governing Policy Directive</span>
          <h3 class="text-base sm:text-lg font-bold font-serif mb-2 text-white">
            Precedence of 90-Day Vitality Guarantee Over Standard Merchandise Terms
          </h3>
          <p class="text-xs sm:text-sm text-emerald-100/90 leading-relaxed font-light mb-3">
            For all dietary supplement products purchased directly from Sujata Nutrilive (including Spirulina Capsules, Sea Buckthorn Capsules, and Pure Powder), our <strong>90-Day Vitality Guarantee takes absolute precedence</strong> over generic ecommerce return conditions.
          </p>
          <ul class="list-disc pl-5 space-y-1.5 text-xs text-emerald-200">
            <li>You are entitled to open, consume, and complete a full 90-day protocol (e.g. 3-bottle routine).</li>
            <li>If you do not experience noticeable improvements in energy, digestion, or cellular vitality, you receive a 100% full refund with zero deductions.</li>
            <li>You are protected even on completely consumed empty bottles under our transparent terms below.</li>
            <li>Standard "unopened packaging" conditions apply strictly to transit-damaged units seeking immediate replacement or excess unopened bottles in custom orders.</li>
          </ul>
        </div>

        <div class="bg-white rounded-[2.5rem] p-6 sm:p-10 md:p-12 border border-emerald-900/10 shadow-[0_20px_50px_rgba(0,0,0,0.03)] space-y-10 text-xs sm:text-sm text-gray-600 font-light leading-relaxed mt-8">
          {/* Section 1 */}
            <div>
              <h2 class="text-base sm:text-lg font-bold text-[#111827] font-['Playfair_Display'] mb-3">
                1. Eligibility &amp; Transparent Terms (4 Key Conditions)
              </h2>
              <p class="mb-3">
                To qualify for the 90-Day Vitality Money-Back Guarantee, customers simply need to fulfill these 4 fair and transparent biological conditions:
              </p>
              <ul class="list-disc pl-5 space-y-2 text-gray-700">
                <li><strong>1. Consistent 90-Day Daily Protocol:</strong> The product must be consumed daily for a full 90 consecutive days (morning routine after breakfast with water) to allow cellular regeneration.</li>
                <li><strong>2. Adequate Cellular Hydration:</strong> Consume at least 2.5 to 3 liters of clean water daily to enable proper absorption of phycocyanin, iron, and active bio-compounds.</li>
                <li><strong>3. Authentic Direct Purchase:</strong> The order must be placed directly through the official Sujata Nutrilive website (<code>sujatanutrilive.com</code>) or verified WhatsApp concierge with a valid Order ID/Invoice.</li>
                <li><strong>4. 7-Day Claim Window &amp; Empty Bottles:</strong> The claim must be initiated within 7 calendar days after completing the 90-day protocol. Keep the empty bottles as physical confirmation of protocol completion.</li>
              </ul>
            </div>

            {/* Section 2 */}
            <div>
              <h2 class="text-base sm:text-lg font-bold text-[#111827] font-['Playfair_Display'] mb-3">
                2. Damaged or Defective In-Transit Shipments
              </h2>
              <p>
                If your parcel arrives with a broken tamper seal, torn outer pouch, or physical transit damage, we offer an <strong>Immediate Free Express Replacement</strong>. Simply snap a photo of the package and WhatsApp our dispatch desk at <strong>+91 98347 83503</strong>. We will dispatch a brand-new sealed batch within 24 hours via Priority Air Cargo.
              </p>
            </div>

            {/* Section 3 */}
            <div>
              <h2 class="text-base sm:text-lg font-bold text-[#111827] font-['Playfair_Display'] mb-3">
                3. Refund Processing Timelines &amp; Methods
              </h2>
              <p class="mb-3">Once approved by our support team, refunds are initiated instantly:</p>
              <ul class="list-disc pl-5 space-y-1.5 text-gray-700">
                <li><strong>Prepaid UPI (Google Pay, PhonePe, Paytm):</strong> Credited directly back to your linked bank account within <strong>24 to 48 hours</strong>.</li>
                <li><strong>Debit / Credit Cards &amp; NetBanking:</strong> Credited within <strong>3 to 5 business days</strong> depending on your issuing bank's settlement cycle.</li>
                <li><strong>Cash on Delivery (COD) Orders:</strong> Transferred via instant IMPS/UPI upon providing your bank account or UPI ID.</li>
              </ul>
            </div>

            {/* Section 4: 2-Step Refund Process */}
            <div class="bg-gray-50 rounded-2xl p-5 border border-gray-200">
              <h2 class="text-base font-bold text-[#111827] font-['Playfair_Display'] mb-3">
                4. How to Request a Refund (2 Simple Steps)
              </h2>
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 text-xs text-gray-700">
                <div class="bg-white p-4 rounded-xl border border-gray-200">
                  <strong class="font-bold text-[#166534] block mb-1">Option A: Via WhatsApp</strong>
                  <span>Send your Order ID (e.g. <code>SUJATA-84920</code>) to our WhatsApp support desk at <a href="https://wa.me/919834783503" class="text-emerald-700 font-bold underline">+91 98347 83503</a>.</span>
                </div>
                <div class="bg-white p-4 rounded-xl border border-gray-200">
                  <strong class="font-bold text-[#166534] block mb-1">Option B: Via Email</strong>
                  <span>Send an email with your Order ID to <a href="mailto:support@sujatanutrilive.com" class="text-emerald-700 font-bold underline">support@sujatanutrilive.com</a>.</span>
                </div>
              </div>
            </div>
        </div>

    </div>

  </main>

  {/* UNIFIED LUXURY STORE FOOTER */}
  <StoreFooter />

</StoreLayout>
