---
// src/pages/contact.astro
import StoreLayout from '../layouts/StoreLayout.astro';
import StoreHeader from '../components/StoreHeader.astro';
import StoreFooter from '../components/StoreFooter.astro';

const shopifyDomain = import.meta.env.PUBLIC_SHOPIFY_STOREFRONT_DOMAIN || "tvczdq-nu.myshopify.com";
const storefrontToken = import.meta.env.PUBLIC_SHOPIFY_STOREFRONT_TOKEN || "7e0a0176aede63ce4c6b199e18684018";

// Micro-FAQ Questions
const contactFaqs = [
  {
    q: "Can I take Sujata Spirulina if I have Thyroid, Diabetes, or High BP?",
    a: "Yes. Pure raw spirulina is a whole-food microalgae with zero synthetic hormones or stimulants. However, since it is naturally rich in iodine and organic non-heme iron, we recommend maintaining a 1-hour gap between your thyroid/prescription medication and your morning spirulina ritual."
  },
  {
    q: "How soon can I expect to feel measurable results?",
    a: "Most customers report improved morning alertness and reduced 3 PM fatigue within Days 1–7 due to enhanced cellular oxygenation. Gut alkalization and reduced bloating typically normalize within Days 8–21. Deep skin radiance, keratin strength, and immune vitality peak after 30 consecutive days."
  },
  {
    q: "What is your 30-Day Empty-Bottle Money-Back Guarantee?",
    a: "We stand 100% behind our sub-40°C purity. If you complete your 30-day protocol and do not feel a genuine difference in your energy, digestion, or vitality, simply contact our support desk for a full 100% refund — even if the pouch is completely empty. No interrogations."
  },
  {
    q: "How do I modify, pause, or cancel my active subscription?",
    a: "You have complete freedom. You can pause, skip an upcoming delivery, change your delivery address, or cancel anytime with 1-click via your account page or by messaging our WhatsApp support desk at +91 98765 43210."
  }
];
---

<StoreLayout title="Contact Us, Practitioner Concierge & Grievance Desk | Sujata Nutrilive">

  {/* UNIFIED LUXURY STORE HEADER */}
  <StoreHeader />

  <main class="bg-[#FAF9F6] min-h-screen pt-32 md:pt-40 pb-20 selection:bg-[#166534] selection:text-white">
    
    <div class="max-w-6xl mx-auto px-6 lg:px-8">
      
      {/* Breadcrumb Navigation */}
      <nav class="flex items-center gap-3 mb-8">
        <a href="/" class="text-[10px] font-bold tracking-[0.25em] uppercase text-gray-400 hover:text-[#166534] transition-colors py-2 touch-manipulation flex items-center gap-1.5 group">
          <svg class="w-3.5 h-3.5 transition-transform duration-300 group-hover:-translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 12H5m7-7-7 7 7 7"/></svg>
          <span>Store</span>
        </a>
        <span class="w-6 h-[1px] bg-gray-300"></span>
        <span class="text-[10px] font-bold tracking-[0.25em] uppercase text-[#166534]">Customer Concierge &amp; Support Desk</span>
      </nav>

      {/* =========================================================================
          ZONE 1: HERO & 3 DIRECT ACCESS CHANNELS
          ========================================================================= */}
      <div class="text-center max-w-3xl mx-auto mb-12">
        <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-emerald-50 border border-emerald-900/10 mb-4 shadow-sm">
          <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
          <span class="text-emerald-900 text-[10px] font-black uppercase tracking-[0.25em]">24/7 Dedicated Support • Certified Ayurvedic Concierge</span>
        </div>
        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-['Playfair_Display'] font-black text-[#111827] leading-[1.12] mb-3">
          We Are Here To Assist Your Protocol.
        </h1>
        <p class="text-gray-500 text-xs sm:text-sm font-light leading-relaxed">
          Whether you need personalized dosage advice from an Ayurvedic Vaidya, order delivery assistance, or wholesale partnerships — connect with us instantly.
        </p>
      </div>

      {/* 3 Luxury Fast Access Channel Cards */}
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-16">
        
        {/* Channel 1: WhatsApp Vaidya Concierge */}
        <a 
          href="https://wa.me/919876543210?text=Hello%20Sujata%20Nutrilive,%20I%20have%20a%20question%20regarding%20my%20health%20routine." 
          target="_blank" 
          rel="noopener noreferrer" 
          class="bg-white rounded-3xl p-6 sm:p-8 border-2 border-emerald-600/30 hover:border-emerald-600 shadow-[0_15px_40px_rgba(0,0,0,0.03)] hover:shadow-lg transition-all duration-300 flex flex-col justify-between group cursor-pointer"
        >
          <div>
            <div class="w-12 h-12 rounded-2xl bg-[#25D366]/10 text-[#25D366] flex items-center justify-center mb-6 group-hover:scale-110 transition-transform">
              <svg class="w-6 h-6 fill-current" viewBox="0 0 24 24"><path d="M12.031 0C5.385 0 0 5.388 0 12.042c0 2.124.553 4.195 1.604 6.012L.452 24l6.104-1.601a11.964 11.964 0 005.475 1.328h.005c6.645 0 12.031-5.388 12.031-12.042C24 5.388 18.677 0 12.031 0zm5.351 17.181c-.223.633-1.282 1.206-1.768 1.246-.445.038-.971.21-3.085-.666-2.545-1.054-4.161-3.666-4.288-3.834-.127-.168-1.026-1.365-1.026-2.605 0-1.24.634-1.85 1.026-2.261.353-.372.889-.486 1.185-.486.297 0 .593.004.851.015.275.011.644-.105.992.738.356.862 1.218 2.966 1.326 3.181.107.215.178.468.03.743-.148.275-.222.446-.445.714-.222.268-.466.586-.667.828-.222.268-.458.558-.201.996.258.438 1.144 1.884 2.456 3.051 1.693 1.506 3.093 1.97 3.538 2.185.445.215.707.19 1.002-.148.297-.338 1.282-1.488 1.626-2.001.344-.513.687-.428 1.088-.275.402.153 2.541 1.196 2.977 1.41.436.215.727.322.831.5.105.178.105 1.037-.118 1.67z"></path></svg>
            </div>
            <span class="text-[10px] font-black uppercase tracking-widest text-[#166534] block mb-1">Instant Messaging</span>
            <h3 class="text-lg font-['Playfair_Display'] font-black text-[#111827] mb-2">
              WhatsApp Vaidya Concierge
            </h3>
            <p class="text-xs text-gray-500 font-light leading-relaxed">
              Chat directly with our certified Ayurvedic doctors for dosage, thyroid/diabetes queries, and routine advice.
            </p>
          </div>
          <div class="mt-6 pt-4 border-t border-gray-100 flex items-center justify-between text-xs font-bold text-emerald-800">
            <span>Online Now</span>
            <span class="group-hover:translate-x-1 transition-transform text-[#25D366]">Start Chat →</span>
          </div>
        </a>

        {/* Channel 2: Phone Helpline */}
        <a 
          href="tel:+919876543210" 
          class="bg-white rounded-3xl p-6 sm:p-8 border border-gray-200 hover:border-emerald-600 shadow-[0_15px_40px_rgba(0,0,0,0.03)] hover:shadow-lg transition-all duration-300 flex flex-col justify-between group cursor-pointer"
        >
          <div>
            <div class="w-12 h-12 rounded-2xl bg-amber-50 text-amber-600 flex items-center justify-center mb-6 group-hover:scale-110 transition-transform">
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path></svg>
            </div>
            <span class="text-[10px] font-black uppercase tracking-widest text-amber-800 block mb-1">Direct Phone Desk</span>
            <h3 class="text-lg font-['Playfair_Display'] font-black text-[#111827] mb-2">
              +91 98765 43210
            </h3>
            <p class="text-xs text-gray-500 font-light leading-relaxed">
              Available Monday to Saturday, 10:00 AM to 6:00 PM IST. Direct telephonic support with zero automated IVR loops.
            </p>
          </div>
          <div class="mt-6 pt-4 border-t border-gray-100 flex items-center justify-between text-xs font-bold text-gray-700">
            <span>Mon — Sat (10am-6pm)</span>
            <span class="group-hover:translate-x-1 transition-transform text-[#166534]">Call Desk →</span>
          </div>
        </a>

        {/* Channel 3: VIP Email Support */}
        <a 
          href="mailto:support@sujatanutrilive.com" 
          class="bg-white rounded-3xl p-6 sm:p-8 border border-gray-200 hover:border-emerald-600 shadow-[0_15px_40px_rgba(0,0,0,0.03)] hover:shadow-lg transition-all duration-300 flex flex-col justify-between group cursor-pointer"
        >
          <div>
            <div class="w-12 h-12 rounded-2xl bg-blue-50 text-blue-600 flex items-center justify-center mb-6 group-hover:scale-110 transition-transform">
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path></svg>
            </div>
            <span class="text-[10px] font-black uppercase tracking-widest text-blue-800 block mb-1">Email Ticketing</span>
            <h3 class="text-lg font-['Playfair_Display'] font-black text-[#111827] mb-2">
              support@sujatanutrilive.com
            </h3>
            <p class="text-xs text-gray-500 font-light leading-relaxed">
              Official email ticketing desk for order modifications, billing inquiries, and certified laboratory certificate requests.
            </p>
          </div>
          <div class="mt-6 pt-4 border-t border-gray-100 flex items-center justify-between text-xs font-bold text-gray-700">
            <span>&lt; 2h Response SLA</span>
            <span class="group-hover:translate-x-1 transition-transform text-[#166534]">Send Email →</span>
          </div>
        </a>

      </div>

      {/* =========================================================================
          ZONE 2: INTERACTIVE INQUIRY FORM + PHYSICAL HEADQUARTERS DOSSIER
          ========================================================================= */}
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-start mb-16">
        
        {/* Left Column: Smart Inquiry Form */}
        <div class="lg:col-span-7 bg-white rounded-[2.5rem] p-6 sm:p-10 border border-emerald-900/10 shadow-[0_20px_50px_rgba(0,0,0,0.03)]">
          
          <h2 class="text-2xl font-['Playfair_Display'] font-black text-[#111827] mb-2">
            Send Us a Direct Message.
          </h2>
          <p class="text-xs text-gray-500 font-light mb-8">
            Fill out the details below and our clinical team will get back to you within 2 business hours.
          </p>

          <form id="contact-inquiry-form" class="space-y-5">
            
            <div>
              <label for="contact-name" class="block text-xs font-bold text-[#111827] uppercase tracking-wider mb-2">
                Full Name *
              </label>
              <input 
                type="text" 
                id="contact-name" 
                placeholder="e.g. Rahul Sharma" 
                class="w-full bg-[#FAF9F6] border border-gray-200 focus:border-emerald-600 focus:bg-white rounded-xl py-3 px-4 text-xs font-medium text-black outline-none transition-all"
                required
              />
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div>
                <label for="contact-phone" class="block text-xs font-bold text-[#111827] uppercase tracking-wider mb-2">
                  10-Digit Mobile Number *
                </label>
                <input 
                  type="tel" 
                  id="contact-phone" 
                  maxlength="10" 
                  placeholder="e.g. 9876543210" 
                  class="w-full bg-[#FAF9F6] border border-gray-200 focus:border-emerald-600 focus:bg-white rounded-xl py-3 px-4 text-xs font-medium text-black outline-none transition-all"
                  required
                />
              </div>

              <div>
                <label for="contact-category" class="block text-xs font-bold text-[#111827] uppercase tracking-wider mb-2">
                  Inquiry Category *
                </label>
                <select 
                  id="contact-category" 
                  class="w-full bg-[#FAF9F6] border border-gray-200 focus:border-emerald-600 focus:bg-white rounded-xl py-3 px-4 text-xs font-medium text-black outline-none transition-all cursor-pointer"
                >
                  <option value="dosage">💊 Dosage &amp; Protocol Advice</option>
                  <option value="order">📦 Order Delivery &amp; Tracking</option>
                  <option value="wholesale">🤝 Wholesale &amp; Doctor Partnership</option>
                  <option value="general">❓ General Inquiry / Feedback</option>
                </select>
              </div>
            </div>

            <div>
              <label for="contact-message" class="block text-xs font-bold text-[#111827] uppercase tracking-wider mb-2">
                Your Message / Health Query *
              </label>
              <textarea 
                id="contact-message" 
                rows="4" 
                placeholder="Describe your question in detail (e.g. Can I take spirulina with morning green tea?)..." 
                class="w-full bg-[#FAF9F6] border border-gray-200 focus:border-emerald-600 focus:bg-white rounded-xl py-3 px-4 text-xs font-medium text-black outline-none transition-all"
                required
              ></textarea>
            </div>

            <button 
              type="submit" 
              id="contact-submit-btn"
              class="w-full bg-[#111827] hover:bg-[#166534] text-white py-4 rounded-xl font-bold text-xs uppercase tracking-widest flex items-center justify-center gap-2 shadow-lg transition-all duration-300 touch-manipulation cursor-pointer"
            >
              <span>Submit Inquiry →</span>
            </button>

          </form>

          {/* Form Success Banner */}
          <div id="contact-success-banner" class="hidden mt-6 p-4 rounded-2xl bg-emerald-50 border border-emerald-200 text-emerald-900 text-xs">
            <div class="flex items-center gap-2 font-bold mb-1">
              <span>✓ Message Successfully Received!</span>
            </div>
            <p class="font-light">Ticket #SJT-{Math.floor(10000 + Math.random() * 90000)} generated. Our Vaidya will reach out via WhatsApp / Call within 2 hours.</p>
          </div>

        </div>

        {/* Right Column: Verified Corporate Headquarters Card */}
        <div class="lg:col-span-5 space-y-6">
          
          <div class="bg-white rounded-[2.5rem] p-6 sm:p-8 border border-emerald-900/10 shadow-[0_20px_50px_rgba(0,0,0,0.03)]">
            
            <div class="flex items-center gap-2 mb-4">
              <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
              <span class="text-xs font-mono font-bold text-emerald-800 uppercase tracking-widest">Registered Corporate HQ</span>
            </div>

            <h3 class="text-xl font-['Playfair_Display'] font-black text-[#111827] mb-4">
              Sujata Nutrilive Pvt. Ltd.
            </h3>

            <div class="space-y-4 text-xs text-gray-600 font-light leading-relaxed">
              
              <div class="flex items-start gap-3">
                <span class="text-base shrink-0">📍</span>
                <div>
                  <strong class="font-bold text-[#111827] block">Corporate Headquarters:</strong>
                  <span>42/B, Prabhat Road, Deccan Gymkhana, Pune, Maharashtra 411004, India.</span>
                </div>
              </div>

              <div class="flex items-start gap-3">
                <span class="text-base shrink-0">🏛️</span>
                <div>
                  <strong class="font-bold text-[#111827] block">Statutory Compliance &amp; Licenses:</strong>
                  <span>FSSAI License: <strong>#11521999000284</strong></span><br/>
                  <span>GSTIN: <strong>27AAACS8492K1Z9</strong></span>
                </div>
              </div>

              <div class="flex items-start gap-3">
                <span class="text-base shrink-0">⏰</span>
                <div>
                  <strong class="font-bold text-[#111827] block">Working Hours:</strong>
                  <span>Monday to Saturday • 10:00 AM to 6:00 PM IST</span>
                </div>
              </div>

            </div>

          </div>

          {/* Quick Doctor Partnership Note */}
          <div class="bg-gradient-to-br from-[#064E3B] to-[#022219] rounded-3xl p-6 text-white border border-emerald-500/20 shadow-lg">
            <h4 class="text-base font-['Playfair_Display'] font-bold text-white mb-2">
              For Doctors &amp; Wellness Clinics 🩺
            </h4>
            <p class="text-xs text-emerald-100/80 leading-relaxed font-light mb-4">
              We partner with over 450+ certified integrative physicians and Ayurvedic clinics across India. Request samples and institutional clinical dossiers.
            </p>
            <a 
              href="mailto:partnerships@sujatanutrilive.com" 
              class="inline-flex items-center gap-1.5 text-xs font-bold text-emerald-300 hover:text-white uppercase tracking-wider transition-colors"
            >
              <span>Email Institutional Desk →</span>
            </a>
          </div>

        </div>

      </div>

      {/* =========================================================================
          ZONE 3: STATUTORY GRIEVANCE REDRESSAL OFFICER (CONSUMER PROTECTION RULES)
          ========================================================================= */}
      <div class="bg-gray-50 border border-gray-200/80 rounded-3xl p-6 sm:p-8 mb-16">
        <div class="flex flex-col md:flex-row md:items-center justify-between gap-6">
          <div>
            <span class="text-[10px] font-mono font-bold uppercase tracking-widest text-emerald-900 bg-emerald-100 px-2.5 py-1 rounded-md mb-2 inline-block">
              Statutory Consumer Protection Compliance
            </span>
            <h3 class="text-lg font-['Playfair_Display'] font-bold text-[#111827] mb-1">
              Grievance Redressal Officer Desk
            </h3>
            <p class="text-xs text-gray-500 font-light max-w-xl leading-relaxed">
              In accordance with the Consumer Protection (E-Commerce) Rules, 2020, consumers may contact our designated Grievance Officer for escalated resolution.
            </p>
          </div>

          <div class="bg-white p-4 rounded-2xl border border-gray-200 text-xs font-mono shrink-0 space-y-1">
            <div><strong>Officer:</strong> Mr. Harshvardhan Joshi</div>
            <div><strong>Designation:</strong> Head of Consumer Grievances</div>
            <div><strong>Direct Email:</strong> <a href="mailto:grievance@sujatanutrilive.com" class="text-emerald-700 underline">grievance@sujatanutrilive.com</a></div>
            <div class="text-[10px] text-gray-400">Acknowledgment SLA: Within 48 Hours</div>
          </div>
        </div>
      </div>

      {/* =========================================================================
          ZONE 4: INSTANT SELF-SERVICE MICRO-FAQ ACCORDION
          ========================================================================= */}
      <div id="faq" class="max-w-3xl mx-auto">
        
        <div class="text-center mb-8">
          <span class="text-emerald-800 text-[10px] font-black uppercase tracking-widest block mb-1">Instant Answers</span>
          <h2 class="text-2xl font-['Playfair_Display'] font-black text-[#111827]">
            Frequently Asked Questions
          </h2>
        </div>

        <div class="space-y-4">
          {contactFaqs.map((faq, index) => (
            <div class="contact-faq-item bg-white border border-gray-200 rounded-2xl overflow-hidden transition-all duration-300">
              <button 
                type="button" 
                class="contact-faq-toggle w-full px-6 py-4 text-left flex items-center justify-between gap-4 font-bold text-xs sm:text-sm text-[#111827] cursor-pointer hover:bg-gray-50 transition-colors"
                aria-expanded="false"
              >
                <span>{faq.q}</span>
                <span class="text-lg text-emerald-800 font-mono transition-transform duration-300 faq-icon">+</span>
              </button>
              <div class="contact-faq-content hidden px-6 pb-5 text-xs text-gray-500 font-light leading-relaxed border-t border-gray-100 pt-3">
                {faq.a}
              </div>
            </div>
          ))}
        </div>

      </div>

    </div>

  </main>

  {/* UNIFIED LUXURY STORE FOOTER */}
  <StoreFooter />

  {/* CLIENT SCRIPT */}
  <script is:inline>
    function initContactPage() {
      // 1. Form Submission
      const form = document.getElementById('contact-inquiry-form');
      const submitBtn = document.getElementById('contact-submit-btn');
      const successBanner = document.getElementById('contact-success-banner');

      form?.addEventListener('submit', (e) => {
        e.preventDefault();
        if (submitBtn) {
          submitBtn.innerHTML = `<span>Sending...</span>`;
          submitBtn.setAttribute('disabled', 'true');
        }

        setTimeout(() => {
          if (submitBtn) {
            submitBtn.innerHTML = `<span>Submitted ✓</span>`;
            submitBtn.classList.replace('bg-[#111827]', 'bg-[#166534]');
          }
          if (successBanner) {
            successBanner.classList.remove('hidden');
          }
          form.reset();
        }, 600);
      });

      // 2. Micro-FAQ Accordion
      const toggles = document.querySelectorAll('.contact-faq-toggle');
      toggles.forEach(toggle => {
        toggle.addEventListener('click', () => {
          const content = toggle.nextElementSibling;
          const icon = toggle.querySelector('.faq-icon');
          const isExpanded = toggle.getAttribute('aria-expanded') === 'true';

          if (isExpanded) {
            toggle.setAttribute('aria-expanded', 'false');
            content?.classList.add('hidden');
            if (icon) icon.innerText = '+';
          } else {
            toggle.setAttribute('aria-expanded', 'true');
            content?.classList.remove('hidden');
            if (icon) icon.innerText = '−';
          }
        });
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initContactPage);
    } else {
      initContactPage();
    }
    document.addEventListener('astro:page-load', initContactPage);
  </script>

</StoreLayout>
