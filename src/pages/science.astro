          <a href={BRAND_CONFIG.googleMapsUrl || "https://share.google/R7aB2MCG9AN5l3RF1"} target="_blank" rel="noopener noreferrer" class="text-[10px] font-mono text-amber-300 hover:text-white transition-colors flex items-center gap-1">
            <span>Nashik Facility (5.0 ★)</span>
            <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/></svg>
