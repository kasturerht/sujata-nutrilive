    function initSciencePage() {
      // 1. Lab Modal Logic
      const modal = document.getElementById('science-lab-modal');
      const openBtn = document.getElementById('open-science-lab-modal');
      const closeBtn = document.getElementById('close-science-lab-modal');

      if (modal && openBtn) {
        const closeModal = () => {
          modal.classList.add('opacity-0', 'pointer-events-none');
          document.body.style.overflow = '';
        };

        openBtn.addEventListener('click', () => {
          modal.classList.remove('opacity-0', 'pointer-events-none');
          document.body.style.overflow = 'hidden';
        });

        closeBtn?.addEventListener('click', closeModal);
        modal.addEventListener('click', (e) => {
          if (e.target === modal) closeModal();
        });

        document.addEventListener('keydown', (e) => {
          if (e.key === 'Escape' && !modal.classList.contains('opacity-0')) {
            closeModal();
          }
        });
      }

      // 2. Buy Box Format Switching Logic
      const formatBtns = document.querySelectorAll('.science-format-btn');
      const subCheckbox = document.getElementById('science-sub-checkbox');
      const ctaPrice = document.getElementById('science-cta-price');
      const buyBtn = document.getElementById('science-buy-btn');

      let currentProduct = {
        id: 'sujata_powder_100g',
        title: 'Raw Spirulina Powder (100g)',
        price: 600,
        image: '/spirulina-powder.png',
        subtitle: 'Sub-40°C Cold Extract'
      };

      function updatePricing() {
        const isSubscribed = subCheckbox ? subCheckbox.checked : false;
        const finalPrice = isSubscribed ? Math.round(currentProduct.price * 0.9) : currentProduct.price;
        if (ctaPrice) ctaPrice.innerText = `₹${finalPrice}`;
      }

      formatBtns.forEach(btn => {
        btn.addEventListener('click', () => {
          formatBtns.forEach(b => {
            b.classList.remove('border-[#166534]', 'bg-emerald-50/50', 'active-format');
            b.classList.add('border-gray-200', 'bg-white');
          });

          btn.classList.remove('border-gray-200', 'bg-white');
          btn.classList.add('border-[#166534]', 'bg-emerald-50/50', 'active-format');

          currentProduct.id = btn.getAttribute('data-id') || 'sujata_powder_100g';
          currentProduct.title = btn.getAttribute('data-title') || 'Raw Spirulina Powder (100g)';
          currentProduct.price = parseFloat(btn.getAttribute('data-price')) || 600;
          currentProduct.image = btn.getAttribute('data-image') || '/spirulina-powder.png';
          currentProduct.subtitle = currentProduct.id.includes('caps') ? '100% Veggie Capsules' : 'Sub-40°C Cold Extract';

          updatePricing();
        });
      });

      subCheckbox?.addEventListener('change', updatePricing);

      // 3. Fast Add to Cart Button
      buyBtn?.addEventListener('click', (e) => {
        e.preventDefault();
        const isSubscribed = subCheckbox ? subCheckbox.checked : false;
        const finalPrice = isSubscribed ? Math.round(currentProduct.price * 0.9) : currentProduct.price;
        const subText = isSubscribed ? 'Monthly Protocol (10% Off)' : currentProduct.subtitle;

        if (typeof window.addItemToLocalCart === 'function') {
          window.addItemToLocalCart({
            id: currentProduct.id,
            title: currentProduct.title,
            subtitle: subText,
            price: finalPrice,
            image: currentProduct.image,
            quantity: 1
          });
        }
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initSciencePage);
    } else {
      initSciencePage();
    }
    document.addEventListener('astro:page-load', initSciencePage);
  </script>

</StoreLayout>
