  <script is:inline>
    function initSciencePage() {
      // 1. Lab Modal Logic
      const modal = document.getElementById('science-lab-modal');
      const openBtn = document.getElementById('open-science-lab-modal');
      const closeBtn = document.getElementById('close-science-lab-modal');

      if (modal && openBtn) {
        const closeModal = () => {
          modal.classList.add('opacity-0', 'pointer-events-none');
          document.body.style.overflow = '';
        };

        openBtn.addEventListener('click', () => {
          modal.classList.remove('opacity-0', 'pointer-events-none');
          document.body.style.overflow = 'hidden';
        });

        closeBtn?.addEventListener('click', closeModal);
        modal.addEventListener('click', (e) => {
          if (e.target === modal) closeModal();
        });

        document.addEventListener('keydown', (e) => {
          if (e.key === 'Escape' && !modal.classList.contains('opacity-0')) {
            closeModal();
          }
        });
      }

      // 2. High-Converting In-Line Scientific Bridge Buttons
      // 2A. Direct 1-Click Buy Now Buttons across the page
      document.querySelectorAll('.science-direct-buy-btn').forEach(btn => {
        btn.addEventListener('click', async (e) => {
          e.preventDefault();
          const id = btn.getAttribute('data-id');
          const title = btn.getAttribute('data-title');
          const price = parseFloat(btn.getAttribute('data-price')) || 350;
          const image = btn.getAttribute('data-image');
          const subtitle = btn.getAttribute('data-subtitle') || '100% Pure Cold-Pressed';

          const originalHtml = btn.innerHTML;
          btn.innerHTML = `<span class="w-3.5 h-3.5 border-2 border-current border-t-transparent rounded-full animate-spin inline-block"></span><span>Preparing...</span>`;
          btn.style.pointerEvents = 'none';

          try {
            if (typeof window.directCheckoutItem === 'function') {
              await window.directCheckoutItem({
                id: id,
                title: title,
                price: price,
                image: image,
                subtitle: subtitle,
                quantity: 1
              });
            } else if (typeof window.addItemToLocalCart === 'function') {
              window.addItemToLocalCart({
                id: id,
                title: title,
                price: price,
                image: image,
                subtitle: subtitle,
                quantity: 1
              });
              btn.innerHTML = originalHtml;
              btn.style.pointerEvents = '';
            }
          } catch (err) {
            console.error("Direct checkout error:", err);
            btn.innerHTML = originalHtml;
            btn.style.pointerEvents = '';
          }
        });
      });

      // 2B. Direct Add to Cart Buttons across the page
      document.querySelectorAll('.science-add-cart-btn').forEach(btn => {
        btn.addEventListener('click', (e) => {
          e.preventDefault();
          const id = btn.getAttribute('data-id');
          const title = btn.getAttribute('data-title');
          const price = parseFloat(btn.getAttribute('data-price')) || 350;
          const image = btn.getAttribute('data-image');
          const subtitle = btn.getAttribute('data-subtitle') || '100% Pure Cold-Pressed';

          if (typeof window.addItemToLocalCart === 'function') {
            window.addItemToLocalCart({
              id: id,
              title: title,
              price: price,
              image: image,
              subtitle: subtitle,
              quantity: 1
            });
          }
          const originalText = btn.innerText;
          btn.innerText = "✓ Added";
          btn.classList.add('bg-emerald-600', 'text-white');
          setTimeout(() => {
            btn.innerText = originalText;
            btn.classList.remove('bg-emerald-600');
          }, 1800);
        });
      });

      // 2C. Combo Plan Switcher Pills on Science Page
      const comboPills = document.querySelectorAll('.science-combo-pill');
      const comboBuyBtn = document.getElementById('science-combo-buy-btn');
      const comboCartBtn = document.getElementById('science-combo-cart-btn');
      const comboPriceEl = document.getElementById('science-combo-price');
      const comboOldPriceEl = document.getElementById('science-combo-old-price');
      const comboSaveBadge = document.getElementById('science-combo-save-badge');

      comboPills.forEach(pill => {
        pill.addEventListener('click', (e) => {
          e.preventDefault();
          comboPills.forEach(p => {
            p.classList.remove('bg-emerald-500', 'text-black', 'border-emerald-400', 'shadow-sm', 'active-combo-pill');
            p.classList.add('bg-white/10', 'text-gray-300', 'border-white/10');
          });

          pill.classList.remove('bg-white/10', 'text-gray-300', 'border-white/10');
          pill.classList.add('bg-emerald-500', 'text-black', 'border-emerald-400', 'shadow-sm', 'active-combo-pill');

          const variantId = pill.getAttribute('data-variant-id');
          const price = parseFloat(pill.getAttribute('data-price') || '1100');
          const oldPrice = pill.getAttribute('data-old-price') || '1430';
          const save = pill.getAttribute('data-save') || '330';
          const title = pill.getAttribute('data-title') || '1-Month Plan';

          if (comboBuyBtn) {
            comboBuyBtn.setAttribute('data-id', variantId);
            comboBuyBtn.setAttribute('data-price', price.toString());
            comboBuyBtn.setAttribute('data-subtitle', `${title} • All-Day Energy, Immunity & Skin Synergy`);
          }
          if (comboCartBtn) {
            comboCartBtn.setAttribute('data-id', variantId);
            comboCartBtn.setAttribute('data-price', price.toString());
            comboCartBtn.setAttribute('data-subtitle', `${title} • All-Day Energy, Immunity & Skin Synergy`);
          }

          if (comboPriceEl) comboPriceEl.innerText = `₹${price.toLocaleString('en-IN')}`;
          if (comboOldPriceEl) comboOldPriceEl.innerText = `₹${oldPrice}`;
          if (comboSaveBadge) comboSaveBadge.innerText = `SAVE ₹${save}`;
        });
      });

      // 3. Bottom Zone 7 Buy Box Logic
      const formatBtns = document.querySelectorAll('.science-format-btn');
      const subCheckbox = document.getElementById('science-sub-checkbox');
      const dynamicPriceSpans = document.querySelectorAll('.science-cta-dynamic-price');
      const directCheckoutBtn = document.getElementById('science-direct-checkout-btn');
      const addCartBtn = document.getElementById('science-buy-btn');

      let currentProduct = {
        id: 'gid://shopify/ProductVariant/52738357854340',
        title: 'Sujata Pure Organic Spirulina Powder (100g)',
        price: 350,
        image: '/products/sujata-spirulina-powder-pouch.jpg',
        subtitle: 'Sub-40°C Cold Extract'
      };

      function updatePricing() {
        const isSubscribed = subCheckbox ? subCheckbox.checked : false;
        const finalPrice = isSubscribed ? Math.round(currentProduct.price * 0.9) : currentProduct.price;
        dynamicPriceSpans.forEach(el => {
          el.innerText = `₹${finalPrice}`;
        });
      }

      formatBtns.forEach(btn => {
        btn.addEventListener('click', () => {
          formatBtns.forEach(b => {
            b.classList.remove('border-[#166534]', 'bg-emerald-50/50', 'active-format');
            b.classList.add('border-gray-200', 'bg-white');
          });

          btn.classList.remove('border-gray-200', 'bg-white');
          btn.classList.add('border-[#166534]', 'bg-emerald-50/50', 'active-format');

          currentProduct.id = btn.getAttribute('data-id') || 'gid://shopify/ProductVariant/52738357854340';
          currentProduct.title = btn.getAttribute('data-title') || 'Sujata Pure Organic Spirulina Powder (100g)';
          currentProduct.price = parseFloat(btn.getAttribute('data-price')) || 350;
          currentProduct.image = btn.getAttribute('data-image') || '/products/sujata-spirulina-powder-pouch.jpg';
          currentProduct.subtitle = btn.getAttribute('data-subtitle') || 'Sub-40°C Cold Extract';

          updatePricing();
        });
      });

      subCheckbox?.addEventListener('change', updatePricing);

      // Direct 1-Click Checkout from Bottom Box
      directCheckoutBtn?.addEventListener('click', async (e) => {
        e.preventDefault();
        const isSubscribed = subCheckbox ? subCheckbox.checked : false;
        const finalPrice = isSubscribed ? Math.round(currentProduct.price * 0.9) : currentProduct.price;
        const subText = isSubscribed ? 'Monthly Protocol (10% Off)' : currentProduct.subtitle;

        const spinner = directCheckoutBtn.querySelector('.btn-spinner');
        const textSpan = directCheckoutBtn.querySelector('.btn-text');
        spinner?.classList.remove('hidden');
        if (textSpan) textSpan.innerHTML = `<span>Redirecting to Checkout...</span>`;
        directCheckoutBtn.style.pointerEvents = 'none';

        try {
          if (typeof window.directCheckoutItem === 'function') {
            await window.directCheckoutItem({
              id: currentProduct.id,
              title: currentProduct.title,
              subtitle: subText,
              price: finalPrice,
              image: currentProduct.image,
              quantity: 1
            });
          } else if (typeof window.addItemToLocalCart === 'function') {
            window.addItemToLocalCart({
              id: currentProduct.id,
              title: currentProduct.title,
              subtitle: subText,
              price: finalPrice,
              image: currentProduct.image,
              quantity: 1
            });
            spinner?.classList.add('hidden');
            if (textSpan) textSpan.innerHTML = `<span>⚡ Buy Now — Cash on Delivery OK • ₹${finalPrice}</span>`;
            directCheckoutBtn.style.pointerEvents = '';
          }
        } catch (err) {
          console.error("Direct checkout error:", err);
          spinner?.classList.add('hidden');
          if (textSpan) textSpan.innerHTML = `<span>⚡ Buy Now — Cash on Delivery OK • ₹${finalPrice}</span>`;
          directCheckoutBtn.style.pointerEvents = '';
        }
      });

      // Add to Cart from Bottom Box
      addCartBtn?.addEventListener('click', (e) => {
        e.preventDefault();
        const isSubscribed = subCheckbox ? subCheckbox.checked : false;
        const finalPrice = isSubscribed ? Math.round(currentProduct.price * 0.9) : currentProduct.price;
        const subText = isSubscribed ? 'Monthly Protocol (10% Off)' : currentProduct.subtitle;

        if (typeof window.addItemToLocalCart === 'function') {
          window.addItemToLocalCart({
            id: currentProduct.id,
            title: currentProduct.title,
            subtitle: subText,
            price: finalPrice,
            image: currentProduct.image,
            quantity: 1
          });
        }

        const originalText = addCartBtn.innerText;
        addCartBtn.innerText = "✓ Added to Routine";
        addCartBtn.classList.add('bg-emerald-700');
        setTimeout(() => {
          addCartBtn.innerText = originalText;
          addCartBtn.classList.remove('bg-emerald-700');
        }, 1800);
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initSciencePage);
    } else {
      initSciencePage();
    }
    document.addEventListener('astro:page-load', initSciencePage);
  </script>

</StoreLayout>
