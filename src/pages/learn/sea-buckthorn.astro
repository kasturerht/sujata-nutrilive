---
// /learn/sea-buckthorn — English ingredient hub. No NABL report exists for sea buckthorn yet, so this page
// quotes no lab values: only the product label (LABEL_FACTS) and live Shopify prices.
import StoreLayout from '../../layouts/StoreLayout.astro';
import StoreHeader from '../../components/StoreHeader.astro';
import StoreFooter from '../../components/StoreFooter.astro';
import LearnBuyCard from '../../components/LearnBuyCard.astro';
import { getCatalogProducts, formatINR } from '../../lib/catalog';
import { LABEL_FACTS, reportFor } from '../../config/lab-reports.mjs';
import { EDITORIAL_TEAM, SITE_URL, editorialAuthorSchema } from '../../config/editorial.mjs';
import { guidesFor } from '../../config/learn-registry.mjs';
import { alternatesFor } from '../../config/hreflang.mjs';

const pageTitle = 'Sea Buckthorn Capsules: What’s Inside & Price per Day';
const pageDescription = 'Sea buckthorn explained: what is in each Sujata capsule (500 mg fruit and seed extract), the label dose, and live cost per day. No invented lab claims.';
const reviewedOn = '2026-11-25';

if (reportFor('sea-buckthorn')) throw new Error('A sea buckthorn NABL report now exists: update this page to show it.');

const label = LABEL_FACTS['sujata-sea-buckthorn-capsules'];
const catalog = await getCatalogProducts(['sujata-sea-buckthorn-capsules']);
const rows = catalog['sujata-sea-buckthorn-capsules'].variants.map((v) => {
  const count = Number((v.title.match(/(\d+)/) || [])[1] || 0);
  const days = count ? Math.round(count / label.unitsPerDayMin) : 0;
  return { pack: `${count} capsules`, price: formatINR(v.price), days: `${days} days`, perDay: days ? formatINR(v.price / days) : '-' };
}).filter((x) => x.days !== '0 days');

const guides = guidesFor('sea-buckthorn');
const languageLinks = alternatesFor('/learn/sea-buckthorn').filter((a) => a.lang === 'hi-IN' || a.lang === 'mr-IN');

const url = `${SITE_URL}/learn/sea-buckthorn`;
const schema = [
  {
    '@type': 'Article',
    '@id': `${url}#article`,
    headline: pageTitle,
    description: pageDescription,
    inLanguage: 'en-IN',
    dateModified: reviewedOn,
    author: editorialAuthorSchema(),
    publisher: { '@id': `${SITE_URL}/#organization` },
    mainEntityOfPage: url,
  },
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: SITE_URL },
      { '@type': 'ListItem', position: 2, name: 'Learn', item: `${SITE_URL}/learn` },
      { '@type': 'ListItem', position: 3, name: 'Sea buckthorn', item: url },
    ],
  },
  {
    '@type': 'ItemList',
    name: 'Sea buckthorn guides',
    itemListElement: guides.map((g, i) => ({ '@type': 'ListItem', position: i + 1, url: `${SITE_URL}${g.path}`, name: g.title })),
  },
];
---
<StoreLayout title={pageTitle} description={pageDescription} image="/products/sujata-sea-buckthorn-capsules-bottle-transparent.png" extraSchema={schema}>
  <StoreHeader />
  <main class="bg-[#FAF9F6] text-[#1F2937] py-12 px-4 sm:px-6">
    <div class="max-w-3xl mx-auto">
      <nav class="text-xs text-gray-500 mb-6" aria-label="Breadcrumb">
        <a href="/" class="hover:underline">Home</a> › <a href="/learn" class="hover:underline">Learn</a> › <span>Sea buckthorn</span>
      </nav>

      <h1 class="text-3xl sm:text-4xl font-bold text-gray-900 font-serif leading-tight">Sea buckthorn capsules: what is inside, how to take them and what they cost per day</h1>
      <p class="mt-4 text-gray-700 leading-relaxed">
        Sea buckthorn (<em>Hippophae rhamnoides</em>) is a thorny shrub that grows in cold, high-altitude regions, including the Himalayas.
        Its small orange berries and their seeds are rich in plant oils; the fruit is one of the few plant sources of omega-7 (palmitoleic acid), alongside omega-3, 6 and 9 fatty acids.
      </p>
      {languageLinks.length > 0 && (
        <p class="mt-3 text-sm">
          Read in:
          {languageLinks.map((a, i) => (
            <>{i > 0 && ' · '}<a href={a.path} hreflang={a.lang.slice(0, 2)} lang={a.lang.slice(0, 2)} class="text-emerald-800 underline">{a.lang === 'hi-IN' ? 'हिंदी' : 'मराठी'}</a></>
          ))}
        </p>
      )}
      <p class="mt-3 text-xs text-gray-500">Prepared by the {EDITORIAL_TEAM.name} · FSSAI Reg. {EDITORIAL_TEAM.fssaiRegistration} · Last reviewed 25 Nov 2026</p>

      <h2 class="mt-10 text-2xl font-bold text-gray-900">What is in each capsule</h2>
      <ul class="mt-3 list-disc pl-6 text-gray-700 space-y-2">
        <li><strong>{label.perUnitMg} mg</strong> of {label.ingredient.toLowerCase()}.</li>
        <li>Label dose: {label.dose}, so a 60-capsule pack lasts 30 days.</li>
        <li>Marketed by Sujata Nutrilive Agrotech, Nashik, under FSSAI registration {EDITORIAL_TEAM.fssaiRegistration}.</li>
      </ul>
      <p class="mt-4 rounded-lg border border-amber-200 bg-amber-50 p-4 text-sm text-amber-900">
        We do not have an independent NABL lab report for our sea buckthorn yet, so this page quotes no lab figures. When we have one, it will be published on our <a href="/science" class="underline">lab reports page</a>.
      </p>

      <h2 class="mt-10 text-2xl font-bold text-gray-900">What a day costs</h2>
      <p class="mt-3 text-gray-700">Live website price, divided by the days a pack lasts at the label dose.</p>
      <div class="mt-4 overflow-x-auto">
        <table class="w-full text-sm border border-gray-200 bg-white">
          <thead class="bg-gray-50 text-left"><tr><th class="p-3">Pack</th><th class="p-3">Price</th><th class="p-3">Lasts</th><th class="p-3">Per day</th></tr></thead>
          <tbody>
            {rows.map((x) => (
              <tr class="border-t border-gray-100"><td class="p-3">{x.pack}</td><td class="p-3">{x.price}</td><td class="p-3">{x.days}</td><td class="p-3 font-semibold">{x.perDay}</td></tr>
            ))}
          </tbody>
        </table>
      </div>

      <div class="mt-8 grid gap-4 sm:grid-cols-2">
        <LearnBuyCard handle="sujata-sea-buckthorn-capsules" placement="hub-sea-buckthorn" compact={true} />
        <LearnBuyCard handle="sujata-spirulina-sea-buckthorn-combo-pack" placement="hub-sea-buckthorn-combo" compact={true} />
      </div>

      <h2 class="mt-10 text-2xl font-bold text-gray-900">Check with your doctor first if</h2>
      <ul class="mt-3 list-disc pl-6 text-gray-700 space-y-2">
        <li>you are pregnant or breastfeeding, or buying for a child;</li>
        <li>you take blood-thinning or any other regular medication, or have surgery coming up;</li>
        <li>you are under treatment for a medical condition.</li>
      </ul>

      <h2 class="mt-10 text-2xl font-bold text-gray-900">Sea buckthorn guides</h2>
      <ul class="mt-3 grid gap-2 sm:grid-cols-2">
        {guides.map((g) => (
          <li><a href={g.path} lang={g.lang} class="block rounded-lg border border-gray-200 bg-white px-4 py-3 text-emerald-900 hover:bg-emerald-50">{g.title}</a></li>
        ))}
      </ul>

      <p class="mt-10 text-xs text-gray-500">This product is not intended to diagnose, treat, cure or prevent any disease.</p>
    </div>
  </main>
  <StoreFooter />
</StoreLayout>
