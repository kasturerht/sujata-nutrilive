                <th class="py-3 px-3 text-amber-400 font-bold">Dose</th>
                <th class="py-3 px-3">Expected Change</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-emerald-950/60">
              <tr><td class="py-3 px-3 text-white">Week 1-2</td><td class="py-3 px-3 bg-emerald-950/40 text-emerald-200 font-bold">1,300 mg/day (2 caps)</td><td class="py-3 px-3 text-gray-300">Mild lubrication, less burning</td></tr>
