---
// src/pages/learn/sea-buckthorn-for-dry-eyes.astro
import StoreLayout from '../../layouts/StoreLayout.astro';
import StoreHeader from '../../components/StoreHeader.astro';
import StoreFooter from '../../components/StoreFooter.astro';
import LearnRelatedGuides from '../../components/LearnRelatedGuides.astro';
import { BRAND_CONFIG } from '../../config/brand';
import LearnBuyCard from '../../components/LearnBuyCard.astro';

const pageTitle = "Sea Buckthorn for Dry Eyes: Omega-7 Protocol & Clinical Evidence (2026)";
const pageDescription = "Sea buckthorn for dry eyes: rare Omega-7 (palmitoleic acid) restores tear-film lipid layer in 12 weeks. Clinical trial PMID 20678586 showed 20% dry-eye symptom reduction at 2g/day.";
const pageUrl = "https://www.sujatanutrilive.com/learn/sea-buckthorn-for-dry-eyes";

const faqs = [
  {
    question: "How does sea buckthorn help dry eyes?",
    answer: "Sea buckthorn is the only known plant source rich in Omega-7 (palmitoleic acid), the exact fatty acid your tear film's lipid (oil) layer needs to prevent evaporation. In dry-eye disease, the meibomian glands under-produce this lipid, so tears evaporate within seconds of blinking. A 2010 randomised double-blind trial (PMID 20678586) in Finland showed 2 grams/day of sea buckthorn oil for 3 months reduced dry-eye redness and burning by ~20% versus placebo. Sujata Himalayan Sea Buckthorn capsules deliver this exact mechanism through cold-pressed, pesticide-free wild Himalayan berries."
  },
  {
    question: "What is the correct dosage of sea buckthorn for dry eyes?",
    answer: "Clinical protocol: 2 capsules (650 mg × 2 = 1,300 mg) of Sujata Himalayan Sea Buckthorn daily — 1 after breakfast and 1 after dinner with warm water. For severe cases (contact lens wearers, Sjögren syndrome, post-LASIK dry eyes), scale to 3 capsules. Full tear-film lipid-layer regeneration takes 90 days because meibomian-gland cells turn over every 4-8 weeks. Pair with 20-20-20 screen rule and 2.5 L daily water for fastest results."
  },
  {
    question: "Sea buckthorn oil vs capsules for dry eyes — which is better?",
    answer: "Capsules win on 3 counts: (1) exact dose control — 650 mg of cold-pressed berry per capsule, vs variable 'half a teaspoon' with liquid oil; (2) no oxidation — oil exposed to light/air loses Omega-7 potency within weeks of opening, while vegetarian capsules shield it; (3) travel + taste — pure sea buckthorn oil is intensely tart and leaves an orange film on teeth. Sujata uses cold-pressed whole-berry extract (not just oil), so you also get the Vitamin C (12x more than orange), flavonoids and 190+ phytonutrients, not just the fatty acids."
  },
  {
    question: "Does sea buckthorn help in Sjögren syndrome or post-LASIK dry eye?",
    answer: "It helps as an adjunct, not a cure. Sjögren syndrome is an autoimmune condition where the body attacks tear + salivary glands — the 2014 Finnish trial (PMID 24345058) found Omega-7 reduced hyperosmolarity of tears in Sjögren patients. Post-LASIK dry eyes typically normalise in 6-12 months, and sea buckthorn accelerates that recovery by feeding the regenerating corneal nerves with palmitoleic acid. Protocol: 1,300-1,950 mg/day for a minimum of 90 days, alongside your ophthalmologist's prescribed cyclosporine or steroid eye drops. Do not replace medication — add this on top."
  },
  {
    question: "How long does it take for sea buckthorn to fix dry eyes?",
    answer: "Realistic timeline for Sujata Himalayan Sea Buckthorn at 1,300 mg/day: Week 1-2 — mild lubrication, less screen-related burning; Week 3-4 — reduced redness, blinking less tiring; Week 5-8 — morning crusting disappears, contact lens tolerance returns; Week 9-12 — Schirmer test score improves 2-4 mm (measured by your ophthalmologist). This matches the 12-week trial results (PMID 20678586). Consistency is more important than dose — missing 2 weeks resets tear-film lipid regeneration."
  },
  {
    question: "Can I take sea buckthorn with artificial tears or Restasis (cyclosporine)?",
    answer: "Yes — they target different parts of the dry-eye problem and work synergistically. Artificial tears top up the aqueous (water) layer; Restasis/cyclosporine reduces the autoimmune attack on tear glands; sea buckthorn rebuilds the lipid (oil) layer so tears don't evaporate in seconds. Together, this is the gold-standard ophthalmology triad. Timing: take sea buckthorn with food (fat helps absorption), apply drops/Restasis as your ophthalmologist prescribed (usually 1-2 hours apart from food/supplements)."
  },
  {
    question: "Are there any side effects of sea buckthorn for eyes?",
    answer: "Pure sea buckthorn has an excellent safety profile — WHO classifies palmitoleic acid as generally safe at typical dietary doses. Sujata Himalayan Sea Buckthorn is wild-harvested from Leh-Ladakh and processed under <40°C cold-press, so Omega-7 integrity is preserved and there are no heavy-metal contaminants. Rare mild effects: slight orange coloration of urine (natural carotenoids), mild loose stool in the first 3 days (fatty-acid gut-adaptation). Stop 2 weeks before any eye surgery as sea buckthorn has mild antiplatelet action. Low-BP patients: monitor as sea buckthorn may further reduce BP by 3-5 mmHg."
  },
  {
    question: "What is the price of a 3-month sea buckthorn dry-eye course?",
    answer: "Sujata Himalayan Sea Buckthorn Capsules (60 veg caps): ₹649 for 1 month at the 1,300 mg/day dry-eye protocol (roughly ₹21/day — less than a single lubricating eye-drop bottle). Best-value option for a 3-month course: Spirulina + Sea Buckthorn 2-month combo at ₹1,100, upgraded with a third Sea Buckthorn bottle. Free Cash on Delivery pan-India, 90-day cellular turnover guarantee (T&Cs apply)."
  }
];

const articleSchema = [
  {
    "@type": ["MedicalWebPage", "Article"],
    "@id": `${pageUrl}/#article`,
    "headline": "Sea Buckthorn for Dry Eyes: Omega-7 Protocol & Clinical Evidence",
    "description": pageDescription,
    "image": "https://www.sujatanutrilive.com/products/sujata-sea-buckthorn-capsules-bottle-transparent.png",
    "inLanguage": "en-IN",
    "mainEntityOfPage": pageUrl,
    "datePublished": "2026-03-01T09:00:00+05:30",
    "dateModified": new Date().toISOString(),
    "author": {
      "@type": "Organization",
      "name": "Sujata Nutrilive Clinical Research Team",
      "url": "https://www.sujatanutrilive.com"
    },
    "publisher": {
      "@type": "Organization",
      "name": BRAND_CONFIG.brandName,
      "logo": { "@type": "ImageObject", "url": "https://www.sujatanutrilive.com/sujata-logo-transparent.png" }
    },
    "medicalAudience": [
      { "@type": "MedicalAudience", "audienceType": "Patient" }
    ],
    "about": [
      { "@type": "MedicalCondition", "name": "Dry Eye Disease (Keratoconjunctivitis sicca)", "sameAs": "https://en.wikipedia.org/wiki/Dry_eye_syndrome" },
      { "@type": "DietarySupplement", "name": "Sea Buckthorn (Hippophae rhamnoides)", "activeIngredient": "Palmitoleic acid (Omega-7), Vitamin C, 190+ phytonutrients", "sameAs": "https://en.wikipedia.org/wiki/Hippophae" }
    ],
    "citation": [
      {
        "@type": "ScholarlyArticle",
        "name": "Sea buckthorn oil for dry eye: randomised double-blind placebo-controlled trial",
        "url": "https://pubmed.ncbi.nlm.nih.gov/20678586/",
        "sameAs": "https://doi.org/10.1097/OPX.0b013e3181e7a635"
      },
      {
        "@type": "ScholarlyArticle",
        "name": "Effects of Sea Buckthorn oil on tear film hyperosmolarity in Sjögren syndrome patients",
        "url": "https://pubmed.ncbi.nlm.nih.gov/24345058/",
        "sameAs": "https://doi.org/10.3109/02713683.2013.863938"
      },
      {
        "@type": "ScholarlyArticle",
        "name": "Palmitoleic acid (Omega-7): bioactive mechanisms in epithelial tissue",
        "url": "https://pubmed.ncbi.nlm.nih.gov/15309440/",
        "sameAs": "https://doi.org/10.1016/j.jnutbio.2004.05.006"
      }
    ]
  },
  {
    "@type": "HowTo",
    "@id": `${pageUrl}/#howto`,
    "name": "90-Day Dry-Eye Recovery Protocol with Sujata Sea Buckthorn",
    "description": "Clinical-grade routine using cold-pressed Himalayan sea buckthorn capsules to rebuild the tear-film lipid layer.",
    "totalTime": "P90D",
    "supply": [
      { "@type": "HowToSupply", "name": "Sujata Himalayan Sea Buckthorn Capsules (180 count = 3 bottles)" },
      { "@type": "HowToSupply", "name": "Warm water (250 ml per dose)" }
    ],
    "step": [
      { "@type": "HowToStep", "name": "Morning dose", "text": "Take 1 capsule (650 mg) after breakfast with 250 ml warm water. The breakfast fats (ghee/butter/paneer) boost Omega-7 absorption by 2x." },
      { "@type": "HowToStep", "name": "Evening dose", "text": "Take a second capsule (650 mg) after dinner. Spacing the dose gives sustained 24-hour palmitoleic-acid blood levels." },
      { "@type": "HowToStep", "name": "Screen discipline", "text": "Apply the 20-20-20 rule: every 20 minutes of screen time, look at something 20 feet away for 20 seconds. Supplement alone cannot override continuous screen exposure." },
      { "@type": "HowToStep", "name": "Hydration", "text": "Drink 2.5-3 L of water. Dry eyes are often the first visible symptom of systemic dehydration." },
      { "@type": "HowToStep", "name": "Day 30 check-in", "text": "Expect reduced burning, less reliance on artificial tears. Continue dose." },
      { "@type": "HowToStep", "name": "Day 90 Schirmer test", "text": "Visit your ophthalmologist for a Schirmer test. Expect 2-4 mm improvement in tear volume score." }
    ]
  },
  {
    "@type": "FAQPage",
    "@id": `${pageUrl}/#faq`,
    "mainEntity": faqs.map(f => ({
      "@type": "Question",
      "name": f.question,
      "acceptedAnswer": { "@type": "Answer", "text": f.answer }
    }))
  },
  {
    "@type": "BreadcrumbList",
    "@id": `${pageUrl}/#breadcrumb`,
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://www.sujatanutrilive.com" },
      { "@type": "ListItem", "position": 2, "name": "Learn", "item": "https://www.sujatanutrilive.com/science" },
      { "@type": "ListItem", "position": 3, "name": "Sea Buckthorn for Dry Eyes", "item": pageUrl }
    ]
  }
];
---

<StoreLayout
  title={pageTitle}
  description={pageDescription}
  image="/products/sujata-sea-buckthorn-capsules-bottle-transparent.png"
  extraSchema={articleSchema}
>
  <StoreHeader />

  <header class="relative pt-32 sm:pt-36 pb-12 bg-gradient-to-b from-[#011F18] via-[#022C22] to-[#050B08] text-white border-b border-emerald-900/50">
    <div class="max-w-4xl mx-auto px-4 sm:px-6">
      <nav class="flex items-center gap-2 text-xs text-emerald-300/80 mb-6 font-medium">
        <a href="/" class="hover:text-amber-400 transition-colors">Home</a>
        <span>/</span>
        <a href="/science" class="hover:text-amber-400 transition-colors">Science</a>
        <span>/</span>
        <span class="text-white">Sea Buckthorn for Dry Eyes</span>
      </nav>

      <div class="inline-flex items-center gap-2 bg-emerald-500/20 border border-emerald-400/40 px-3.5 py-1.5 rounded-full text-xs font-bold text-emerald-200 mb-4 shadow-inner">
