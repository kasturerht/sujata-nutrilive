---
// src/pages/learn/sea-buckthorn-for-dry-eyes.astro
// FSSAI-compliant rewrite (Advertising & Claims 2018 + Nutraceutical 2022 + Maharashtra FDA Nov-2026).
// Removed: Keratoconjunctivitis sicca naming, Sjögren syndrome, Restasis / cyclosporine drug comparisons,
// Schirmer-test outcome promises, meibomian-gland medical framing, MedicalCondition schema.
// Pivot: Omega-7 as a daily nutrient that supports the body's own natural moisture.
import StoreLayout from '../../layouts/StoreLayout.astro';
import StoreHeader from '../../components/StoreHeader.astro';
import StoreFooter from '../../components/StoreFooter.astro';
