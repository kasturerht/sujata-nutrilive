            </details>
          ))}
        </div>
      </section>

      <!-- 5. Scientific citations -->
      <article class="bg-[#0A1A12] border border-emerald-900/50 rounded-2xl p-6 sm:p-8 shadow-xl">
        <h2 class="text-xl sm:text-2xl font-serif font-bold text-white mb-4 flex items-center gap-2">
          <span class="text-amber-400">5.</span> Peer-Reviewed Evidence
        </h2>
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 text-xs">
          <a href="https://pubmed.ncbi.nlm.nih.gov/20678586/" target="_blank" rel="noopener noreferrer" class="bg-black/40 border border-white/10 rounded-xl p-4 hover:border-emerald-400/40 transition-colors">
            <div class="text-amber-400 font-bold text-[11px] uppercase">PubMed · Finnish RCT</div>
            <h3 class="font-bold text-white text-xs mt-1 mb-1.5">Sea Buckthorn Dry-Eye Trial</h3>
            <p class="text-gray-400 text-[11px] leading-relaxed">PMID 20678586 — 2 g/day for 3 months, 20% symptom reduction.</p>
          </a>
          <a href="https://pubmed.ncbi.nlm.nih.gov/24345058/" target="_blank" rel="noopener noreferrer" class="bg-black/40 border border-white/10 rounded-xl p-4 hover:border-emerald-400/40 transition-colors">
