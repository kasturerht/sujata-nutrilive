---
import { isListed } from '../../lib/catalog';
// src/pages/learn/spirulina-in-hindi.astro
import StoreLayout from '../../layouts/StoreLayout.astro';
import LearnQuickBuyStrip from '../../components/LearnQuickBuyStrip.astro';
import StoreHeader from '../../components/StoreHeader.astro';
import StoreFooter from '../../components/StoreFooter.astro';
import LearnRelatedGuides from '../../components/LearnRelatedGuides.astro';
import { BRAND_CONFIG } from '../../config/brand';
import LearnBuyCard from '../../components/LearnBuyCard.astro';

const pageTitle = "Spirulina in Hindi: स्पिरुलिना क्या है? फायदे, खुराक और कीमत (2026)";
const pageDescription = "Spirulina in Hindi: स्पिरुलिना क्या है? जानिए 62.39% शुद्ध प्लांट प्रोटीन, 290.89 mg/kg आयरन, 10 फायदे, सही खुराक, नुकसान और सुजाता स्पिरुलिना की कीमत।";
const pageUrl = "https://www.sujatanutrilive.com/learn/spirulina-in-hindi";

const faqs = [
  {
    question: "स्पिरुलिना क्या है और इसका हिंदी नाम क्या है? (What is Spirulina in Hindi?)",
    answer: "स्पिरुलिना (Arthrospira platensis) एक सूक्ष्म नीले-हरे शैवाल (Blue-Green Microalgae) है जिसे हिंदी में 'नीली-हरी काई' या 'जल शैवाल' कहा जाता है। विश्व स्वास्थ्य संगठन (WHO) और नासा (NASA) ने इसे 'भविष्य का सर्वोत्तम सुपरफूड' घोषित किया है। सुजाता स्पिरुलिना में Lilaba NABL-मान्यता प्राप्त लैब रिपोर्ट (LAL-NN-131125023) के अनुसार 62.39% शुद्ध प्लांट प्रोटीन, 290.89 mg/kg प्राकृतिक आयरन और 1,407.91 mg/kg कैल्शियम प्राकृतिक रूप से मौजूद है।"
  },
  {
    question: "स्पिरुलिना खाने के मुख्य फायदे क्या हैं? (Spirulina ke Fayde)",
    answer: "सुजाता स्पिरुलिना एक पौधों पर आधारित होल-फूड सप्लीमेंट है जिसमें प्राकृतिक पोषक तत्व मौजूद हैं: 1. 290.89 mg/kg प्राकृतिक प्लांट आयरन (आयरन सामान्य रक्त-कोशिका निर्माण में योगदान करता है)। 2. 62.39% शाकाहारी संपूर्ण प्लांट प्रोटीन, सभी 9 आवश्यक अमीनो एसिड के साथ। 3. 1,407.91 mg/kg प्राकृतिक कैल्शियम। 4. B-विटामिन जो सामान्य ऊर्जा-यिल्डिंग मेटाबॉलिज़्म में योगदान देते हैं। 5. प्राकृतिक क्लोरोफिल और कैरोटीनॉइड्स। यह एक खाद्य सप्लीमेंट है, किसी रोग का इलाज नहीं — संतुलित आहार और डॉक्टर की सलाह का विकल्प नहीं है।"
  },
  {
    question: "स्पिरुलिना कैसे और कब लें? सही खुराक क्या है?",
    answer: "वयस्कों के लिए रोज़ 1000 mg से 2000 mg (1 से 2 कैप्सूल 500 mg) सुबह नाश्ते के बाद एक गिलास गुनगुने पानी के साथ लें। खाली पेट लेने से बचें। पाउडर के लिए 1 चम्मच (लगभग 3 ग्राम) जूस, छाछ या स्मूदी में मिलाकर लें। दिनभर में 2.5 से 3 लीटर पानी अवश्य पिएं क्योंकि स्पिरुलिना एक नेचुरल डिटॉक्स है।"
  },
  {
    question: "स्पिरुलिना पाउडर, टैबलेट या कैप्सूल - क्या बेहतर है?",
    answer: "तीनों में 62.39% शुद्ध प्लांट प्रोटीन समान है, फर्क इस्तेमाल के तरीके का है: (1) पाउडर (100g): स्मूदी, जूस, फेसपैक और फिटनेस के लिए सबसे उपयोगी, फ्लेक्सिबल डोज़। (2) टैबलेट्स (500mg, 60 Nos.): हाइड्रोलिक दबाव से बनी, 0% केमिकल बाइंडर, यात्रा के लिए सुविधाजनक। (3) वेज कैप्सूल्स (500mg, 60 Nos.): पौधे-आधारित शेल, पेट में सिर्फ 5 मिनट में घुल जाती हैं, कोई गंध नहीं - यात्री एवं संवेदनशील पेट वालों के लिए सर्वोत्तम।"
  },
  {
    question: "क्या स्पिरुलिना के कोई नुकसान या साइड इफेक्ट्स हैं?",
    answer: "शुद्ध स्पिरुलिना के कोई रासायनिक दुष्प्रभाव नहीं होते। सुजाता स्पिरुलिना बंद हाइड्रो-डोम में उगाया जाता है और Lilaba Analytical Laboratories LLP, Surat (रिपोर्ट #LAL-NN-131125023, 17 Nov 2025) से प्रमाणित है। शुरुआती 3-5 दिनों में शरीर डिटॉक्स होता है, जिसमें पेशाब का रंग थोड़ा गाढ़ा दिख सकता है - यह कोई साइड इफेक्ट नहीं, बल्कि प्राकृतिक सफाई का संकेत है। पर्याप्त पानी पिएं।"
  },
  {
    question: "स्पिरुलिना किसे नहीं लेना चाहिए? (Contraindications)",
    answer: "1. फिनाइलकीटोन्यूरिया (PKU) के दुर्लभ आनुवंशिक रोगी - स्पिरुलिना में फिनाइलऐलेनिन अमीनो एसिड होता है। 2. गंभीर ऑटोइम्यून रोगी (Lupus, MS) जो इम्युनोसप्रेसेंट दवा ले रहे हैं, बिना डॉक्टर सलाह के न लें। 3. गंभीर किडनी रोगी जिन्हें प्रोटीन/पोटैशियम पर पाबंदी है। 4. सर्जरी से 2 हफ्ते पहले बंद कर दें। गर्भवती व स्तनपान कराने वाली माताएं डॉक्टर से परामर्श के बाद ही लें।"
  },
  {
    question: "यदि मैं दवाइयां ले रहा/रही हूं तो क्या मुझे स्पिरुलिना से पहले डॉक्टर से बात करनी चाहिए?",
    answer: "हां, अवश्य। सुजाता स्पिरुलिना एक खाद्य सप्लीमेंट है, दवा नहीं। यदि आप किसी भी दीर्घकालिक दवा पर हैं, तो स्पिरुलिना शुरू करने से पहले अपने उपचार कर रहे डॉक्टर से परामर्श करें। स्पिरुलिना 0% चीनी और 0% फिलर है। किसी भी निर्धारित दवा और स्पिरुलिना के बीच कम से कम 1 घंटे का अंतर रखें और अपनी दवाओं की पूरी सूची अपने डॉक्टर के साथ साझा करें।"
  },
  {
    question: "सुजाता स्पिरुलिना की कीमत कितनी है और कैसे ऑर्डर करें?",
    answer: "सुजाता स्पिरुलिना वेज कैप्सूल्स (60 Nos., 1 महीने का डोज़): ₹499 (UPI पर 10% छूट = ₹449, यानी रोज़ सिर्फ ₹15)। 2 महीने का स्पिरुलिना + सी बकथॉर्न सुपर-सेवर कॉम्बो पैक: ₹1,100 (प्रति दिन सिर्फ ₹18)। पूरे भारत में फ्री कैश ऑन डिलीवरी (Free COD) और WhatsApp (+91 98347 83503) पर 1-क्लिक ऑर्डर उपलब्ध।"
  }
];

const articleAndFaqSchema = [
  {
    "@type": "Article",
    "@id": `${pageUrl}/#article`,
    "headline": "Spirulina in Hindi: स्पिरुलिना क्या है? फायदे, खुराक और कीमत (2026)",
    "description": pageDescription,
    "image": "https://www.sujatanutrilive.com/products/sujata-spirulina-capsules-bottle-transparent.png",
    "inLanguage": "hi-IN",
    "mainEntityOfPage": pageUrl,
    "datePublished": "2026-02-10T09:00:00+05:30",
    "dateModified": new Date().toISOString(),
    "author": {
      "@type": "Organization",
      "name": "Sujata Nutrilive Nutrition Research Team",
      "url": "https://www.sujatanutrilive.com"
    },
    "publisher": {
      "@type": "Organization",
      "name": BRAND_CONFIG.brandName,
      "logo": {
        "@type": "ImageObject",
        "url": "https://www.sujatanutrilive.com/sujata-logo-transparent.png"
      }
    },
    "about": {
      "@type": "DietarySupplement",
      "name": "Spirulina (Arthrospira platensis)",
      "sameAs": "https://en.wikipedia.org/wiki/Spirulina_(dietary_supplement)"
    },
    "citation": [
      {
        "@type": "ScholarlyArticle",
        "name": "Spirulina in Clinical Practice: Evidence-Based Human Applications",
        "url": "https://pubmed.ncbi.nlm.nih.gov/18955364/",
        "sameAs": "https://doi.org/10.1093/ecam/nem058"
      },
      {
        "@type": "ScholarlyArticle",
        "name": "Bioactive peptides and Phycobiliproteins from microalgae Arthrospira platensis",
        "url": "https://pubmed.ncbi.nlm.nih.gov/32805562/",
        "sameAs": "https://doi.org/10.1016/j.foodres.2020.109339"
      },
      {
        "@type": "ScholarlyArticle",
        "name": "Spirulina and iron deficiency anemia: a randomized trial",
        "url": "https://pubmed.ncbi.nlm.nih.gov/21951264/",
        "sameAs": "https://doi.org/10.3390/md9122031"
      }
    ]
  },
  {
    "@type": "FAQPage",
    "@id": `${pageUrl}/#faq`,
    "mainEntity": faqs.map(f => ({
      "@type": "Question",
      "name": f.question,
      "acceptedAnswer": { "@type": "Answer", "text": f.answer }
    }))
  },
  {
    "@type": "BreadcrumbList",
    "@id": `${pageUrl}/#breadcrumb`,
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://www.sujatanutrilive.com" },
      { "@type": "ListItem", "position": 2, "name": "Learn", "item": "https://www.sujatanutrilive.com/science" },
      { "@type": "ListItem", "position": 3, "name": "Spirulina in Hindi", "item": pageUrl }
    ]
  }
];
---

<StoreLayout
  lang="hi"
  title={pageTitle}
  description={pageDescription}
  image="/products/sujata-spirulina-capsules-bottle-transparent.png"
  extraSchema={articleAndFaqSchema}
>
  <StoreHeader />

  <!-- Hero -->
  <header class="relative pt-32 sm:pt-36 pb-12 bg-gradient-to-b from-[#011F18] via-[#022C22] to-[#050B08] text-white border-b border-emerald-900/50">
    <div class="max-w-4xl mx-auto px-4 sm:px-6">
      <nav class="flex items-center gap-2 text-xs text-emerald-300/80 mb-6 font-medium">
        <a href="/" class="hover:text-amber-400 transition-colors">होम</a>
        <span>/</span>
        <a href="/science" class="hover:text-amber-400 transition-colors">वैज्ञानिक शोध</a>
        <span>/</span>
        <span class="text-white">स्पिरुलिना हिंदी गाइड</span>
      </nav>

      <div class="inline-flex items-center gap-2 bg-emerald-500/20 border border-emerald-400/40 px-3.5 py-1.5 rounded-full text-xs font-bold text-emerald-200 mb-4 shadow-inner">
