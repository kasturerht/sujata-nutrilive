            <div class="text-[11px] text-gray-300 mt-1">प्राकृतिक आयरन / kg</div>
          </div>
          <div class="bg-black/40 border border-emerald-500/20 rounded-xl p-3">
            <div class="text-xl sm:text-2xl font-black text-sky-400 font-sans">1,408 mg</div>
            <div class="text-[11px] text-gray-300 mt-1">कैल्शियम / kg</div>
          </div>
