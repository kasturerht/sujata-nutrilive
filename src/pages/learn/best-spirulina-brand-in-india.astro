              </ul>
            </div>
            <a href="/product/sujata-spirulina-tablets" class="w-full text-center bg-emerald-700 hover:bg-emerald-600 text-white font-bold py-2.5 px-4 rounded-lg text-xs transition-colors">
              View Spirulina Tablets (₹495)
            </a>
          </div>

          <!-- Capsules Card -->
          <div class="bg-black/40 border border-emerald-900/40 rounded-xl p-5 flex flex-col justify-between">
            <div>
              <div class="text-emerald-400 font-bold text-lg mb-2">3. Premium Capsules</div>
              <p class="text-xs text-gray-300 mb-4">
                <strong>Best for:</strong> Individuals with sensitive palate or gag reflex who demand 100% zero taste and instant digestion.
              </p>
              <ul class="text-xs text-gray-400 space-y-1.5 mb-6">
                <li>• Plant-based vegetarian cellulose shells</li>
                <li>• Completely odorless and neutral</li>
                <li>• Gentle on sensitive stomachs</li>
              </ul>
            </div>
            <a href="/product/sujata-spirulina-capsules" class="w-full text-center bg-emerald-700 hover:bg-emerald-600 text-white font-bold py-2.5 px-4 rounded-lg text-xs transition-colors">
              View Spirulina Capsules (₹499)
