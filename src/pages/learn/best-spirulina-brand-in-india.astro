            <!-- Sujata Nutrilive -->
            <tr class="bg-emerald-950/30 font-medium text-white border-l-4 border-emerald-500">
              <td class="py-3 px-3">
                <div class="font-bold text-emerald-300">Sujata Nutrilive</div>
                <div class="text-[10px] text-gray-400">Powder, Tablets &amp; Capsules</div>
              </td>
              <td class="py-3 px-3 text-emerald-300 font-bold">Sub-40°C Cryo-Milling</td>
              <td class="py-3 px-3 text-emerald-300 font-bold">21.4% (Certified)</td>
              <td class="py-3 px-3 text-emerald-300 font-bold">Fresh, Mild Earthy (Zero Fish Smell)</td>
              <td class="py-3 px-3 text-emerald-300 font-bold">Lead &lt; 0.01 ppm, Hg NIL</td>
              <td class="py-3 px-3 text-emerald-300 font-bold">0% (Pure Algae)</td>
            </tr>

