              <td class="py-3 px-3 text-red-300">Noticeable Fishy Smell</td>
              <td class="py-3 px-3">Standard FSSAI Compliant</td>
              <td class="py-3 px-3">15–20% Excipients / Talc</td>
            </tr>

            <!-- Patanjali Nutrela -->
            <tr class="text-gray-300">
              <td class="py-3 px-3 font-semibold">Patanjali Nutrela</td>
              <td class="py-3 px-3">High-Heat Dehydration</td>
              <td class="py-3 px-3">Not Disclosed (~8%)</td>
              <td class="py-3 px-3 text-red-300">Strong Pungent Odor</td>
              <td class="py-3 px-3">FSSAI Standard Ceiling</td>
              <td class="py-3 px-3">Microcrystalline Cellulose / Binders</td>
            </tr>
          </tbody>
        </table>
      </section>

