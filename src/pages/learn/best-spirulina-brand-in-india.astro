              <td class="py-3 px-3 text-amber-200">Moderate Swamp Aroma</td>
              <td class="py-3 px-3">NABL Tested Batch-wise</td>
              <td class="py-3 px-3">&lt; 5% Binders</td>
            </tr>

            <!-- Carbamide Forte -->
            <tr class="text-gray-300">
              <td class="py-3 px-3 font-semibold">Carbamide Forte</td>
              <td class="py-3 px-3">Open Heat Drying</td>
