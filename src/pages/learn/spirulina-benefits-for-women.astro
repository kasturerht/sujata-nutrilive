---
// src/pages/learn/spirulina-benefits-for-women.astro
// FSSAI-compliant rewrite (Advertising & Claims 2018 + Nutraceutical 2022 + Maharashtra FDA Nov-2026).
// Pivoted from disease-treatment framing to nutrient-function + daily-vitality framing.
// Removed: cure/treats anemia, PCOS ICD references, Telogen Effluvium, pregnancy/lactation dosing specifics,
// hemoglobin g/dL outcome promises, money-back-if-hemoglobin, MedicalCondition schema, drug comparisons.
import StoreLayout from '../../layouts/StoreLayout.astro';
import StoreHeader from '../../components/StoreHeader.astro';
import StoreFooter from '../../components/StoreFooter.astro';
import LearnRelatedGuides from '../../components/LearnRelatedGuides.astro';
import { BRAND_CONFIG } from '../../config/brand';
import LearnBuyCard from '../../components/LearnBuyCard.astro';

const pageTitle = "Spirulina for Women: Natural Plant Iron, Complete Protein & Daily Vitality (2026)";
const pageDescription = "A daily spirulina routine for women: 290.89 mg/kg natural plant iron, 62.39% complete plant protein and 1,407.91 mg/kg natural calcium. A whole-food supplement, not a medicine.";
const pageUrl = "https://www.sujatanutrilive.com/learn/spirulina-benefits-for-women";

const faqs = [
  {
    question: "Why do women add spirulina to their daily routine?",
    answer: "Spirulina is a whole-food supplement that is naturally rich in iron, plant protein, calcium and B-vitamins — nutrients that many Indian women look to top up in their everyday diet. Sujata Spirulina is lab-verified by Lilaba Analytical Laboratories (report #LAL-NN-131125023) at 62.39% plant protein, 290.89 mg/kg natural iron and 1,407.91 mg/kg natural calcium. It is a dietary supplement and does not replace balanced meals, iron-rich foods or medical advice."
  },
  {
    question: "How much iron is naturally present in Sujata Spirulina?",
    answer: "Sujata Spirulina contains 290.89 mg of natural non-heme iron per kilogram, as verified by Lilaba lab report #LAL-NN-131125023. Iron is a nutrient that contributes to normal formation of red blood cells and haemoglobin and normal oxygen transport in the body. The iron here is naturally present in the whole food alongside Vitamin C and beta-carotene co-factors. Spirulina is not a medicine; women with diagnosed iron deficiency should see their doctor for a full assessment and prescribed care."
  },
  {
    question: "What is a sensible daily serving of spirulina for adult women?",
    answer: "A typical adult serving is 1,000-2,000 mg per day (2-4 capsules of 500 mg), taken with 250 ml of warm water after breakfast. Active adults may take up to 3,000 mg split across two servings. The WHO safe upper intake for healthy adults is 10 g per day — do not exceed. Girls under 18, pregnant or lactating women, women with a medical condition and women on prescribed medication should consult their physician or gynaecologist before use."
  },
  {
    question: "Can spirulina be a protein top-up for vegetarian women?",
    answer: "Yes, as a concentrated whole-food protein supplement. Each 500 mg capsule delivers roughly 0.31 g of 62.39% plant protein (NABL-verified). A 2 g daily serving adds a small but complete-amino-acid protein boost to a vegetarian plate that is often lentil or dairy-based. It is not a substitute for a full protein meal — it is an add-on to a balanced diet."
  },
  {
    question: "What natural nutrients in spirulina support hair and skin?",
    answer: "Hair and skin cells depend on a steady supply of protein, iron, B-vitamins and antioxidants from the daily diet. Sujata Spirulina contains naturally occurring plant protein (62.39%), iron (290.89 mg/kg), B-vitamins and carotenoid antioxidants — all of which are nutrients the body uses in normal skin and hair maintenance. Consistent nutrition over 90-180 days is sensible because hair and skin cells turn over slowly. For medical hair or skin concerns, consult a dermatologist."
  },
  {
    question: "Is spirulina suitable during pregnancy or lactation?",
    answer: "Nutritional interest in spirulina during pregnancy and lactation is well discussed in food science, but this is a decision that belongs with your gynaecologist or physician. Sujata Nutrilive makes no dosing recommendation for pregnancy or lactation. Do not start, stop or change any supplement during pregnancy or lactation without written clearance from your treating doctor."
  },
  {
    question: "Which form is practical for women — capsules, tablets or powder?",
    answer: "All three Sujata Spirulina products deliver the same 62.39% lab-verified protein and 290.89 mg/kg natural iron: (1) Capsules (500 mg × 60) — odourless, portable, dissolve in 5 minutes; (2) Tablets (500 mg × 60) — no chemical binder, pressed under hydraulic pressure; (3) Powder (100 g) — for smoothies, buttermilk or face packs. Pick the format that fits your routine."
  },
  {
    question: "What is the price of a 1-month supply?",
    answer: "Sujata Spirulina Capsules (60 count × 500 mg) are ₹499 per bottle (₹449 on UPI), which is a 1-month supply at the 2-capsule daily serving — roughly ₹15 per day. The Spirulina + Himalayan Sea Buckthorn 2-month combo pack is ₹1,100, roughly ₹18 per day. Free Cash on Delivery pan-India via WhatsApp (+91 98347 83503). Refund policy: see /refund-policy."
  }
];

// FAQPage schema avoids disease-cure questions. Article (not MedicalWebPage), no MedicalCondition entries.
const articleSchema = [
  {
    "@type": "Article",
    "@id": `${pageUrl}/#article`,
    "headline": "Spirulina for Women: Natural Plant Iron, Complete Protein & Daily Vitality",
    "description": pageDescription,
    "image": "https://www.sujatanutrilive.com/products/sujata-spirulina-capsules-bottle-transparent.png",
    "inLanguage": "en-IN",
    "mainEntityOfPage": pageUrl,
    "datePublished": "2026-02-20T09:00:00+05:30",
    "dateModified": new Date().toISOString(),
    "author": {
      "@type": "Organization",
      "name": "Sujata Nutrilive Nutrition Research Team",
      "url": "https://www.sujatanutrilive.com"
    },
    "publisher": {
      "@type": "Organization",
      "name": BRAND_CONFIG.brandName,
      "logo": { "@type": "ImageObject", "url": "https://www.sujatanutrilive.com/sujata-logo-transparent.png" }
    },
    "audience": {
      "@type": "Audience",
      "audienceType": "Adult women following a plant-rich diet",
      "suggestedMinAge": 18
    },
    "about": {
      "@type": "DietarySupplement",
      "name": "Spirulina (Arthrospira platensis)",
      "activeIngredient": "Plant Protein (62.39%), Non-Heme Iron (290.89 mg/kg), Natural Calcium (1,407.91 mg/kg), B-Vitamins, Chlorophyll",
      "sameAs": "https://en.wikipedia.org/wiki/Spirulina_(dietary_supplement)"
    }
  },
  {
    "@type": "FAQPage",
    "@id": `${pageUrl}/#faq`,
    "mainEntity": faqs.map(f => ({
      "@type": "Question",
      "name": f.question,
      "acceptedAnswer": { "@type": "Answer", "text": f.answer }
    }))
  },
  {
    "@type": "BreadcrumbList",
    "@id": `${pageUrl}/#breadcrumb`,
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://www.sujatanutrilive.com" },
      { "@type": "ListItem", "position": 2, "name": "Learn", "item": "https://www.sujatanutrilive.com/science" },
      { "@type": "ListItem", "position": 3, "name": "Spirulina for Women", "item": pageUrl }
    ]
  }
];
---

<StoreLayout
  title={pageTitle}
  description={pageDescription}
  image="/products/sujata-spirulina-capsules-bottle-transparent.png"
  extraSchema={articleSchema}
>
  <StoreHeader />

  <header class="relative pt-32 sm:pt-36 pb-12 bg-gradient-to-b from-[#011F18] via-[#022C22] to-[#050B08] text-white border-b border-emerald-900/50">
    <div class="max-w-4xl mx-auto px-4 sm:px-6">
      <nav class="flex items-center gap-2 text-xs text-emerald-300/80 mb-6 font-medium">
        <a href="/" class="hover:text-amber-400 transition-colors">Home</a>
        <span>/</span>
        <a href="/science" class="hover:text-amber-400 transition-colors">Science</a>
        <span>/</span>
        <span class="text-white">Spirulina for Women</span>
      </nav>

      <div class="inline-flex items-center gap-2 bg-emerald-500/20 border border-emerald-400/40 px-3.5 py-1.5 rounded-full text-xs font-bold text-emerald-200 mb-4 shadow-inner">
        <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
        <span>Natural Plant Iron • Complete Protein • Daily Nutrition</span>
      </div>

      <h1 class="text-2xl sm:text-4xl md:text-5xl font-serif font-black tracking-tight text-white leading-tight mb-4">
        Spirulina for Women: <br class="hidden sm:block"/>
        <span class="text-amber-400 italic font-serif">Natural Plant Iron, Complete Protein & Daily Vitality (2026)</span>
      </h1>

      <p class="text-emerald-100/90 text-sm sm:text-base leading-relaxed max-w-2xl font-sans">
        A whole-food supplement for adult women: 290.89 mg/kg natural plant iron, 62.39% complete plant protein, 1,407.91 mg/kg natural calcium — lab-verified by Lilaba Analytical Laboratories.
      </p>

      <div class="mt-6 p-4 sm:p-5 bg-[#02231A]/95 border-2 border-emerald-500/50 rounded-2xl shadow-2xl relative overflow-hidden backdrop-blur-sm">
        <div class="flex items-center gap-2 mb-2">
          <span class="bg-amber-400 text-black text-[10px] font-black uppercase px-2.5 py-0.5 rounded-full tracking-wide">Direct Answer</span>
          <span class="text-xs text-emerald-300 font-semibold">Nutrient-Function Framing</span>
        </div>
        <p class="text-xs sm:text-sm text-gray-200 leading-relaxed font-sans">
          <strong class="text-amber-300 font-bold">Why do women add spirulina to a daily diet?</strong>
          Sujata Spirulina is a plant-based whole-food supplement that is naturally rich in <strong class="text-emerald-300">290.89 mg/kg iron</strong>, <strong class="text-emerald-300">62.39% complete protein</strong> and <strong class="text-emerald-300">1,407.91 mg/kg calcium</strong>. Iron contributes to normal red-blood-cell formation and oxygen transport; protein and calcium are everyday building blocks of a balanced diet. Typical adult serving: 1,000-2,000 mg/day. This is a food supplement — not a medicine — and does not replace a diagnosis or treatment.
        </p>
      </div>
    </div>
  </header>

  <main class="bg-[#050B08] text-gray-200 py-12 px-4 sm:px-6 font-sans">
    <div class="max-w-4xl mx-auto space-y-12">

      <!-- 1. Nutrients women look to top up -->
      <article class="bg-[#0A1A12] border border-emerald-900/50 rounded-2xl p-6 sm:p-8 shadow-xl">
        <h2 class="text-xl sm:text-2xl font-serif font-bold text-white mb-4 flex items-center gap-2">
          <span class="text-amber-400">1.</span> Nutrients Many Indian Women Look to Top Up
        </h2>
        <p class="text-sm text-gray-300 leading-relaxed mb-5">
          Everyday Indian plates vary widely in their iron, protein and calcium density. Spirulina is one plant-food source that packs these nutrients into a small daily serving. The values below come from the Lilaba Lab report #LAL-NN-131125023 for Sujata Spirulina. Read them as nutrition content, not as medical treatment.
        </p>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 text-sm">
          <div class="bg-black/30 border border-emerald-500/20 rounded-xl p-4">
            <h3 class="font-bold text-emerald-400 text-base mb-2">🩸 290.89 mg/kg Natural Plant Iron</h3>
            <p class="text-gray-300 leading-relaxed text-xs sm:text-sm">A naturally occurring non-heme iron accompanied by Vitamin C and beta-carotene co-factors. Iron contributes to normal red-blood-cell formation and oxygen transport.</p>
          </div>
          <div class="bg-black/30 border border-amber-500/20 rounded-xl p-4">
            <h3 class="font-bold text-amber-400 text-base mb-2">💪 62.39% Complete Plant Protein</h3>
            <p class="text-gray-300 leading-relaxed text-xs sm:text-sm">All nine essential amino acids present in the whole food. Protein is needed for maintenance of normal muscle mass and structure.</p>
          </div>
          <div class="bg-black/30 border border-purple-500/20 rounded-xl p-4">
            <h3 class="font-bold text-purple-400 text-base mb-2">🦴 1,407.91 mg/kg Natural Calcium</h3>
            <p class="text-gray-300 leading-relaxed text-xs sm:text-sm">Calcium contributes to maintenance of normal bones and teeth. A daily serving is a small, natural top-up alongside dairy and leafy greens.</p>
          </div>
          <div class="bg-black/30 border border-emerald-500/20 rounded-xl p-4">
            <h3 class="font-bold text-emerald-400 text-base mb-2">⚡ B-Vitamins & Carotenoids</h3>
            <p class="text-gray-300 leading-relaxed text-xs sm:text-sm">B-vitamins contribute to normal energy-yielding metabolism. Natural carotenoids are antioxidants widely eaten in green foods.</p>
          </div>
        </div>
      </article>

      <LearnBuyCard
        handle="sujata-spirulina-capsules"
        lang="en"
        placement="women-top"
        badge="For Women • Plant Iron + Protein"
        heading="Sujata Spirulina Capsules (500mg × 60)"
        pitch="One month of the 2-capsule daily serving. 62.39% lab-verified plant protein and 290.89 mg/kg natural iron — in an odourless, 100% vegetarian capsule."
        points={["Lilaba NABL Lab Report #LAL-NN-131125023", "0 g sugar, 0 g lactose, 0 g binder", "FSSAI Central License #11526999001381"]}
      />

      <!-- 2. Sensible Serving Guide -->
      <article class="bg-[#0A1A12] border border-emerald-900/50 rounded-2xl p-6 sm:p-8 shadow-xl">
        <h2 class="text-xl sm:text-2xl font-serif font-bold text-white mb-4 flex items-center gap-2">
          <span class="text-amber-400">2.</span> Sensible Serving Guide (Adult Women, General Nutrition)
        </h2>
        <div class="overflow-x-auto">
          <table class="w-full text-left text-xs sm:text-sm border-collapse">
            <thead>
              <tr class="border-b border-emerald-800 text-emerald-300">
                <th class="py-3 px-3">Audience</th>
                <th class="py-3 px-3 text-amber-400 font-bold">Suggested Daily Serving</th>
                <th class="py-3 px-3">When</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-emerald-950/60">
              <tr><td class="py-3 px-3 text-white">Adult women, general wellbeing</td><td class="py-3 px-3 bg-emerald-950/40 text-emerald-200 font-bold">1,000 mg (2 capsules)</td><td class="py-3 px-3 text-gray-300">After breakfast, with warm water</td></tr>
              <tr><td class="py-3 px-3 text-white">Physically active women</td><td class="py-3 px-3 bg-emerald-950/40 text-emerald-200 font-bold">2,000 mg (4 capsules)</td><td class="py-3 px-3 text-gray-300">Breakfast + lunch</td></tr>
              <tr><td class="py-3 px-3 text-white">Teen girls (13-17, parental consent)</td><td class="py-3 px-3 bg-emerald-950/40 text-emerald-200 font-bold">500 mg (1 capsule)</td><td class="py-3 px-3 text-gray-300">After breakfast only</td></tr>
              <tr><td class="py-3 px-3 text-white">Pregnancy / lactation</td><td class="py-3 px-3 bg-amber-950/40 text-amber-200 font-bold">Consult your doctor</td><td class="py-3 px-3 text-gray-300">Decision belongs with your gynaecologist</td></tr>
              <tr><td class="py-3 px-3 text-white">Women on prescribed medication</td><td class="py-3 px-3 bg-amber-950/40 text-amber-200 font-bold">Consult your physician</td><td class="py-3 px-3 text-gray-300">Share your medication list</td></tr>
            </tbody>
          </table>
        </div>
        <p class="mt-4 text-xs text-emerald-200/80 bg-emerald-950/30 border border-emerald-500/20 rounded-xl p-3">
          This is a general nutrition serving guide, not medical advice. For any diagnosed condition, follow your treating physician's plan.
        </p>
      </article>

      <LearnBuyCard
        handle="sujata-spirulina-sea-buckthorn-combo-pack"
        lang="en"
        placement="women-combo"
        badge="Daily Nutrition Combo"
        heading="Spirulina + Himalayan Sea Buckthorn Combo"
        pitch="Plant protein + rare Omega-7 in a single daily routine. Two whole-food supplements — not medicines — chosen by women who prefer natural nutrition."
        points={["Omega-7 from wild Himalayan berries", "2 free SpiruGlow soaps with 2-month pack", "Free COD pan-India via WhatsApp"]}
      />

      <!-- 3. When to speak with your doctor -->
      <article class="bg-[#0A1A12] border border-emerald-900/50 rounded-2xl p-6 sm:p-8 shadow-xl">
        <h2 class="text-xl sm:text-2xl font-serif font-bold text-white mb-4 flex items-center gap-2">
          <span class="text-amber-400">3.</span> When to Speak With Your Doctor First
        </h2>
        <ul class="text-gray-300 space-y-3 leading-relaxed text-sm">
          <li class="flex items-start gap-2"><span class="text-red-400 font-bold">✕</span><span><strong>PKU (Phenylketonuria):</strong> This rare genetic condition makes spirulina's phenylalanine content unsuitable.</span></li>
          <li class="flex items-start gap-2"><span class="text-amber-400 font-bold">!</span><span><strong>Autoimmune conditions on immunosuppressants:</strong> Share your medication list with your rheumatologist before starting any new supplement.</span></li>
          <li class="flex items-start gap-2"><span class="text-amber-400 font-bold">!</span><span><strong>Advanced CKD with protein restriction:</strong> Your nephrologist should clear any protein-rich supplement.</span></li>
          <li class="flex items-start gap-2"><span class="text-amber-400 font-bold">!</span><span><strong>Thyroid medication:</strong> Maintain a 1-hour gap from the thyroid tablet, as is standard practice with any supplement.</span></li>
          <li class="flex items-start gap-2"><span class="text-amber-400 font-bold">!</span><span><strong>Pregnancy and lactation:</strong> Decide with your gynaecologist. Do not self-prescribe during these phases.</span></li>
        </ul>
      </article>

      <!-- 4. FAQ -->
      <section class="bg-[#0A1A12] border border-emerald-900/50 rounded-2xl p-6 sm:p-8 shadow-xl">
        <h2 class="text-xl sm:text-2xl font-serif font-bold text-white mb-6 flex items-center gap-2">
          <span class="text-amber-400">4.</span> Frequently Asked Questions
        </h2>
        <div class="space-y-4">
          {faqs.map((faq, index) => (
            <details class="group bg-black/40 border border-white/10 rounded-xl p-4 sm:p-5 cursor-pointer hover:border-emerald-500/30 transition-all">
              <summary class="font-bold text-white flex justify-between items-center text-sm sm:text-base select-none">
                <span class="flex items-start gap-2.5 pr-2">
                  <span class="text-amber-400 font-sans text-xs font-black mt-0.5 shrink-0">Q{index + 1}.</span>
                  <span>{faq.question}</span>
                </span>
                <span class="text-emerald-400 text-lg transition-transform group-open:rotate-180 shrink-0">↓</span>
              </summary>
              <p class="text-gray-300 text-xs sm:text-sm mt-3.5 leading-relaxed border-t border-white/10 pt-3.5 font-sans">{faq.answer}</p>
            </details>
          ))}
        </div>
      </section>

    </div>
  </main>

  <LearnRelatedGuides current="spirulina-benefits-for-women" />
  <StoreFooter />
</StoreLayout>
