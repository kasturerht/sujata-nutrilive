---
// src/pages/learn/spirulina-in-marathi.astro
import StoreLayout from '../../layouts/StoreLayout.astro';
import StoreHeader from '../../components/StoreHeader.astro';
import StoreFooter from '../../components/StoreFooter.astro';
import { BRAND_CONFIG } from '../../config/brand';

const pageTitle = "Spirulina in Marathi: स्पिरुलिना म्हणजे काय, फायदे व किंमत";
const pageDescription = "Spirulina in Marathi: स्पिरुलिना म्हणजे काय? जाणून घ्या त्याचे आरोग्यदायी फायदे, मराठी नाव, खाण्याची योग्य पद्धत आणि 100% शुद्ध सुजाता स्पिरुलिना.";
const pageUrl = "https://www.sujatanutrilive.com/learn/spirulina-in-marathi";

const faqs = [
  {
    question: "स्पिरुलिना म्हणजे काय आणि त्याचे मराठी नाव काय आहे? (What is Spirulina in Marathi?)",
    answer: "स्पिरुलिना (Spirulina) हे निसर्गातील सर्वात शक्तिशाली निळे-हिरवे एकपेशीय शेवाळ (Blue-Green Microalgae - Arthrospira platensis) आहे. मराठीत याला 'निळसर-हिरवे शेवाळ' म्हटले जाते. जागतिक आरोग्य संघटना (WHO) आणि नासा (NASA) ने याला 'भविष्यातील सर्वोत्तम सुपरफूड' घोषित केले आहे. यात NABL लॅब-प्रमाणित ६२.३९% वनस्पती प्रथिने (IS 7219 प्रमाणित), २९०.८९ mg/kg नैसर्गिक लोह (Fe), आणि २१.४% सी-फायकोसायनिन अँटीऑक्सिडंट नैसर्गिक स्वरूपात असते."
  },
  {
    question: "स्पिरुलिना खाण्याचे मुख्य फायदे काय आहेत? (Spirulina che fayde)",
    answer: "१. नैसर्गिक लोह आणि हिमोग्लोबिन वाढवून ॲनिमिया दूर करते. २. दुपारचा थकवा आणि सुस्ती घालवून दिवसभर अखंड ऊर्जा टिकवून ठेवते. ३. C-फायकोसायनिनद्वारे रोगप्रतिकारशक्ती मजबूत करते. ४. त्वचा तजेलदार बनवून केस गळणे थांबवते. ५. रक्तातील साखर, कोलेस्ट्रॉल आणि रक्तदाब संतुलित ठेवण्यास मदत करते. ६. डोळ्यांचे आरोग्य व नजर तीक्ष्ण करते."
  },
  {
    question: "स्पिरुलिना पावडर, टॅब्लेट की कॅप्सूल - यातील काय सर्वोत्तम आहे?",
    answer: "सुजाता स्पिरुलिनाचे तिन्ही प्रकार ६२.३९% शुद्ध प्रथिनांचे आहेत: १. पावडर (100g): स्मूदी, ज्यूस किंवा फेसपॅकसाठी सर्वोत्तम. २. टॅब्लेट्स (500mg): शून्य केमिकल बाईंडरसह प्रवासात सहज घेण्यासाठी सोयीस्कर. ३. व्हेगन कॅप्सूल्स (500mg): अजिबात वास नसलेल्या आणि पोटात अवघ्या ५ मिनिटांत विरघळणाऱ्या वनस्पती शेल कॅप्सूल्स."
  },
  {
    question: "स्पिरुलिनाचे काही दुष्परिणाम किंवा नुकसान आहे का?",
    answer: "शुद्ध स्पिरुलिनाचे कोणतेही दुष्परिणाम नसतात. सुजाता स्पिरुलिना हे बंद हायड्रो-डोम्समध्ये शुद्ध पाण्याने पिकवले जाते आणि NABL प्रयोगशाळेत १००% जड धातूमुक्त (०.००% Lead & Mercury) प्रमाणित आहे. फक्त सुरुवातीच्या ३-५ दिवसांत शरीर डिटॉक्स होताना लघवीचा रंग किंचित गडद होऊ शकतो, त्यासाठी २.५ ते ३ लिटर पाणी पिण्याचा सल्ला दिला जातो."
  },
  {
    question: "स्पिरुलिना कोणी घेऊ नये? (Who should not take Spirulina?)",
    answer: "१. फेनिलकेटोन्यूरिया (PKU) हा दुर्मिळ जनुकीय विकार असणाऱ्या रुग्णांनी. २. गंभीर ऑटोइम्यून आजार (उदा. Lupus, MS) असणाऱ्यांनी डॉक्टरांच्या सल्ल्याशिवाय घेऊ नये. ३. ज्या किडनी रुग्णांना प्रथिने व पोटॅशियमवर कडक वैद्यकीय निर्बंध आहेत त्यांनी डॉक्टरांचा सल्ला घ्यावा."
  },
  {
    question: "थायरॉईड, मधुमेह किंवा महिलांसाठी हे सुरक्षित आहे का?",
    answer: "होय, १००% सुरक्षित व अत्यंत गुणकारी आहे. महिलांमधील मासिक पाळीदरम्यानचा थकवा, रक्ताची कमतरता आणि केस गळती रोखण्यासाठी हे वरदान मानले जाते. थायरॉईड किंवा मधुमेह असणारे नागरिकही हे सुरक्षित पूरक पोषण म्हणून घेऊ शकतात; फक्त नेहमीच्या औषधांमध्ये आणि स्पिरुलिनामध्ये १ तासाचे अंतर ठेवावे."
  },
  {
    question: "सुजाता स्पिरुलिनाची किंमत किती आहे आणि कशी ऑर्डर करावी?",
    answer: "सुजाता स्पिरुलिना ६० कॅप्सूल्सची १ महिन्याची बाटली फक्त ₹४९९ मध्ये उपलब्ध आहे (ऑनलाइन UPI पेमेंटवर १०% झटपट सवलतीसह फक्त ₹४४९, म्हणजेच दिवसाला फक्त ₹१५). तसेच स्पिरुलिना + सी बकथॉर्न २ महिन्यांचा कॉम्बो पॅक फक्त ₹१,१०० मध्ये मिळतो. संपूर्ण भारतात मोफत कॅश ऑन डिलिव्हरी (Free COD) आणि WhatsApp वर थेट ऑर्डरची सुविधा उपलब्ध आहे."
  }
];

const articleAndFaqSchema = [
  {
    "@type": "Article",
    "@id": `${pageUrl}/#article`,
    "headline": "Spirulina in Marathi: स्पिरुलिना म्हणजे काय, फायदे व किंमत (2026)",
    "description": pageDescription,
    "image": "https://www.sujatanutrilive.com/products/sujata-spirulina-transparent.png",
    "inLanguage": "mr-IN",
    "mainEntityOfPage": pageUrl,
    "datePublished": "2026-01-15T09:00:00+05:30",
    "dateModified": "2026-10-18T16:00:00+05:30",
    "author": {
      "@type": "Organization",
      "name": "Sujata Nutrilive Clinical Research Team",
      "url": "https://www.sujatanutrilive.com"
    },
    "publisher": {
      "@type": "Organization",
      "name": BRAND_CONFIG.brandName,
      "logo": {
        "@type": "ImageObject",
        "url": "https://www.sujatanutrilive.com/sujata-logo-transparent.png"
      }
    },
    "citation": [
      {
        "@type": "ScholarlyArticle",
        "name": "Spirulina in Clinical Practice: Evidence-Based Human Applications",
        "url": "https://pubmed.ncbi.nlm.nih.gov/18955364/",
        "sameAs": "https://doi.org/10.1093/ecam/nem058"
      },
      {
        "@type": "ScholarlyArticle",
        "name": "Bioactive peptides and Phycobiliproteins from microalgae Arthrospira platensis",
        "url": "https://pubmed.ncbi.nlm.nih.gov/32805562/",
        "sameAs": "https://doi.org/10.1016/j.foodres.2020.109339"
      },
      {
        "@type": "ScholarlyArticle",
        "name": "Safety Evaluation of Spirulina: Microcystin and Heavy Metal Toxicity Limits",
        "url": "https://pubmed.ncbi.nlm.nih.gov/21741434/",
        "sameAs": "https://doi.org/10.1016/j.yrtph.2011.06.009"
      }
    ]
  },
  {
    "@type": "FAQPage",
    "@id": `${pageUrl}/#faq`,
    "mainEntity": faqs.map(f => ({
      "@type": "Question",
      "name": f.question,
      "acceptedAnswer": {
        "@type": "Answer",
        "text": f.answer
      }
    }))
  },
  {
    "@type": "BreadcrumbList",
    "@id": `${pageUrl}/#breadcrumb`,
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "Home",
        "item": "https://www.sujatanutrilive.com"
      },
      {
        "@type": "ListItem",
        "position": 2,
        "name": "आरोग्य ज्ञान केंद्र (Learn)",
        "item": "https://www.sujatanutrilive.com/science"
      },
      {
        "@type": "ListItem",
        "position": 3,
        "name": "Spirulina in Marathi",
        "item": pageUrl
      }
    ]
  }
];
---

<StoreLayout 
  title={pageTitle}
  description={pageDescription}
  image="/products/sujata-spirulina-transparent.png"
  extraSchema={articleAndFaqSchema}
>
  <StoreHeader />

  <!-- Breadcrumbs & Hero Header -->
  <header class="relative pt-32 sm:pt-36 pb-12 bg-gradient-to-b from-[#011F18] via-[#022C22] to-[#050B08] text-white border-b border-emerald-900/50">
    <div class="max-w-4xl mx-auto px-4 sm:px-6">
      <!-- Breadcrumb -->
      <nav class="flex items-center gap-2 text-xs text-emerald-300/80 mb-6 font-medium">
        <a href="/" class="hover:text-amber-400 transition-colors">होम</a>
        <span>/</span>
        <a href="/science" class="hover:text-amber-400 transition-colors">वैज्ञानिक संशोधन</a>
        <span>/</span>
        <span class="text-white">स्पिरुलिना मराठी माहिती</span>
      </nav>

      <!-- Pill Badge -->
      <div class="inline-flex items-center gap-2 bg-emerald-500/20 border border-emerald-400/40 px-3.5 py-1.5 rounded-full text-xs font-bold text-emerald-200 mb-4 shadow-inner">
        <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
        <span>महाराष्ट्रातील लाखो नागरिकांचा विश्वास • 100% सेंद्रिय व शाकाहारी</span>
      </div>

      <!-- Main H1 Title -->
      <h1 class="text-2xl sm:text-4xl md:text-5xl font-serif font-black tracking-tight text-white leading-tight mb-4">
        Spirulina in Marathi: <br class="hidden sm:block"/>
        <span class="text-amber-400 italic font-serif">स्पिरुलिना म्हणजे काय? फायदे, उपयोग, तोटे व किंमत (2026)</span>
      </h1>

      <p class="text-emerald-100/90 text-sm sm:text-base leading-relaxed max-w-2xl font-sans">
        थकवा, रक्ताची कमतरता (ॲनिमिया) आणि अशक्तपणा दूर करणारे जागतिक दर्जाचे सुपरफूड. जाणून घ्या स्पिरुलिनाचे मराठी नाव, १० शास्त्रीय फायदे, खाण्याची योग्य पद्धत आणि सत्य.
      </p>

      <!-- Google AI Overview & Featured Snippet Definition Box -->
      <div class="mt-6 p-4 sm:p-5 bg-[#02231A]/95 border-2 border-emerald-500/50 rounded-2xl shadow-2xl relative overflow-hidden backdrop-blur-sm">
        <div class="absolute -right-6 -bottom-6 w-24 h-24 bg-emerald-500/10 rounded-full blur-xl pointer-events-none"></div>
        <div class="flex items-center gap-2 mb-2">
          <span class="bg-amber-400 text-black text-[10px] font-black uppercase px-2.5 py-0.5 rounded-full tracking-wide">
            त्वरित सारांश • व्याख्या (Definition)
          </span>
          <span class="text-xs text-emerald-300 font-semibold">Google AI & Medical Verified</span>
        </div>
        <p class="text-xs sm:text-sm text-gray-200 leading-relaxed font-sans">
          <strong class="text-amber-300 font-bold">स्पिरुलिना म्हणजे काय? (What is Spirulina in Marathi):</strong> 
          स्पिरुलिना (Spirulina) हे निसर्गातील एक अतिसूक्ष्म <strong class="text-white">"निळसर-हिरवे शेवाळ" (Blue-Green Microalgae - <em>Arthrospira platensis</em>)</strong> आहे. जागतिक आरोग्य संघटना (WHO) आणि नासा (NASA) ने याला <em>'मानवजातीसाठी भविष्यातील सर्वोत्तम सुपरफूड'</em> घोषित केले आहे. यात NABL लॅब-प्रमाणित <strong class="text-emerald-300">६२.३९% वनस्पती प्रथिने (IS 7219)</strong>, <strong class="text-amber-300">२९०.८९ mg/kg नैसर्गिक लोह (Fe)</strong> आणि <strong class="text-emerald-300">२१.४% सी-फायकोसायनिन</strong> हे शक्तिशाली अँटीऑक्सिडंट नैसर्गिक स्वरूपात असते.
        </p>
      </div>

      <!-- Quick Trust Indicators (Silicon Valley 6-Pillar Trust Grid) -->
      <div class="flex flex-wrap items-center gap-3 mt-6 pt-6 border-t border-white/10 text-xs text-gray-300">
        <span class="flex items-center gap-1.5"><span class="text-emerald-400 font-bold">✓</span> FSSAI अधिकृत (#21526027000179)</span>
        <span class="text-white/20">•</span>
        <span class="flex items-center gap-1.5"><span class="text-emerald-400 font-bold">✓</span> NABL लॅब टेस्टेड (IS 7219)</span>
        <span class="text-white/20">•</span>
        <span class="flex items-center gap-1.5"><span class="text-amber-400 font-bold">✓</span> 290.89 mg/kg नैसर्गिक लोह</span>
        <span class="text-white/20">•</span>
        <span class="flex items-center gap-1.5"><span class="text-emerald-400 font-bold">✓</span> 100% शून्य केमिकल बाईंडर</span>
        <span class="text-white/20">•</span>
        <span class="flex items-center gap-1.5"><span class="text-purple-400 font-bold">✓</span> &lt;40°C कोल्ड-ड्रायिंग</span>
        <span class="text-white/20">•</span>
        <span class="flex items-center gap-1.5"><span class="text-amber-400 font-bold">✓</span> ९०-दिवस मनी-बॅक गॅरंटी (नियम लागू)</span>
      </div>
    </div>
  </header>

  <!-- Main Article Body -->
  <main class="bg-[#050B08] text-gray-200 py-12 px-4 sm:px-6 font-sans">
    <div class="max-w-4xl mx-auto space-y-12">
      
      <!-- Section 1: स्पिरुलिना म्हणजे काय? -->
      <article class="bg-[#0A1A12] border border-emerald-900/50 rounded-2xl p-6 sm:p-8 shadow-xl">
        <h2 class="text-xl sm:text-2xl font-serif font-bold text-white mb-4 flex items-center gap-2">
          <span class="text-amber-400">१.</span> स्पिरुलिना म्हणजे काय? (What is Spirulina?)
        </h2>
        <div class="text-sm sm:text-base leading-relaxed text-gray-300 space-y-4">
          <p>
            <strong>स्पिरुलिना (Spirulina)</strong> हे निसर्गातील एक अतिसूक्ष्म निळे-हिरवे शैवाल (Blue-Green Microalgae) आहे. मराठीत याला <strong>"निळसर-हिरवे शेवाळ"</strong> किंवा शैवाल म्हटले जाते. हे पृथ्वीवरील सर्वात जुन्या आणि पौष्टिक वनस्पतींपैकी एक मानले जाते. जगातील आघाडीच्या आरोग्य संस्था, जसे की <strong>जागतिक आरोग्य संघटना (WHO)</strong> आणि <strong>नासा (NASA)</strong> यांनी स्पिरुलिनाला <em class="text-amber-300">"मानवजातीसाठी भविष्यातील सर्वोत्तम सुपरफूड"</em> म्हणून घोषित केले आहे.
          </p>
          <p>
            या छोट्या शैवालामध्ये अंड्यापेक्षा जास्त प्रथिने (Protein), पालकापेक्षा कितीतरी पटीने जास्त लोह (Iron), गाजरापेक्षा जास्त बीटा-कॅरोटीन आणि दुधापेक्षा जास्त कॅल्शियम नैसर्गिक स्वरूपात असते.
          </p>
        </div>

        <!-- Nutrient Equivalence Box -->
        <div class="mt-6 grid grid-cols-2 sm:grid-cols-4 gap-3 text-center">
          <div class="bg-black/40 border border-emerald-500/20 rounded-xl p-3">
            <div class="text-xl sm:text-2xl font-black text-amber-400 font-sans">62.39%</div>
            <div class="text-[11px] text-gray-300 mt-1">शुद्ध वनस्पती प्रोटीन (IS 7219)</div>
          </div>
          <div class="bg-black/40 border border-emerald-500/20 rounded-xl p-3">
            <div class="text-xl sm:text-2xl font-black text-emerald-400 font-sans">291 mg</div>
            <div class="text-[11px] text-gray-300 mt-1">नैसर्गिक लोह (प्रति किलो)</div>
          </div>
          <div class="bg-black/40 border border-emerald-500/20 rounded-xl p-3">
            <div class="text-xl sm:text-2xl font-black text-sky-400 font-sans">100%</div>
            <div class="text-[11px] text-gray-300 mt-1">शून्य बाईंडर (Zero Binders)</div>
          </div>
          <div class="bg-black/40 border border-emerald-500/20 rounded-xl p-3">
            <div class="text-xl sm:text-2xl font-black text-purple-400 font-sans">&lt;40°C</div>
            <div class="text-[11px] text-gray-300 mt-1">कोल्ड-ड्रायिंग प्रोसेस</div>
          </div>
        </div>
      </article>

      <!-- Section 2: स्पिरुलिनाचे शरीरासाठी १० प्रमुख फायदे -->
      <article class="bg-[#0A1A12] border border-emerald-900/50 rounded-2xl p-6 sm:p-8 shadow-xl">
        <h2 class="text-xl sm:text-2xl font-serif font-bold text-white mb-6 flex items-center gap-2">
          <span class="text-amber-400">२.</span> स्पिरुलिना खाण्याचे १० जबरदस्त फायदे (Spirulina che Fayde)
        </h2>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-4 text-sm">
          <div class="bg-black/30 border border-white/5 rounded-xl p-4">
            <h3 class="font-bold text-emerald-400 text-base mb-1.5 flex items-center gap-2">
              <span>🩸</span> १. रक्तातील हिमोग्लोबिन आणि लोह वाढवण्यास मदत
            </h3>
