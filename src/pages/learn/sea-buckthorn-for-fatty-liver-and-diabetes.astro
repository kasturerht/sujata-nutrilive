---
// src/pages/learn/sea-buckthorn-for-fatty-liver-and-diabetes.astro
// FSSAI-compliant rewrite (Advertising & Claims 2018 + Nutraceutical 2022 + Maharashtra FDA Nov-2026).
// The original disease-targeting draft (NAFLD, Type 2 Diabetes, HbA1c, ALT/AST, metformin/statin counselling,
// "Hepatologist-Reviewed", PPAR-α mechanism) has been fully replaced with a nutrient-function framing:
// Himalayan Omega-7 for daily metabolic wellness and cellular nourishment.
import StoreLayout from '../../layouts/StoreLayout.astro';
import StoreHeader from '../../components/StoreHeader.astro';
import StoreFooter from '../../components/StoreFooter.astro';
import LearnRelatedGuides from '../../components/LearnRelatedGuides.astro';
import { BRAND_CONFIG } from '../../config/brand';
import LearnBuyCard from '../../components/LearnBuyCard.astro';

const pageTitle = "Himalayan Sea Buckthorn Omega-7: Daily Metabolic Wellness & Cellular Nourishment (2026)";
