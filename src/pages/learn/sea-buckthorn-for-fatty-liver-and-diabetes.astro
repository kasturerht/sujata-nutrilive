const faqs = [
  {
    question: "What makes Himalayan sea buckthorn a unique whole-food supplement?",
    answer: "Sea buckthorn (Hippophae rhamnoides) is one of the few widely-edible plants that is naturally rich in Omega-7 (palmitoleic acid), alongside Omega-3, 6 and 9, flavonoids (isorhamnetin, quercetin) and natural Vitamin C. Sujata uses wild-harvested Leh-Ladakh berries cold-pressed below 40 °C to keep these nutrients intact. It is a food supplement that adds whole-berry phytonutrients to a daily diet; it is not a medicine and does not replace diet, exercise or medical care."
  },
  {
    question: "What is a sensible daily serving of Sujata Himalayan Sea Buckthorn?",
    answer: "A typical adult serving is 1-2 capsules (650-1,300 mg) per day with food. Take 1 after breakfast and, optionally, 1 after dinner with warm water. The fats in a normal meal help the body absorb the fat-soluble carotenoids. Do not exceed 2 capsules per day without consulting your physician, and do not take it as a replacement for any prescribed medicine."
  },
  {
    question: "What nutrients does sea buckthorn add to a daily diet?",
    answer: "Each Sujata Himalayan Sea Buckthorn capsule delivers 650 mg of cold-pressed whole-berry extract. This provides naturally occurring Omega-7 (palmitoleic acid), Omega-3, 6 and 9 fatty acids, Vitamin C, Vitamin E, beta-carotene, flavonoids and 190+ plant phytonutrients. These are everyday nutrients — Vitamin C, for example, contributes to normal collagen formation and normal immune function. Spirulina and sea buckthorn can be combined as part of a balanced plant-forward routine."
  },
  {
    question: "Can I take sea buckthorn alongside other food supplements?",
    answer: "Yes, as part of a balanced routine. Many Sujata customers combine Sea Buckthorn with Spirulina through the 2-month combo pack. Both are food supplements. If you are already on prescribed medication for any health condition, speak with your physician first — supplements can interact with medicines, so your doctor should know your full list before you add or stop anything."
  },
  {
    question: "Is sea buckthorn a substitute for prescribed medicine?",
    answer: "No. Sujata Himalayan Sea Buckthorn is a food supplement, not a medicine. It is not intended to diagnose, treat, cure or prevent any disease, including metabolic or liver conditions. If your doctor has prescribed medicine for any condition, continue that medicine and consult your doctor before adding any supplement to your routine."
  },
  {
    question: "Does Sujata Himalayan Sea Buckthorn contain added sugar?",
    answer: "No. Sujata Himalayan Sea Buckthorn capsules contain 0 g added sugar, 0 g preservative, 0 g artificial flavour and 0 g colour. The capsule shell is 100 % vegetarian. The only ingredient is cold-pressed wild Himalayan sea-buckthorn whole-berry extract. Check the ingredient panel on the product page for the full composition."
  },
  {
    question: "Who should avoid sea buckthorn or speak to a doctor first?",
    answer: "Speak to your doctor before using Sujata Himalayan Sea Buckthorn if you are pregnant or lactating, are on blood thinners (anticoagulants / antiplatelets), are scheduled for surgery within the next 2 weeks, have very low blood pressure, or have any known allergy to Hippophae rhamnoides. Stop the supplement 2 weeks before any planned surgery, as is standard with all plant-oil supplements."
  },
  {
    question: "What is the price of a 3-month daily supply?",
    answer: "Sujata Himalayan Sea Buckthorn Capsules (60 count × 650 mg) are ₹649 for a 1-month supply at the 2-capsule daily serving — about ₹21 per day. For 90 days, the Spirulina + Himalayan Sea Buckthorn 2-month combo pack is ₹1,100 (roughly ₹18 per day) and ships with 2 free SpiruGlow soaps. Free Cash on Delivery pan-India via WhatsApp (+91 98347 83503). Refund policy: see /refund-policy."
  }
];

// Pure Article schema — no MedicalWebPage, no MedicalCondition, no mechanismOfAction.
const articleSchema = [
  {
    "@type": "Article",
    "@id": `${pageUrl}/#article`,
    "headline": "Himalayan Sea Buckthorn Omega-7: Daily Metabolic Wellness & Cellular Nourishment",
    "description": pageDescription,
    "image": "https://www.sujatanutrilive.com/products/sujata-sea-buckthorn-capsules-bottle-transparent.png",
    "inLanguage": "en-IN",
    "mainEntityOfPage": pageUrl,
    "datePublished": "2026-03-05T09:00:00+05:30",
    "dateModified": new Date().toISOString(),
    "author": {
      "@type": "Organization",
      "name": "Sujata Nutrilive Nutrition Research Team",
      "url": "https://www.sujatanutrilive.com"
    },
    "publisher": {
      "@type": "Organization",
      "name": BRAND_CONFIG.brandName,
      "logo": { "@type": "ImageObject", "url": "https://www.sujatanutrilive.com/sujata-logo-transparent.png" }
    },
    "about": {
      "@type": "DietarySupplement",
      "name": "Sea Buckthorn (Hippophae rhamnoides)",
      "activeIngredient": "Palmitoleic acid (Omega-7), Omega-3, Omega-6, Omega-9, Vitamin C, Vitamin E, Beta-carotene, Flavonoids",
      "sameAs": "https://en.wikipedia.org/wiki/Hippophae"
    }
  },
  {
    "@type": "FAQPage",
    "@id": `${pageUrl}/#faq`,
    "mainEntity": faqs.map(f => ({
      "@type": "Question",
      "name": f.question,
      "acceptedAnswer": { "@type": "Answer", "text": f.answer }
    }))
  },
  {
    "@type": "BreadcrumbList",
    "@id": `${pageUrl}/#breadcrumb`,
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://www.sujatanutrilive.com" },
      { "@type": "ListItem", "position": 2, "name": "Learn", "item": "https://www.sujatanutrilive.com/science" },
      { "@type": "ListItem", "position": 3, "name": "Himalayan Sea Buckthorn Omega-7", "item": pageUrl }
    ]
  }
];
---

<StoreLayout
  title={pageTitle}
  description={pageDescription}
  image="/products/sujata-sea-buckthorn-capsules-bottle-transparent.png"
  extraSchema={articleSchema}
>
  <StoreHeader />

  <header class="relative pt-32 sm:pt-36 pb-12 bg-gradient-to-b from-[#011F18] via-[#022C22] to-[#050B08] text-white border-b border-emerald-900/50">
    <div class="max-w-4xl mx-auto px-4 sm:px-6">
      <nav class="flex items-center gap-2 text-xs text-emerald-300/80 mb-6 font-medium">
        <a href="/" class="hover:text-amber-400 transition-colors">Home</a>
        <span>/</span>
        <a href="/science" class="hover:text-amber-400 transition-colors">Science</a>
        <span>/</span>
        <span class="text-white">Himalayan Sea Buckthorn Omega-7</span>
