---
// src/pages/learn/spirulina-for-weight-loss.astro
// FSSAI (Advertising & Claims Regulations 2018 + Nutraceutical Regulations 2022) compliant rewrite.
// Pivoted from disease/outcome framing to nutrient-function + active-lifestyle framing.
// Removed: melts fat, belly fat, burns fat, AMPK mechanism, "clinically-validated dosage", outcome-conditional
// money-back guarantee, specific BMI/kg promises, MedicalWebPage/mechanismOfAction schema.
import StoreLayout from '../../layouts/StoreLayout.astro';
import StoreHeader from '../../components/StoreHeader.astro';
import StoreFooter from '../../components/StoreFooter.astro';
import LearnRelatedGuides from '../../components/LearnRelatedGuides.astro';
import { BRAND_CONFIG } from '../../config/brand';
import LearnBuyCard from '../../components/LearnBuyCard.astro';

const pageTitle = "Spirulina for an Active Lifestyle: 62.39% Plant Protein & Daily Satiety Routine (2026)";
const pageDescription = "A daily spirulina routine for an active lifestyle: 62.39% plant protein (NABL-verified), natural satiety, steady energy and 290.89 mg/kg iron. Not a medicine — a whole-food nutritional supplement.";
const pageUrl = "https://www.sujatanutrilive.com/learn/spirulina-for-weight-loss";

const faqs = [
  {
    question: "How does spirulina support an active, high-protein lifestyle?",
    answer: "Spirulina is a whole-food source of 62.39% lab-verified plant protein (Lilaba report #LAL-NN-131125023). Protein is the most satiating macronutrient, so adding spirulina to breakfast or pre-meal water can help you feel satisfied with your usual plate size. It also provides 290.89 mg/kg natural iron and B-vitamins, nutrients your body uses for everyday energy and physical activity. Spirulina is a food supplement; it is not intended to replace balanced meals, diet or exercise."
  },
  {
    question: "What is a sensible daily spirulina serving for adults?",
    answer: "A typical adult serving of Sujata Spirulina is 1,000-2,000 mg per day (2-4 capsules of 500 mg), taken with 250 ml of warm water after breakfast. Active adults who consume more protein overall may take up to 3,000 mg daily, split across two servings. The WHO safe upper intake for healthy adults is 10 g per day — do not exceed. Children under 12, pregnant or lactating women, and anyone with a medical condition should consult their physician before use."
  },
  {
    question: "Should I take spirulina before or after food?",
    answer: "Both work. Taking it 20-30 minutes before a meal with warm water can support natural meal-time satiety, because dietary protein is generally satisfying. Taking it 30 minutes after a meal can support absorption of its fat-soluble carotenoids. Avoid completely empty-stomach intake first thing in the morning — the chlorophyll can feel strong for sensitive stomachs. Always with warm water, never with hot water or milk."
  },
  {
    question: "Can I combine spirulina with my regular walks and workouts?",
    answer: "Yes. Spirulina is a food supplement, so it can be part of a routine that includes daily walking, yoga or gym training. Many active adults take it 20 minutes before a workout alongside water and a light snack. It does not replace a balanced diet, hydration, sleep or structured exercise — it simply adds concentrated plant protein, iron and B-vitamins to the day."
  },
  {
    question: "Does spirulina have added sugar or stimulants?",
    answer: "No. Sujata Spirulina capsules, tablets and powder are 0 g added sugar, 0 g caffeine and 0 g stimulant. The capsule shell is 100% vegetarian cellulose with no chemical binder. The product contains only cold-dried spirulina from hydro-dome cultivation. See the ingredient list on the pack and the Lilaba Lab Report #LAL-NN-131125023 for the full composition."
  },
  {
    question: "Spirulina compared to whey protein — how are they different?",
    answer: "Whey protein delivers a large amount of animal-dairy protein per serving (typically 20-25 g). Spirulina delivers a smaller amount of plant protein per serving (around 1.9 g in a 3 g dose), but it is naturally lactose-free, vegetarian and comes with iron, calcium and B-vitamins already present in the whole food. They are not substitutes — many active adults use whey for post-workout protein needs and spirulina as a daily whole-food supplement. Pick based on your diet, tolerance and preference."
  },
  {
    question: "What is the price of a 90-day spirulina supply?",
    answer: "Sujata Spirulina Capsules (60 count × 500 mg) are ₹499 per bottle (₹449 on UPI). A 90-day supply at the 2-capsule daily serving is 3 bottles (180 capsules), roughly ₹11-₹15 per day. For readers who prefer flexibility, the 100 g powder works out to about ₹10 per day in smoothies. Free Cash on Delivery pan-India via WhatsApp (+91 98347 83503). Refund policy: see sitewide /refund-policy for full terms."
  }
];

// FAQPage schema deliberately omits disease/outcome questions. Article (not MedicalWebPage) and no mechanismOfAction.
const articleSchema = [
  {
    "@type": "Article",
    "@id": `${pageUrl}/#article`,
    "headline": "Spirulina for an Active Lifestyle: 62.39% Plant Protein & Daily Satiety Routine",
    "description": pageDescription,
    "image": "https://www.sujatanutrilive.com/products/sujata-spirulina-capsules-bottle-transparent.png",
    "inLanguage": "en-IN",
    "mainEntityOfPage": pageUrl,
    "datePublished": "2026-02-15T09:00:00+05:30",
    "dateModified": new Date().toISOString(),
    "author": {
      "@type": "Organization",
      "name": "Sujata Nutrilive Nutrition Research Team",
      "url": "https://www.sujatanutrilive.com"
    },
    "publisher": {
      "@type": "Organization",
      "name": BRAND_CONFIG.brandName,
      "logo": { "@type": "ImageObject", "url": "https://www.sujatanutrilive.com/sujata-logo-transparent.png" }
    },
    "about": {
      "@type": "DietarySupplement",
      "name": "Spirulina (Arthrospira platensis)",
      "activeIngredient": "Plant Protein (62.39%), Non-Heme Iron (290.89 mg/kg), Natural Calcium (1,407.91 mg/kg), Chlorophyll",
      "sameAs": "https://en.wikipedia.org/wiki/Spirulina_(dietary_supplement)"
    },
    "citation": [
      {
        "@type": "ScholarlyArticle",
        "name": "Spirulina supplementation and body-composition outcomes in human studies: a meta-analysis",
        "url": "https://pubmed.ncbi.nlm.nih.gov/32639477/",
        "sameAs": "https://doi.org/10.1186/s12944-020-01270-2"
      }
    ]
  },
  {
    "@type": "FAQPage",
    "@id": `${pageUrl}/#faq`,
    "mainEntity": faqs.map(f => ({
      "@type": "Question",
      "name": f.question,
      "acceptedAnswer": { "@type": "Answer", "text": f.answer }
    }))
  },
  {
    "@type": "BreadcrumbList",
    "@id": `${pageUrl}/#breadcrumb`,
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://www.sujatanutrilive.com" },
      { "@type": "ListItem", "position": 2, "name": "Learn", "item": "https://www.sujatanutrilive.com/science" },
      { "@type": "ListItem", "position": 3, "name": "Spirulina for an Active Lifestyle", "item": pageUrl }
    ]
  }
];
---

<StoreLayout
  title={pageTitle}
  description={pageDescription}
  image="/products/sujata-spirulina-capsules-bottle-transparent.png"
  extraSchema={articleSchema}
>
  <StoreHeader />

  <!-- Hero -->
  <header class="relative pt-32 sm:pt-36 pb-12 bg-gradient-to-b from-[#011F18] via-[#022C22] to-[#050B08] text-white border-b border-emerald-900/50">
    <div class="max-w-4xl mx-auto px-4 sm:px-6">
      <nav class="flex items-center gap-2 text-xs text-emerald-300/80 mb-6 font-medium">
        <a href="/" class="hover:text-amber-400 transition-colors">Home</a>
        <span>/</span>
        <a href="/science" class="hover:text-amber-400 transition-colors">Science</a>
        <span>/</span>
        <span class="text-white">Spirulina for an Active Lifestyle</span>
      </nav>

      <div class="inline-flex items-center gap-2 bg-emerald-500/20 border border-emerald-400/40 px-3.5 py-1.5 rounded-full text-xs font-bold text-emerald-200 mb-4 shadow-inner">
        <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
        <span>Daily Plant-Protein Routine • NABL Lab-Verified Nutrition</span>
      </div>

      <h1 class="text-2xl sm:text-4xl md:text-5xl font-serif font-black tracking-tight text-white leading-tight mb-4">
        Spirulina for an Active Lifestyle: <br class="hidden sm:block"/>
        <span class="text-amber-400 italic font-serif">62.39% Plant Protein & Daily Satiety Routine (2026)</span>
      </h1>

      <p class="text-emerald-100/90 text-sm sm:text-base leading-relaxed max-w-2xl font-sans">
        A daily plant-protein ritual for people who walk, train and eat mindfully. 62.39% lab-verified protein, 290.89 mg/kg natural iron, zero sugar, zero stimulant — a whole-food supplement, not a medicine.
      </p>

      <!-- Direct Answer Box -->
      <div class="mt-6 p-4 sm:p-5 bg-[#02231A]/95 border-2 border-emerald-500/50 rounded-2xl shadow-2xl relative overflow-hidden backdrop-blur-sm">
        <div class="flex items-center gap-2 mb-2">
          <span class="bg-amber-400 text-black text-[10px] font-black uppercase px-2.5 py-0.5 rounded-full tracking-wide">
            Direct Answer
          </span>
          <span class="text-xs text-emerald-300 font-semibold">Nutrient-Function Framing</span>
        </div>
        <p class="text-xs sm:text-sm text-gray-200 leading-relaxed font-sans">
          <strong class="text-amber-300 font-bold">How does spirulina fit into an active lifestyle?</strong>
          Sujata Spirulina is a whole-food supplement that adds <strong class="text-emerald-300">62.39% plant protein (Lilaba lab #LAL-NN-131125023)</strong>, <strong class="text-emerald-300">290.89 mg/kg natural iron</strong> and B-vitamins to your day. Protein is naturally satiating, so a pre-meal serving can help you feel satisfied with your usual plate size. Typical adult serving: 1,000-2,000 mg/day after breakfast with warm water. This is a dietary supplement — it does not replace balanced meals, regular movement or medical advice.
        </p>
      </div>

      <div class="flex flex-wrap items-center gap-3 mt-6 pt-6 border-t border-white/10 text-xs text-gray-300">
        <span class="flex items-center gap-1.5"><span class="text-emerald-400 font-bold">✓</span> 62.39% Plant Protein</span>
        <span class="text-white/20">•</span>
        <span class="flex items-center gap-1.5"><span class="text-amber-400 font-bold">✓</span> 0 g Added Sugar</span>
        <span class="text-white/20">•</span>
        <span class="flex items-center gap-1.5"><span class="text-emerald-400 font-bold">✓</span> 0 g Stimulant</span>
        <span class="text-white/20">•</span>
        <span class="flex items-center gap-1.5"><span class="text-emerald-400 font-bold">✓</span> FSSAI #21526027000179</span>
      </div>
    </div>
  </header>

  <!-- Body -->
  <main class="bg-[#050B08] text-gray-200 py-12 px-4 sm:px-6 font-sans">
    <div class="max-w-4xl mx-auto space-y-12">

      <!-- 1. Why protein matters for an active lifestyle -->
      <article class="bg-[#0A1A12] border border-emerald-900/50 rounded-2xl p-6 sm:p-8 shadow-xl">
        <h2 class="text-xl sm:text-2xl font-serif font-bold text-white mb-4 flex items-center gap-2">
          <span class="text-amber-400">1.</span> Why Plant Protein Matters in a Daily Routine
        </h2>
        <p class="text-sm text-gray-300 leading-relaxed mb-4">
          Protein is the most satiating of the three macronutrients — meals built around it generally leave you feeling satisfied for longer. Sujata Spirulina is a concentrated, whole-food source of plant protein and does not contain added sugar or stimulants. Each 500 mg capsule delivers naturally occurring protein, non-heme iron and B-vitamins. The nutrients in spirulina support the body's normal energy-yielding metabolism and are useful additions to a balanced Indian diet.
        </p>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-4 text-sm">
          <div class="bg-black/30 border border-emerald-500/20 rounded-xl p-4">
            <h3 class="font-bold text-emerald-400 text-base mb-2">① 62.39% Plant Protein</h3>
            <p class="text-gray-300 leading-relaxed text-xs sm:text-sm">Lab-verified by Lilaba Analytical Laboratories (NABL). All 9 essential amino acids present in the whole food. Lactose-free, vegetarian.</p>
          </div>
          <div class="bg-black/30 border border-amber-500/20 rounded-xl p-4">
            <h3 class="font-bold text-amber-400 text-base mb-2">② 290.89 mg/kg Natural Iron</h3>
            <p class="text-gray-300 leading-relaxed text-xs sm:text-sm">Iron contributes to normal formation of red blood cells and haemoglobin and normal oxygen transport in the body (nutrient-function reference).</p>
          </div>
          <div class="bg-black/30 border border-purple-500/20 rounded-xl p-4">
            <h3 class="font-bold text-purple-400 text-base mb-2">③ B-Vitamins & Chlorophyll</h3>
            <p class="text-gray-300 leading-relaxed text-xs sm:text-sm">B-vitamins contribute to normal energy-yielding metabolism. Natural chlorophyll is a traditional green-food nutrient enjoyed worldwide.</p>
          </div>
        </div>
      </article>

      <LearnBuyCard
        handle="sujata-spirulina-capsules"
        lang="en"
        placement="active-lifestyle-top"
        badge="Daily Protein Ritual • 1,000 mg"
        heading="Sujata Spirulina Capsules (500mg × 60)"
        pitch="One month of the daily 2-capsule serving. 62.39% lab-verified plant protein, odourless veg capsule, dissolves in 5 minutes. For adults who walk, train and eat mindfully."
        points={["62.39% plant protein (Lilaba Lab #LAL-NN-131125023)", "0 g sugar, 0 g lactose, 0 g binder", "FSSAI Reg. #21526027000179"]}
      />

      <!-- 2. The Daily Routine -->
      <article class="bg-[#0A1A12] border border-emerald-900/50 rounded-2xl p-6 sm:p-8 shadow-xl">
        <h2 class="text-xl sm:text-2xl font-serif font-bold text-white mb-4 flex items-center gap-2">
          <span class="text-amber-400">2.</span> A Sensible Daily Routine with Spirulina
        </h2>
        <div class="overflow-x-auto">
          <table class="w-full text-left text-xs sm:text-sm border-collapse">
            <thead>
              <tr class="border-b border-emerald-800 text-emerald-300">
                <th class="py-3 px-3">Time</th>
                <th class="py-3 px-3 text-amber-400 font-bold">Routine</th>
                <th class="py-3 px-3">Nutrition Rationale</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-emerald-950/60">
              <tr><td class="py-3 px-3 font-semibold text-white">7:00 AM</td><td class="py-3 px-3 bg-emerald-950/40 text-emerald-200 font-bold">Warm water + optional lemon</td><td class="py-3 px-3 text-gray-300">Hydration first, before breakfast.</td></tr>
              <tr><td class="py-3 px-3 font-semibold text-white">7:30 AM</td><td class="py-3 px-3 bg-emerald-950/40 text-emerald-200 font-bold">Protein-rich breakfast (eggs/paneer/dal)</td><td class="py-3 px-3 text-gray-300">Base protein for the day.</td></tr>
              <tr><td class="py-3 px-3 font-semibold text-white">8:00 AM</td><td class="py-3 px-3 bg-emerald-950/40 text-emerald-200 font-bold">2 Spirulina capsules (1,000 mg) + warm water</td><td class="py-3 px-3 text-gray-300">Adds plant protein, iron, B-vitamins.</td></tr>
              <tr><td class="py-3 px-3 font-semibold text-white">1:00 PM</td><td class="py-3 px-3 bg-emerald-950/40 text-emerald-200 font-bold">Balanced lunch (½ veg, ¼ protein, ¼ complex carb)</td><td class="py-3 px-3 text-gray-300">Portion awareness, fibre-rich.</td></tr>
              <tr><td class="py-3 px-3 font-semibold text-white">Anytime</td><td class="py-3 px-3 bg-emerald-950/40 text-emerald-200 font-bold">10,000 steps + 2.5-3 L water</td><td class="py-3 px-3 text-gray-300">Physical activity, hydration.</td></tr>
              <tr><td class="py-3 px-3 font-semibold text-white">7:30 PM</td><td class="py-3 px-3 bg-emerald-950/40 text-emerald-200 font-bold">Light dinner before 8 PM</td><td class="py-3 px-3 text-gray-300">Natural overnight gap of 12 hours.</td></tr>
            </tbody>
          </table>
        </div>
        <p class="mt-4 text-xs text-emerald-200/80 bg-emerald-950/30 border border-emerald-500/20 rounded-xl p-3">
          This is a general lifestyle routine, not a medical or therapeutic protocol. Spirulina is a food supplement and does not replace a balanced meal plan, physical activity or advice from your physician.
        </p>
      </article>

      <!-- 3. Supporting Nutrition Research -->
      <article class="bg-[#0A1A12] border border-emerald-900/50 rounded-2xl p-6 sm:p-8 shadow-xl">
        <h2 class="text-xl sm:text-2xl font-serif font-bold text-white mb-4 flex items-center gap-2">
          <span class="text-amber-400">3.</span> Nutrition Research Reading List
        </h2>
        <p class="text-sm text-gray-300 leading-relaxed mb-4">
          For readers who enjoy the peer-reviewed literature on spirulina as a whole food, the links below point to publicly indexed scientific articles. They are provided for general nutrition reading only. Nothing on this page is a medical recommendation.
        </p>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 text-xs">
          <a href="https://pubmed.ncbi.nlm.nih.gov/32639477/" target="_blank" rel="noopener noreferrer" class="bg-black/40 border border-white/10 rounded-xl p-4 hover:border-emerald-400/40 transition-colors">
            <div class="text-emerald-400 font-bold text-[11px] uppercase">Lipids Health Dis · Meta-analysis</div>
            <h3 class="font-bold text-white text-xs mt-1 mb-1.5">Spirulina & body-composition outcomes</h3>
            <p class="text-gray-400 text-[11px] leading-relaxed">PMID 32639477 — pooled human-study analysis.</p>
          </a>
          <a href="https://pubmed.ncbi.nlm.nih.gov/18955364/" target="_blank" rel="noopener noreferrer" class="bg-black/40 border border-white/10 rounded-xl p-4 hover:border-emerald-400/40 transition-colors">
            <div class="text-amber-400 font-bold text-[11px] uppercase">eCAM</div>
            <h3 class="font-bold text-white text-xs mt-1 mb-1.5">Spirulina in nutrition practice</h3>
            <p class="text-gray-400 text-[11px] leading-relaxed">PMID 18955364 — general evidence overview.</p>
          </a>
        </div>
      </article>

      <LearnBuyCard
        handle="sujata-spirulina-sea-buckthorn-combo-pack"
        lang="en"
        placement="active-lifestyle-combo"
        badge="Daily Nutrition Combo"
        heading="Spirulina + Himalayan Sea Buckthorn Combo"
        pitch="Add Himalayan sea buckthorn's rare Omega-7 to your daily whole-food routine — both are plant-based supplements, not medicines. 1, 2 and 3-month packs available."
        points={["1, 2 or 3-month pack", "2-month pack ships with 2 free SpiruGlow soaps", "Free COD pan-India via WhatsApp"]}
      />

      <!-- 4. FAQ -->
      <section class="bg-[#0A1A12] border border-emerald-900/50 rounded-2xl p-6 sm:p-8 shadow-xl">
        <h2 class="text-xl sm:text-2xl font-serif font-bold text-white mb-6 flex items-center gap-2">
          <span class="text-amber-400">4.</span> Frequently Asked Questions
        </h2>
        <div class="space-y-4">
          {faqs.map((faq, index) => (
            <details class="group bg-black/40 border border-white/10 rounded-xl p-4 sm:p-5 cursor-pointer hover:border-emerald-500/30 transition-all">
              <summary class="font-bold text-white flex justify-between items-center text-sm sm:text-base select-none">
                <span class="flex items-start gap-2.5 pr-2">
                  <span class="text-amber-400 font-sans text-xs font-black mt-0.5 shrink-0">Q{index + 1}.</span>
                  <span>{faq.question}</span>
                </span>
                <span class="text-emerald-400 text-lg transition-transform group-open:rotate-180 shrink-0">↓</span>
              </summary>
              <p class="text-gray-300 text-xs sm:text-sm mt-3.5 leading-relaxed border-t border-white/10 pt-3.5 font-sans">{faq.answer}</p>
            </details>
          ))}
        </div>
      </section>

    </div>
  </main>

  <LearnRelatedGuides current="spirulina-for-weight-loss" />
  <StoreFooter />
</StoreLayout>
