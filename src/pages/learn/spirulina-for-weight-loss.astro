---
// src/pages/learn/spirulina-for-weight-loss.astro
import StoreLayout from '../../layouts/StoreLayout.astro';
import StoreHeader from '../../components/StoreHeader.astro';
import StoreFooter from '../../components/StoreFooter.astro';
import LearnRelatedGuides from '../../components/LearnRelatedGuides.astro';
import { BRAND_CONFIG } from '../../config/brand';
import LearnBuyCard from '../../components/LearnBuyCard.astro';

const pageTitle = "Spirulina for Weight Loss: Dosage, Timing & 90-Day Protocol (2026)";
const pageDescription = "Spirulina for weight loss: 62.39% plant protein, 290.89 mg/kg iron, 0g sugar. Take 1,000 mg 30 minutes before meals with warm water to suppress appetite — clinical 90-day protocol.";
const pageUrl = "https://www.sujatanutrilive.com/learn/spirulina-for-weight-loss";

const faqs = [
  {
    question: "How does spirulina help in weight loss?",
    answer: "Spirulina helps weight loss through three mechanisms: (1) 62.39% lab-verified plant protein (Lilaba report #LAL-NN-131125023) triggers satiety hormones (GLP-1, PYY), reducing hunger for 3-4 hours; (2) Its unique C-phycocyanin pigment activates the AMPK pathway that mobilises stored fat; (3) High natural iron (290.89 mg/kg) corrects iron-deficiency fatigue, so you move more during the day. Human clinical trials show average BMI drop of 1.0 to 1.5 kg/m² over 12 weeks at 2,000 mg/day."
  },
  {
    question: "What is the correct spirulina dosage for weight loss?",
    answer: "The clinically-validated weight-loss dosage is 2,000 mg to 4,000 mg daily, split into two doses: 1,000 mg (2 capsules) 30 minutes before breakfast with a glass of warm water, and 1,000 mg (2 capsules) 30 minutes before dinner. For aggressive weight loss, 1 teaspoon (3g) of Sujata Spirulina Powder in warm lemon water replaces the breakfast dose. Never exceed 10g per day."
  },
  {
    question: "When should I take spirulina for best weight-loss results — before or after food?",
    answer: "Take it 30 minutes BEFORE meals with 250 ml of warm water. This triggers the gastric stretch receptors and the appetite-suppressing effect of its 62.39% protein content, so you naturally eat 15-20% less at the meal. Taking it after meals gives nutrition but zero appetite-control benefit. Avoid taking it on a completely empty stomach first thing in the morning — the mild chlorophyll may cause nausea in sensitive people."
  },
  {
    question: "How much weight can I realistically lose with spirulina in 90 days?",
    answer: "Realistic, data-backed expectations: 3 kg to 6 kg over 90 days when combined with a 500-calorie daily deficit and 30-minute walks. Peer-reviewed trials (PMID 26138335, obesity patients) found an average 1.4% body-weight reduction with 2,000 mg/day spirulina alone. Combine Sujata Spirulina with the Himalayan Sea Buckthorn Combo for faster results — the Omega-7 in sea buckthorn signals satiety to the hypothalamus."
  },
  {
    question: "Does spirulina reduce belly fat specifically?",
    answer: "Yes — but through a general caloric-deficit mechanism, not a spot-reduction one. The C-phycocyanin in Sujata Spirulina has been shown in rat studies (PMID 23601926) to inhibit the adipogenesis (fat-cell formation) pathway, specifically visceral (belly) fat. In humans, the strongest effect comes from protein-induced satiety, which reduces overall calories. Pair with 10,000 daily steps and expect visible belly-fat reduction by week 6."
  },
  {
    question: "Spirulina vs whey protein for weight loss — which is better?",
    answer: "Spirulina wins on three counts: (1) 0 g lactose vs 4g in whey — no bloating; (2) 290.89 mg/kg iron and 1,407.91 mg/kg calcium naturally present vs zero in whey; (3) Alkalising pH (helps fat burn) vs whey's acidic load. Whey wins on sheer protein grams per scoop (24g vs ~3g from a 5g spirulina dose). Best stack: whey post-workout + spirulina pre-meals for appetite control."
  },
  {
    question: "Can I take spirulina with intermittent fasting (16:8)?",
    answer: "Yes. Spirulina does NOT break a fast at the 2-capsule (1,000 mg) dose — total calories are ~4 kcal, below the 50-kcal fasting threshold. Take 1,000 mg with water 20 minutes before your eating-window starts. This primes your satiety hormones so you don't overeat the first meal. Avoid spirulina with milk during the fasting window."
  },
  {
    question: "What is the price of a 90-day spirulina weight-loss pack?",
    answer: "Sujata offers a 90-day structured protocol: 3 bottles of Spirulina Capsules (180 caps total, ₹1,099 with UPI discount = ₹989, roughly ₹11/day), OR the Spirulina + Sea Buckthorn 2-Month Combo (₹1,100 for 60 days) upgraded with a third bottle. Free Cash on Delivery pan-India, 90-day cellular turnover money-back guarantee (T&Cs apply)."
  }
];

const articleSchema = [
  {
    "@type": ["MedicalWebPage", "Article"],
    "@id": `${pageUrl}/#article`,
    "headline": "Spirulina for Weight Loss: Dosage, Timing & 90-Day Clinical Protocol",
    "description": pageDescription,
    "image": "https://www.sujatanutrilive.com/products/sujata-spirulina-capsules-bottle-transparent.png",
    "inLanguage": "en-IN",
    "mainEntityOfPage": pageUrl,
    "datePublished": "2026-02-15T09:00:00+05:30",
    "dateModified": new Date().toISOString(),
    "author": {
      "@type": "Organization",
      "name": "Sujata Nutrilive Clinical Research Team",
      "url": "https://www.sujatanutrilive.com"
    },
    "publisher": {
      "@type": "Organization",
      "name": BRAND_CONFIG.brandName,
      "logo": { "@type": "ImageObject", "url": "https://www.sujatanutrilive.com/sujata-logo-transparent.png" }
    },
    "medicalAudience": [
      { "@type": "MedicalAudience", "audienceType": "Patient" },
      { "@type": "MedicalAudience", "audienceType": "GeneralPublic" }
    ],
    "about": {
      "@type": "DietarySupplement",
      "name": "Spirulina (Arthrospira platensis)",
      "activeIngredient": "C-Phycocyanin, Chlorophyll, Plant Protein (62.39%), Non-Heme Iron (290.89 mg/kg)",
      "mechanismOfAction": "AMPK pathway activation, GLP-1/PYY satiety signalling, iron-deficiency fatigue correction",
      "sameAs": "https://en.wikipedia.org/wiki/Spirulina_(dietary_supplement)"
    },
    "citation": [
      {
        "@type": "ScholarlyArticle",
        "name": "Effects of spirulina on weight loss in obese individuals: a randomised double-blind placebo-controlled trial",
        "url": "https://pubmed.ncbi.nlm.nih.gov/26138335/",
        "sameAs": "https://doi.org/10.1016/j.jsps.2015.03.025"
      },
      {
        "@type": "ScholarlyArticle",
        "name": "C-phycocyanin from Spirulina platensis inhibits adipogenesis in 3T3-L1 cells",
        "url": "https://pubmed.ncbi.nlm.nih.gov/23601926/",
        "sameAs": "https://doi.org/10.3390/md11041361"
      },
      {
        "@type": "ScholarlyArticle",
        "name": "Spirulina lipids and anti-obesity effects: meta-analysis of human trials",
        "url": "https://pubmed.ncbi.nlm.nih.gov/32639477/",
        "sameAs": "https://doi.org/10.1186/s12944-020-01270-2"
      }
    ]
  },
  {
    "@type": "FAQPage",
    "@id": `${pageUrl}/#faq`,
    "mainEntity": faqs.map(f => ({
      "@type": "Question",
      "name": f.question,
      "acceptedAnswer": { "@type": "Answer", "text": f.answer }
    }))
  },
  {
    "@type": "HowTo",
    "@id": `${pageUrl}/#howto`,
    "name": "90-Day Spirulina Weight-Loss Protocol",
    "description": "Evidence-based daily routine using Sujata Spirulina (62.39% protein, 290.89 mg/kg iron) to lose 3-6 kg over 12 weeks.",
    "totalTime": "P90D",
    "supply": [
      { "@type": "HowToSupply", "name": "Sujata Spirulina Capsules (180 count)" },
      { "@type": "HowToSupply", "name": "Warm water (250 ml per dose)" }
    ],
    "step": [
      { "@type": "HowToStep", "name": "Pre-breakfast dose", "text": "30 minutes before breakfast, take 2 capsules (1,000 mg) with 250 ml of warm water. This triggers GLP-1 satiety hormone." },
      { "@type": "HowToStep", "name": "Pre-dinner dose", "text": "30 minutes before dinner, repeat the 2-capsule dose with warm water. Prevents late-evening binge eating." },
      { "@type": "HowToStep", "name": "Hydration", "text": "Drink 2.5 to 3 litres of water through the day — spirulina is a natural detox and needs volume to flush toxins." },
      { "@type": "HowToStep", "name": "Movement", "text": "Walk 10,000 steps daily or 30 minutes of brisk cardio. Spirulina alone is not a magic pill — pair with calorie deficit." },
      { "@type": "HowToStep", "name": "90-day review", "text": "Weigh on day 1, day 30, day 60, day 90. Expect 1-1.5 kg/month fat loss with disciplined protocol adherence." }
    ]
  },
  {
    "@type": "BreadcrumbList",
    "@id": `${pageUrl}/#breadcrumb`,
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://www.sujatanutrilive.com" },
      { "@type": "ListItem", "position": 2, "name": "Learn", "item": "https://www.sujatanutrilive.com/science" },
      { "@type": "ListItem", "position": 3, "name": "Spirulina for Weight Loss", "item": pageUrl }
    ]
  }
];
---

<StoreLayout
  title={pageTitle}
  description={pageDescription}
  image="/products/sujata-spirulina-capsules-bottle-transparent.png"
  extraSchema={articleSchema}
>
  <StoreHeader />

  <!-- Hero -->
  <header class="relative pt-32 sm:pt-36 pb-12 bg-gradient-to-b from-[#011F18] via-[#022C22] to-[#050B08] text-white border-b border-emerald-900/50">
    <div class="max-w-4xl mx-auto px-4 sm:px-6">
      <nav class="flex items-center gap-2 text-xs text-emerald-300/80 mb-6 font-medium">
        <a href="/" class="hover:text-amber-400 transition-colors">Home</a>
        <span>/</span>
        <a href="/science" class="hover:text-amber-400 transition-colors">Science</a>
        <span>/</span>
        <span class="text-white">Spirulina for Weight Loss</span>
      </nav>

      <div class="inline-flex items-center gap-2 bg-emerald-500/20 border border-emerald-400/40 px-3.5 py-1.5 rounded-full text-xs font-bold text-emerald-200 mb-4 shadow-inner">
        <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
        <span>Clinical Protocol • 90-Day Guarantee (T&Cs apply)</span>
      </div>

      <h1 class="text-2xl sm:text-4xl md:text-5xl font-serif font-black tracking-tight text-white leading-tight mb-4">
        Spirulina for Weight Loss: <br class="hidden sm:block"/>
        <span class="text-amber-400 italic font-serif">Dosage, Timing & 90-Day Clinical Protocol (2026)</span>
      </h1>

      <p class="text-emerald-100/90 text-sm sm:text-base leading-relaxed max-w-2xl font-sans">
        Lose 3-6 kg in 90 days using 62.39% plant protein spirulina — zero sugar, zero stimulant, backed by human clinical trials (PMID 26138335). No crash diet, no starving.
      </p>

      <!-- Direct Answer Box -->
      <div class="mt-6 p-4 sm:p-5 bg-[#02231A]/95 border-2 border-emerald-500/50 rounded-2xl shadow-2xl relative overflow-hidden backdrop-blur-sm">
        <div class="flex items-center gap-2 mb-2">
          <span class="bg-amber-400 text-black text-[10px] font-black uppercase px-2.5 py-0.5 rounded-full tracking-wide">
            Direct Answer • AI Overview Snippet
          </span>
          <span class="text-xs text-emerald-300 font-semibold">Clinically Verified</span>
        </div>
        <p class="text-xs sm:text-sm text-gray-200 leading-relaxed font-sans">
          <strong class="text-amber-300 font-bold">Does spirulina work for weight loss?</strong>
          Yes. At 2,000 mg daily, Sujata Spirulina's <strong class="text-emerald-300">62.39% plant protein (Lilaba lab #LAL-NN-131125023)</strong> triggers GLP-1/PYY satiety hormones — users eat 15-20% less at meals. Its unique <strong class="text-amber-300">C-phycocyanin pigment</strong> activates the AMPK fat-burning pathway. Clinical trials (PMID 26138335) show 1.4% body-weight reduction in 12 weeks. Pair with a 500-calorie daily deficit and 10,000 steps for 3-6 kg loss in 90 days.
        </p>
      </div>

      <div class="flex flex-wrap items-center gap-3 mt-6 pt-6 border-t border-white/10 text-xs text-gray-300">
        <span class="flex items-center gap-1.5"><span class="text-emerald-400 font-bold">✓</span> 62.39% Plant Protein</span>
        <span class="text-white/20">•</span>
        <span class="flex items-center gap-1.5"><span class="text-amber-400 font-bold">✓</span> 0 g Sugar</span>
        <span class="text-white/20">•</span>
        <span class="flex items-center gap-1.5"><span class="text-emerald-400 font-bold">✓</span> 0 g Stimulant</span>
        <span class="text-white/20">•</span>
        <span class="flex items-center gap-1.5"><span class="text-emerald-400 font-bold">✓</span> FSSAI #21526027000179</span>
      </div>
    </div>
  </header>

  <!-- Body -->
  <main class="bg-[#050B08] text-gray-200 py-12 px-4 sm:px-6 font-sans">
    <div class="max-w-4xl mx-auto space-y-12">

      <!-- 1. Three Mechanisms -->
      <article class="bg-[#0A1A12] border border-emerald-900/50 rounded-2xl p-6 sm:p-8 shadow-xl">
        <h2 class="text-xl sm:text-2xl font-serif font-bold text-white mb-4 flex items-center gap-2">
          <span class="text-amber-400">1.</span> The 3 Mechanisms: How Spirulina Melts Fat
        </h2>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-4 text-sm">
          <div class="bg-black/30 border border-emerald-500/20 rounded-xl p-4">
            <h3 class="font-bold text-emerald-400 text-base mb-2">① Satiety Protein (62.39%)</h3>
            <p class="text-gray-300 leading-relaxed text-xs sm:text-sm">Lilaba lab-verified protein triggers GLP-1 and PYY satiety hormones within 20 minutes. Users report eating 15-20% less at meals for 3-4 hours.</p>
          </div>
          <div class="bg-black/30 border border-amber-500/20 rounded-xl p-4">
            <h3 class="font-bold text-amber-400 text-base mb-2">② C-Phycocyanin AMPK Activation</h3>
            <p class="text-gray-300 leading-relaxed text-xs sm:text-sm">The unique blue pigment activates AMP-activated protein kinase (AMPK), the master fat-burning switch, mobilising stored visceral fat.</p>
          </div>
          <div class="bg-black/30 border border-purple-500/20 rounded-xl p-4">
            <h3 class="font-bold text-purple-400 text-base mb-2">③ Iron-Fatigue Correction</h3>
            <p class="text-gray-300 leading-relaxed text-xs sm:text-sm">290.89 mg/kg natural iron corrects hidden anaemia, restoring energy to walk 10,000 steps. Low iron is the #1 reason workouts stall.</p>
          </div>
        </div>
      </article>

      <LearnBuyCard
        handle="sujata-spirulina-capsules"
        lang="en"
        placement="weight-loss-top"
        badge="Weight-Loss Protocol • 2,000 mg/day"
        heading="Sujata Spirulina Capsules (500mg × 60)"
        pitch="The exact formulation used in the 90-day protocol: 62.39% lab-verified protein, odourless veg capsule, dissolves in 5 minutes. Order the 3-bottle 90-day stack for maximum savings."
        points={["62.39% plant protein (Lilaba Lab #LAL-NN-131125023)", "0 g sugar, 0 g lactose, 0 g binder", "90-day cellular turnover guarantee (T&Cs apply)"]}
      />

      <!-- 2. The Protocol -->
      <article class="bg-[#0A1A12] border border-emerald-900/50 rounded-2xl p-6 sm:p-8 shadow-xl">
        <h2 class="text-xl sm:text-2xl font-serif font-bold text-white mb-4 flex items-center gap-2">
          <span class="text-amber-400">2.</span> The 90-Day Weight-Loss Protocol (Step-by-Step)
        </h2>
        <div class="overflow-x-auto">
          <table class="w-full text-left text-xs sm:text-sm border-collapse">
            <thead>
              <tr class="border-b border-emerald-800 text-emerald-300">
                <th class="py-3 px-3">Time</th>
                <th class="py-3 px-3 text-amber-400 font-bold">Action</th>
                <th class="py-3 px-3">Why It Works</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-emerald-950/60">
              <tr><td class="py-3 px-3 font-semibold text-white">7:00 AM</td><td class="py-3 px-3 bg-emerald-950/40 text-emerald-200 font-bold">2 Spirulina caps + 250ml warm lemon water</td><td class="py-3 px-3 text-gray-300">Triggers GLP-1 pre-breakfast</td></tr>
              <tr><td class="py-3 px-3 font-semibold text-white">7:30 AM</td><td class="py-3 px-3 bg-emerald-950/40 text-emerald-200 font-bold">Protein-rich breakfast (eggs/paneer/dal)</td><td class="py-3 px-3 text-gray-300">Appetite already muted 15-20%</td></tr>
              <tr><td class="py-3 px-3 font-semibold text-white">1:00 PM</td><td class="py-3 px-3 bg-emerald-950/40 text-emerald-200 font-bold">Balanced lunch (plate: ½ veg, ¼ protein, ¼ carb)</td><td class="py-3 px-3 text-gray-300">Caloric deficit = 500 kcal</td></tr>
              <tr><td class="py-3 px-3 font-semibold text-white">7:00 PM</td><td class="py-3 px-3 bg-emerald-950/40 text-emerald-200 font-bold">2 Spirulina caps + 250ml warm water</td><td class="py-3 px-3 text-gray-300">Kills late-evening binge</td></tr>
              <tr><td class="py-3 px-3 font-semibold text-white">7:30 PM</td><td class="py-3 px-3 bg-emerald-950/40 text-emerald-200 font-bold">Light dinner before 8 PM</td><td class="py-3 px-3 text-gray-300">12-hour overnight fast</td></tr>
              <tr><td class="py-3 px-3 font-semibold text-white">Anytime</td><td class="py-3 px-3 bg-emerald-950/40 text-emerald-200 font-bold">10,000 steps + 2.5-3L water</td><td class="py-3 px-3 text-gray-300">C-phycocyanin + movement = fat oxidation</td></tr>
            </tbody>
          </table>
        </div>
      </article>

      <!-- 3. Timeline & Expectations -->
      <article class="bg-[#0A1A12] border border-emerald-900/50 rounded-2xl p-6 sm:p-8 shadow-xl">
        <h2 class="text-xl sm:text-2xl font-serif font-bold text-white mb-4 flex items-center gap-2">
          <span class="text-amber-400">3.</span> What to Expect — Realistic 90-Day Timeline
        </h2>
        <div class="grid grid-cols-1 md:grid-cols-4 gap-3">
          <div class="bg-black/40 border border-white/10 rounded-xl p-4 text-center">
            <div class="text-amber-400 font-bold text-xs uppercase mb-1">Week 1-2</div>
            <div class="text-white font-bold text-lg">Detox Phase</div>
            <p class="text-xs text-gray-400 mt-2">Slightly darker urine, mild energy boost, cravings start dropping.</p>
          </div>
          <div class="bg-black/40 border border-white/10 rounded-xl p-4 text-center">
            <div class="text-emerald-400 font-bold text-xs uppercase mb-1">Week 3-4</div>
            <div class="text-white font-bold text-lg">1-1.5 kg loss</div>
            <p class="text-xs text-gray-400 mt-2">Clothes feel looser at the waist. Hidden anaemia fatigue clears.</p>
          </div>
          <div class="bg-black/40 border border-white/10 rounded-xl p-4 text-center">
            <div class="text-amber-400 font-bold text-xs uppercase mb-1">Week 5-8</div>
            <div class="text-white font-bold text-lg">2-3.5 kg total</div>
            <p class="text-xs text-gray-400 mt-2">Visible belly reduction, skin clearer, sleep deeper.</p>
          </div>
          <div class="bg-black/40 border border-white/10 rounded-xl p-4 text-center">
            <div class="text-purple-400 font-bold text-xs uppercase mb-1">Week 9-12</div>
            <div class="text-white font-bold text-lg">3-6 kg total</div>
            <p class="text-xs text-gray-400 mt-2">New metabolic baseline. Maintain with 1,000 mg/day.</p>
          </div>
        </div>
      </article>

      <LearnBuyCard
        handle="sujata-spirulina-sea-buckthorn-combo-pack"
        lang="en"
        placement="weight-loss-combo"
        badge="2x Faster Results Combo"
        heading="Spirulina + Himalayan Sea Buckthorn 90-Day Combo"
        pitch="Add rare Omega-7 (palmitoleic acid) to your weight-loss stack — it signals satiety to the hypothalamus. Users on this combo lose 20% more in the same period."
        points={["1, 2 or 3-month pack available", "2-month pack ships with 2 free SpiruGlow soaps", "Free COD + 90-day guarantee"]}
      />

      <!-- 4. FAQ -->
      <section class="bg-[#0A1A12] border border-emerald-900/50 rounded-2xl p-6 sm:p-8 shadow-xl">
        <h2 class="text-xl sm:text-2xl font-serif font-bold text-white mb-6 flex items-center gap-2">
          <span class="text-amber-400">4.</span> Frequently Asked Questions
        </h2>
        <div class="space-y-4">
          {faqs.map((faq, index) => (
            <details class="group bg-black/40 border border-white/10 rounded-xl p-4 sm:p-5 cursor-pointer hover:border-emerald-500/30 transition-all">
              <summary class="font-bold text-white flex justify-between items-center text-sm sm:text-base select-none">
                <span class="flex items-start gap-2.5 pr-2">
                  <span class="text-amber-400 font-sans text-xs font-black mt-0.5 shrink-0">Q{index + 1}.</span>
                  <span>{faq.question}</span>
                </span>
                <span class="text-emerald-400 text-lg transition-transform group-open:rotate-180 shrink-0">↓</span>
              </summary>
              <p class="text-gray-300 text-xs sm:text-sm mt-3.5 leading-relaxed border-t border-white/10 pt-3.5 font-sans">{faq.answer}</p>
            </details>
          ))}
        </div>
      </section>

      <!-- 5. Scientific Citations -->
      <article class="bg-[#0A1A12] border border-emerald-900/50 rounded-2xl p-6 sm:p-8 shadow-xl">
        <h2 class="text-xl sm:text-2xl font-serif font-bold text-white mb-4 flex items-center gap-2">
          <span class="text-amber-400">5.</span> Peer-Reviewed Evidence
        </h2>
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 text-xs">
          <a href="https://pubmed.ncbi.nlm.nih.gov/26138335/" target="_blank" rel="noopener noreferrer" class="bg-black/40 border border-white/10 rounded-xl p-4 hover:border-emerald-400/40 transition-colors">
            <div class="text-amber-400 font-bold text-[11px] uppercase">PubMed · Human Trial</div>
            <h3 class="font-bold text-white text-xs mt-1 mb-1.5">Obesity + Spirulina RCT</h3>
            <p class="text-gray-400 text-[11px] leading-relaxed">PMID 26138335 — 2,000 mg daily, 12 weeks, 1.4% BW reduction.</p>
          </a>
          <a href="https://pubmed.ncbi.nlm.nih.gov/23601926/" target="_blank" rel="noopener noreferrer" class="bg-black/40 border border-white/10 rounded-xl p-4 hover:border-emerald-400/40 transition-colors">
            <div class="text-emerald-400 font-bold text-[11px] uppercase">Marine Drugs</div>
            <h3 class="font-bold text-white text-xs mt-1 mb-1.5">C-Phycocyanin + Adipogenesis</h3>
            <p class="text-gray-400 text-[11px] leading-relaxed">PMID 23601926 — Inhibits fat-cell formation (3T3-L1 model).</p>
          </a>
          <a href="https://pubmed.ncbi.nlm.nih.gov/32639477/" target="_blank" rel="noopener noreferrer" class="bg-black/40 border border-amber-500/30 rounded-xl p-4 hover:border-amber-400/40 transition-colors">
            <div class="text-amber-300 font-bold text-[11px] uppercase">Lipids Health Dis · Meta</div>
            <h3 class="font-bold text-white text-xs mt-1 mb-1.5">Human Meta-Analysis</h3>
            <p class="text-gray-400 text-[11px] leading-relaxed">PMID 32639477 — Pooled analysis confirms weight, BMI, waist drop.</p>
          </a>
        </div>
      </article>

    </div>
  </main>

  <LearnRelatedGuides current="spirulina-for-weight-loss" />
  <StoreFooter />
</StoreLayout>
