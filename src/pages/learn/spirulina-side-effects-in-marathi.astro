import { BRAND_CONFIG } from '../../config/brand';

const pageTitle = "Spirulina Side Effects in Marathi: स्पिरुलिनाचे दुष्परिणाम, तोटे व नुकसान होतात का? (२०२६ वैज्ञानिक सत्य)";
const pageDescription = "Spirulina Side Effects in Marathi: स्पिरुलिनाचे काही दुष्परिणाम किंवा नुकसान आहे का? जाणून घ्या NABL लॅब रिपोर्ट, लिव्हर व किडनीवरील शास्त्रीय सत्य, योग्य डोस आणि १००% सुरक्षित स्पिरुलिना.";
const pageUrl = "https://www.sujatanutrilive.com/learn/spirulina-side-effects-in-marathi";
const ogImage = "/products/sujata-spirulina-capsules-bottle-transparent.png";

const faqs = [
  {
    question: "स्पिरुलिना खाल्ल्याने वजन वाढते की कमी होते?",
