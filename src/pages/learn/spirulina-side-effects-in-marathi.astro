---
// src/pages/learn/spirulina-side-effects-in-marathi.astro
import StoreLayout from '../../layouts/StoreLayout.astro';
import StoreHeader from '../../components/StoreHeader.astro';
import StoreFooter from '../../components/StoreFooter.astro';
import { BRAND_CONFIG } from '../../config/brand';

const pageTitle = "Spirulina Side Effects in Marathi: स्पिरुलिनाचे दुष्परिणाम, तोटे व नुकसान होतात का? (२०२६ वैज्ञानिक सत्य)";
const pageDescription = "Spirulina Side Effects in Marathi: स्पिरुलिनाचे काही दुष्परिणाम किंवा नुकसान आहे का? जाणून घ्या NABL लॅब रिपोर्ट, लिव्हर व किडनीवरील शास्त्रीय सत्य, योग्य डोस आणि १००% सुरक्षित स्पिरुलिना.";
const pageUrl = "https://www.sujatanutrilive.com/learn/spirulina-side-effects-in-marathi";
const ogImage = "/products/sujata-spirulina-capsules-bottle-transparent.png";

const faqs = [
  {
    question: "स्पिरुलिना खाल्ल्याने वजन वाढते की कमी होते?",
    answer: "स्पिरुलिना चयापचय (Metabolism) गतिमान करते. जेवणाच्या ३० मिनिटे आधी कोमट पाण्यासोबत २ कॅप्सूल्स घेतल्यास यातील नैसर्गिक प्रथिने भूक संतुलित ठेवतात आणि वजन कमी करण्यास मदत करतात."
  },
  {
    question: "थायरॉईड आणि मधुमेहाचे रुग्ण स्पिरुलिना घेऊ शकतात का?",
    answer: "होय, १००% सुरक्षित आहे. स्पिरुलिना रक्तातील इन्सुलिन संवेदनशीलता सुधारण्यास मदत करते. फक्त नेहमीच्या ॲलोपॅथी औषधांमध्ये आणि स्पिरुलिनामध्ये १ तासाचे अंतर ठेवावे."
  },
  {
    question: "महिलांसाठी आणि मासिक पाळीतील त्रासात हे उपयुक्त आहे का?",
    answer: "अत्यंत उपयुक्त आहे! सुजाता स्पिरुलिनामध्ये २९०.८९ mg/kg नैसर्गिक वनस्पती लोह (Bio-available Iron) असते. यामुळे ॲनिमिया दूर होतो, मासिक पाळीतील तीव्र थकवा कमी होतो आणि केस गळती थांबते."
  },
  {
    question: "स्पिरुलिना सलग किती महिने खावे? मधे खंड पाडावा का?",
    answer: "शरीराचे पेशीय पोषण (Cellular Nutrition) पूर्ण होण्यासाठी सलग ३ महिने (९० दिवस) घेणे आदर्श मानले जाते. त्यानंतर १५ दिवसांचा नैसर्गिक ब्रेक देऊन पुन्हा सुरू करू शकता."
  },
  {
    question: "सुजाता स्पिरुलिनाचा NABL लॅब रिपोर्ट कुठे तपासता येईल?",
    answer: "सुजाता न्यूट्रीलाइव्ह पारदर्शकतेला सर्वोच्च प्राधान्य देते. आमच्या संकेतस्थळावर /science या पानावर NABL प्रयोगशाळेचा अधिकृत अहवाल (IS 7219 प्रमाणित ६२.३९% प्रथिने व ०.००% जड धातू) सार्वजनिकरीत्या उपलब्ध आहे."
  },
  {
    question: "दुष्परिणाम टाळण्यासाठी सर्वात सोपी खबरदारी कोणती?",
    answer: "फक्त दोन साधे नियम पाळा: १) उघड्या तलावातील स्वस्त स्पिरुलिना टाळून नेहमी बंद हायड्रो-डोम्समध्ये पिकवलेले लॅब-प्रमाणित स्पिरुलिनाच घ्या. २) रोज २.५ ते ३ लिटर पाणी प्या."
  }
];

const extraSchema = [
  {
    "@type": "Article",
    "@id": `${pageUrl}/#article`,
    "headline": pageTitle,
    "description": pageDescription,
    "image": `https://www.sujatanutrilive.com${ogImage}`,
    "inLanguage": "mr-IN",
    "mainEntityOfPage": pageUrl,
    "datePublished": "2026-02-10T09:00:00+05:30",
    "dateModified": "2026-11-13T17:20:00+05:30",
    "author": {
      "@type": "Organization",
      "name": "Sujata Nutrilive Clinical Nutrition Team",
      "url": "https://www.sujatanutrilive.com"
    },
    "publisher": {
      "@type": "Organization",
      "name": "Sujata Nutrilive",
      "logo": {
        "@type": "ImageObject",
        "url": "https://www.sujatanutrilive.com/sujata-logo-transparent.png"
      }
    }
  },
  {
    "@type": "FAQPage",
    "@id": `${pageUrl}/#faq`,
    "mainEntity": faqs.map(faq => ({
      "@type": "Question",
      "name": faq.question,
      "acceptedAnswer": {
        "@type": "Answer",
        "text": faq.answer
      }
    }))
  },
  {
    "@type": "Product",
    "@id": "https://www.sujatanutrilive.com/product/sujata-spirulina-capsules/#product",
    "name": "Sujata Nutrilive Pure Vegan Spirulina Capsules (500mg - 60 Caps)",
    "image": `https://www.sujatanutrilive.com${ogImage}`,
    "description": "NABL Lab Tested Hydro-dome cultivated Pure Spirulina with 62.39% protein and 0.00% Heavy Metals. FSSAI Reg: #21526027000179.",
    "brand": {
      "@type": "Brand",
      "name": "Sujata Nutrilive"
    },
    "aggregateRating": {
      "@type": "AggregateRating",
      "ratingValue": "4.9",
      "reviewCount": "487"
    },
    "offers": {
      "@type": "Offer",
      "priceCurrency": "INR",
      "price": "499.00",
      "availability": "https://schema.org/InStock",
      "url": "https://www.sujatanutrilive.com/product/sujata-spirulina-capsules"
    }
  }
];
---

<StoreLayout 
  title={pageTitle} 
  description={pageDescription} 
  image={ogImage}
  extraSchema={extraSchema}
>
  <StoreHeader />

  <!-- ========================================================================= -->
  <!-- EDITORIAL HERO HEADER (Deep Obsidian Luxury Canvas)                       -->
  <!-- ========================================================================= -->
  <header class="relative pt-32 sm:pt-40 pb-16 bg-[#030906] text-white border-b border-emerald-950/60 overflow-hidden">
    <!-- Subtle Background Ambient Glow -->
    <div class="absolute top-1/4 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[350px] bg-emerald-500/10 rounded-full blur-[120px] pointer-events-none"></div>

    <div class="max-w-4xl mx-auto px-4 sm:px-6 relative z-10">
      
      <!-- Elegant Breadcrumb -->
      <nav class="flex items-center gap-2 text-xs text-gray-400 mb-6 font-medium tracking-wide" aria-label="Breadcrumb">
        <a href="/" class="hover:text-emerald-400 transition-colors">होम</a>
        <span class="text-gray-600">/</span>
        <a href="/science" class="hover:text-emerald-400 transition-colors">क्लिनिकल सायन्स</a>
        <span class="text-gray-600">/</span>
        <span class="text-gray-200">स्पिरुलिना दुष्परिणाम व सत्य</span>
      </nav>

      <!-- Category Eyebrow Badge -->
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-emerald-950/80 border border-emerald-500/30 text-emerald-300 text-xs font-semibold tracking-wider uppercase mb-5">
        <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
        <span>क्लिनिकल न्यूट्रिशन अहवाल • २०२६ एडिशन</span>
      </div>

      <!-- Main Headline: Serif Editorial Luxury -->
      <h1 class="text-2xl sm:text-4xl lg:text-5xl font-serif font-black tracking-tight text-[#F9FAFB] leading-[1.2] mb-5">
        Spirulina Side Effects in Marathi: <br class="hidden sm:block"/>
        <span class="text-amber-400 italic font-serif">स्पिरुलिनाचे दुष्परिणाम, तोटे व नुकसान होतात का?</span>
      </h1>

      <!-- Subtitle -->
      <p class="text-gray-300 text-sm sm:text-base leading-relaxed max-w-2xl font-sans mb-8">
        लिव्हर, किडनी आणि पचनसंस्थेवर स्पिरुलिनाचा नेमका काय परिणाम होतो? PubMed व NIH च्या आंतरराष्ट्रीय संशोधनावर आधारित वैज्ञानिक सत्य, प्रयोगशाळा चाचणी आणि सुरक्षिततेची खात्री.
      </p>

      <!-- Unified Clinical Verdict Card (Frosted Glassmorphism - Calm & Authoritative) -->
      <div class="bg-[#081710]/90 border border-emerald-500/30 rounded-2xl p-6 sm:p-8 shadow-2xl backdrop-blur-md relative overflow-hidden">
        
        <div class="flex items-center justify-between gap-4 mb-4 pb-4 border-b border-emerald-950">
          <div class="flex items-center gap-2 text-emerald-300 font-bold text-xs sm:text-sm tracking-wide">
            <span class="w-5 h-5 rounded-full bg-emerald-500/20 text-emerald-400 flex items-center justify-center text-xs font-black">✓</span>
            <span>वैद्यकीय निष्कर्ष (Scientific Verdict)</span>
          </div>
          <span class="text-[11px] text-gray-400 font-medium">WHO & NABL Verified</span>
        </div>

        <p class="text-base sm:text-lg text-white font-medium leading-relaxed mb-5">
          <strong>१००% शुद्ध स्पिरुलिनाचे कोणतेही घातक दुष्परिणाम किंवा शरीराला नुकसान नसते.</strong> जागतिक आरोग्य संघटना (WHO) ने याला मानवासाठी सर्वोत्तम नैसर्गिक आहार मानले आहे. मात्र, माहितीअभावी निर्माण होणाऱ्या शंकांचे वस्तुनिष्ठ सत्य खालीलप्रमाणे आहे:
        </p>

        <!-- Clean 3-Point Editorial Breakdown -->
        <div class="grid grid-cols-1 md:grid-cols-3 gap-4 text-xs sm:text-sm pt-2">
          
          <div class="p-4 rounded-xl bg-black/40 border border-white/5 flex flex-col justify-between">
            <div>
              <span class="text-emerald-400 font-bold text-xs tracking-wider uppercase block mb-1">१. वैज्ञानिक सत्य</span>
              <p class="text-gray-300 leading-relaxed text-xs">
                शुद्ध स्पिरुलिना हिमोग्लोबिन, पेशीय ऊर्जा आणि रोगप्रतिकारशक्ती वाढवण्यासाठी पूर्णपणे सुरक्षित आहे.
              </p>
            </div>
          </div>

          <div class="p-4 rounded-xl bg-black/40 border border-white/5 flex flex-col justify-between">
            <div>
              <span class="text-amber-400 font-bold text-xs tracking-wider uppercase block mb-1">२. नैसर्गिक बदल</span>
              <p class="text-gray-300 leading-relaxed text-xs">
                सुरुवातीच्या ३-४ दिवसांत शरीर डिटॉक्स होताना मल किंचित हिरवा दिसणे ही सामान्य प्रक्रिया आहे, दुष्परिणाम नाही.
              </p>
            </div>
          </div>

          <div class="p-4 rounded-xl bg-black/40 border border-white/5 flex flex-col justify-between">
            <div>
              <span class="text-emerald-300 font-bold text-xs tracking-wider uppercase block mb-1">३. खरा धोका कुठे?</span>
              <p class="text-gray-300 leading-relaxed text-xs">
                केवळ अस्वच्छ उघड्या तलावातील निकृष्ट शेवाळात जड धातूंची भेसळ असू शकते. सुजाता स्पिरुलिना हे ०.००% जड धातूमुक्त प्रमाणित आहे.
              </p>
            </div>
          </div>

        </div>

      </div>

      <!-- Trust Pillars Line -->
      <div class="flex flex-wrap items-center gap-y-2 gap-x-4 mt-8 pt-6 border-t border-white/10 text-xs text-gray-400">
        <span class="flex items-center gap-1.5"><span class="text-emerald-400">✓</span> FSSAI अधिकृत (#21526027000179)</span>
        <span class="text-gray-700 hidden sm:inline">•</span>
        <span class="flex items-center gap-1.5"><span class="text-emerald-400">✓</span> NABL लॅब टेस्टेड (IS 7219)</span>
        <span class="text-gray-700 hidden sm:inline">•</span>
        <span class="flex items-center gap-1.5"><span class="text-emerald-400">✓</span> ०.००% लेड व मर्क्युरी</span>
        <span class="text-gray-700 hidden sm:inline">•</span>
        <span class="flex items-center gap-1.5"><span class="text-emerald-400">✓</span> १००% शून्य केमिकल बाईंडर</span>
      </div>

    </div>
  </header>

  <!-- ========================================================================= -->
  <!-- MAIN ARTICLE BODY (Editorial Obsidian Flow with Generous Spacing)         -->
  <!-- ========================================================================= -->
  <main class="bg-[#030906] text-gray-300 py-16 px-4 sm:px-6 font-sans">
    <div class="max-w-4xl mx-auto space-y-16">
      
      <!-- ========================================================================= -->
      <!-- SECTION 1: Scientific Reality (Liver, Kidneys & Microcystins)              -->
      <!-- ========================================================================= -->
      <article class="bg-[#08140E] border border-emerald-500/20 rounded-2xl p-6 sm:p-10 shadow-xl">
        
        <div class="flex items-center gap-3 mb-3">
          <span class="text-xs font-bold text-amber-400 tracking-widest uppercase bg-amber-400/10 px-2.5 py-1 rounded border border-amber-400/20">विभाग १</span>
          <span class="text-xs text-gray-500">वैद्यकीय संशोधन</span>
        </div>

        <h2 class="text-xl sm:text-2xl lg:text-3xl font-serif font-bold text-[#F9FAFB] tracking-tight mb-4">
          शास्त्रीय सत्य: स्पिरुलिनामुळे लिव्हर किंवा किडनीचे नुकसान होते का?
        </h2>

        <p class="text-sm sm:text-base leading-relaxed text-gray-300 mb-6">
          PubMed आणि National Institutes of Health (NIH) च्या अधिकृत क्लिनिकल संशोधनानुसार, <strong class="text-white">शुद्ध स्पिरुलिनामुळे निरोगी लिव्हर किंवा किडनीचे कोणतेही नुकसान होत नाही.</strong> उलट, स्पिरुलिनामधील सक्रिय घटक <strong class="text-emerald-400">C-Phycocyanin (सी-फायकोसायनिन)</strong> हा शक्तिशाली ॲन्टीऑक्सिडंट फॅटी लिव्हरच्या पेशींचे रक्षण करतो आणि शरीरातील विषारी घटक बाहेर टाकण्यास मदत करतो.
        </p>

        <!-- Subtle Editorial Note on Contamination -->
        <div class="my-6 p-5 bg-black/40 border-l-2 border-emerald-500 rounded-r-xl">
          <h3 class="text-sm sm:text-base font-bold text-white mb-2">
            मग बाजारात स्पिरुलिनाचे दुष्परिणाम का ऐकायला मिळतात?
          </h3>
          <p class="text-xs sm:text-sm text-gray-300 leading-relaxed">
            दुष्परिणाम स्पिरुलिना वनस्पतीमुळे होत नाहीत, तर ते <strong class="text-white">पिकवण्याच्या निकृष्ट पद्धतीमुळे</strong> होतात. जेव्हा उघड्या तलावात किंवा औद्योगिक सांडपाण्याजवळ स्पिरुलिना पिकवले जाते, तेव्हा त्यात <strong class="text-amber-300">'मायक्रोसस्टिन' (Cyanotoxins)</strong> आणि <strong class="text-amber-300">शिसे (Lead), पारा (Mercury)</strong> हे जड धातू शोषले जातात. अशी भेसळयुक्त पावडर खाल्ल्याने पोटदुखी आणि पचनावर ताण येतो.
          </p>
        </div>

        <!-- Sleek Editorial Comparison Table -->
        <div class="mt-8">
          <h3 class="text-base sm:text-lg font-bold text-white mb-4">
            तुलना: सामान्य बाजारू स्पिरुलिना वि. सुजाता हायड्रो-डोम स्पिरुलिना
          </h3>

          <div class="overflow-x-auto rounded-xl border border-emerald-950 shadow-inner">
            <table class="w-full text-left text-xs sm:text-sm border-collapse">
              <thead>
                <tr class="border-b border-emerald-900/80 bg-black/60 text-gray-300">
                  <th class="py-4 px-5 font-semibold">तपासणी निकष</th>
                  <th class="py-4 px-5 text-gray-400 font-medium">बाजारातील सामान्य स्पिरुलिना</th>
                  <th class="py-4 px-5 text-emerald-300 font-bold bg-emerald-950/40">सुजाता स्पिरुलिना (NABL लॅब)</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-emerald-950/80 text-gray-300">
                <tr class="hover:bg-emerald-950/10 transition-colors">
                  <td class="py-4 px-5 font-medium text-white">पिकवण्याचे वातावरण</td>
                  <td class="py-4 px-5 text-gray-400">उघडे तलाव (धुळीचा व सांडपाण्याचा धोका)</td>
                  <td class="py-4 px-5 font-semibold text-emerald-300 bg-emerald-950/20">१००% बंद हायड्रो-डोम्स (RO शुद्ध पाणी)</td>
                </tr>
                <tr class="hover:bg-emerald-950/10 transition-colors">
                  <td class="py-4 px-5 font-medium text-white">जड धातू (Lead व Mercury)</td>
                  <td class="py-4 px-5 text-gray-400">अनियंत्रित (किडनीसाठी धोकादायक)</td>
                  <td class="py-4 px-5 font-bold text-amber-400 bg-emerald-950/20">०.००% (NABL लॅब रिपोर्ट प्रमाणित)</td>
                </tr>
                <tr class="hover:bg-emerald-950/10 transition-colors">
                  <td class="py-4 px-5 font-medium text-white">प्रथिनांचे प्रमाण (Protein)</td>
                  <td class="py-4 px-5 text-gray-400">४०% ते ५०% (कमी पोषण)</td>
                  <td class="py-4 px-5 font-semibold text-emerald-300 bg-emerald-950/20">६२.३९% शुद्ध वनस्पती प्रथिने (IS 7219)</td>
                </tr>
                <tr class="hover:bg-emerald-950/10 transition-colors">
                  <td class="py-4 px-5 font-medium text-white">केमिकल बाईंडर्स व वास</td>
                  <td class="py-4 px-5 text-gray-400">गोळी घट्ट करण्यासाठी केमिकल डिंक</td>
                  <td class="py-4 px-5 font-semibold text-emerald-300 bg-emerald-950/20">शून्य केमिकल बाईंडर (Zero Binders)</td>
                </tr>
              </tbody>
            </table>
          </div>
          <p class="text-[11px] text-gray-500 mt-2.5">
            *संदर्भ: NABL मान्यताप्राप्त अधिकृत चाचणी पद्धती IS 7219 आणि NIH पबमेड क्लिनिकल रिव्ह्यू २०२६.
          </p>
        </div>

      </article>

      <!-- ========================================================================= -->
      <!-- SECTION 2: Who Should NOT Take Spirulina? (Reassuring Medical Advice)     -->
