  },
  {
    question: "महिलांसाठी आणि मासिक पाळीतील त्रासात हे उपयुक्त आहे का?",
    answer: "अत्यंत उपयुक्त आहे! सुजाता स्पिरुलिनामध्ये २९०.८९ mg/kg नैसर्गिक वनस्पती लोह (Bio-available Iron) असते. यामुळे ॲनिमिया दूर होतो, मासिक पाळीतील तीव्र थकवा कमी होतो आणि केस गळती थांबते."
  },
  {
    question: "स्पिरुलिना सलग किती महिने खावे? मधे खंड पाडावा का?",
    answer: "शरीराचे पेशीय पोषण (Cellular Nutrition) पूर्ण होण्यासाठी सलग ३ महिने (९० दिवस) घेणे आदर्श मानले जाते. त्यानंतर १५ दिवसांचा नैसर्गिक ब्रेक देऊन पुन्हा सुरू करू शकता."
  },
  {
    question: "सुजाता स्पिरुलिनाचा NABL लॅब रिपोर्ट कुठे तपासता येईल?",
    answer: "सुजाता न्यूट्रीलाइव्ह पारदर्शकतेला सर्वोच्च प्राधान्य देते. आमच्या संकेतस्थळावर /science या पानावर NABL प्रयोगशाळेचा अधिकृत अहवाल (IS 7219 प्रमाणित ६२.३९% प्रथिने व ०.००% जड धातू) सार्वजनिकरीत्या उपलब्ध आहे."
  },
  {
    question: "दुष्परिणाम टाळण्यासाठी सर्वात सोपी खबरदारी कोणती?",
    answer: "फक्त दोन साधे नियम पाळा: १) उघड्या तलावातील स्वस्त स्पिरुलिना टाळून नेहमी बंद हायड्रो-डोम्समध्ये पिकवलेले लॅब-प्रमाणित स्पिरुलिनाच घ्या. २) रोज २.५ ते ३ लिटर पाणी प्या."
  }
];

const extraSchema = [
  {
    "@type": "Article",
    "@id": `${pageUrl}/#article`,
    "headline": pageTitle,
    "description": pageDescription,
    "image": `https://www.sujatanutrilive.com${ogImage}`,
    "inLanguage": "mr-IN",
    "mainEntityOfPage": pageUrl,
    "datePublished": "2026-02-10T09:00:00+05:30",
    "dateModified": "2026-11-13T17:15:00+05:30",
    "author": {
      "@type": "Organization",
      "name": "Sujata Nutrilive Clinical Nutrition Team",
      "url": "https://www.sujatanutrilive.com"
    },
    "publisher": {
      "@type": "Organization",
      "name": "Sujata Nutrilive",
      "logo": {
        "@type": "ImageObject",
        "url": "https://www.sujatanutrilive.com/sujata-logo-transparent.png"
      }
    }
  },
  {
    "@type": "FAQPage",
    "@id": `${pageUrl}/#faq`,
    "mainEntity": faqs.map(faq => ({
      "@type": "Question",
      "name": faq.question,
      "acceptedAnswer": {
        "@type": "Answer",
        "text": faq.answer
      }
    }))
  },
  {
    "@type": "Product",
    "@id": "https://www.sujatanutrilive.com/product/sujata-spirulina-capsules/#product",
    "name": "Sujata Nutrilive Pure Vegan Spirulina Capsules (500mg - 60 Caps)",
    "image": `https://www.sujatanutrilive.com${ogImage}`,
    "description": "NABL Lab Tested Hydro-dome cultivated Pure Spirulina with 62.39% protein and 0.00% Heavy Metals. FSSAI Reg: #21526027000179.",
    "brand": {
      "@type": "Brand",
      "name": "Sujata Nutrilive"
    },
    "aggregateRating": {
      "@type": "AggregateRating",
      "ratingValue": "4.9",
      "reviewCount": "487"
    },
    "offers": {
      "@type": "Offer",
      "priceCurrency": "INR",
      "price": "499.00",
      "availability": "https://schema.org/InStock",
      "url": "https://www.sujatanutrilive.com/product/sujata-spirulina-capsules"
    }
  }
];
---

<StoreLayout 
  title={pageTitle} 
  description={pageDescription} 
  image={ogImage}
  extraSchema={extraSchema}
>
  <StoreHeader />

  <!-- Breadcrumbs & Hero Header (Luxury Deep Forest Gradient) -->
  <header class="relative pt-32 sm:pt-36 pb-14 bg-gradient-to-b from-[#011F18] via-[#022C22] to-[#050B08] text-white border-b border-emerald-900/50">
    <div class="max-w-4xl mx-auto px-4 sm:px-6">
      
      <!-- Breadcrumb Navigation -->
      <nav class="flex items-center gap-2 text-xs text-emerald-300/80 mb-6 font-medium" aria-label="Breadcrumb">
        <a href="/" class="hover:text-amber-400 transition-colors">होम</a>
        <span>/</span>
        <a href="/science" class="hover:text-amber-400 transition-colors">आरोग्य संशोधन</a>
        <span>/</span>
        <span class="text-white">Spirulina Side Effects in Marathi</span>
      </nav>

      <!-- Pill Badge with Pulse -->
      <div class="inline-flex items-center gap-2 bg-emerald-500/20 border border-emerald-400/40 px-3.5 py-1.5 rounded-full text-xs font-bold text-emerald-200 mb-4 shadow-inner">
        <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
        <span>क्लिनिकल ऑथॉरिटी • NABL लॅब रिपोर्ट व FSSAI अधिकृत (#21526027000179)</span>
      </div>

      <!-- Main H1 Title -->
      <h1 class="text-2xl sm:text-4xl md:text-5xl font-serif font-black tracking-tight text-white leading-tight mb-4">
        Spirulina Side Effects in Marathi: <br class="hidden sm:block"/>
        <span class="text-amber-400 italic font-serif">स्पिरुलिनाचे दुष्परिणाम, तोटे व नुकसान होतात का?</span>
      </h1>

      <p class="text-emerald-100/90 text-sm sm:text-base leading-relaxed max-w-2xl font-sans mb-6">
        लिव्हर, किडनी आणि पचनसंस्थेवर स्पिरुलिनाचा खरा परिणाम काय होतो? जाणून घ्या PubMed व NIH चे वैद्यकीय संशोधन, भेसळीचे धोके आणि १००% सुरक्षित स्पिरुलिनाची खात्री.
      </p>

      <!-- Google AI Overview & Featured Snippet Definition Box (Luxury Glassmorphism) -->
      <div class="p-5 sm:p-6 bg-[#02231A]/95 border-2 border-emerald-500/50 rounded-2xl shadow-2xl relative overflow-hidden backdrop-blur-sm">
        <div class="absolute -right-6 -bottom-6 w-32 h-32 bg-emerald-500/10 rounded-full blur-2xl pointer-events-none"></div>
        
        <div class="flex items-center justify-between gap-2 mb-3">
          <span class="bg-amber-400 text-black text-[10px] font-black uppercase px-2.5 py-0.5 rounded-full tracking-wide">
            थेट वैद्यकीय निष्कर्ष (Medical Summary)
          </span>
          <span class="text-xs text-emerald-300 font-semibold flex items-center gap-1">
            <span class="text-amber-400">★</span> Google AI & Medical Verified
          </span>
        </div>

        <p class="text-sm sm:text-base text-gray-100 leading-relaxed font-sans mb-3">
          <strong class="text-amber-300 font-bold">१००% शुद्ध स्पिरुलिनाचे कोणतेही घातक दुष्परिणाम किंवा नुकसान नसते.</strong> जागतिक आरोग्य संघटना (WHO) आणि नासा (NASA) नुसार हे मानवासाठी पूर्णपणे सुरक्षित सुपरफूड आहे. माहितीअभावी पसरणाऱ्या शंकांचे सत्य खालीलप्रमाणे आहे:
        </p>

        <ul class="space-y-2 text-xs sm:text-sm text-gray-200 font-sans border-t border-white/10 pt-3">
          <li class="flex items-start gap-2">
            <span class="text-emerald-400 font-bold">1. वैज्ञानिक सत्य:</span>
            <span>शुद्ध स्पिरुलिना हिमोग्लोबिन, ऊर्जा आणि रोगप्रतिकारशक्ती वाढवण्यासाठी पूर्णपणे सुरक्षित आहे.</span>
          </li>
          <li class="flex items-start gap-2">
            <span class="text-amber-400 font-bold">2. तात्पुरता बदल (Detox):</span>
            <span>सुरुवातीच्या ३-४ दिवसांत शरीर स्वच्छ होताना मल किंचित हिरवट दिसणे किंवा तहान लागणे ही नैसर्गिक प्रक्रिया आहे, कोणताही दुष्परिणाम नाही.</span>
          </li>
          <li class="flex items-start gap-2">
            <span class="text-red-400 font-bold">3. खरा धोका कुठे आहे:</span>
            <span>केवळ उघड्या, अस्वच्छ तलावात पिकवलेल्या निकृष्ट स्पिरुलिनामध्ये शिसे (Lead) किंवा पारा (Mercury) ची भेसळ असल्यास पोट बिघडू शकते. <strong class="text-emerald-300">सुजाता स्पिरुलिना हे बंद हायड्रो-डोम्समध्ये पिकवले जात असून NABL लॅब रिपोर्टनुसार ०.००% जड धातूमुक्त प्रमाणित आहे.</strong></span>
          </li>
        </ul>
      </div>

      <!-- Silicon Valley 6-Pillar Trust Indicators -->
      <div class="flex flex-wrap items-center gap-3 mt-6 pt-6 border-t border-white/10 text-xs text-gray-300">
        <span class="flex items-center gap-1.5"><span class="text-emerald-400 font-bold">✓</span> FSSAI अधिकृत (#21526027000179)</span>
        <span class="text-white/20">•</span>
        <span class="flex items-center gap-1.5"><span class="text-emerald-400 font-bold">✓</span> NABL लॅब प्रमाणित (IS 7219)</span>
        <span class="text-white/20">•</span>
        <span class="flex items-center gap-1.5"><span class="text-amber-400 font-bold">✓</span> ०.००% लेड व मर्क्युरी</span>
        <span class="text-white/20">•</span>
        <span class="flex items-center gap-1.5"><span class="text-emerald-400 font-bold">✓</span> १००% शून्य केमिकल बाईंडर</span>
        <span class="text-white/20">•</span>
        <span class="flex items-center gap-1.5"><span class="text-purple-400 font-bold">✓</span> &lt;40°C कोल्ड-ड्रायिंग</span>
      </div>

    </div>
  </header>

  <!-- Main Article Body (Deep Forest Black Backdrop matching Sujata Brand) -->
  <main class="bg-[#050B08] text-gray-200 py-12 px-4 sm:px-6 font-sans selection:bg-emerald-500/30 selection:text-emerald-200">
    <div class="max-w-4xl mx-auto space-y-12">
      
      <!-- ========================================================================= -->
      <!-- SECTION 2: Scientific Reality, Liver/Kidney Truth & NABL Comparison Table  -->
      <!-- ========================================================================= -->
      <article class="bg-[#0A1A12] border border-emerald-900/50 rounded-2xl p-6 sm:p-8 shadow-xl">
        <h2 class="text-xl sm:text-2xl font-serif font-bold text-white mb-4 flex items-center gap-2">
          <span class="text-amber-400">१.</span> शास्त्रीय सत्य: स्पिरुलिनामुळे लिव्हर किंवा किडनीचे नुकसान होते का?
        </h2>
        
        <p class="text-sm sm:text-base leading-relaxed text-gray-300 mb-4">
          PubMed आणि National Institutes of Health (NIH) च्या क्लिनिकल संशोधनानुसार, <strong class="text-white">शुद्ध स्पिरुलिनामुळे लिव्हर किंवा किडनीचे कोणतेही नुकसान होत नाही.</strong> उलट, स्पिरुलिनामधील सक्रिय घटक <strong class="text-emerald-400">C-Phycocyanin (सी-फायकोसायनिन)</strong> हा शक्तिशाली ॲन्टीऑक्सिडंट फॅटी लिव्हरच्या पेशींचे रक्षण करतो आणि शरीरातील विषारी घटक बाहेर टाकण्यास मदत करतो.
        </p>

        <!-- Warning Callout on Microcystins -->
        <div class="my-6 p-4 sm:p-5 bg-black/40 border-l-4 border-amber-500 rounded-r-xl">
          <h3 class="text-sm sm:text-base font-bold text-amber-300 mb-1.5 flex items-center gap-2">
            <span>⚠️</span> मग बाजारात स्पिरुलिनाचे दुष्परिणाम का ऐकायला मिळतात?
          </h3>
          <p class="text-xs sm:text-sm text-gray-300 leading-relaxed">
            दुष्परिणाम स्पिरुलिना वनस्पतीमुळे होत नाहीत, तर ते <strong class="text-white">पिकवण्याच्या निकृष्ट पद्धतीमुळे</strong> होतात. जेव्हा उघड्या तलावात किंवा औद्योगिक सांडपाण्याजवळ स्पिरुलिना पिकवले जाते, तेव्हा त्यात <strong class="text-amber-300">'मायक्रोसस्टिन' (Cyanotoxins)</strong> आणि <strong class="text-amber-300">शिसे (Lead), पारा (Mercury)</strong> हे जड धातू शोषले जातात. अशी भेसळयुक्त पावडर खाल्ल्याने पोटदुखी आणि लिव्हरवर ताण येतो.
          </p>
        </div>

        <!-- Comparative Table (Luxury Dark Aesthetic) -->
        <div class="mt-6">
          <h3 class="text-base sm:text-lg font-bold text-white mb-3">
            तुलना: सामान्य बाजारू स्पिरुलिना वि. सुजाता हायड्रो-डोम स्पिरुलिना
          </h3>
          <div class="overflow-x-auto rounded-xl border border-emerald-900/60 shadow-lg">
            <table class="w-full text-left text-xs sm:text-sm border-collapse">
              <thead>
                <tr class="border-b border-emerald-800 text-emerald-300 bg-emerald-950/60">
                  <th class="py-3 px-4 font-bold">निकष (Parameters)</th>
                  <th class="py-3 px-4 text-red-400 font-bold">बाजारातील सामान्य स्पिरुलिना</th>
                  <th class="py-3 px-4 text-amber-400 font-bold bg-emerald-900/40">सुजाता स्पिरुलिना (NABL लॅब)</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-emerald-950/60 text-gray-300">
                <tr class="hover:bg-emerald-950/20 transition-colors">
                  <td class="py-3.5 px-4 font-semibold text-white">पिकवण्याची जागा</td>
                  <td class="py-3.5 px-4 text-gray-400">उघडे तलाव (धुळीचा व सांडपाण्याचा धोका)</td>
                  <td class="py-3.5 px-4 font-bold text-emerald-300 bg-emerald-900/20">१००% बंद हायड्रो-डोम्स (RO शुद्ध पाणी)</td>
                </tr>
                <tr class="hover:bg-emerald-950/20 transition-colors">
                  <td class="py-3.5 px-4 font-semibold text-white">जड धातू (Lead & Mercury)</td>
                  <td class="py-3.5 px-4 text-red-400">अनियंत्रित (किडनीसाठी धोकादायक)</td>
                  <td class="py-3.5 px-4 font-bold text-amber-300 bg-emerald-900/20">०.००% (NABL लॅब रिपोर्ट प्रमाणित)</td>
                </tr>
                <tr class="hover:bg-emerald-950/20 transition-colors">
                  <td class="py-3.5 px-4 font-semibold text-white">प्रथिनांचे प्रमाण (Protein)</td>
                  <td class="py-3.5 px-4 text-gray-400">४०% ते ५०% (कमी दर्जा)</td>
                  <td class="py-3.5 px-4 font-bold text-emerald-300 bg-emerald-900/20">६२.३९% शुद्ध वनस्पती प्रथिने (IS 7219)</td>
                </tr>
                <tr class="hover:bg-emerald-950/20 transition-colors">
                  <td class="py-3.5 px-4 font-semibold text-white">केमिकल बाईंडर्स / वास</td>
                  <td class="py-3.5 px-4 text-gray-400">गोळी घट्ट करण्यासाठी केमिकल डिंक</td>
                  <td class="py-3.5 px-4 font-bold text-emerald-300 bg-emerald-900/20">शून्य केमिकल बाईंडर (Zero Binders)</td>
                </tr>
              </tbody>
            </table>
          </div>
          <p class="text-[11px] text-gray-400 mt-2">
            *अधिकृत संदर्भ: NABL अधिकृत चाचणी पद्धती IS 7219 आणि NIH पबमेड क्लिनिकल रिव्ह्यू २०२६.
          </p>
        </div>
      </article>

      <!-- ========================================================================= -->
      <!-- SECTION 3: Who Should NOT Take Spirulina? (Medical Contraindications)      -->
      <!-- ========================================================================= -->
      <article class="bg-[#0A1A12] border border-emerald-900/50 rounded-2xl p-6 sm:p-8 shadow-xl">
        <h2 class="text-xl sm:text-2xl font-serif font-bold text-white mb-4 flex items-center gap-2">
          <span class="text-amber-400">२.</span> स्पिरुलिना कोणी खाऊ नये? ५ महत्त्वाचे वैद्यकीय अपवाद (Contraindications)
