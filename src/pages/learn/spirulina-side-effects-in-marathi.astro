    "description": "NABL Lab Tested Hydro-dome cultivated Pure Spirulina with 62.39% protein and 0.00% Heavy Metals. FSSAI Reg: #21526027000179.",
    "brand": {
      "@type": "Brand",
      "name": "Sujata Nutrilive"
    },
    "aggregateRating": {
      "@type": "AggregateRating",
      "ratingValue": "4.9",
      "reviewCount": "487"
    },
    "offers": {
      "@type": "Offer",
      "priceCurrency": "INR",
      "price": "499.00",
      "availability": "https://schema.org/InStock",
      "url": "https://www.sujatanutrilive.com/product/sujata-spirulina-capsules"
    }
  }
];
---

<StoreLayout 
  title={pageTitle} 
  description={pageDescription} 
  image={ogImage}
  extraSchema={extraSchema}
>
  <StoreHeader />

  <!-- ========================================================================= -->
  <!-- ZONE 1: BRAND HERO (Luxury Forest Green - Seamless Header Blend)          -->
  <!-- ========================================================================= -->
  <header class="relative pt-32 sm:pt-36 pb-12 bg-gradient-to-b from-[#011F18] via-[#022A21] to-[#011A14] text-white border-b border-emerald-900/60">
    <div class="max-w-3xl mx-auto px-4 sm:px-6">
      
      <!-- Breadcrumb -->
      <nav class="flex items-center gap-2 text-xs text-emerald-300/80 mb-5 font-medium tracking-wide" aria-label="Breadcrumb">
        <a href="/" class="hover:text-amber-400 transition-colors">होम</a>
        <span class="text-emerald-700">/</span>
        <a href="/science" class="hover:text-amber-400 transition-colors">वैज्ञानिक संशोधन</a>
        <span class="text-emerald-700">/</span>
        <span class="text-white font-medium">स्पिरुलिना दुष्परिणाम</span>
      </nav>

      <!-- Category Eyebrow Pill -->
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-emerald-500/20 border border-emerald-400/30 text-emerald-200 text-xs font-semibold tracking-wider uppercase mb-4 shadow-sm">
        <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
        <span>क्लिनिकल न्यूट्रिशन अहवाल • २०२६ एडिशन</span>
      </div>

      <!-- Main Headline: Balanced Mobile Clamp -->
      <h1 class="text-2xl sm:text-3xl md:text-4xl font-serif font-bold text-white tracking-tight leading-snug mb-4">
        Spirulina Side Effects in Marathi: <br />
        <span class="text-amber-400 font-serif italic">स्पिरुलिनाचे दुष्परिणाम, तोटे व नुकसान होतात का?</span>
      </h1>

      <p class="text-emerald-100/90 text-sm sm:text-base leading-relaxed mb-6 font-sans">
        लिव्हर, किडनी आणि पचनावर स्पिरुलिनाचा नेमका काय परिणाम होतो? PubMed व NIH च्या आंतरराष्ट्रीय संशोधनावर आधारित वस्तुनिष्ठ सत्य आणि लॅब रिपोर्ट.
      </p>

      <!-- Immediate Medical Summary Card (AEO Snippet Box) -->
      <div class="p-5 sm:p-6 bg-[#03231A]/95 border border-emerald-400/40 rounded-2xl shadow-xl backdrop-blur-sm">
        <div class="flex items-center justify-between gap-2 mb-3 pb-2 border-b border-emerald-900/60">
          <span class="text-xs font-bold text-emerald-300 uppercase tracking-wide flex items-center gap-1.5">
            <span class="text-amber-400">✓</span> थेट वैद्यकीय निष्कर्ष (Summary)
          </span>
          <span class="text-[11px] text-emerald-400 font-semibold bg-emerald-950/80 px-2.5 py-0.5 rounded-full border border-emerald-700">
            WHO & NABL Verified
          </span>
        </div>

        <p class="text-sm sm:text-base text-white font-medium leading-relaxed mb-3">
          <strong>१००% शुद्ध स्पिरुलिनाचे कोणतेही घातक दुष्परिणाम किंवा नुकसान नसते.</strong> जागतिक आरोग्य संघटना (WHO) ने याला मानवासाठी सर्वोत्तम नैसर्गिक आहार मानले आहे.
        </p>

        <ul class="space-y-2 text-xs sm:text-sm text-emerald-100/90 pt-1">
          <li class="flex items-start gap-2">
            <span class="text-amber-400 font-bold shrink-0">•</span>
            <span><strong>सत्य:</strong> शुद्ध स्पिरुलिना हिमोग्लोबिन, ऊर्जा व रोगप्रतिकारशक्तीसाठी पूर्ण सुरक्षित आहे.</span>
          </li>
