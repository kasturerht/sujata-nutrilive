      "name": "Sujata Nutrilive",
      "logo": {
        "@type": "ImageObject",
        "url": "https://www.sujatanutrilive.com/sujata-logo-transparent.png"
      }
    }
  },
  {
    "@type": "FAQPage",
    "@id": `${pageUrl}/#faq`,
    "mainEntity": faqs.map(faq => ({
      "@type": "Question",
      "name": faq.question,
      "acceptedAnswer": {
