---
// src/pages/index.astro

// 🎯 SMART AD CAMPAIGN TRAFFIC ROUTER:
// If visitor clicks the Meta Video Ad for Spirulina + Sea Buckthorn Combo,
// instantly route them directly to the combo product page without breaking Meta Ad status or triggering review!
const utmCampaign = Astro.url.searchParams.get('utm_campaign') || '';
if (utmCampaign.includes('spirulina_seabuckthorn') || utmCampaign.includes('sales_asc_spirulina_seabuckthorn_oct2026')) {
  return Astro.redirect(`/product/sujata-spirulina-sea-buckthorn-combo-pack${Astro.url.search}`, 302);
}

import StoreLayout from '../layouts/StoreLayout.astro';
import StoreHeader from '../components/StoreHeader.astro';
import StoreHero from '../components/StoreHero.astro';
import StoreTrustBadges from '../components/StoreTrustBadges.astro';
import StoreShopHub from '../components/StoreShopHub.astro';
import StoreNutrientMatrix from '../components/StoreNutrientMatrix.astro';
import StoreConviction from '../components/StoreConviction.astro';
import StoreProtocol from '../components/StoreProtocol.astro';
import StoreSocialProof from '../components/StoreSocialProof.astro';
import StoreAuthorityVault from '../components/StoreAuthorityVault.astro';
import StoreFooter from '../components/StoreFooter.astro';
import ExitPopup from '../components/ExitPopup.astro';

// Shopify Credentials
const shopifyDomain = import.meta.env.PUBLIC_SHOPIFY_STOREFRONT_DOMAIN || "tvczdq-nu.myshopify.com"; 
const storefrontToken = import.meta.env.PUBLIC_SHOPIFY_STOREFRONT_TOKEN || "7e0a0176aede63ce4c6b199e18684018"; 

// GraphQL Query for Products Catalog (Fetches exact sequence from Shopify 'Home page' Collection)
const query = `
  {
    collection(handle: "frontpage") {
      id
      title
      products(first: 50) {
        edges {
          node {
            id
            handle
            title
            description
            tags
            availableForSale
            subtitle: metafield(namespace: "custom", key: "subtitle") { value }
            keyBenefit: metafield(namespace: "custom", key: "key_benefit") { value }
            badgeTag: metafield(namespace: "custom", key: "badge") { value }
            badgeTagAlt: metafield(namespace: "custom", key: "badge_tag") { value }
            priceRange {
              minVariantPrice {
                amount
                currencyCode
              }
            }
            variants(first: 10) {
              edges {
                node {
                  id
                  title
                  availableForSale
                  price {
                    amount
                    currencyCode
                  }
                  compareAtPrice {
                    amount
                    currencyCode
                  }
                  selectedOptions {
                    name
                    value
                  }
                }
              }
            }
            images(first: 2) {
              edges {
                node {
                  url
                  altText
                }
              }
            }
          }
        }
      }
    }
    products(first: 50) {
      edges {
        node {
          id
          handle
          title
          description
          tags
          availableForSale
          subtitle: metafield(namespace: "custom", key: "subtitle") { value }
          keyBenefit: metafield(namespace: "custom", key: "key_benefit") { value }
          badgeTag: metafield(namespace: "custom", key: "badge") { value }
          badgeTagAlt: metafield(namespace: "custom", key: "badge_tag") { value }
          priceRange {
            minVariantPrice {
              amount
              currencyCode
            }
          }
          variants(first: 10) {
            edges {
              node {
                id
                title
                availableForSale
                price {
                  amount
                  currencyCode
                }
                compareAtPrice {
                  amount
                  currencyCode
                }
                selectedOptions {
                  name
                  value
                }
              }
            }
          }
          images(first: 2) {
            edges {
              node {
                url
                altText
              }
            }
          }
        }
      }
    }
  }
`;

// Server-side Fetch with safe handling
let products = [];
try {
  if (shopifyDomain && storefrontToken) {
    const response = await fetch(`https://${shopifyDomain}/api/2024-01/graphql.json`, {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
        'X-Shopify-Storefront-Access-Token': storefrontToken,
      },
      body: JSON.stringify({ query }),
    });

    const json = await response.json();
    // Prioritize exact manual sort sequence from 'Home page' (frontpage) collection
    const collectionEdges = json.data?.collection?.products?.edges || [];
    const fallbackEdges = json.data?.products?.edges || [];
    products = collectionEdges.length > 0 ? collectionEdges : fallbackEdges;
  } else {
    console.warn("⚠️ Shopify credentials missing! Please configure PUBLIC_SHOPIFY_STOREFRONT_DOMAIN and PUBLIC_SHOPIFY_STOREFRONT_TOKEN.");
  }
} catch (error) {
  console.error("❌ Failed to fetch products from Shopify:", error);
}
---

<StoreLayout 
  title="Buy Pure Cold-Pressed Spirulina & Himalayan Sea Buckthorn | Sujata Nutrilive"
  description="India's leading cold-pressed Spirulina (62.3% protein, 291 mg/kg natural iron as Fe) & wild Himalayan Sea Buckthorn Capsules (rare Omega-7, 3, 6, 9). 100% vegetarian, laboratory tested, FSSAI certified. Free COD."
  isHomePage={true}
>
  <script is:inline>
    (() => {
      const p = new URLSearchParams(window.location.search);
      const c = p.get('utm_campaign') || '';
      if (c.includes('spirulina_seabuckthorn') || c.includes('sales_asc_spirulina_seabuckthorn_oct2026')) {
        window.location.replace('/product/sujata-spirulina-sea-buckthorn-combo-pack' + window.location.search);
      }
    })();
  </script>
  
  {/* GLOBAL HEADER */}
  <StoreHeader />
  
  {/* 🌟 1. SINGLE HIGH-CONVERTING HERO */}
  <StoreHero products={products} />

  {/* 🛡️ 2. SMART INDIAN TRUST STRIP (FSSAI, NABL, 100% Veg, Free COD) */}
  <StoreTrustBadges />

  {/* 🛍️ 3. CORE BESTSELLERS & CURATED CATALOG (Direct from Shopify API) */}
  <StoreShopHub products={products} />

  {/* ⭐ 4. VERIFIED VIDEO SOCIAL PROOF & CLINICAL TRANSFORMATIONS (Immediate Trust Hook) */}
  <StoreSocialProof />

  {/* 🧬 5. THE TRANSPARENT SERVING & NUTRIENT MATRIX (3g Powder Scoop vs 1g Capsules) */}
  <StoreNutrientMatrix />

  {/* ⚖️ 6. "WHY SUJATA?" PURITY MOAT (Ordinary Spirulina vs Sujata Cryo) */}
  <StoreConviction />

  {/* ⏳ 7. THE 30-DAY BIOLOGICAL PROTOCOL (Smooth, Zero Scroll-Jacking) */}
  <StoreProtocol />

  {/* 🩺 9. CLINICAL GOVERNANCE, FAQS & 40-DAY EVALUATION GUARANTEE VAULT */}
  <StoreAuthorityVault />

  {/* GLOBAL FOOTER & CONVERSION POPUPS */}
  <StoreFooter />
  <ExitPopup />

</StoreLayout>