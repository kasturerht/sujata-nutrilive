---
// src/pages/index.astro
import StoreLayout from '../layouts/StoreLayout.astro';
import StoreHeader from '../components/StoreHeader.astro';
import StoreHero from '../components/StoreHero.astro';
import StoreMedia from '../components/StoreMedia.astro';
import StoreShopHub from '../components/StoreShopHub.astro';
import StoreNutrientMatrix from '../components/StoreNutrientMatrix.astro';
import StoreProtocol from '../components/StoreProtocol.astro';
import StoreSocialProof from '../components/StoreSocialProof.astro';
import StoreAuthorityVault from '../components/StoreAuthorityVault.astro';
import StoreFooter from '../components/StoreFooter.astro';
import ExitPopup from '../components/ExitPopup.astro';

// Shopify Credentials
const shopifyDomain = import.meta.env.PUBLIC_SHOPIFY_STOREFRONT_DOMAIN || "skadas-headless-demo.myshopify.com"; 
const storefrontToken = import.meta.env.PUBLIC_SHOPIFY_STOREFRONT_TOKEN || "32f678c5f8d1345e945ed48713d9cf2f"; 

// GraphQL Query for Products Catalog
const query = `
  {
    products(first: 6) {
      edges {
        node {
          id
          handle
          title
          description
          availableForSale
          priceRange {
            minVariantPrice {
              amount
              currencyCode
            }
          }
          variants(first: 1) {
            edges {
              node {
                id
              }
            }
          }
          images(first: 2) {
            edges {
              node {
                url
                altText
              }
            }
          }
        }
      }
    }
  }
`;

// Server-side Fetch with safe handling
let products = [];
try {
  if (shopifyDomain && storefrontToken) {
    const response = await fetch(`https://${shopifyDomain}/api/2024-01/graphql.json`, {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
        'X-Shopify-Storefront-Access-Token': storefrontToken,
      },
      body: JSON.stringify({ query }),
    });

    const json = await response.json();
    products = json.data?.products?.edges || [];
  } else {
    console.warn("⚠️ Shopify credentials missing! Please configure PUBLIC_SHOPIFY_STOREFRONT_DOMAIN and PUBLIC_SHOPIFY_STOREFRONT_TOKEN.");
  }
} catch (error) {
  console.error("❌ Failed to fetch products from Shopify:", error);
}
---

<StoreLayout title="Sujata Nutrilive | Premium Cold-Pressed Spirulina">
  
  {/* GLOBAL HEADER */}
  <StoreHeader />
  
  {/* 🌟 ZONE 1: THE HOOK & MEDIA AUTHORITY */}
  <StoreHero />
  <StoreMedia />

  {/* 🛍️ ZONE 2: THE UNIFIED SHOP ENGINE (Featured Daily Kit + Segmented Catalog) */}
  <StoreShopHub products={products} />

  {/* 🧬 ZONE 3: NUTRITIONAL BIO-EQUIVALENCY (The 1-Scoop Radial Diagram) */}
  <StoreNutrientMatrix />

  {/* ⏳ ZONE 4: THE 30-DAY TRANSFORMATION PROTOCOL */}
  <StoreProtocol />

  {/* ⭐ ZONE 5: SOCIAL PROOF & VERIFIED REVIEWS */}
  <StoreSocialProof />

  {/* 🛡️ ZONE 6: CLINICAL GOVERNANCE, FAQ & 30-DAY RISK REVERSAL VAULT */}
  <StoreAuthorityVault />

  {/* GLOBAL FOOTER & CONVERSION POPUPS */}
  <StoreFooter />
  <ExitPopup />

</StoreLayout>