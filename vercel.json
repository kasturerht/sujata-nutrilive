      "permanent": true
    },
    {
      "source": "/Organic-Spirulina-Capsules-/catalogue/5JawixhL/sgbMlH3e",
      "destination": "/product/sujata-spirulina-capsules",
      "permanent": true
    },
    {
      "source": "/Organic-Spirulina-Face-Wash--And-Spirulina-Face-Pack-For/catalogue/8gAQ-nPy/viiOiX6M",
      "destination": "/product/sujata-spirulina-facewash",
