{
  "framework": "astro",
  "buildCommand": "npm run build",
  "installCommand": "npm install",
  "regions": ["bom1"],
  "redirects": [
    {
      "source": "/products/sujata-daily-super-immunity-combo",
      "destination": "/product/sujata-spirulina-sea-buckthorn-combo-pack",
      "permanent": true
    },
    {
      "source": "/product/sujata-daily-super-immunity-combo",
      "destination": "/product/sujata-spirulina-sea-buckthorn-combo-pack",
      "permanent": true
    },
    {
      "source": "/products/:slug([^.]+)",
      "destination": "/product/:slug",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(product|learn|science|quiz|contact|track-order|refund-policy|privacy-policy|terms-of-service|shipping-policy)(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=60, s-maxage=300, stale-while-revalidate=600"
        }
      ]
    },
    {
      "source": "/_astro/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/cron/daily-dispatch",
      "schedule": "30 4 * * *"
    }
  ]
}
