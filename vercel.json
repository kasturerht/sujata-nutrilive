    },
    {
      "source": "/SKIN-CARE/collection/:id*",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/AMAZING-DEALS/collection/:id*",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/about-us",
      "destination": "/science",
      "permanent": true
    },
    {
      "source": "/about",
      "destination": "/science",
      "permanent": true
    },
    {
      "source": "/testimonials",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/search",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/return-policy",
      "destination": "/refund-policy",
      "permanent": true
    },
    {
      "source": "/terms-and-conditions",
      "destination": "/terms-of-service",
      "permanent": true
    },
    {
      "source": "/product/bride-cream",
      "destination": "/product/sujata-bridal-whitening-cream",
      "permanent": true
    },
    {
      "source": "/product/spirulina-shampoo",
      "destination": "/product/sujata-spirushine-shampoo-conditioner",
      "permanent": true
    },
    {
      "source": "/product/spirulina-shampoo-hair-oil-combo",
      "destination": "/product/sujata-spirushine-shampoo-conditioner",
      "permanent": true
    },
    {
      "source": "/product/spirulina-product-kit",
      "destination": "/product/sujata-spirulina-sea-buckthorn-combo-pack",
      "permanent": true
    },
    {
      "source": "/product/spirulina-weight-loss-tablets",
      "destination": "/product/sujata-spirulina-tablets",
      "permanent": true
    },
    {
      "source": "/product/spirulina-face-wash",
      "destination": "/product/sujata-spirulina-facewash",
      "permanent": true
    },
    {
      "source": "/product/spirulina-tablets",
      "destination": "/product/sujata-spirulina-tablets",
      "permanent": true
    },
    {
      "source": "/product-category/:slug*",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/shop",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/cart",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/my-account",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/learn/sea-buckthorn-for-fatty-liver-and-diabetes",
      "destination": "/learn/pure-himalayan-sea-buckthorn-buying-guide",
      "permanent": true
    },
    {
      "source": "/learn/spirulina-for-weight-loss",
      "destination": "/learn/how-to-take-spirulina",
      "permanent": true
    },
    {
      "source": "/learn/sea-buckthorn-for-dry-eyes",
      "destination": "/learn/sea-buckthorn-capsules-buyers-guide",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "(?<sub>.*)\\.vercel\\.app"
        }
      ],
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/(product|learn|science|quiz|contact|track-order|refund-policy|privacy-policy|terms-of-service|shipping-policy)(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=60, s-maxage=300, stale-while-revalidate=600"
        }
      ]
    },
    {
      "source": "/_astro/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/cron/daily-dispatch",
      "schedule": "30 4 * * *"
    }
  ]
}
